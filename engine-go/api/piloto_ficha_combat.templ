package api

import "t20engine/web/ui"

// O painel de COMBATE desenhado (ALE-272, fatia 3).
//
// Quatro blocos: os três números do meio do turno, as três resistências, os seis
// atributos, e o que só às vezes importa — as armas empunhadas e a tripla do
// conjurador.
//
// # Os diálogos NÃO pedem nada ao servidor
//
// Cada caixa traz a decomposição dela já desenhada, escondida, e abrir é escrever
// UM sinal. É de propósito, e por duas razões: os números já foram computados
// para desenhar as caixas, então buscá-los de novo seria pedir o que já está na
// página; e um `@get` por caixa poria onze pedidos disputando o remendo da
// mesma cena — que é exatamente a sétima armadilha do Datastar, a que custou o
// vermelho do CI nesta issue.
//
// UM sinal e não onze: `$detalhe` guarda a CHAVE da caixa aberta, e cada
// sobreposição se compara com ela. Onze booleanos precisariam de alguém que
// apagasse os outros dez ao abrir o décimo primeiro, e o dia em que esse alguém
// esquecesse uma caixa abriria duas ao mesmo tempo.
//
// O sinal é declarado no `<body>` (ver `handleFicha`), que nunca é remendado:
// declarado aqui dentro, o `@post` do PV redeclararia `detalhe` a cada toque —
// a mesma família do `fichaAberta` do bestiário.

// oPainelDeCombate é a seção inteira.
templ oPainelDeCombate(v fichaView) {
	<section class="flex min-h-0 flex-1 flex-col">
		<div class="flex shrink-0 items-center border-b border-grimorio-iron px-3 py-2 sm:px-4">
			<h2 class="font-heading text-sm uppercase tracking-[0.18em] text-muted-foreground">Combate</h2>
		</div>
		<div class="flex min-h-0 flex-1 flex-col gap-2 overflow-y-auto p-3 sm:p-4">
			<div class="grid grid-cols-3 gap-2">
				for _, tile := range v.Combat.Tiles {
					@aCaixaDeCombate(tile)
				}
			</div>
			<div class="grid grid-cols-3 gap-2">
				for _, tile := range v.Combat.Saves {
					@aCaixaDeCombate(tile)
				}
			</div>
			<div class="grid grid-cols-6 gap-2">
				for _, attr := range v.Combat.Attributes {
					@aCaixaDeAtributo(attr)
				}
			</div>
			if v.Combat.ShowWeapons {
				@osCartoesDeArma(v.Combat.Weapons)
			}
			if len(v.Combat.MagicTiles) > 0 {
				<div class="grid grid-cols-3 gap-2">
					for _, tile := range v.Combat.MagicTiles {
						@aCaixaDeCombate(tile)
					}
				</div>
			}
		</div>
	</section>
	// As sobreposições ficam FORA da coluna que rola: dentro dela, um diálogo
	// `fixed` continuaria preso ao contexto de empilhamento do pai que rola, e
	// abrir com a página rolada o desenharia fora da vista.
	for _, tile := range v.Combat.Tiles {
		@oDetalheDaCaixa(tile)
	}
	for _, tile := range v.Combat.Saves {
		@oDetalheDaCaixa(tile)
	}
	for _, tile := range v.Combat.MagicTiles {
		@oDetalheDaCaixa(tile)
	}
	for _, arma := range v.Combat.Weapons {
		@oDetalheDaArma(arma)
	}
}

// A TINTA DO RÓTULO é `penalty-ink` e não o `destructive/80` da SPA, e a troca
// é conserto de um defeito que veio no porte.
//
// O `text-destructive/80` dá 3,22:1 sobre o painel e 3,69:1 sobre o fundo do
// diálogo — abaixo dos 4,5 do AA, e estes rótulos são `text-4xs`, que é o
// tamanho que mais precisa. A SPA tem o mesmo defeito desde sempre; ele nunca
// apareceu porque o medidor de contraste era função privada de outro spec e
// nunca chegou à ficha (ver `e2e/tests/support/contraste.ts`).
//
// `penalty-ink` é o vermelho LEGÍVEL da casa, com a regra já escrita no
// `index.css`: `bg-penalty` para o bloco, `text-penalty-ink` para a letra. A
// borda continua `destructive`, porque borda não é texto e não entra na conta.

// aCaixaDeCombate é uma caixa com número, e ela é um BOTÃO porque abre coisa.
//
// O `aria-label` repete rótulo e valor porque o leitor de tela leria "Defesa" e
// "22" como dois textos soltos de um botão sem nome — e um botão chamado "22"
// não diz o que faz.
templ aCaixaDeCombate(tile statTile) {
	<button
		type="button"
		aria-label={ tile.Label + " " + tile.Value }
		aria-haspopup="dialog"
		data-on:click={ "$detalhe = '" + tile.Key + "'" }
		class={ "relative flex cursor-pointer flex-col items-center rounded-none border-2 bg-grimorio-panel p-2 text-center outline-none transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring",
			templ.KV("border-destructive/50 hover:bg-destructive/10", !tile.Magic),
			templ.KV("border-arcane/40 hover:bg-arcane/10", tile.Magic) }
	>
		<span
			class={ "flex items-center gap-1 text-4xs font-bold uppercase tracking-widest",
				templ.KV("text-penalty-ink", !tile.Magic),
				templ.KV("text-arcane-ink", tile.Magic) }
		>
			@ui.Icon(tile.Icon, "size-3.5")
			{ tile.Label }
		</span>
		<span
			class={ "mt-0.5 text-2xl font-bold leading-none",
				templ.KV("text-foreground", !tile.Magic),
				templ.KV("text-arcane-ink", tile.Magic) }
		>{ tile.Value }</span>
		if tile.Sub != "" {
			<span
				class={ "text-3xs font-semibold uppercase tracking-widest",
					templ.KV("text-penalty-ink", !tile.Magic),
					templ.KV("text-arcane-ink", tile.Magic) }
			>{ tile.Sub }</span>
		}
	</button>
}

// aCaixaDeAtributo é um dos seis quadrados. Ela NÃO abre nada, e por isso é um
// `<div>`: um botão que não faz nada é uma promessa quebrada para quem navega
// por teclado, que pararia em seis paradas mudas.
templ aCaixaDeAtributo(attr attributeTile) {
	<div class="rounded-none border-2 border-grimorio-iron bg-grimorio-panel p-2 text-center">
		<p class="text-4xs font-bold uppercase tracking-widest text-muted-foreground">{ attr.Abbr }</p>
		<p class="mt-0.5 text-2xl font-bold leading-none text-foreground">{ attr.Value }</p>
	</div>
}

// osCartoesDeArma são as armas empunhadas, ou o texto de que não há nenhuma.
//
// O texto de vazio existe para a caixa não PARECER quebrada: um marcial de mãos
// livres veria um buraco entre os atributos e o fim da aba, e buraco em tela de
// ficha se lê como defeito.
templ osCartoesDeArma(armas []weaponTile) {
	if len(armas) == 0 {
		<p class="self-center text-center text-xs italic text-muted-foreground">Nenhuma arma empunhada.</p>
	} else {
		<div class={ "grid gap-2", templ.KV("grid-cols-2", len(armas) > 1) }>
			for _, arma := range armas {
				@oCartaoDeArma(arma)
			}
		</div>
	}
}

templ oCartaoDeArma(arma weaponTile) {
	<button
		type="button"
		aria-label={ "Detalhamento de " + arma.Name }
		aria-haspopup="dialog"
		title={ arma.Skill + " " + arma.Attack + " · dano " + arma.Damage + " · crítico " + arma.Crit }
		data-on:click={ "$detalhe = '" + arma.Key + "'" }
		class="flex cursor-pointer flex-col items-center rounded-none border-2 border-destructive/50 bg-grimorio-panel p-2 text-center outline-none transition-colors hover:bg-destructive/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
	>
		<span class="max-w-full truncate text-4xs font-bold uppercase tracking-widest text-penalty-ink">{ arma.Name }</span>
		<span class="mt-0.5 font-mono text-sm font-bold leading-tight text-foreground">
			{ arma.Attack + " · " + arma.Damage }
		</span>
		<span class="text-3xs text-muted-foreground">{ arma.Crit }</span>
	</button>
}

// oDetalheDaCaixa é a decomposição de UMA caixa, escondida até o sinal apontar
// para ela.
templ oDetalheDaCaixa(tile statTile) {
	@aSobreposicao(tile.Key, tile.Title, tile.Icon, tile.Magic) {
		@asLinhasDaDecomposicao(tile.Rows)
		<div
			class={ "flex items-center justify-between rounded-none border px-3 py-2",
				templ.KV("border-destructive/40 bg-destructive/10", !tile.Magic),
				templ.KV("border-arcane/40 bg-arcane/10", tile.Magic) }
		>
			<span
				class={ "text-xs uppercase tracking-widest",
					templ.KV("text-penalty-ink", !tile.Magic),
					templ.KV("text-arcane-ink", tile.Magic) }
			>Total</span>
			<span
				class={ "font-mono text-2xl font-bold",
					templ.KV("text-foreground", !tile.Magic),
					templ.KV("text-arcane-ink", tile.Magic) }
			>{ tile.Value }</span>
		</div>
		if tile.Extra != nil {
			<div class="space-y-1">
				<p class="text-xs font-bold uppercase tracking-widest text-penalty-ink">{ tile.Extra.Title }</p>
				@asLinhasDaDecomposicao(tile.Extra.Rows)
			</div>
		}
	}
}

// oDetalheDaArma são as DUAS contas de uma arma, cada uma sob o próprio rótulo.
//
// Não há caixa de "Total" aqui, e a ausência é a da SPA: uma arma não tem um
// número só — tem o ataque e tem o dano, e um total entre os dois não
// significaria nada.
templ oDetalheDaArma(arma weaponTile) {
	@aSobreposicao(arma.Key, arma.Name, "Sword", false) {
		<div>
			<p class="text-xs font-bold uppercase tracking-widest text-penalty-ink">
				{ "Ataque (" + arma.Skill + ") " + arma.Attack }
			</p>
			<div class="mt-1">
				@asLinhasDaDecomposicao(arma.AttackRows)
			</div>
		</div>
		<div>
			<p class="text-xs font-bold uppercase tracking-widest text-penalty-ink">
				{ "Dano " + arma.Damage + " · crítico " + arma.Crit }
			</p>
			<div class="mt-1">
				if len(arma.DamageRows) == 0 {
					<p class="text-xs text-muted-foreground">Só o dado da arma.</p>
				} else {
					@asLinhasDaDecomposicao(arma.DamageRows)
				}
			</div>
		</div>
	}
}

// aSobreposicao é a moldura de todo diálogo desta aba.
//
// O Esc e o clique FORA fecham, e há botão de fechar além dos dois: diálogo sem
// saída é tela travada, e quem navega por teclado não deve depender de descobrir
// o Esc.
//
// `data-expanded` é o que faz o driver de setas se recolher — ele procura
// `[role="dialog"][data-expanded]`, e sem isto as setas continuariam andando nas
// caixas ATRÁS da sobreposição. Aqui o `data-attr` com BOOLEANO é o certo, ao
// contrário do que vale para `aria-*`: é a PRESENÇA do atributo que o seletor
// procura.
templ aSobreposicao(key, titulo, icone string, magic bool) {
	<div
		data-show={ "$detalhe === '" + key + "'" }
		data-on:click="evt.target === el && ($detalhe = '')"
		data-on:keydown__window="evt.key === 'Escape' && ($detalhe = '')"
		class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 p-3 sm:p-4"
	>
		// CENTRALIZADO em toda largura, e não folha subindo da borda de baixo: é
		// a geometria da SPA, e este painel é porte. O bestiário usa a folha de
		// baixo porque lá o diálogo é a ficha INTEIRA de uma criatura; aqui são
		// quatro linhas e um total, e uma folha de borda para quatro linhas
		// pareceria uma gaveta pela metade.
		<div
			role="dialog"
			aria-modal="true"
			aria-label={ titulo }
			data-attr:data-expanded={ "$detalhe === '" + key + "'" }
			class="relative max-h-[85vh] w-full overflow-y-auto rounded-md border border-grimorio-iron bg-background p-4 sm:max-w-sm"
		>
			<button
				type="button"
				aria-label={ "Fechar " + titulo }
				data-on:click="$detalhe = ''"
				class="absolute right-2 top-2 flex size-11 items-center justify-center rounded-sm text-lg text-muted-foreground outline-none transition-colors hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
			>×</button>
			<p
				class={ "flex items-center gap-2 pr-10 font-heading uppercase tracking-wide",
					templ.KV("text-grimorio-gold", !magic),
					templ.KV("text-arcane-ink", magic) }
			>
				@iconeDoDetalhe(icone)
				{ titulo }
			</p>
			<div class="mt-3 space-y-2 text-sm">
				{ children... }
			</div>
		</div>
	</div>
}

// iconeDoDetalhe existe só para o comentário do `@icone` não morar na lista de
// atributos de um elemento, que é a armadilha do templ que já custou oito
// rodadas.
templ iconeDoDetalhe(nome string) {
	@ui.Icon(nome, "size-3.5")
}

// asLinhasDaDecomposicao é a lista de "de onde veio, e quanto".
templ asLinhasDaDecomposicao(rows []breakdownRow) {
	<ul class="space-y-1">
		for _, row := range rows {
			<li class={ "border-b border-grimorio-iron pb-1", templ.KV("text-muted-foreground", row.Muted) }>
				<div class="flex items-center justify-between gap-2">
					<span class="truncate">{ row.Label }</span>
					<span class="shrink-0 font-mono">{ row.Value }</span>
				</div>
				// A nota QUEBRA linha em vez de truncar: sem quebra ela vira a
				// largura mínima da linha e estica o diálogo inteiro para fora
				// do `max-w`.
				if row.Note != "" {
					<p class="text-2xs leading-snug text-muted-foreground">{ row.Note }</p>
				}
			</li>
		}
	</ul>
}

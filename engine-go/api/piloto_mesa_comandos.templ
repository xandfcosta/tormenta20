package api

import "t20engine/web/ui"



// OS CONTROLES DO MESTRE (ALE-265).
//
// Eles entram na MESMA cena do jogador, e não numa segunda: a tela do mestre é
// a do jogador mais o que ele comanda. Duas cenas seriam duas listas de
// combatente para manter em dia, que é o formato exato do defeito da ALE-122 —
// a mesma tela mostrando 52/95 e 57/95 do mesmo combatente.
//
// Quem decide se eles aparecem é o PAPEL, resolvido no servidor pelo mesmo
// `stateForRole` que o resto da casa usa. Esconder no cliente seria UX; a trava
// é a redação do estado, que o jogador nunca recebe.

templ controlesDoMestre(v mesaView, r mestreView) {
	<section
		aria-label="Controles do mestre"
		class="flex shrink-0 flex-wrap items-center gap-2 border-t border-grimorio-iron bg-grimorio-panel px-2 py-1 sm:px-3"
	>
		// O CONTADOR vem primeiro e é texto, não enfeite: ele é quem explica por
		// que o avanço está apagado quando está. Botão apagado sem frase ao lado
		// é um beco.
		//
		// `aria-live` porque num app de remendo a rodada muda sem navegação, e
		// quem não vê a tela não tem outro sinal.
		<p aria-live="polite" class="text-xs text-muted-foreground">{ r.Contador }</p>
		// A RECUSA de um comando, e ela mora aqui e não na caixa de registrar: o
		// mestre que também joga tem as duas na tela, e a frase do "Adicionar
		// grupo" acesa dentro do "Registrar iniciativa" seria a frase certa no
		// lugar errado. Por isso o sinal é `erroDoComando` e não `erro`.
		//
		// `w-full` e `order-last` para ela ocupar a própria fileira quando
		// aparece: enfiada entre os botões, empurraria o avanço para fora da
		// linha e a frase seria lida como rótulo do vizinho.
		<p
			data-show="$erroDoComando != ''"
			data-text="$erroDoComando"
			aria-live="assertive"
			class="order-last w-full text-xs text-destructive"
		></p>
		<div class="ml-auto flex flex-wrap items-center gap-2">
			@passoDoTurno(v, "previous-turn", "Turno anterior", "‹", r.PodeAvancar)
			// O rótulo do avanço diz PARA ONDE vai (ALE-184): o mestre lia "▶" e
			// contava a lista para saber quem entrava.
			<button
				type="button"
				if r.PodeAvancar {
					data-on:click={ comandoDaMesa(v, "POST", "initiative/next-turn") }
					class="inline-flex min-h-11 items-center gap-1.5 rounded-sm border border-grimorio-gold bg-accent px-3 text-sm font-medium text-grimorio-gold outline-none transition-colors hover:bg-grimorio-gold/20 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
				} else {
					disabled
					class="inline-flex min-h-11 cursor-not-allowed items-center gap-1.5 rounded-sm border border-grimorio-iron px-3 text-sm text-muted-foreground opacity-60"
				}
			>{ r.Avanco.Rotulo }</button>
			// O "Iniciar cena" fica SEMPRE na fileira, em qualquer altura de
			// palco: abaixo de 1024 a SPA tirou o ciclo do trilho justamente para
			// o mestre no celular não ficar sem caminho nenhum para COMEÇAR
			// (ALE-210 lida pela ALE-184). O que anda é o par de baixo.
			if !v.SceneActive {
				@iniciarCena(v)
			}
			// Palco ALTO: encerrar e recuperar dividem a fileira com o avanço.
			// Palco BAIXO: os mesmos nós reaparecem na gaveta, e não outros —
			// são as MESMAS funções chamadas duas vezes, porque dois desenhos do
			// mesmo botão são dois lugares para consertar.
			<div class="palco-alto-so">
				if v.SceneActive {
					@encerrarCena(v)
				}
				@aRecuperacao(v)
			</div>
			@gavetaDaMesa(v)
		</div>
		@descansoDeDia(v)
	</section>
}

// gavetaDaMesa é o rodapé do mestre quando o palco é baixo (ALE-263).
//
// `<details>` e não um popover com JavaScript: abrir e fechar é o que o elemento
// JÁ faz, e ele leva de graça o teclado, o foco e o "fechar com Escape" que uma
// gaveta de mão sempre esquece. Ela sobe (`bottom-full`) porque nasce no rodapé.
//
// Quem a mostra e a esconde é a consulta de contêiner na folha, e não uma classe
// aqui: a decisão é sobre a ALTURA MEDIDA do palco, e essa medida o servidor não
// tem — é a tradução do `palcoBaixo` que a ALE-265 deixou anotada.
templ gavetaDaMesa(v mesaView) {
	<details class="palco-gaveta relative">
		<summary
			aria-label="Mais comandos da mesa"
			class="flex size-11 cursor-pointer list-none items-center justify-center rounded-sm border border-grimorio-iron text-sm outline-none transition-colors hover:bg-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
		>
			@ui.Icon("Settings2", "size-4")
		</summary>
		<div class="absolute bottom-full right-0 z-20 mb-2 flex w-56 flex-col gap-1 rounded-sm border border-grimorio-iron bg-grimorio-panel p-2 shadow-lg">
			if v.SceneActive {
				@encerrarCena(v)
			}
			@aRecuperacao(v)
		</div>
	</details>
}

// aRecuperacao é o par do livro (T20 p105): devolve PV e PM ao grupo.
//
// A palavra da SEÇÃO é "recuperação" porque diz o que ela DEVOLVE, e a das AÇÕES
// é "descanso" porque é a do livro — a distinção é do GLOSSARIO e a SPA já a
// pratica com estas mesmas frases. Duas telas não devem inventar dois
// vocabulários para o mesmo gesto.
//
// A de CENA acontece no clique porque não precisa de mais nada. A de DIA precisa
// da qualidade, que é o que a p105 usa para calcular quanto volta, e só por isso
// abre o diálogo — cobrar dois passos pelo que tem um seria cobrar por um dado
// que o motor não usa.
templ aRecuperacao(v mesaView) {
	<button
		type="button"
		data-indicator:descansando
		data-attr:disabled="$descansando"
		data-on:click={ comandoDaMesa(v, "POST", "rest/scene") }
		class="inline-flex min-h-11 items-center gap-1.5 rounded-sm border border-grimorio-iron px-3 text-sm outline-none transition-colors hover:bg-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring disabled:opacity-50"
	>
		@ui.Icon("Hourglass", "size-4")
		Recuperar · cena
	</button>
	<button
		type="button"
		data-on:click="document.getElementById('descanso-de-dia').showModal()"
		class="inline-flex min-h-11 items-center gap-1.5 rounded-sm border border-grimorio-iron px-3 text-sm outline-none transition-colors hover:bg-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
	>
		@ui.Icon("Moon", "size-4")
		Recuperar · dia
	</button>
}

// descansoDeDia pergunta a QUALIDADE antes de descansar (T20 p105).
//
// `data-preserve-attr="open"` não é enfeite e sem ele o diálogo é inútil: a cena
// inteira é remendada a cada mudança, o `open` do `showModal()` só existe no DOM
// vivo, e o morph o apagaria — o diálogo FECHARIA sozinho no instante em que
// qualquer jogador registrasse iniciativa. O atributo diz ao morph para não
// tocar naquele, e ele é lido do nó que CHEGA, que é por isso que ele mora no
// HTML do servidor e não no que o navegador escreve.
//
// `<dialog>` nativo e não uma caixa flutuante: o modal de verdade traz o foco
// preso, o Escape, o fundo inerte e a camada de topo — que ainda por cima é o
// que o tira de dentro do `contain` do palco.
// `m-auto` na caixa porque o `preflight` do Tailwind zera a margem de TODO
// elemento, e a centralização do `<dialog>` modal é justamente a `margin: auto`
// que o navegador aplica sobre `inset: 0`. Sem ele o diálogo nasce grudado no
// canto superior esquerdo — medido, `top: 0, left: 0` numa janela de 1916×907.
templ descansoDeDia(v mesaView) {
	<dialog
		id="descanso-de-dia"
		data-preserve-attr="open"
		aria-labelledby="descanso-de-dia-titulo"
		class="scene-grimorio m-auto w-[min(24rem,calc(100vw-2rem))] rounded-sm border border-grimorio-iron bg-grimorio-panel p-4 text-foreground backdrop:bg-black/60"
	>
		<h2 id="descanso-de-dia-titulo" class="font-heading text-lg tracking-wide text-grimorio-gold">Descanso de dia</h2>
		<p class="mt-1 text-sm text-muted-foreground">A qualidade do descanso decide quanto o grupo recupera de PV e PM (p105).</p>
		<label for="qualidade-do-descanso" class="mt-3 block text-xs font-bold uppercase tracking-widest text-muted-foreground">Qualidade do descanso</label>
		// O NOME DO SINAL É TODO MINÚSCULO, e isso não é desleixo: nome de
		// ATRIBUTO é minusculado pelo analisador de HTML, então um
		// `data-bind:qualidadeDoDescanso` chega ao Datastar como
		// `data-bind:qualidadedodescanso` e ele liga um sinal NOVO com esse
		// nome. Medido no navegador: o fio levava os DOIS —
		// `"qualidadeDoDescanso":"normal"`, que ninguém tocou, e
		// `"qualidadedodescanso":"luxuosa"`, que era a escolha real —, e o
		// servidor lia o primeiro. O mestre escolhia Luxuosa e o grupo
		// descansava em normal.
		//
		// A distinção que salva os outros sinais: `erroDoComando` e `d20`
		// aparecem só em VALOR de atributo (`data-show`, `data-text`,
		// `data-signals`), e valor preserva a caixa. A regra é sobre sinal usado
		// como CHAVE.
		<select
			id="qualidade-do-descanso"
			data-bind:qualidadedodescanso
			class="mt-1 w-full rounded-sm border border-input bg-background px-2 py-1.5 text-sm outline-none focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-ring"
		>
			<option value="ruim">Ruim (½ nível)</option>
			<option value="normal">Normal (nível)</option>
			<option value="confortavel">Confortável (2×)</option>
			<option value="luxuosa">Luxuosa (3×)</option>
		</select>
		<div class="mt-4 flex justify-end gap-2">
			// `formmethod=dialog` num botão SEM formulário não fecha nada; o
			// fechar é explícito, e é o mesmo `close()` que o Descansar usa.
			<button
				type="button"
				data-on:click="document.getElementById('descanso-de-dia').close()"
				class="inline-flex min-h-11 items-center rounded-sm border border-grimorio-iron px-3 text-sm outline-none transition-colors hover:bg-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
			>Cancelar</button>
			// Fecha ANTES de postar: a recusa do servidor chega no
			// `$erroDoComando`, que é do RODAPÉ — deixar o diálogo aberto por
			// cima dela esconderia a única frase que explica o que houve.
			<button
				type="button"
				data-on:click={ "document.getElementById('descanso-de-dia').close(); " + comandoDaMesa(v, "POST", "rest/day") }
				class="inline-flex min-h-11 items-center rounded-sm bg-primary px-3 text-sm font-semibold text-primary-foreground outline-none transition-opacity hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
			>Descansar</button>
		</div>
	</dialog>
}

// passoDoTurno é o voltar. Ele existe porque errar o avanço é o engano mais
// comum da mesa, e sem ele o conserto é remontar a ordem inteira.
templ passoDoTurno(v mesaView, rota, rotulo, sinal string, ligado bool) {
	<button
		type="button"
		aria-label={ rotulo }
		if ligado {
			data-on:click={ comandoDaMesa(v, "POST", "initiative/"+rota) }
			class="flex size-11 items-center justify-center rounded-sm border border-grimorio-iron text-sm outline-none transition-colors hover:bg-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
		} else {
			disabled
			class="flex size-11 cursor-not-allowed items-center justify-center rounded-sm border border-grimorio-iron text-sm text-muted-foreground opacity-60"
		}
	>{ sinal }</button>
}

// Abrir e encerrar a cena NÃO são um interruptor, e por isso são dois nós e não
// um com `if` dentro.
//
// Encerrar a cena tira a fila da mesa e é irreversível pelo mesmo clique — desde
// a ALE-210 a vaga de registrar só existe DENTRO da cena. Um interruptor convida
// ao clique de volta que não existe; dois verbos dizem o que cada um faz.
//
// Eles se separaram na ALE-263 porque passaram a viver em lugares diferentes: o
// INICIAR fica na fileira em qualquer altura de palco, e o ENCERRAR desce para a
// gaveta quando o palco é baixo. Quem escolhe entre eles continua sendo a cena,
// e continua sendo uma vaga só — nenhum deles aparece com o outro.
templ encerrarCena(v mesaView) {
	<button
		type="button"
		data-on:click={ comandoDaMesa(v, "POST", "scene/end") }
		class="inline-flex min-h-11 items-center rounded-sm border border-grimorio-iron px-3 text-sm text-muted-foreground outline-none transition-colors hover:border-destructive hover:text-destructive focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
	>Encerrar cena</button>
}

templ iniciarCena(v mesaView) {
	<button
		type="button"
		data-on:click={ comandoDaMesa(v, "POST", "scene/start") }
		class="inline-flex min-h-11 items-center rounded-sm border border-grimorio-gold px-3 text-sm text-grimorio-gold outline-none transition-colors hover:bg-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
	>Iniciar cena</button>
}

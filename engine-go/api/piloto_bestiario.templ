package api

import "fmt"

// A MESA DO MESTRE, e a primeira das quatro ferramentas (ALE-257).
//
// O título na tela continua "Mesa do Mestre", que é o nome do original, mas o
// endereço é `/piloto/mestre/`. A decisão do dono foi em dois tempos, e o que a
// virou foi um FATO que só apareceu ao escrever as rotas: `/piloto/mesa/` já
// está ocupado desde a fatia 1 — `/piloto/mesa/{campanha}/{sessao}` é a sessão
// ao vivo. Pendurar as ferramentas ali daria à mesma palavra dois sentidos no
// mesmo espaço de endereço, que é exatamente o que o GLOSSARIO.md proíbe (um
// conceito por palavra), e ainda por cima no sentido que ele já rejeita:
// **mesa** é "as pessoas conectadas agora", metonímia e nunca entidade.
//
// O título fica porque renomear tela que o mestre já conhece não é assunto de
// migração. O endereço nasce limpo porque ele ainda não existe — não há link
// para quebrar, e o dia em que a tela for rebatizada a URL já está certa.

// ferramentaDoMestre é uma parada da trilha.
type ferramentaDoMestre struct {
	Slug   string
	Rotulo string
	Icone  string
	Dica   string
}

// A ordem é a da trilha, e ela não é alfabética: vai do que se usa em combate
// para o que se consulta entre cenas.
var ferramentasDoMestre = []ferramentaDoMestre{
	{"bestiario", "Bestiário", "Skull", "Criaturas por ND, tipo e tamanho, com ataques e habilidades."},
	{"encontros", "Encontros", "Swords", "ND do combate e XP do grupo, combinando criaturas."},
	{"improviso", "Improviso", "Dices", "Tabelas do Cap 6 e estrutura de masmorra na hora."},
	{"catalogos", "Catálogos", "BookMarked", "Condições, magias, poderes e itens numa busca só."},
}

templ mesaDoMestre(atual string, cena templ.Component) {
	<div class="flex min-h-0 flex-1 flex-col gap-3 px-4 py-3 lg:flex-row lg:gap-4">
		@trilhaDoMestre(atual)
		<div class="flex min-h-0 flex-1 flex-col">
			@cena
		</div>
	</div>
}

// trilhaDoMestre: coluna no laptop, barra rolável no telefone — UMA lista nos
// dois casos, porque duas árvores para o mesmo trilho é como um trilho e o
// gêmeo dele de telefone se desencontram.
//
// A escolha por LARGURA e nunca por altura: no telefone o teclado virtual muda
// a ALTURA da janela, e um trilho que troca de forma no meio da digitação some
// debaixo do dedo.
//
// São LINKS e não botões, e essa é a diferença para a SPA: trocar de ferramenta
// é navegar. O botão perdia o clique do meio, o "abrir em nova aba" e o
// endereço que se cola no chat.
templ trilhaDoMestre(atual string) {
	<nav
		aria-label="Ferramentas do mestre"
		class="flex shrink-0 gap-1 overflow-x-auto pb-1 lg:w-44 lg:flex-col lg:overflow-x-visible lg:pb-0"
	>
		for _, f := range ferramentasDoMestre {
			<a
				href={ templ.SafeURL("/piloto/mestre/" + f.Slug) }
				title={ f.Dica }
				if f.Slug == atual {
					aria-current="page"
					class="flex min-h-11 shrink-0 items-center gap-2 rounded-sm border border-grimorio-gold bg-accent px-3 py-2 text-left text-xs font-medium text-grimorio-gold transition-colors outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring lg:w-full"
				} else {
					class="flex min-h-11 shrink-0 items-center gap-2 rounded-sm border border-grimorio-iron px-3 py-2 text-left text-xs text-muted-foreground transition-colors outline-none hover:bg-accent hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring lg:w-full"
				}
			>
				@icone(f.Icone, "size-4 shrink-0")
				<span class="truncate font-heading uppercase tracking-[0.12em]">{ f.Rotulo }</span>
			</a>
		}
	</nav>
}

// ── o bestiário ──────────────────────────────────────────────────────────────

templ cenaDoBestiario(v bestiarioView) {
	<section
		id="bestiario"
		class="mesa-palco flex min-h-0 flex-1 flex-col gap-3"
		aria-labelledby="mesa-bestiario"
		data-signals={ sinaisDoBestiario(v) }
	>
		<div class="flex flex-wrap items-baseline gap-x-3">
			<h2 id="mesa-bestiario" class="font-heading text-lg tracking-wide text-foreground">Bestiário</h2>
			<p class="text-xs text-muted-foreground">{ fmt.Sprintf("%d de %d", len(v.Verbetes), v.Total) }</p>
		</div>
		// A grade é a mesma `mesa-duas-colunas` da SPA, e ela é `@container` e
		// não `lg:` (ALE-172): a pergunta é "cabe painel ao lado da lista?", que
		// é sobre o espaço que ESTA grade recebe, não sobre a janela. Com o
		// `lg:` a resposta era não-monotônica — um contêiner de 800px dava DUAS
		// colunas e um de 968px dava UMA, porque a coluna de ferramentas
		// devolve largura conforme a janela encolhe. Crescer o espaço custava
		// uma coluna.
		<div class="mesa-duas-colunas grid min-h-0 flex-1 gap-4">
			<div class="flex min-h-0 flex-col gap-2">
				@filtrosDoBestiario(v)
				@listaDeVerbetes(v)
			</div>
			<section aria-label="Criatura escolhida" class="mesa-painel">
				if v.Escolhido != nil {
					@blocoDoVerbete(*v.Escolhido)
				} else {
					<p class="text-xs text-muted-foreground">Escolha uma criatura na lista.</p>
				}
			</section>
		</div>
		if v.Escolhido != nil {
			@fichaEmDialogo(*v.Escolhido)
		}
	</section>
}

// fichaEmDialogo é a MESMA ficha, para a largura em que o painel não cabe.
//
// O `.mesa-painel` da SPA é `display:none` até 50rem de contêiner, e abaixo
// disso a lista ficaria sem detalhe nenhum — a SPA abre um diálogo, e não
// trazer isso perderia a ficha inteira no telefone. A troca é do CSS
// (`.mesa-ficha-em-dialogo`, na folha do piloto) e não de uma consulta de mídia
// em JS, e ela compõe com o `data-show`: numa tela larga o diálogo fica
// escondido mesmo com o sinal ligado, porque lá o painel já mostra a ficha.
//
// `role="dialog"` com `aria-modal` e `aria-label` no NOME da criatura: sem nome
// acessível, um diálogo é uma caixa anônima para quem usa leitor de tela.
//
// O nome vem por `aria-label` e não por um `<h3>` próprio de propósito: o
// `blocoDoVerbete` já desenha o dele, e um segundo cabeçalho aqui faria o
// leitor de tela anunciar a criatura duas vezes seguidas. (A SPA tem essa
// duplicação — um `DialogHeader` em `sr-only` por cima do bloco.)
//
// O Esc e o clique fora fecham, porque diálogo sem saída é tela travada — e o
// botão de fechar existe além dos dois, para quem navega por teclado não
// depender de descobrir o Esc.
templ fichaEmDialogo(m verbete) {
	<div
		class="mesa-ficha-em-dialogo fixed inset-0 z-50 flex items-end justify-center bg-black/60 p-0 sm:items-center sm:p-4"
		data-show="$fichaAberta"
		data-on:click="evt.target === el && ($fichaAberta = false)"
		data-on:keydown__window="evt.key === 'Escape' && ($fichaAberta = false)"
	>
		<div
			role="dialog"
			aria-modal="true"
			aria-label={ m.Name }
			class="relative max-h-[85vh] w-full overflow-y-auto rounded-t-md border border-grimorio-iron bg-background p-4 sm:max-w-2xl sm:rounded-md"
		>
			<button
				type="button"
				aria-label={ "Fechar a ficha de " + m.Name }
				data-on:click="$fichaAberta = false"
				class="absolute right-2 top-2 flex size-11 items-center justify-center rounded-sm text-lg text-muted-foreground outline-none transition-colors hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
			>×</button>
			@blocoDoVerbete(m)
		</div>
	</div>
}

templ filtrosDoBestiario(v bestiarioView) {
	<div class="space-y-2">
		<div class="relative">
			@icone("Search", "pointer-events-none absolute left-2 top-1/2 size-4 -translate-y-1/2 text-muted-foreground")
			<input
				type="search"
				name="busca"
				data-bind:busca
				data-on:input__debounce.250ms={ fmt.Sprintf("@get('%s')", v.bestiarioBase()) }
				value={ v.Busca }
				placeholder="Buscar criatura"
				aria-label="Buscar criatura"
				class="h-9 w-full rounded-sm border border-input bg-transparent pl-8 pr-3 text-base outline-none focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-ring md:text-sm"
			/>
		</div>
		<div class="flex flex-wrap items-end gap-2">
			@caixaDeND(v.bestiarioBase(), "nd-min", "ND mínimo", "ndMin", ndNaCaixa(v.NDMin))
			@caixaDeND(v.bestiarioBase(), "nd-max", "ND máximo", "ndMax", ndNaCaixa(v.NDMax))
		</div>
		// `fieldset` porque é um conjunto de escolhas, e a `legend` em `sr-only`
		// porque a tela já diz "Bestiário" logo acima — repetir "Tipo" ali só
		// tira espaço de sete crachás que precisam caber numa linha.
		<fieldset class="flex flex-wrap gap-1.5 border-0 p-0">
			@legendaDeSecao("muted", "sr-only") {
				Filtrar por tipo
			}
			for _, t := range tiposDeCriatura {
				<button
					type="button"
					aria-pressed={ boolTexto(v.tipoAceso(t)) }
					data-on:click={ fmt.Sprintf("@post('%s/tipo/%s')", v.bestiarioBase(), t) }
					if v.tipoAceso(t) {
						class="min-h-11 rounded-sm border border-grimorio-gold bg-accent px-2 py-0.5 text-2xs font-medium text-grimorio-gold transition-colors outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
					} else {
						class="min-h-11 rounded-sm border border-grimorio-iron px-2 py-0.5 text-2xs text-muted-foreground transition-colors outline-none hover:bg-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
					}
				>{ nomeDoTipo(t) }</button>
			}
		</fieldset>
	</div>
}

// caixaDeND é um campo numérico simples, e não o `NumberInput` com setas da SPA.
//
// O `step` de 0,25 é do livro: o ND anda em quartos abaixo de 1 (ND 1/4, 1/2).
// O `min`/`max` nativos NÃO são a trava — o servidor aperta a faixa de novo,
// porque o número chega pela URL e qualquer um a edita à mão.
templ caixaDeND(base, id, rotulo, sinal, valor string) {
	<div class="space-y-1">
		@rotuloDeSecao("muted", "block") {
			<label for={ "bestiario-" + id }>{ rotulo }</label>
		}
		<input
			id={ "bestiario-" + id }
			type="number"
			min="0"
			max="20"
			step="0.25"
			value={ valor }
			data-bind={ sinal }
			data-on:input__debounce.400ms={ fmt.Sprintf("@get('%s')", base) }
			aria-label={ rotulo }
			class="h-9 w-24 rounded-sm border border-input bg-transparent px-2 text-base tabular-nums outline-none focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-ring md:text-sm"
		/>
	</div>
}

// listaDeVerbetes: uma lista de verdade, sem virtualização.
//
// São 80 criaturas. A SPA usa `VirtualList` com `estimateSize={72}`, que é
// maquinaria para lista que não cabe — e a 80 ela cobra o custo (medir, janela,
// espaçador) sem cobrir problema nenhum. Ela também obrigava um e2e, porque
// lista virtualizada mede zero no jsdom e só o browser testemunha.
//
// A tampa de 45vh também não volta (ALE-175): a lista é o ÚLTIMO elemento da
// coluna, e quem a limita é a caixa. Com a tampa sobravam 243px mortos em
// 768×1024 — um quarto da tela — protegendo conteúdo que naquele formato está
// `hidden`.
templ listaDeVerbetes(v bestiarioView) {
	if len(v.Verbetes) == 0 {
		<p class="p-4 text-center text-xs text-muted-foreground">Nenhuma criatura casa com os filtros.</p>
	} else {
		<ul class="min-h-0 flex-1 space-y-1 overflow-y-auto rounded-sm border border-grimorio-iron p-1">
			for _, m := range v.Verbetes {
				<li>
					<a
						href={ templ.SafeURL(v.bestiarioBase() + "?criatura=" + m.ID) }
						data-on:click={ fmt.Sprintf("evt.preventDefault(); $criatura = %q; $fichaAberta = true; @get('%s')", m.ID, v.bestiarioBase()) }
						if v.Escolhido != nil && v.Escolhido.ID == m.ID {
							aria-current="true"
							class="block w-full rounded-sm border border-grimorio-gold bg-accent p-2 text-left transition-colors outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
						} else {
							class="block w-full rounded-sm border border-grimorio-iron p-2 text-left transition-colors outline-none hover:bg-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
						}
					>
						<p class="flex flex-wrap items-baseline gap-x-1.5 text-xs font-semibold">
							{ m.Name }
							<span class="font-mono text-3xs text-grimorio-gold">{ "ND " + ndEscrito(m.ND) }</span>
							<span class="text-3xs font-normal text-muted-foreground">
								{ nomeDoTipo(m.Tipo) + " · " + nomeDoTamanho(m.Size) }
							</span>
						</p>
						<p class="font-mono text-3xs text-muted-foreground">
							{ fmt.Sprintf("PV %d · DEF %d · p%d", m.HP, m.Defesa, m.BookPage) }
						</p>
					</a>
				</li>
			}
		</ul>
	}
}

// ── o bloco de estatísticas ──────────────────────────────────────────────────

// blocoDoVerbete é a ficha da criatura como o livro a imprime.
//
// A ORDEM é regra e foi decidida na ALE-170: Ataques e Habilidades vêm ANTES
// de Atributos e Resistências. O mestre abre o bestiário no meio do combate
// para saber o que a criatura rola AGORA, e antes disso ele atravessava doze
// estatísticas para chegar nos ataques. O bloco que o próprio mestre escreve já
// punha Ataques em primeiro: a casa sabia a ordem certa num lugar e não no
// outro.
//
// A medida é limitada (`max-w-4xl`) porque isto é dado mais prosa: a 1920 as
// caixas de atributo esticavam para ~220px cada para segurar dois caracteres.
templ blocoDoVerbete(m verbete) {
	<div class="max-w-4xl space-y-4 text-sm">
		<div class="space-y-0.5">
			<h3 class="font-heading text-lg tracking-wide text-foreground">{ m.Name }</h3>
			<p class="text-xs text-muted-foreground">
				{ fmt.Sprintf("ND %s · %s · %s · p%d · XP %d", ndEscrito(m.ND), nomeDoTipo(m.Tipo), nomeDoTamanho(m.Size), m.BookPage, xpDoND(m.ND)) }
			</p>
		</div>
		// Iniciativa e Percepção são a PRIMEIRA linha do bloco impresso (p289),
		// e o mestre rola as duas antes de qualquer outra coisa no combate.
		<div class="grid grid-cols-2 gap-2 sm:grid-cols-4">
			@estatistica("Iniciativa", comSinalInt(m.Iniciativa))
			@estatistica("Percepção", comSinalInt(m.Percepcao))
			@estatistica("PV", fmt.Sprintf("%d", m.HP))
			@estatistica("Defesa", fmt.Sprintf("%d", m.Defesa))
			@estatistica("Deslocamento", m.Deslocamento)
			if m.PM != nil {
				@estatistica("PM", fmt.Sprintf("%d", *m.PM))
			}
		</div>
		if len(m.Attacks) > 0 {
			@secaoDoBloco("Ataques") {
				<div class="space-y-1">
					for _, a := range m.Attacks {
						<div class="rounded-sm border border-grimorio-iron p-2">
							<p class="text-xs font-semibold">
								{ a.Name + " " }
								<span class="font-mono text-muted-foreground">{ comSinalInt(a.AttackBonus) + " · " + a.Damage }</span>
							</p>
							if a.Special != "" {
								<p class="text-2xs text-muted-foreground">{ a.Special }</p>
							}
						</div>
					}
				</div>
			}
		}
		if len(m.SpecialAbilities) > 0 {
			@secaoDoBloco("Habilidades especiais") {
				<ul class="list-disc space-y-1 pl-5 text-xs">
					for _, h := range m.SpecialAbilities {
						<li>{ h }</li>
					}
				</ul>
			}
		}
		if len(m.Skills) > 0 {
			@secaoDoBloco("Perícias") {
				<p class="text-xs">
					for i, p := range m.Skills {
						if i > 0 {
							{ " · " }
						}
						{ p.Name + " " }
						<span class="font-mono">{ comSinalInt(p.Bonus) }</span>
						if p.Nota != "" {
							<span class="text-muted-foreground">{ " (" + p.Nota + ")" }</span>
						}
					}
				</p>
			}
		}
		// Equipamento e Tesouro fecham o bloco impresso, e é onde o livro os
		// põe. O equipamento se perdeu INTEIRO na importação — zero dos 80
		// verbetes o tinham — e o tesouro virava um número de XP (ALE-151).
		if m.Equipamento != "" {
			@secaoDoBloco("Equipamento") {
				<p class="text-xs">{ m.Equipamento }</p>
			}
		}
		if m.Tesouro != "" {
			@secaoDoBloco("Tesouro") {
				<p class="text-xs">{ m.Tesouro }</p>
			}
		}
		@secaoDoBloco("Atributos") {
			<div class="grid grid-cols-3 gap-1 sm:grid-cols-6">
				@estatistica("For", comSinal(m.Forca))
				@estatistica("Des", comSinal(m.Destreza))
				@estatistica("Con", comSinal(m.Constituicao))
				@estatistica("Int", comSinal(m.Inteligencia))
				@estatistica("Sab", comSinal(m.Sabedoria))
				@estatistica("Car", comSinal(m.Carisma))
			</div>
		}
		@secaoDoBloco("Resistências") {
			<div class="grid grid-cols-3 gap-1">
				@estatistica("Fortitude", comSinalInt(m.Fortitude))
				@estatistica("Reflexos", comSinalInt(m.Reflexos))
				@estatistica("Vontade", comSinalInt(m.Vontade))
			</div>
		}
	</div>
}

// secaoDoBloco leva `aria-label` além do `h4`: uma `<section>` SEM nome
// acessível não é uma região para o leitor de tela — vira caixa anônima, e o
// mestre que navega por regiões não consegue pular para Ataques (ALE-151).
templ secaoDoBloco(titulo string) {
	<section aria-label={ titulo }>
		<h4 class={ classesDoRotulo("muted", "mb-1") }>{ titulo }</h4>
		{ children... }
	</section>
}

templ estatistica(rotulo, valor string) {
	<div class="rounded-sm border border-grimorio-iron p-2 text-center">
		@rotuloDeSecao("muted", "") {
			{ rotulo }
		}
		<p class="text-sm font-semibold tabular-nums">{ valor }</p>
	</div>
}

package api

import (
	"fmt"
	"t20engine/web/ui"
)

// O ELENCO DA CAMPANHA (ALE-269, superfície 6a — os jogadores).
//
// O conceito que faltava é que **iniciativa não é lista de combatentes**: até
// aqui, a única forma de alguém existir na sessão era já estar na fila. O
// elenco responde "quem existe nesta campanha" — e quem põe alguém no combate é
// o mestre, QUANDO ele quiser.
//
// Esta é a metade dos JOGADORES. Os NPCs da campanha vêm num commit próprio: o
// piloto não tem CRUD de criatura nenhum, e o editor de bloco são ~25 campos
// mais ataques e habilidades — trabalho de outra natureza.
//
// O QUE A FICHA MOSTRA, e por que não é a ficha inteira: a SPA abre o
// `CharacterSheet` completo e editável, e o piloto NÃO TEM ficha — ela é a
// ÚLTIMA tela da migração e ainda vive na SPA. Construí-la aqui seria fazer a
// última tela fora de ordem, dentro de uma superfície que é sobre outra coisa.
// Então esta caixa mostra o que o mestre precisa DA MESA: quem é, como está, e
// o caminho para o combate. Quando a ficha for migrada, é daqui que ela abre.
//
// UM DIÁLOGO POR MEMBRO, e não um só reaproveitado — o inverso da escolha das
// condições, de propósito. Lá são 35 crachás × 9 linhas e um diálogo por linha
// seriam 315 nós redesenhados; aqui são quatro ou cinco jogadores, e um nó por
// um. O que se compra com isso é a armadilha que o link de redefinir senha
// ensinou: nó COMPARTILHADO que recebe escrita depois da renderização mostra o
// dado do item ANTERIOR sob o nome do próximo. Com um diálogo por pessoa não há
// o que limpar, porque não há o que sobreviver à troca.

// oElencoDoMestre é o segundo bloco do trilho esquerdo — a vaga do `CastRail`.
//
// Ele ROLA, e a fila acima dele não: a assimetria é deliberada. A posição na
// fila CARREGA significado (acima já agiu, abaixo ainda vai) e rolar
// embaralharia isso; o elenco é lista sem ordem própria.
templ oElencoDoMestre(v mesaView) {
	if len(v.Grupo) > 0 {
		<nav
			aria-label="Elenco"
			class="flex min-h-0 flex-1 flex-col gap-1 overflow-y-auto border border-grimorio-iron bg-grimorio-panel p-1"
		>
			for _, m := range v.Grupo {
				@oRetratoDoElenco(v, m)
			}
		</nav>
		for _, m := range v.Grupo {
			@aFichaDoElenco(v, m)
		}
	}
}

// O retrato em 80px: monograma, presença, e o clique que abre a pessoa.
//
// O NOME INTEIRO viaja no `aria-label` e no `title`, com a presença junto,
// porque duas letras não são um nome e cor não existe para quem usa leitor de
// tela (ALE-212).
templ oRetratoDoElenco(v mesaView, m mesaMembro) {
	<button
		type="button"
		title={ rotuloDoElenco(m) }
		aria-label={ rotuloDoElenco(m) }
		data-on:click={ abreAFichaDoElenco(m) }
		class="relative flex flex-col items-center rounded-sm border border-grimorio-iron px-1 py-1.5 outline-none transition-colors hover:bg-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
	>
		<span class="text-sm font-semibold text-foreground">{ m.Iniciais }</span>
		if m.Presenca != nil {
			<span
				aria-hidden="true"
				class={ "absolute right-0.5 top-0.5 size-2 rounded-full",
					templ.KV("bg-hp-full", m.Presenca.NaMesa),
					templ.KV("bg-grimorio-iron", !m.Presenca.NaMesa) }
			></span>
		}
	</button>
}

// A ficha do elenco: quem é, como está, e o caminho para o combate.
templ aFichaDoElenco(v mesaView, m mesaMembro) {
	<dialog
		id={ fmt.Sprintf("elenco-%d", m.CharacterID) }
		data-preserve-attr="open"
		aria-labelledby={ fmt.Sprintf("elenco-%d-titulo", m.CharacterID) }
		class="scene-grimorio m-auto w-[min(26rem,calc(100vw-2rem))] rounded-sm border border-grimorio-iron bg-grimorio-panel p-4 text-foreground backdrop:bg-black/60"
	>
		<div class="flex items-start justify-between gap-3">
			<div class="min-w-0">
				<h2 id={ fmt.Sprintf("elenco-%d-titulo", m.CharacterID) } class="truncate font-heading text-lg tracking-wide text-grimorio-gold">{ m.Nome }</h2>
				<p class="text-xs text-muted-foreground">
					Nível { fmt.Sprint(m.Nivel) }
					if m.Classes != "" {
						· { m.Classes }
					}
				</p>
			</div>
			<button
				type="button"
				aria-label="Fechar"
				data-on:click={ fechaAFichaDoElenco(m) }
				class="flex size-8 shrink-0 items-center justify-center rounded-sm border border-grimorio-iron outline-none transition-colors hover:bg-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
			>
				@ui.Icon("X", "size-4")
			</button>
		</div>
		if m.Presenca != nil {
			<p class="mt-2 flex items-center gap-1.5 text-xs text-muted-foreground">
				<span
					aria-hidden="true"
					class={ "size-2 rounded-full",
						templ.KV("bg-hp-full", m.Presenca.NaMesa),
						templ.KV("bg-grimorio-iron", !m.Presenca.NaMesa) }
				></span>
				{ m.Presenca.Frase }
			</p>
		}
		<dl class="mt-3 space-y-2">
			@barra("PV", m.PV)
			@barra("PM", m.PM)
		</dl>
		<p class="mt-3 flex items-baseline justify-between gap-2 border-t border-grimorio-iron pt-3 text-sm">
			<span class="text-muted-foreground">Defesa</span>
			<span class="font-mono tabular-nums text-foreground">{ m.Defesa }</span>
		</p>
		<div class="mt-4 flex justify-end">
			if m.NaFila {
				<p class="text-xs text-muted-foreground">Já está na fila do combate.</p>
			} else {
				<button
					type="button"
					data-on:click={ fechaAFichaDoElenco(m) + " " + poeNaFila(v, m) }
					class="inline-flex min-h-11 items-center gap-1.5 rounded-sm bg-primary px-3 text-sm font-semibold text-primary-foreground outline-none transition-opacity hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
				>
					@ui.Icon("Swords", "size-4")
					Pôr na iniciativa
				</button>
			}
		</div>
	</dialog>
}

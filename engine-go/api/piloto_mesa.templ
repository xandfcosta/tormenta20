package api

import "fmt"

// A Mesa do jogador desenhada (ALE-219; em templ pela ALE-227). Nenhuma REGRA
// aqui: o que decide mora em `piloto_mesa_view.go`, onde se testa sem HTML.

templ mesa(v mesaView) {
	// A MEDIDA é da página, não da casca: a casca dá cromo e espaçamento, e cada
	// tela decide a própria largura de leitura. A Mesa é uma coluna — na SPA ela
	// vive dentro do palco da sessão —, enquanto o admin é uma grade de dois
	// painéis e ocupa o que recebe. Sem isto, as linhas da fila esticam 1500px e
	// o número da iniciativa fica a meia tela do nome.
	// `mesa-palco` é o que dá ALTURA MEDIDA a esta cena, e é a MESMA classe que o
	// bestiário usa (`container-type: size`, index.css): a pergunta "quanto este
	// palco recebe" tem uma resposta só na casa. Ela exige que a caixa tenha
	// altura definida, e é por isso que o `main` passou a ser o item que PREENCHE
	// o palco (`flex-1`) com o miolo rolando por dentro, em vez de crescer com o
	// conteúdo e deixar a casca rolar por fora. A premissa do app sempre foi tela
	// cheia com o CONTEÚDO rolando — o comentário do layout já dizia isso —, e
	// com ela as duas faixas deixam de precisar de `sticky`: elas são o cabeçalho
	// e o rodapé de uma caixa que não rola.
	<main id="mesa" class="mesa-palco mx-auto flex min-h-0 w-full max-w-3xl flex-1 flex-col">
		// A faixa AO VIVO (ALE-30). Acende em DOURADO na vez do jogador, porque
		// dourado é o que já diz "a vez" na iniciativa e no tabuleiro (ALE-200).
		<div
			class={ "flex shrink-0 flex-wrap items-center justify-between gap-x-4 gap-y-1 border-b px-3 py-2 sm:px-4",
				templ.KV("border-grimorio-gold/60 bg-grimorio-gold/10", v.Turn.Kind == "mine"),
				templ.KV("border-grimorio-iron bg-grimorio-panel", v.Turn.Kind != "mine") }
		>
			<p class="flex items-center gap-2">
				<span class="relative flex size-2.5">
					<span class="absolute inline-flex size-full animate-ping rounded-full bg-hp-full opacity-75"></span>
					<span class="relative inline-flex size-2.5 rounded-full bg-hp-full"></span>
				</span>
				<span class="text-xs font-semibold uppercase tracking-widest text-hp-full">Ao vivo</span>
				<span class="text-sm text-muted-foreground">· Sessão { fmt.Sprint(v.SessionNum) }</span>
			</p>
			// `aria-live` é obrigatório aqui e não é enfeite: num app de morph a vez
			// muda sem navegação nenhuma, então quem não vê a tela não tem OUTRO
			// sinal de que chegou a vez dele. Na SPA o aviso chega por toast.
			<div class="flex items-center gap-2 text-sm" aria-live="polite">
				if v.Turn.Kind != "idle" {
					<span class="text-muted-foreground">Rodada { fmt.Sprint(v.Round) }</span>
				}
				switch v.Turn.Kind {
					case "mine":
						<span class="flex animate-pulse items-center gap-1 bg-primary px-2 py-0.5 text-xs font-bold uppercase tracking-widest text-primary-foreground">Sua vez</span>
					case "other":
						<span class="truncate text-muted-foreground">· Vez de { v.Turn.Label }</span>
					default:
						<span class="truncate text-muted-foreground">Aguardando iniciativa</span>
				}
			</div>
		</div>
		<div class="min-h-0 flex-1 space-y-4 overflow-y-auto p-3 sm:p-4">
			// Registrar iniciativa — a ÚNICA mutação desta superfície (ALE-213). Some
			// fora de cena pelo mesmo motivo da SPA: gravaria o combatente na fila do
			// mestre sem mudar nada na tela de quem clicou.
			if v.SceneActive && v.Eu != nil {
				@mesaRegistrar(v)
			}
			// Grupo — como todo mundo está, que é pergunta diferente de "quem age
			// quando". Aparece FORA de cena de propósito: PV do grupo não é
			// informação de combate.
			if len(v.Grupo) > 0 {
				<section class="space-y-1.5">
					<h2 class="text-xs font-bold uppercase tracking-widest text-muted-foreground">Grupo</h2>
					<div class="grid gap-2 sm:grid-cols-2">
						for _, m := range v.Grupo {
							<article class="space-y-1.5 border border-border/60 bg-card/60 p-2.5">
								<div class="flex items-baseline justify-between gap-2">
									<span class="truncate font-medium">{ m.Nome }</span>
									<span class="shrink-0 bg-muted px-1.5 text-xs font-bold uppercase tracking-widest text-muted-foreground">Nv { fmt.Sprint(m.Nivel) }</span>
								</div>
								if m.Classes != "" {
									<p class="truncate text-xs text-muted-foreground">{ m.Classes }</p>
								}
								@barra("PV", m.PV)
								@barra("PM", m.PM)
							</article>
						}
					</div>
				</section>
			}
			// Iniciativa — LEITURA para o jogador (ALE-213); o mestre ganha aqui o
			// que MONTA a fila.
			<section class="space-y-1.5">
				<div class="flex items-center justify-between gap-2">
					<h2 class="text-xs font-bold uppercase tracking-widest text-muted-foreground">Iniciativa</h2>
					// "Adicionar grupo" fica com a LISTA e não com o rodapé, que é
					// onde a SPA o pôs: ele monta a fila, e os verbos do rodapé
					// andam com ela pronta. A palavra é a mesma dos dois lados de
					// propósito — duas telas não devem inventar dois vocabulários
					// para o mesmo gesto.
					if v.Mestre != nil {
						@adicionarGrupo(v)
					}
				</div>
				// Desenha O QUE CHEGOU, e nada mais. A decisão de esconder a fila fora
				// de cena já foi tomada pelo servidor, que a esvaziou no
				// `redactForPlayers` — repeti-la aqui num `if v.SceneActive` seria a
				// MESMA regra escrita em dois lugares, e o dia em que elas divergissem
				// a tela mentiria com toda a confiança (ALE-210: não mandar é
				// segurança, não desenhar é UX, e cada uma tem um dono).
				// O que sobra para o template é escolher a FRASE do vazio.
				if len(v.Fila) == 0 {
					<p class="border border-dashed border-grimorio-iron p-4 text-center text-sm text-muted-foreground">
						if v.SceneActive {
							Em cena · ninguém na fila ainda.
						} else {
							Fora de cena. O mestre ainda não começou.
						}
					</p>
				} else {
					<ol class="space-y-1">
						for _, l := range v.Fila {
							@mesaLinhaDaFila(l)
						}
					</ol>
				}
			</section>
		</div>
		if v.Mestre != nil {
			@controlesDoMestre(v, *v.Mestre)
		}
	</main>
}

// mesaRegistrar é o único caminho de escrita da superfície.
templ mesaRegistrar(v mesaView) {
	<section class="space-y-2 border border-grimorio-iron bg-grimorio-panel p-3">
		<h2 class="font-heading text-sm font-semibold text-grimorio-gold">
			if v.Eu.NaFila {
				Rolar de novo
			} else {
				Registrar iniciativa
			}
			· { v.Eu.Nome }
		</h2>
		<div class="flex flex-wrap items-end gap-2">
			<div class="space-y-1">
				<label for="d20" class="block text-xs font-bold uppercase tracking-widest text-muted-foreground">Dado (d20)</label>
				// Ligado a um SINAL e nunca renderizado pelo servidor: o remendo
				// chega a cada tique, e um `value` vindo do servidor apagaria o que
				// o jogador está digitando. Sinal não é estado da aplicação — é
				// entrada em curso, e ela é do teclado de quem digita.
				<input
					id="d20"
					name="d20"
					type="number"
					min="1"
					max="20"
					inputmode="numeric"
					data-bind:d20
					class="w-24 border border-input bg-background px-2 py-1.5 font-mono tabular-nums outline-none focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-ring"
				/>
			</div>
			<button
				type="button"
				data-on:click="$d20 = Math.floor(Math.random() * 20) + 1"
				class="border border-grimorio-iron-light bg-secondary px-3 py-1.5 text-sm text-secondary-foreground outline-none hover:bg-accent focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-ring"
			>
				🎲 Rolar
			</button>
			// A PRÉVIA some quando o dado não é um dado, e isso é conserto de um
			// defeito medido (ALE-236, avisado pela outra sessão): o `data-bind`
			// do Datastar escreve ZERO no sinal quando o campo numérico esvazia.
			// Medido no navegador — digitar 7, apagar, e o sinal vai a 0.
			//
			// Sem isto, apagar para redigitar mostra "Total previsto 8" quando o
			// bônus é 8 e não há dado nenhum: um total que não existe, lido no
			// instante em que a pessoa está decidindo. É a mesma família da
			// ALE-224, onde a prévia do saldo era o que impedia o erro
			// silencioso — prévia que mente não é cosmético.
			//
			// A faixa vem do LIVRO (1..20) e o servidor já a recusa; o que se
			// conserta aqui é a tela dizer a verdade antes do clique.
			<p class="text-sm text-muted-foreground">
				Bônus <span class="font-mono tabular-nums text-foreground">{ fmt.Sprint(v.Eu.Bonus) }</span>
				<span data-show="$d20 >= 1 && $d20 <= 20">
					· Total previsto <span class="font-mono tabular-nums text-foreground" data-text={ fmt.Sprintf("$d20 + %d", v.Eu.Bonus) }></span>
				</span>
				<span data-show="!($d20 >= 1 && $d20 <= 20)" class="italic">· informe o dado (1 a 20)</span>
			</p>
		</div>
		// Sai só o d20 no fio; o TOTAL é somado pelo servidor (ALE-213), que é
		// quem tem a `ComputeSheetV2`. O `data-indicator` desliga o botão
		// enquanto o POST voa — sem isso o duplo clique manda duas rolagens.
		//
		// E o botão fica desabilitado com o dado fora da faixa (ALE-236):
		// oferecer uma ação que o servidor vai recusar é fazer a pessoa
		// descobrir o erro DEPOIS de clicar, com a recusa em texto pequeno
		// embaixo. O campo vazio conta como fora da faixa, porque o `data-bind`
		// escreve ZERO no sinal quando ele esvazia.
		<button
			type="button"
			data-indicator:registrando
			data-attr:disabled="$registrando || !($d20 >= 1 && $d20 <= 20)"
			data-on:click={ fmt.Sprintf("@post('/piloto/mesa/%d/%d/iniciativa')", v.CampaignID, v.SessionID) }
			class="bg-primary px-3 py-1.5 text-sm font-semibold text-primary-foreground outline-none hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-ring disabled:opacity-50"
		>
			Registrar
		</button>
		<p class="text-xs text-destructive" data-show="$erro != ''" data-text="$erro"></p>
	</section>
}

templ mesaLinhaDaFila(l mesaLinha) {
	<li
		if l.NaVez {
			aria-current="true"
		}
		class={ "flex items-center gap-2.5 border p-2",
			templ.KV("border-grimorio-gold/60 bg-grimorio-gold/10", l.NaVez),
			templ.KV("border-border/60 bg-card/60", !l.NaVez) }
	>
		<span class={ "w-8 shrink-0 text-center font-mono text-lg font-bold tabular-nums",
			templ.KV("text-grimorio-gold", l.NaVez), templ.KV("text-muted-foreground", !l.NaVez) }>
			{ fmt.Sprint(l.Iniciativa) }
		</span>
		<div class="min-w-0 flex-1 space-y-1">
			<div class="flex flex-wrap items-center gap-1.5">
				<span class="truncate font-medium">{ l.Rotulo }</span>
				// O crachá é `--marker` e nunca a primária: crachá não se clica,
				// então não compete com a ação (ALE-200).
				if l.PC {
					<span class="shrink-0 bg-marker px-1 text-[10px] font-bold uppercase tracking-widest text-marker-foreground">PC</span>
				}
				if l.Minha {
					<span class="shrink-0 bg-marker px-1 text-[10px] font-bold uppercase tracking-widest text-marker-foreground">Seu</span>
				}
				// "Na vez" por ESCRITO e não só pela cor dourada: um fundo colorido
				// não existe para leitor de tela (ALE-212).
				if l.NaVez {
					<span class="shrink-0 text-[10px] font-bold uppercase tracking-widest text-grimorio-gold">Na vez</span>
				}
			</div>
			if l.PV != nil {
				@barra("PV", *l.PV)
			} else if l.Oculto {
				// A flag sobrevive à redação de propósito: "sem barra" e "escondido"
				// são coisas diferentes, e a segunda é informação (ALE-210).
				<p class="text-xs italic text-muted-foreground">PV ocultos pelo mestre</p>
			}
			if len(l.Condicoes) > 0 {
				<ul class="flex flex-wrap gap-1">
					// Fundo a 15% da MESMA cor e a cor como texto, que é o desenho do
					// `condition-pips.tsx` da SPA — e não a tinta de penalidade sobre
					// preenchimento sólido, que foi como eu escrevi primeiro: medido no
					// navegador, aquilo dava 2,36:1 contra os 4,5 do AA. É o mesmo erro
					// que a ALE-200 consertou no botão destrutivo — tinta é para
					// ESCREVER sobre o painel, não sobre o próprio preenchimento.
					for _, c := range l.Condicoes {
						<li class="rounded-md border border-[color:var(--hp-hurt)]/60 bg-[color:var(--hp-hurt)]/15 px-1.5 py-px text-[10px] font-semibold uppercase tracking-wide text-[color:var(--hp-hurt)]">{ c }</li>
					}
				</ul>
			}
		</div>
	</li>
}

// barra tem o mesmo contrato de acessibilidade da `VitalBar` da SPA: um
// `progressbar` de verdade, porque "um pouco de verde" não é resposta para quem
// não vê a tela — e é o que o e2e consegue ler.
templ barra(rotulo string, b mesaBarra) {
	<div class="flex items-center gap-1.5">
		<span class="w-7 shrink-0 text-xs font-bold uppercase tracking-widest text-muted-foreground">{ rotulo }</span>
		<div
			role="progressbar"
			aria-valuenow={ fmt.Sprint(b.Atual) }
			aria-valuemin="0"
			aria-valuemax={ fmt.Sprint(b.Max) }
			aria-label={ fmt.Sprintf("%s %d de %d", rotulo, b.Atual, b.Max) }
			class="h-1.5 min-w-0 flex-1 overflow-hidden rounded-full bg-muted"
		>
			<div class={ "h-full rounded-full", b.Tom } style={ fmt.Sprintf("width: %d%%", b.Pct) }></div>
		</div>
		<span class="shrink-0 font-mono text-[13px] tabular-nums text-foreground">{ fmt.Sprint(b.Atual) }/{ fmt.Sprint(b.Max) }</span>
	</div>
}

// adicionarGrupo traz os personagens do grupo para a fila.
//
// Continua clicável DEPOIS do primeiro uso porque `populateParty` é idempotente:
// o mestre que aceitou um jogador atrasado clica de novo e leva só o que
// faltava. Apagá-lo faria a segunda pergunta parecer respondida.
templ adicionarGrupo(v mesaView) {
	<button
		type="button"
		data-indicator:trazendo
		data-attr:disabled="$trazendo"
		data-on:click={ comandoDaMesa(v, "POST", "initiative/populate") }
		class="inline-flex min-h-11 items-center gap-1.5 rounded-sm border border-grimorio-iron px-3 text-sm outline-none transition-colors hover:bg-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring disabled:opacity-50"
	>+ Adicionar grupo</button>
}

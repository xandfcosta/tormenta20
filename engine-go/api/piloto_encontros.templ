package api

import (
	"fmt"
	"t20engine/web/ui"
)

// O CONSTRUTOR DE ENCONTROS (ALE-259).
//
// O VEREDITO é o bloco principal, e isso é a ALE-170: a ferramenta existe para
// responder "esse encontro é duro demais?", e na versão anterior a resposta era
// uma faixa de 14px — mais discreta que o botão de adicionar criatura logo
// abaixo. O ND é o número grande, a dificuldade vem ao lado com o peso que
// merece, e o XP fica secundário porque ele é consequência, não decisão.

templ cenaDosEncontros(v encontrosView) {
	<section
		id="encontros"
		class="mesa-palco flex min-h-0 flex-1 flex-col gap-3"
		aria-labelledby="mesa-encontros"
		data-signals={ sinaisDosEncontros(v) }
	>
		<h2 id="mesa-encontros" class="font-heading text-lg tracking-wide text-foreground">
			Construtor de encontros
		</h2>
		@oGrupoDoEncontro(v)
		@oVeredito(v)
		@aComposicao(v)
		@painelDeAdicionar(v)
	</section>
}

templ oGrupoDoEncontro(v encontrosView) {
	<div class="flex shrink-0 flex-wrap items-end gap-3 rounded-sm border border-grimorio-iron p-3">
		@ui.SectionLabel("muted", "self-center") {
			O grupo
		}
		@campoDoGrupo("nivel", "Nível", v.Nivel, nivelMinimo, nivelMaximo)
		@campoDoGrupo("grupo", "Personagens", v.Grupo, grupoMinimo, grupoMaximo)
	</div>
}

// campoDoGrupo: `aria-label` diz "<rótulo> do grupo" e não só o rótulo, porque
// "Nível" sozinho, numa tela que também tem ND de criatura, não diz nível DE
// QUÊ para quem ouve a página em vez de vê-la.
templ campoDoGrupo(sinal, rotulo string, valor, minimo, maximo int) {
	<div class="space-y-1">
		@ui.SectionLabel("muted", "block") {
			<label for={ "encontro-" + sinal }>{ rotulo }</label>
		}
		<input
			id={ "encontro-" + sinal }
			type="number"
			min={ ui.Int(minimo) }
			max={ ui.Int(maximo) }
			value={ ui.Int(valor) }
			data-bind={ sinal }
			data-on:input__debounce.300ms="@get('/mestre/encontros')"
			aria-label={ rotulo + " do grupo" }
			class="h-9 w-20 rounded-sm border border-input bg-transparent px-2 text-base tabular-nums outline-none focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-ring md:text-sm"
		/>
	</div>
}

templ oVeredito(v encontrosView) {
	<div class="flex shrink-0 flex-wrap items-center gap-x-8 gap-y-3 rounded-sm border border-grimorio-iron bg-muted/20 px-4 py-3">
		<div class="flex items-baseline gap-3">
			@ui.SectionLabel("muted", "") {
				ND do encontro
			}
			<span class="font-mono text-4xl leading-none tabular-nums text-grimorio-gold">
				{ ndArredondado(v.ND()) }
			</span>
		</div>
		<div class="flex items-baseline gap-2">
			@ui.SectionLabel("muted", "") {
				Dificuldade
			}
			<span class="font-mono text-xl leading-none" style={ corDaDificuldade(v.Dificuldade().Tom) }>
				{ v.Dificuldade().Rotulo }
			</span>
		</div>
		<div class="flex items-baseline gap-2">
			@ui.SectionLabel("muted", "") {
				XP por personagem
			}
			<span class="font-mono text-sm tabular-nums text-foreground">{ xpEscrito(v.XPPorPersonagem()) }</span>
		</div>
		@botaoDeCopiarOEncontro(v)
	</div>
}

// botaoDeCopiarOEncontro entrega o encontro como ENDEREÇO, sob demanda.
//
// O link é montado no servidor e viaja pronto no `data-url`: montá-lo no
// cliente exigiria repetir ali a codificação do formato `id:qtd`, e formato
// escrito em dois lugares é formato que diverge.
//
// O aviso troca o texto do próprio botão por dois segundos em vez de abrir um
// balão: quem clicou está olhando para ele, e uma confirmação que aparece em
// outro canto da tela é uma confirmação que se perde.
templ botaoDeCopiarOEncontro(v encontrosView) {
	<button
		type="button"
		data-url={ enderecoDoEncontro(v) }
		data-on:click="navigator.clipboard.writeText(location.origin + el.dataset.url); $copiado = true; setTimeout(() => $copiado = false, 2000)"
		class="ml-auto inline-flex min-h-11 items-center gap-1.5 rounded-sm border border-grimorio-iron px-3 text-xs text-muted-foreground outline-none transition-colors hover:bg-accent hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
	>
		<span data-show="!$copiado">Copiar link do encontro</span>
		<span data-show="$copiado" class="text-grimorio-gold">Link copiado</span>
	</button>
}

templ aComposicao(v encontrosView) {
	if v.Vazio() {
		<p class="shrink-0 rounded-sm border border-dashed border-grimorio-iron p-4 text-center text-xs text-muted-foreground">
			Nenhuma criatura no encontro. Busque abaixo para acrescentar.
		</p>
	} else {
		<ul class="min-h-0 shrink-0 space-y-1 overflow-y-auto">
			for _, l := range v.Linhas {
				<li class="flex flex-wrap items-center gap-x-3 gap-y-1 rounded-sm border border-grimorio-iron p-2">
					<span class="text-sm font-medium">{ l.Verbete.Name }</span>
					<span class="font-mono text-3xs text-grimorio-gold">{ "ND " + ndEscrito(l.Verbete.ND) }</span>
					<span class="font-mono text-3xs text-muted-foreground">{ "grupo ND " + ndArredondado(l.ND) }</span>
					<div class="ml-auto flex items-center gap-1">
						@passoDaQuantidade(l.Verbete, "menos", "−")
						<span class="w-8 text-center font-mono text-sm tabular-nums">{ ui.Int(l.Qtd) }</span>
						@passoDaQuantidade(l.Verbete, "mais", "+")
						<button
							type="button"
							aria-label={ "Remover " + l.Verbete.Name + " do encontro" }
							data-on:click={ fmt.Sprintf("@post('/mestre/encontros/remover/%s')", l.Verbete.ID) }
							class="flex size-11 items-center justify-center rounded-sm text-muted-foreground outline-none transition-colors hover:text-destructive focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
						>✕</button>
					</div>
				</li>
			}
		</ul>
	}
}

// passoDaQuantidade: o nome acessível diz o VERBO e a criatura, porque numa
// lista de seis linhas "mais" sozinho não distingue os seis botões iguais — e
// nem o `getByRole` nem um leitor de tela separam homônimos.
templ passoDaQuantidade(m verbete, passo, sinal string) {
	<button
		type="button"
		aria-label={ rotuloDoPasso(passo, m.Name) }
		data-on:click={ fmt.Sprintf("@post('/mestre/encontros/%s/%s')", passo, m.ID) }
		class="flex size-11 items-center justify-center rounded-sm border border-grimorio-iron font-mono text-sm outline-none transition-colors hover:bg-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
	>{ sinal }</button>
}

// painelDeAdicionar reusa a busca do bestiário: o mestre que aprendeu a
// procurar criatura lá não reaprende aqui.
//
// A lista só aparece com termo digitado. Mostrar as 80 abaixo da composição
// empurraria o VEREDITO para fora da tela, e o veredito é o assunto da
// ferramenta (ALE-170) — a mesma razão pela qual ele é o bloco grande.
templ painelDeAdicionar(v encontrosView) {
	<div class="flex min-h-0 flex-1 flex-col gap-2">
		<div class="relative shrink-0">
			@ui.Icon("Search", "pointer-events-none absolute left-2 top-1/2 size-4 -translate-y-1/2 text-muted-foreground")
			<input
				type="search"
				name="buscaCriatura"
				data-bind:buscaCriatura
				data-on:input__debounce.250ms="@get('/mestre/encontros')"
				value={ v.Busca }
				placeholder="Buscar criatura para acrescentar"
				aria-label="Buscar criatura para acrescentar"
				class="h-9 w-full rounded-sm border border-input bg-transparent pl-8 pr-3 text-base outline-none focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-ring md:text-sm"
			/>
		</div>
		if v.Busca != "" {
			if len(v.Achados) == 0 {
				<p class="p-3 text-center text-xs text-muted-foreground">Nenhuma criatura com esse nome.</p>
			} else {
				<ul class="min-h-0 flex-1 space-y-1 overflow-y-auto rounded-sm border border-grimorio-iron p-1">
					for _, m := range v.Achados {
						<li>
							<button
								type="button"
								aria-label={ "Acrescentar " + m.Name + " ao encontro" }
								data-on:click={ fmt.Sprintf("@post('/mestre/encontros/adicionar/%s')", m.ID) }
								class="flex min-h-11 w-full flex-wrap items-baseline gap-x-2 rounded-sm border border-grimorio-iron p-2 text-left outline-none transition-colors hover:bg-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
							>
								<span class="text-xs font-semibold">{ m.Name }</span>
								<span class="font-mono text-3xs text-grimorio-gold">{ "ND " + ndEscrito(m.ND) }</span>
								<span class="text-3xs text-muted-foreground">{ nomeDoTipo(m.Tipo) }</span>
								<span class="ml-auto font-mono text-3xs text-muted-foreground">{ fmt.Sprintf("PV %d", m.HP) }</span>
							</button>
						</li>
					}
				</ul>
			}
		}
	</div>
}

package api

import "strconv"

// O painel de PODERES desenhado (ALE-272, fatia 8).
//
// UMA lista, a da mesa: as AÇÕES em cima, prontas para usar, e as PASSIVAS
// recolhidas atrás de um "mostrar (N)". Escolher poder é administração e mora
// num diálogo — na tela fica o que se usa jogando.
//
// A BUSCA achata tudo: com um termo digitado as duas seções somem e o que
// aparece é uma lista só, por nome. Na mesa o jogador sabe como o poder se
// chama, não qual fonte o concedeu.

// powersPanelSection é a seção inteira.
templ powersPanelSection(v fichaView) {
	<section class="flex min-h-0 flex-1 flex-col">
		<div class="flex shrink-0 items-center gap-2 border-b border-grimorio-iron px-3 py-2 sm:px-4">
			<h2 class="font-heading text-sm uppercase tracking-[0.18em] text-muted-foreground">Poderes</h2>
			<p class="text-3xs text-muted-foreground sm:text-xs">{ osPoderesEscrito(v.Powers.Total) }</p>
			<span class="ml-auto">
				@choicesButton(v)
			</span>
		</div>
		<div class="flex min-h-0 flex-1 flex-col gap-2 overflow-y-auto p-2 sm:p-3">
			@powerSearch(v)
			if v.Powers.Search != "" {
				@powerSearchResults(v)
			} else {
				@actionsBlock(v)
				@passivesBlock(v)
			}
		</div>
	</section>
	for _, linha := range v.Powers.Actions {
		if linha.Stance != nil && linha.Stance.MaxSteps > 0 {
			@stanceStepperDialog(v, linha)
		}
	}
	@choicesDialog(v)
}

templ powerSearch(v fichaView) {
	<input
		type="search"
		data-bind:poderbusca
		data-on:input__debounce.250ms={ oGetDaFicha(v) }
		value={ v.Powers.Search }
		placeholder="Buscar poder ou habilidade…"
		aria-label="Buscar poder ou habilidade"
		class="h-8 w-full rounded-sm border border-grimorio-iron bg-background px-2 text-xs text-foreground outline-none placeholder:text-muted-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
	/>
}

// powerSearchResults é a lista achatada da busca.
templ powerSearchResults(v fichaView) {
	if len(v.Powers.Results) == 0 {
		<p class="py-4 text-center text-xs italic text-muted-foreground">
			{ "Nenhum poder para \"" + v.Powers.Search + "\"." }
		</p>
	} else {
		<ul class="space-y-1.5">
			for _, linha := range v.Powers.Results {
				@powerRowItem(v, linha)
			}
		</ul>
	}
}

// actionsBlock são os poderes que se ATIVAM.
templ actionsBlock(v fichaView) {
	<section class="space-y-1.5">
		<h3 class="font-heading text-2xs font-semibold uppercase tracking-wide text-muted-foreground">Ações</h3>
		if len(v.Powers.Actions) == 0 {
			// A SEÇÃO FICA MESMO VAZIA, e explica (decisão do dono, ALE-217).
			// Medido: um arcanista de nível 20 tem ZERO ações ativáveis — 26
			// habilidades, todas passivas. Sumir com a seção faria a tela mudar
			// de forma por classe, e duas pessoas na mesma mesa veriam layouts
			// diferentes. A frase manda para as Magias só quem conjura; mandar
			// um guerreiro para lá seria mandá-lo a uma aba vazia.
			<p class="text-xs italic text-muted-foreground">{ aFraseDeSemAcoes(v.Powers.IsCaster) }</p>
		} else {
			<ul class="space-y-1.5">
				for _, linha := range v.Powers.Actions {
					@powerRowItem(v, linha)
				}
			</ul>
		}
	</section>
}

// passivesBlock são as passivas, recolhidas.
//
// Elas já entram nos números da ficha, então na mesa são referência. O que NÃO
// se recolhe é a passiva de gatilho com o gatilho no ar: ela está fazendo
// efeito agora, e escondê-la seria a tela mentir sobre o que está em vigor.
templ passivesBlock(v fichaView) {
	if len(v.Powers.Passives) > 0 {
		<section class="space-y-1.5">
			<button
				type="button"
				data-on:click="$passivas = !$passivas"
				data-attr:aria-expanded="$passivas ? 'true' : 'false'"
				class="flex items-center gap-1 text-2xs font-semibold uppercase tracking-wide text-muted-foreground outline-none hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
			>
				<span data-show="!$passivas">{ "Passivas · mostrar (" + strconv.Itoa(len(v.Powers.Passives)) + ")" }</span>
				<span data-show="$passivas">Passivas · ocultar</span>
			</button>
			<div data-show="!$passivas" class="space-y-1">
				for _, linha := range v.Powers.LiveTriggers {
					<p class="text-2xs text-bonus-ink">{ "● gatilho ativo: " + linha.Name }</p>
				}
			</div>
			<ul data-show="$passivas" class="space-y-1.5">
				for _, linha := range v.Powers.Passives {
					@powerRowItem(v, linha)
				}
			</ul>
		</section>
	}
}

// powerRowItem é um poder, numa linha.
//
// O texto da regra fica CORTADO numa linha e o toque no nome abre o resto: são
// 26 a 34 poderes num personagem de nível 20, e a descrição inteira de cada um
// faria a lista virar um livro que ninguém percorre no meio de um turno.
templ powerRowItem(v fichaView, linha powerRow) {
	<li class="rounded-none border border-grimorio-iron p-2">
		<div class="flex flex-wrap items-start gap-1.5">
			<button
				type="button"
				aria-label={ "Detalhes de " + linha.Name }
				data-on:click={ "$poder = $poder === '" + linha.ID + "' ? '' : '" + linha.ID + "'" }
				data-attr:aria-expanded={ "$poder === '" + linha.ID + "' ? 'true' : 'false'" }
				class="flex min-w-0 flex-1 basis-40 flex-col gap-0.5 text-left outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
			>
				<span class="flex flex-wrap items-center gap-1.5">
					@icone(linha.Glyph, "size-3.5 shrink-0 text-muted-foreground")
					<span class="text-xs font-semibold text-foreground">{ linha.Name }</span>
					<span class="rounded-none bg-muted px-1 text-3xs text-muted-foreground">{ linha.Source }</span>
				</span>
				<span data-show={ "$poder !== '" + linha.ID + "'" } class="line-clamp-1 text-2xs leading-snug text-muted-foreground">
					{ linha.Detail }
				</span>
			</button>
			@powerActionSlot(v, linha)
		</div>
		<p data-show={ "$poder === '" + linha.ID + "'" } class="mt-1 text-2xs leading-snug text-muted-foreground">
			{ linha.Detail }
			if linha.Page > 0 {
				<span class="ml-1 opacity-70">{ "(p" + strconv.Itoa(linha.Page) + ")" }</span>
			}
		</p>
	</li>
}

// powerActionSlot é o que dá para fazer com o poder, no fim da linha.
templ powerActionSlot(v fichaView, linha powerRow) {
	<span class="ml-auto flex shrink-0 flex-wrap items-center justify-end gap-1">
		if linha.Cost != "" {
			<span class={ oCrachaDoPoder(linha.Kind) }>{ linha.Cost }</span>
		}
		if linha.Spent != "" {
			<span class={ oCrachaDoPoder("") }>{ linha.Spent }</span>
		} else if linha.Limit != "" {
			<span class={ oCrachaDoPoder("") }>{ linha.Limit }</span>
		}
		if linha.Stance != nil {
			@stanceButton(v, linha)
		} else if linha.Kind == "instant" {
			<button
				type="button"
				aria-label={ "Usar " + linha.Name }
				disabled?={ !linha.Can }
				title={ linha.Why }
				data-on:click={ oPostDaFicha(v, "/poderes/usa/"+linha.Command) }
				class={ classesDoBotao(varSecundaria, tamPequeno, "gap-1") }
			>
				@icone("Zap", "size-3")
				Usar
			</button>
		}
	</span>
}

// stanceButton entra ou encerra a postura.
//
// Uma postura de custo FIXO entra num toque só; a que escala com o nível abre o
// contador de degraus, porque aí o preço depende de uma escolha.
templ stanceButton(v fichaView, linha powerRow) {
	if linha.Stance.Active {
		<button
			type="button"
			aria-label={ "Encerrar " + linha.Name }
			data-on:click={ oPostDaFicha(v, "/efeitos/postura/"+linha.Stance.Flag) }
			class={ classesDoBotao(varDestrutiva, tamPequeno, "") }
		>ATIVA · Encerrar</button>
	} else if linha.Stance.MaxSteps > 0 {
		<button
			type="button"
			aria-label={ "Ativar " + linha.Name }
			aria-haspopup="dialog"
			disabled?={ !linha.Can }
			title={ linha.Why }
			data-on:click={ "$poderdegraus = 0; $detalhe = 'postura-" + linha.Stance.Flag + "'" }
			class={ classesDoBotao(varSecundaria, tamPequeno, "gap-1") }
		>
			@icone("Flame", "size-3")
			Ativar
		</button>
	} else {
		<button
			type="button"
			aria-label={ "Ativar " + linha.Name }
			disabled?={ !linha.Can }
			title={ linha.Why }
			data-on:click={ "$poderdegraus = 0; " + oPostDaFicha(v, "/poderes/postura/"+linha.Stance.Flag+"/entra") }
			class={ classesDoBotao(varSecundaria, tamPequeno, "gap-1") }
		>
			@icone("Flame", "size-3")
			{ "Ativar " + strconv.Itoa(linha.Stance.BasePm) + " PM" }
		</button>
	}
}

// stanceStepperDialog escolhe quantos degraus pagar.
//
// O custo aparece antes de confirmar, somado por expressão sobre números que o
// servidor mandou — é PRÉVIA, e quem cobra é o servidor com a regra inteira.
templ stanceStepperDialog(v fichaView, linha powerRow) {
	@aSobreposicao("postura-"+linha.Stance.Flag, linha.Name, "Flame", false) {
		<p class="text-xs text-muted-foreground">{ linha.Stance.StepLabel }</p>
		<div class="flex items-center justify-center gap-3">
			<button
				type="button"
				aria-label="Menos um degrau"
				data-on:click="$poderdegraus = Math.max(0, $poderdegraus - 1)"
				class={ classesDoBotao(varSecundaria, tamPequeno, "") }
			>−</button>
			<span class="font-mono text-lg text-foreground" data-text="$poderdegraus"></span>
			<button
				type="button"
				aria-label="Mais um degrau"
				data-on:click={ "$poderdegraus = Math.min(" + strconv.Itoa(linha.Stance.MaxSteps) + ", $poderdegraus + 1)" }
				class={ classesDoBotao(varSecundaria, tamPequeno, "") }
			>+</button>
		</div>
		<p class="text-center text-xs text-muted-foreground">
			<span data-text={ aPreviaDoCustoDaPostura(linha) }></span>
		</p>
		<button
			type="button"
			aria-label={ "Confirmar " + linha.Name }
			data-on:click={ oPostDaFicha(v, "/poderes/postura/"+linha.Stance.Flag+"/entra") + "; $detalhe = ''" }
			class={ classesDoBotao(varPrimaria, tamPadrao, "w-full") }
		>Ativar</button>
	}
}

package api

import (
	"fmt"

	"t20engine/tabuleiro"
)

// O TABULEIRO desenhado (ALE-263) — a fatia que se OLHA.
//
// UM NÓ POR CAMADA, nunca um por quadrado, e essa é a restrição que segura o
// custo: uma moldura de 20×14 são 280 quadrados, e desenhá-los daria 280 nós para
// pintar linhas que um `repeating-linear-gradient` pinta em zero. O chão, o
// ambiente e a grade são três divs; o que vira nó é só o que EXISTE — as peças,
// os marcadores e o terreno difícil.
//
// DOM e não canvas, como a SPA: cada peça é um `<button>` de verdade com nome
// acessível que diz QUEM e ONDE. Num canvas isso viraria um DOM espelho
// invisível, escrito duas vezes.

templ tabuleiroDaMesa(v tabuleiroView) {
	if !v.Aberto {
		// As duas frases são DIFERENTES de propósito: o jogador não tem o que
		// fazer além de esperar, e o mestre tem. Uma frase só serviria mal aos
		// dois — e "o mestre abre quando a cena tiver lugar" dita ao próprio
		// mestre é a tela mandando ele fazer o que ela não deixa.
		<div class="flex flex-col items-center gap-3 border border-dashed border-grimorio-iron p-6 text-center">
			<span aria-hidden="true" class="text-2xl text-muted-foreground">▦</span>
			if v.Mestre {
				<p class="text-sm text-muted-foreground">Nenhum tabuleiro aberto. Vale para combate e para cena de interpretação.</p>
				<button
					type="button"
					data-on:click="document.getElementById('abrir-tabuleiro').showModal()"
					class="inline-flex min-h-11 items-center rounded-sm bg-primary px-3 text-sm font-semibold text-primary-foreground outline-none transition-opacity hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
				>Abrir tabuleiro</button>
				// O acervo vem DEPOIS do abrir: montar cena nova é o que se faz
				// na primeira noite, e reabrir é o que se faz nas outras. E só
				// aparece com lugares guardados — um botão que abre uma lista
				// vazia ensina que o acervo não serve para nada.
				if len(v.Acervo) > 0 {
					@botaoDoAcervo(v)
				}
			} else {
				<p class="text-sm text-muted-foreground">O mestre ainda não abriu um tabuleiro.</p>
			}
		</div>
		if v.Mestre {
			@abrirTabuleiro(v)
			// O diálogo nasce E MORRE com o gatilho: um `<dialog>` sem botão que
			// o abra é peso morto no documento, e o guarda pegou isto na
			// primeira corrida — a campanha sem lugar nenhum servia um menu
			// inalcançável cujo título a busca da página ainda encontrava.
			if len(v.Acervo) > 0 {
				@oAcervoDeLugares(v)
			}
		}
	} else if v.Cortina {
		// A CORTINA ocupa o lugar da cena e NÃO desenha grade, de propósito: a
		// cena vazia mostra grade, e as duas telas têm de se parecer o menos
		// possível — o jogador resolve uma esperando e a outra cutucando o
		// mestre. O nome do lugar não aparece porque o servidor já o apagou.
		<section aria-label="Cortina" class="flex flex-col items-center justify-center gap-2 border border-dashed border-grimorio-gold/40 p-6 text-center">
			<span aria-hidden="true" class="text-2xl text-grimorio-gold/70">🎭</span>
			<p class="text-sm text-muted-foreground">O mestre está montando a cena.</p>
		</section>
	} else {
		<section aria-label={ "Tabuleiro · " + v.Lugar } class="space-y-1.5">
			<div class="flex flex-wrap items-baseline gap-x-2">
				<h2 class="text-xs font-bold uppercase tracking-widest text-muted-foreground">Tabuleiro</h2>
				<p class="truncate text-sm text-foreground">{ v.Lugar }</p>
				if v.Mestre {
					// Os DOIS verbos do canto direito num agrupador só, e ele
					// existe para o `ml-auto` ter dono fixo: pendurado no ✕, o
					// alinhamento sumia junto com o acervo quando a campanha
					// ainda não tinha lugar guardado nenhum.
					<span class="ml-auto flex items-center gap-1">
						// O acervo alcançável COM cena na mesa (ALE-191): trocar da
						// taverna para a cripta sem encerrar primeiro. Sem ele o
						// caminho existia e era inalcançável, porque a lista só
						// aparecia na cena vazia.
						if len(v.Acervo) > 0 {
							@botaoDoAcervo(v)
						}
						// ÍCONE e não texto: a linha do lugar é a mais estreita da
						// região, e "Encerrar o tabuleiro" por extenso empurra o
						// nome da cena para fora. O nome acessível é o texto
						// inteiro — quem usa leitor de tela não perde a palavra
						// que o desenho economizou.
						<button
							type="button"
							aria-label="Encerrar o tabuleiro"
							title="Encerrar o tabuleiro"
							data-on:click="document.getElementById('encerrar-tabuleiro').showModal()"
							class="flex size-8 items-center justify-center rounded-sm border border-transparent text-sm text-muted-foreground outline-none transition-colors hover:border-destructive hover:text-destructive focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
						>✕</button>
					</span>
				}
			</div>
			if v.Mestre {
				@encerrarTabuleiro(v)
				if len(v.Acervo) > 0 {
					@oAcervoDeLugares(v)
				}
			}
			// A TIRA DA CORTINA, e o esquecimento que ela evita é caro: o mapa do
			// mestre fica igualzinho com a cortina aberta ou fechada, então sem
			// ela ele narra a taverna e move o taverneiro para uma mesa que está
			// olhando um aviso. `role="status"` porque é o estado da cena, e não
			// uma ação.
			if v.AvisoDaCortina {
				<p role="status" class="flex flex-wrap items-center gap-2 border-b border-grimorio-gold/40 bg-grimorio-gold/10 px-2 py-1 text-xs text-grimorio-gold">
					<span aria-hidden="true">🎭</span>
					A cortina está fechada: a mesa não vê esta cena.
				</p>
			}
			// O PALCO é a janela; o PLANO é a moldura inteira dentro dela. O
			// enquadramento é do NAVEGADOR e nunca do servidor — foi essa a
			// escolha que tirou a ida ao servidor de cada passo de arrasto —, e
			// nesta fatia ele é a rolagem nativa: ela já é o arrasto, e vem com
			// teclado, roda e toque de graça. Como o enquadramento não está no
			// HTML, o remendo do SSE redesenha as peças sem que o mestre perca
			// onde estava olhando.
			<div class="tabuleiro-palco grimorio-frame">
				<div
					class={ "tabuleiro-plano chao-" + v.Chao }
					style={ fmt.Sprintf("--colunas:%d; --linhas:%d", v.Colunas, v.Linhas) }
				>
					<div aria-hidden="true" class="tabuleiro-ambiente"></div>
					<div aria-hidden="true" class="tabuleiro-grade"></div>
					// O terreno difícil vem ANTES das peças para ficar por baixo
					// delas: ele é chão, e uma peça em cima de terreno difícil
					// continua sendo a peça que se clica.
					for _, q := range v.Dificil {
						<div aria-hidden="true" class="tabuleiro-dificil" style={ posicaoNoPlano(q.Col, q.Lin, 1) }></div>
					}
					for _, m := range v.Marcadores {
						@marcadorNoPlano(m)
					}
					// A TRILHA vem antes das peças e depois do chão: ela é rastro,
					// e a peça que anda por cima dela continua sendo a peça que
					// se clica.
					if v.Movimento != nil {
						for _, q := range v.Movimento.Trilha {
							<div aria-hidden="true" class="tabuleiro-trilha" style={ posicaoNoPlano(q.Col, q.Lin, 1) }></div>
						}
					}
					// O ALCANCE é PINTURA e não alvo de clique, e a diferença é o
					// que fez este desenho mudar no meio: quem tem orçamento é o
					// jogador NA VEZ dele — o mestre move sem teto (-1), e fora
					// de combate todo mundo também. Se a casa alcançável fosse o
					// único alvo, o mestre não teria onde clicar, porque não há
					// alcance a desenhar para quem não tem limite.
					//
					// Então o alcance informa e a camada abaixo é que recebe o
					// clique. Ele continua sendo o que impede o estouro, só que
					// pela frente: a pessoa vê até onde cabe antes de escolher.
					for _, q := range v.Alcance {
						<div aria-hidden="true" class="tabuleiro-alcance" style={ posicaoNoPlano(q.Col, q.Lin, 1) }></div>
					}
					for _, p := range v.Pecas {
						@pecaNoPlano(v, p)
					}
					// O DESTINO é o que se arrasta enquanto há proposta, e ele é
					// losango para não ser confundido com peça: a peça está no
					// lugar dela, e isto é uma promessa.
					if v.Destino != nil {
						<button
							type="button"
							aria-label={ "Arrastar o destino de " + v.RotuloDoAlvo }
							title="Arraste para escolher a próxima parada"
							style={ posicaoNoPlano(v.Destino.Col, v.Destino.Lin, 1) }
							data-class={ estaArrastando("destino") }
							data-on:pointerdown={ pegaParaArrastar("destino") }
							data-on:pointermove__window={ segueODedo("destino") }
							data-on:pointerup__window={ soltaEPara(v, "destino", v.Destino.X, v.Destino.Y) }
							class="tabuleiro-destino"
						></button>
					}
					// A CAMADA DE CASAS é UM nó, e não um por quadrado: 280
					// botões seriam um campo minado no leitor de tela, que é a
					// mesma razão pela qual a SPA torna a dela condicional. O
					// quadrado sai do PONTO do clique dividido pelo tamanho da
					// casa, e o `$quadrado` acompanha o zoom quando ele chegar.
					//
					// Ela só existe quando há o que mover: sem peça movível e sem
					// movimento em curso, ela seria um alvo que não faz nada.
					if v.AlvoDoMovimento != "" {
						<button
							type="button"
							aria-label={ "Mover " + v.RotuloDoAlvo + " — escolha a casa" }
							data-on:click={ paradaNoPontoClicado(v) }
							class="tabuleiro-casas"
						></button>
					}
				</div>
			</div>
			if v.Movimento != nil && v.Movimento.Meu {
				@oMovimentoProposto(v)
			}
		</section>
	}
}

// oMovimentoProposto é a faixa que diz o CUSTO e oferece o par de decidir.
//
// O número vem antes dos botões porque ele é o que decide o clique: "5 de 6"
// responde a pergunta que a pessoa tem na mão, e um par de botões sem o custo ao
// lado obrigaria a contar quadrados na tela.
//
// Confirmar e cancelar NÃO são um interruptor, pelo mesmo motivo do encerrar
// cena: são dois verbos com consequências diferentes, e um só convidaria ao
// clique de volta que não existe.
templ oMovimentoProposto(v tabuleiroView) {
	<div class="flex flex-wrap items-center gap-2 border-t border-grimorio-iron px-1 pt-2 text-sm">
		<p aria-live="polite" class="text-muted-foreground">
			{ v.Movimento.Rotulo } ·
			if v.Movimento.Orcamento < 0 {
				// Sem orçamento é o mestre, ou fora de combate: o custo continua
				// sendo dito, porque ele informa, mas não há teto para comparar.
				<span class="font-mono tabular-nums text-foreground">{ fmt.Sprint(v.Movimento.Custo) }</span>
				{ " quadrados" }
			} else {
				<span class="font-mono tabular-nums text-foreground">
					{ fmt.Sprintf("%d de %d", v.Movimento.Custo, v.Movimento.Orcamento) }
				</span>
				{ fmt.Sprintf(" quadrados · sobram %d", v.Movimento.Restante) }
			}
		</p>
		<span class="ml-auto flex items-center gap-2">
			<button
				type="button"
				data-on:click={ comandoDoMovimento(v, "cancelar") }
				class="inline-flex min-h-11 items-center rounded-sm border border-grimorio-iron px-3 text-sm text-muted-foreground outline-none transition-colors hover:border-destructive hover:text-destructive focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
			>Cancelar</button>
			<button
				type="button"
				data-on:click={ comandoDoMovimento(v, "confirmar") }
				class="inline-flex min-h-11 items-center rounded-sm bg-primary px-3 text-sm font-semibold text-primary-foreground outline-none transition-opacity hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
			>Confirmar</button>
		</span>
	</div>
}



// pecaNoPlano é uma peça: monograma da ESPÉCIE, selo da INSTÂNCIA, e a barra de
// PV quando há número para mostrar.
//
// O nome acessível diz QUEM e ONDE, com a coordenada COM SINAL que o servidor
// guarda — sem ele a peça é um disco anônimo para quem não vê a tela, e "o Zumbi
// 3" deixa de ter resposta.
//
// A cor vem por variável de estilo e não por classe, e é o único jeito: o matiz
// é um número calculado por nome, então não existe classe do Tailwind para ele —
// seriam 360 classes que o scanner nunca veria.
templ pecaNoPlano(v tabuleiroView, p pecaDoTabuleiro) {
	<button
		type="button"
		aria-label={ nomeDaPeca(p) }
		title={ nomeDaPeca(p) }
		style={ posicaoNoPlano(p.Col, p.Lin, p.Pegada) + fmt.Sprintf("--matiz:%d;", p.Matiz) }
		if v.ArrastaAPeca == p.ID {
			data-class={ estaArrastando("peca") }
			data-on:pointerdown={ pegaParaArrastar("peca") }
			data-on:pointermove__window={ segueODedo("peca") }
			data-on:pointerup__window={ soltaEPara(v, "peca", p.X, p.Y) }
		}
		class={ "tabuleiro-peca",
			templ.KV("tabuleiro-peca-na-vez", p.NaVez),
			templ.KV("tabuleiro-peca-oculta", p.Oculta) }
	>
		<span class="tabuleiro-monograma">{ p.Monograma }</span>
		if p.Instancia != "" {
			// O selo é TEXTO e não só cor: "eu ataco o Zumbi 3" precisa de
			// resposta num relance inclusive para quem não distingue matiz.
			<span class="tabuleiro-selo">{ p.Instancia }</span>
		}
		if p.PV != nil {
			<span aria-hidden="true" class="tabuleiro-vida">
				<span class={ "tabuleiro-vida-cheia", hpTomDe(*p.PV) } style={ fmt.Sprintf("width:%d%%", *p.PV) }></span>
			</span>
		}
	</button>
}

templ marcadorNoPlano(m marcadorDoTabuleiro) {
	<span
		aria-label={ "Marcador " + m.Texto + " em " + m.Onde }
		title={ m.Texto + " · " + m.Onde }
		style={ posicaoNoPlano(m.Col, m.Lin, 1) + fmt.Sprintf("--marcador:%s;", corDeMarcador(m.Cor)) }
		class="tabuleiro-marcador"
	>{ m.Texto }</span>
}

// O diálogo de ABRIR (ALE-124, portado na ALE-264).
//
// Pede o LUGAR antes da grade porque é uma cena que o mestre está montando, não
// uma planilha: "Taverna do Javali" é o que a mesa vai ler no topo. E diz a
// conversão do livro à vista (1 quadrado = 1,5m, p236) porque a ficha fala em
// METROS — sem ela o mestre faz a conta de cabeça toda vez.
//
// `<dialog>` nativo pelo mesmo motivo dos outros: foco preso, Escape, fundo
// inerte e camada de topo, que é o que o tira de dentro do `contain` do palco.
// O `m-auto` é obrigatório — o `preflight` do Tailwind zera a margem de todo
// elemento, e a centralização do modal é justamente a `margin: auto`.
templ abrirTabuleiro(v tabuleiroView) {
	<dialog
		id="abrir-tabuleiro"
		data-preserve-attr="open"
		aria-labelledby="abrir-tabuleiro-titulo"
		class="scene-grimorio m-auto w-[min(24rem,calc(100vw-2rem))] rounded-sm border border-grimorio-iron bg-grimorio-panel p-4 text-foreground backdrop:bg-black/60"
	>
		<h2 id="abrir-tabuleiro-titulo" class="font-heading text-lg tracking-wide text-grimorio-gold">Abrir tabuleiro</h2>
		<p class="mt-1 text-sm text-muted-foreground">
			O tabuleiro não tem bordas: cada quadrado é 1,5m (p236) e a cena cresce para onde a mesa for. O deslocamento padrão de 9m anda 6 quadrados (p106).
		</p>
		<label for="novo-lugar" class="mt-3 block text-xs font-bold uppercase tracking-widest text-muted-foreground">Lugar</label>
		// O NOME DO SINAL É TODO MINÚSCULO, e é obrigatório: nome de ATRIBUTO é
		// minusculado pelo analisador de HTML, então um `data-bind:novoLugar`
		// liga um sinal `novolugar` e deixa o declarado intocado — o fio leva os
		// dois e o servidor lê o errado.
		<input
			id="novo-lugar"
			type="text"
			data-bind:novolugar
			placeholder="Taverna do Javali"
			class="mt-1 w-full rounded-sm border border-input bg-background px-2 py-1.5 text-sm outline-none focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-ring"
		/>
		// CHÃO e não "Cenário", que é o rótulo da SPA: em T20 cenário é ARTON, o
		// mundo da campanha, e a palavra não pode significar duas coisas na
		// mesma casa. Ver GLOSSARIO.md.
		<label for="novo-chao" class="mt-3 block text-xs font-bold uppercase tracking-widest text-muted-foreground">Chão</label>
		<select
			id="novo-chao"
			data-bind:novochao
			class="mt-1 w-full rounded-sm border border-input bg-background px-2 py-1.5 text-sm outline-none focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-ring"
		>
			// A lista vem do `tabuleiro` e não é digitada aqui: ela já existia no
			// CSS e na SPA, e uma terceira cópia à mão é como nasce a opção que a
			// tela oferece e o navegador desenha em branco.
			for _, chao := range tabuleiro.ChoesDoLugar {
				<option value={ chao.ID }>{ chao.Rotulo }</option>
			}
		</select>
		<div class="mt-4 flex justify-end gap-2">
			<button
				type="button"
				data-on:click="document.getElementById('abrir-tabuleiro').close()"
				class="inline-flex min-h-11 items-center rounded-sm border border-grimorio-iron px-3 text-sm outline-none transition-colors hover:bg-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
			>Cancelar</button>
			// Fecha ANTES de postar, como o descanso: a recusa chega no
			// `$erroDoComando`, que é do RODAPÉ — o diálogo aberto por cima dela
			// esconderia a única frase que explica o que houve.
			<button
				type="button"
				data-on:click={ "document.getElementById('abrir-tabuleiro').close(); " + comandoDoTabuleiroDaCena(v, "abrir") }
				class="inline-flex min-h-11 items-center rounded-sm bg-primary px-3 text-sm font-semibold text-primary-foreground outline-none transition-opacity hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
			>Abrir</button>
		</div>
	</dialog>
}

// O diálogo de ENCERRAR, que é confirmação e não interruptor.
//
// A frase diz o que ACONTECE com a cena porque "encerrar" sozinho soa como
// perder: ela vai para os Lugares da campanha com as peças onde estão. Sem isso
// o mestre hesita no fim da noite e deixa a cena velha na mesa da semana
// seguinte.
templ encerrarTabuleiro(v tabuleiroView) {
	<dialog
		id="encerrar-tabuleiro"
		data-preserve-attr="open"
		aria-labelledby="encerrar-tabuleiro-titulo"
		class="scene-grimorio m-auto w-[min(24rem,calc(100vw-2rem))] rounded-sm border border-grimorio-iron bg-grimorio-panel p-4 text-foreground backdrop:bg-black/60"
	>
		<h2 id="encerrar-tabuleiro-titulo" class="font-heading text-lg tracking-wide text-grimorio-gold">Encerrar o tabuleiro?</h2>
		<p class="mt-1 text-sm text-muted-foreground">
			A cena vai para os Lugares da campanha, com as peças onde estão, e você a reabre quando quiser. A iniciativa e os PV continuam como estão.
		</p>
		<div class="mt-4 flex justify-end gap-2">
			<button
				type="button"
				data-on:click="document.getElementById('encerrar-tabuleiro').close()"
				class="inline-flex min-h-11 items-center rounded-sm border border-grimorio-iron px-3 text-sm outline-none transition-colors hover:bg-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
			>Cancelar</button>
			<button
				type="button"
				data-on:click={ "document.getElementById('encerrar-tabuleiro').close(); " + comandoDoTabuleiroDaCena(v, "encerrar") }
				class="inline-flex min-h-11 items-center rounded-sm bg-destructive px-3 text-sm font-semibold text-destructive-foreground outline-none transition-opacity hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
			>Encerrar</button>
		</div>
	</dialog>
}

// botaoDoAcervo é o gatilho, e ele aparece em DOIS lugares — na cena vazia e no
// cabeçalho da cena aberta. É um componente e não duas cópias porque a segunda
// cópia é a que fica para trás: o rótulo com a contagem tem de dizer o mesmo
// número nos dois, e a rota tem de ser a mesma.
templ botaoDoAcervo(v tabuleiroView) {
	<button
		type="button"
		data-on:click="document.getElementById('acervo-de-lugares').showModal()"
		class="inline-flex min-h-11 items-center gap-1.5 rounded-sm border border-grimorio-iron px-3 text-sm outline-none transition-colors hover:bg-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
	>
		<span aria-hidden="true">📚</span>
		{ fmt.Sprintf("Lugares da campanha · %d", len(v.Acervo)) }
	</button>
}

// O ACERVO de cenas guardadas (ALE-124, fatia 5).
//
// LISTA e não grade: o que decide entre a taverna e a cripta é o NOME, e nome é
// texto que se lê em coluna. Uma grade de miniaturas exigiria miniatura, que o
// servidor não tem — a cena guardada é estado, não imagem.
//
// A CONTAGEM de peças vai junto porque é o que separa a cena montada da cena
// aberta e abandonada: "Cripta · 9 peças" é uma noite de trabalho e "Cena · 0
// peças" é lixo que o mestre quer apagar.
templ oAcervoDeLugares(v tabuleiroView) {
	<dialog
		id="acervo-de-lugares"
		data-preserve-attr="open"
		aria-labelledby="acervo-titulo"
		class="scene-grimorio m-auto w-[min(30rem,calc(100vw-2rem))] rounded-sm border border-grimorio-iron bg-grimorio-panel p-4 text-foreground backdrop:bg-black/60"
	>
		<h2 id="acervo-titulo" class="font-heading text-lg tracking-wide text-grimorio-gold">Lugares da campanha</h2>
		<p class="mt-1 text-sm text-muted-foreground">
			As cenas que você encerrou, com as peças onde estavam. Reabrir traz a cena para a mesa e guarda a atual no lugar dela.
		</p>
		<ul class="mt-3 max-h-[50vh] space-y-1 overflow-y-auto">
			for _, l := range v.Acervo {
				<li class="flex flex-wrap items-center gap-2 border border-grimorio-iron px-2 py-1.5">
					<span class="min-w-0 flex-1">
						<span class="block truncate text-sm text-foreground">{ l.Nome }</span>
						<span class="block text-xs text-muted-foreground">
							{ fmt.Sprintf("%s · %s", pecasEmPortugues(l.Pecas), l.Quando) }
						</span>
					</span>
					<button
						type="button"
						data-on:click={ "document.getElementById('acervo-de-lugares').close(); " + comandoDoLugar(v, l.ID, "reabrir") }
						class="inline-flex min-h-11 items-center rounded-sm bg-primary px-3 text-sm font-semibold text-primary-foreground outline-none transition-opacity hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
					>Reabrir</button>
					// APAGAR não fecha o diálogo, ao contrário do reabrir: quem
					// está limpando o acervo geralmente apaga mais de um, e
					// reabrir o menu a cada lixeira seria cobrar um clique por
					// item. O reabrir fecha porque ele TROCA a cena — ficar com o
					// menu por cima da cena nova esconderia o que ele fez.
					<button
						type="button"
						aria-label={ "Apagar " + l.Nome }
						title={ "Apagar " + l.Nome + " do acervo" }
						data-on:click={ comandoDoLugar(v, l.ID, "remover") }
						class="flex size-11 items-center justify-center rounded-sm border border-grimorio-iron text-sm text-muted-foreground outline-none transition-colors hover:border-destructive hover:text-destructive focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
					>🗑</button>
				</li>
			}
		</ul>
		<div class="mt-4 flex justify-end">
			<button
				type="button"
				data-on:click="document.getElementById('acervo-de-lugares').close()"
				class="inline-flex min-h-11 items-center rounded-sm border border-grimorio-iron px-3 text-sm outline-none transition-colors hover:bg-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
			>Fechar</button>
		</div>
	</dialog>
}

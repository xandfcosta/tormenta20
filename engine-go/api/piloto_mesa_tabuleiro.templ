package api

import "fmt"

// O TABULEIRO desenhado (ALE-263) — a fatia que se OLHA.
//
// UM NÓ POR CAMADA, nunca um por quadrado, e essa é a restrição que segura o
// custo: uma moldura de 20×14 são 280 quadrados, e desenhá-los daria 280 nós para
// pintar linhas que um `repeating-linear-gradient` pinta em zero. O chão, o
// ambiente e a grade são três divs; o que vira nó é só o que EXISTE — as peças,
// os marcadores e o terreno difícil.
//
// DOM e não canvas, como a SPA: cada peça é um `<button>` de verdade com nome
// acessível que diz QUEM e ONDE. Num canvas isso viraria um DOM espelho
// invisível, escrito duas vezes.

templ tabuleiroDaMesa(v tabuleiroView) {
	if !v.Aberto {
		<p class="border border-dashed border-grimorio-iron p-4 text-center text-sm text-muted-foreground">
			Nenhum tabuleiro aberto. O mestre abre quando a cena tiver lugar.
		</p>
	} else if v.Cortina {
		// A CORTINA ocupa o lugar da cena e NÃO desenha grade, de propósito: a
		// cena vazia mostra grade, e as duas telas têm de se parecer o menos
		// possível — o jogador resolve uma esperando e a outra cutucando o
		// mestre. O nome do lugar não aparece porque o servidor já o apagou.
		<section aria-label="Cortina" class="flex flex-col items-center justify-center gap-2 border border-dashed border-grimorio-gold/40 p-6 text-center">
			<span aria-hidden="true" class="text-2xl text-grimorio-gold/70">🎭</span>
			<p class="text-sm text-muted-foreground">O mestre está montando a cena.</p>
		</section>
	} else {
		<section aria-label={ "Tabuleiro · " + v.Lugar } class="space-y-1.5">
			<div class="flex flex-wrap items-baseline gap-x-2">
				<h2 class="text-xs font-bold uppercase tracking-widest text-muted-foreground">Tabuleiro</h2>
				<p class="truncate text-sm text-foreground">{ v.Lugar }</p>
			</div>
			// A TIRA DA CORTINA, e o esquecimento que ela evita é caro: o mapa do
			// mestre fica igualzinho com a cortina aberta ou fechada, então sem
			// ela ele narra a taverna e move o taverneiro para uma mesa que está
			// olhando um aviso. `role="status"` porque é o estado da cena, e não
			// uma ação.
			if v.AvisoDaCortina {
				<p role="status" class="flex flex-wrap items-center gap-2 border-b border-grimorio-gold/40 bg-grimorio-gold/10 px-2 py-1 text-xs text-grimorio-gold">
					<span aria-hidden="true">🎭</span>
					A cortina está fechada: a mesa não vê esta cena.
				</p>
			}
			// O PALCO é a janela; o PLANO é a moldura inteira dentro dela. O
			// enquadramento é do NAVEGADOR e nunca do servidor — foi essa a
			// escolha que tirou a ida ao servidor de cada passo de arrasto —, e
			// nesta fatia ele é a rolagem nativa: ela já é o arrasto, e vem com
			// teclado, roda e toque de graça. Como o enquadramento não está no
			// HTML, o remendo do SSE redesenha as peças sem que o mestre perca
			// onde estava olhando.
			<div class="tabuleiro-palco grimorio-frame">
				<div
					class={ "tabuleiro-plano chao-" + v.Terreno }
					style={ fmt.Sprintf("--colunas:%d; --linhas:%d", v.Colunas, v.Linhas) }
				>
					<div aria-hidden="true" class="tabuleiro-ambiente"></div>
					<div aria-hidden="true" class="tabuleiro-grade"></div>
					// O terreno difícil vem ANTES das peças para ficar por baixo
					// delas: ele é chão, e uma peça em cima de terreno difícil
					// continua sendo a peça que se clica.
					for _, q := range v.Dificil {
						<div aria-hidden="true" class="tabuleiro-dificil" style={ posicaoNoPlano(q.Col, q.Lin, 1) }></div>
					}
					for _, m := range v.Marcadores {
						@marcadorNoPlano(m)
					}
					// A TRILHA vem antes das peças e depois do chão: ela é rastro,
					// e a peça que anda por cima dela continua sendo a peça que
					// se clica.
					if v.Movimento != nil {
						for _, q := range v.Movimento.Trilha {
							<div aria-hidden="true" class="tabuleiro-trilha" style={ posicaoNoPlano(q.Col, q.Lin, 1) }></div>
						}
					}
					// O ALCANCE é PINTURA e não alvo de clique, e a diferença é o
					// que fez este desenho mudar no meio: quem tem orçamento é o
					// jogador NA VEZ dele — o mestre move sem teto (-1), e fora
					// de combate todo mundo também. Se a casa alcançável fosse o
					// único alvo, o mestre não teria onde clicar, porque não há
					// alcance a desenhar para quem não tem limite.
					//
					// Então o alcance informa e a camada abaixo é que recebe o
					// clique. Ele continua sendo o que impede o estouro, só que
					// pela frente: a pessoa vê até onde cabe antes de escolher.
					for _, q := range v.Alcance {
						<div aria-hidden="true" class="tabuleiro-alcance" style={ posicaoNoPlano(q.Col, q.Lin, 1) }></div>
					}
					for _, p := range v.Pecas {
						@pecaNoPlano(p)
					}
					// A CAMADA DE CASAS é UM nó, e não um por quadrado: 280
					// botões seriam um campo minado no leitor de tela, que é a
					// mesma razão pela qual a SPA torna a dela condicional. O
					// quadrado sai do PONTO do clique dividido pelo tamanho da
					// casa, e o `$quadrado` acompanha o zoom quando ele chegar.
					//
					// Ela só existe quando há o que mover: sem peça movível e sem
					// movimento em curso, ela seria um alvo que não faz nada.
					if v.AlvoDoMovimento != "" {
						<button
							type="button"
							aria-label={ "Mover " + v.RotuloDoAlvo + " — escolha a casa" }
							data-on:click={ paradaNoPontoClicado(v) }
							class="tabuleiro-casas"
						></button>
					}
				</div>
			</div>
			if v.Movimento != nil && v.Movimento.Meu {
				@oMovimentoProposto(v)
			}
		</section>
	}
}

// oMovimentoProposto é a faixa que diz o CUSTO e oferece o par de decidir.
//
// O número vem antes dos botões porque ele é o que decide o clique: "5 de 6"
// responde a pergunta que a pessoa tem na mão, e um par de botões sem o custo ao
// lado obrigaria a contar quadrados na tela.
//
// Confirmar e cancelar NÃO são um interruptor, pelo mesmo motivo do encerrar
// cena: são dois verbos com consequências diferentes, e um só convidaria ao
// clique de volta que não existe.
templ oMovimentoProposto(v tabuleiroView) {
	<div class="flex flex-wrap items-center gap-2 border-t border-grimorio-iron px-1 pt-2 text-sm">
		<p aria-live="polite" class="text-muted-foreground">
			{ v.Movimento.Rotulo } ·
			if v.Movimento.Orcamento < 0 {
				// Sem orçamento é o mestre, ou fora de combate: o custo continua
				// sendo dito, porque ele informa, mas não há teto para comparar.
				<span class="font-mono tabular-nums text-foreground">{ fmt.Sprint(v.Movimento.Custo) }</span>
				{ " quadrados" }
			} else {
				<span class="font-mono tabular-nums text-foreground">
					{ fmt.Sprintf("%d de %d", v.Movimento.Custo, v.Movimento.Orcamento) }
				</span>
				{ fmt.Sprintf(" quadrados · sobram %d", v.Movimento.Restante) }
			}
		</p>
		<span class="ml-auto flex items-center gap-2">
			<button
				type="button"
				data-on:click={ comandoDoMovimento(v, "cancelar") }
				class="inline-flex min-h-11 items-center rounded-sm border border-grimorio-iron px-3 text-sm text-muted-foreground outline-none transition-colors hover:border-destructive hover:text-destructive focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
			>Cancelar</button>
			<button
				type="button"
				data-on:click={ comandoDoMovimento(v, "confirmar") }
				class="inline-flex min-h-11 items-center rounded-sm bg-primary px-3 text-sm font-semibold text-primary-foreground outline-none transition-opacity hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
			>Confirmar</button>
		</span>
	</div>
}



// pecaNoPlano é uma peça: monograma da ESPÉCIE, selo da INSTÂNCIA, e a barra de
// PV quando há número para mostrar.
//
// O nome acessível diz QUEM e ONDE, com a coordenada COM SINAL que o servidor
// guarda — sem ele a peça é um disco anônimo para quem não vê a tela, e "o Zumbi
// 3" deixa de ter resposta.
//
// A cor vem por variável de estilo e não por classe, e é o único jeito: o matiz
// é um número calculado por nome, então não existe classe do Tailwind para ele —
// seriam 360 classes que o scanner nunca veria.
templ pecaNoPlano(p pecaDoTabuleiro) {
	<button
		type="button"
		aria-label={ nomeDaPeca(p) }
		title={ nomeDaPeca(p) }
		style={ posicaoNoPlano(p.Col, p.Lin, p.Pegada) + fmt.Sprintf("--matiz:%d;", p.Matiz) }
		class={ "tabuleiro-peca",
			templ.KV("tabuleiro-peca-na-vez", p.NaVez),
			templ.KV("tabuleiro-peca-oculta", p.Oculta) }
	>
		<span class="tabuleiro-monograma">{ p.Monograma }</span>
		if p.Instancia != "" {
			// O selo é TEXTO e não só cor: "eu ataco o Zumbi 3" precisa de
			// resposta num relance inclusive para quem não distingue matiz.
			<span class="tabuleiro-selo">{ p.Instancia }</span>
		}
		if p.PV != nil {
			<span aria-hidden="true" class="tabuleiro-vida">
				<span class={ "tabuleiro-vida-cheia", hpTomDe(*p.PV) } style={ fmt.Sprintf("width:%d%%", *p.PV) }></span>
			</span>
		}
	</button>
}

templ marcadorNoPlano(m marcadorDoTabuleiro) {
	<span
		aria-label={ "Marcador " + m.Texto + " em " + m.Onde }
		title={ m.Texto + " · " + m.Onde }
		style={ posicaoNoPlano(m.Col, m.Lin, 1) + fmt.Sprintf("--marcador:%s;", corDeMarcador(m.Cor)) }
		class="tabuleiro-marcador"
	>{ m.Texto }</span>
}

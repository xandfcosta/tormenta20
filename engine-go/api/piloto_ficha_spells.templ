package api

import (
	"fmt"
	"strconv"
	"t20engine/web/ui"
)

// O painel de MAGIAS desenhado (ALE-272, fatia 6).
//
// # O catálogo inteiro numa lista, sem virtualizar
//
// São 198 magias, e elas saem todas. É a decisão que o piloto já tomou para os
// catálogos do mestre, onde as 992 entradas viajam de uma vez — o que sustenta
// isso é a lista rolar DENTRO da caixa, e não a página crescer. A corrente de
// `min-h-0` até o `overflow-y-auto` é o que segura, e há guarda medindo que o
// DOCUMENTO não fica mais alto que a janela.
//
// # O diálogo de conjurar guarda as pilhas em SEIS sinais, e não um por magia
//
// Só um diálogo abre por vez, então `$aug0`..`$aug5` bastam — seis porque é o
// máximo do catálogo (Conjurar Monstro). Quem ABRE zera os seis: é a regra do
// "remendo em nó compartilhado" do guia, e sem ela a pilha escolhida numa magia
// reapareceria na seguinte.

// spellsPanelSection é a seção inteira.
templ spellsPanelSection(v fichaView) {
	<section class="flex min-h-0 flex-1 flex-col">
		<div class="flex shrink-0 flex-wrap items-center gap-2 border-b border-grimorio-iron px-3 py-2 sm:px-4">
			<h2 class="font-heading text-sm uppercase tracking-[0.18em] text-muted-foreground">Grimório</h2>
			<p class="text-3xs text-muted-foreground sm:text-xs">{ aprendidasEscrito(len(v.Spells.Learned)) }</p>
			if v.Spells.IsCaster {
				<button
					type="button"
					aria-label="Aprender magia"
					data-on:click="$aprender = true"
					class={ ui.ButtonClasses(ui.VariantSecondary, ui.SizeSmall, "ml-auto") }
				>
					@ui.Icon("Plus", "size-4")
				</button>
			}
		</div>
		<div class="flex min-h-0 flex-1 flex-col gap-2 overflow-y-auto p-2 sm:p-3">
			@grantedSpellsBlock(v)
			if len(v.Spells.Learned) == 0 {
				<p class="px-2 py-3 text-center text-xs text-muted-foreground">
					if v.Spells.IsCaster {
						{ "Nenhuma magia aprendida. Use Aprender para escolher no livro." }
					} else {
						{ "Este personagem não conjura por classe." }
					}
				</p>
			} else {
				for _, magia := range v.Spells.Learned {
					@learnedSpellRowItem(v, magia)
				}
			}
		</div>
	</section>
	for _, magia := range v.Spells.Learned {
		@castSpellDialog(v, magia)
	}
	// O diálogo só existe para quem CONJURA. Não é só o botão que some: o
	// catálogo do Capítulo 4 são ~198 linhas de HTML, e mandá-las para um
	// guerreiro é peso puro num telefone com dados móveis.
	if v.Spells.IsCaster {
		@learnSpellDialog(v)
	}
}

// grantedSpellsBlock são as magias que um PODER ensinou.
//
// Elas aparecem mesmo para quem não conjura por classe — um bárbaro com Totem
// Espiritual (p42) tem de ver a magia dele — e NÃO têm esquecer: some com o
// poder, e não com um botão aqui.
templ grantedSpellsBlock(v fichaView) {
	if len(v.Spells.Granted) > 0 {
		<div class="space-y-1 rounded-none border border-grimorio-iron p-2">
			<p class="text-3xs font-bold uppercase tracking-widest text-muted-foreground">Concedidas por poderes</p>
			for _, magia := range v.Spells.Granted {
				<div class="flex items-center gap-2 rounded-sm border border-arcane/40 bg-grimorio-panel px-2 py-1.5">
					<span class="shrink-0 rounded-full border border-arcane/40 px-1.5 font-mono text-3xs text-arcane-ink">{ magia.Circle }</span>
					<span class="min-w-0 flex-1 truncate text-sm text-foreground">{ magia.Name }</span>
					<span class="shrink-0 truncate text-2xs text-muted-foreground">{ magia.Source }</span>
				</div>
			}
		</div>
	}
}

// learnedSpellRowItem é uma magia do grimório.
templ learnedSpellRowItem(v fichaView, magia learnedSpellRow) {
	<div class="flex min-w-0 items-center gap-2 rounded-none border border-grimorio-iron p-1.5">
		<span class="shrink-0 rounded-full border border-arcane/40 px-1.5 font-mono text-3xs text-arcane-ink">{ magia.Circle }</span>
		<button
			type="button"
			aria-label={ "Detalhar " + magia.Name }
			aria-haspopup="dialog"
			data-on:click={ oGestoQueAbreOConjurar(magia) }
			class="min-w-0 flex-1 truncate text-left text-sm text-foreground outline-none hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
		>{ magia.Name }</button>
		if magia.CD != "—" {
			<span class="shrink-0 font-mono text-2xs text-muted-foreground">{ "CD " + magia.CD }</span>
		}
		if v.Spells.RequiresPrep {
			@preparedToggle(v, magia)
		}
		<button
			type="button"
			aria-label={ "Conjurar " + magia.Name }
			aria-haspopup="dialog"
			data-on:click={ oGestoQueAbreOConjurar(magia) }
			class={ ui.ButtonClasses(ui.VariantPrimary, ui.SizeSmall, "shrink-0") }
		>Conjurar</button>
		<button
			type="button"
			aria-label={ "Esquecer " + magia.Name }
			data-on:click={ oPostDaFicha(v, "/magias/esquece/"+magia.Command) }
			class="inline-flex size-8 shrink-0 items-center justify-center rounded-sm text-muted-foreground outline-none transition-colors hover:text-destructive-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
		>
			@ui.Icon("Trash2", "size-3.5")
		</button>
	</div>
}

// preparedToggle só existe para quem PREPARA magia — Clérigo, Druida e o
// Arcanista do caminho `mago`. Para os outros, um botão de preparar seria um
// controle que não significa nada.
templ preparedToggle(v fichaView, magia learnedSpellRow) {
	<button
		type="button"
		role="switch"
		aria-checked={ fmt.Sprintf("%t", magia.Prepared) }
		aria-label={ magia.Name + " preparada" }
		data-on:click={ oPostDaFicha(v, "/magias/prepara/"+magia.Command) }
		class={ "inline-flex shrink-0 items-center gap-1 rounded-full border px-2 py-0.5 text-3xs uppercase tracking-wider outline-none transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring",
			templ.KV("border-grimorio-gold/60 text-grimorio-gold", magia.Prepared),
			templ.KV("border-grimorio-iron text-muted-foreground", !magia.Prepared) }
	>Preparada</button>
}

// castSpellDialog escolhe os aprimoramentos e conjura.
//
// A PRÉVIA do custo é uma soma do cliente sobre números que o servidor mandou, e
// ela nunca decide nada: quem recusa é o `@post`, com a regra inteira. Uma
// prévia que decidisse seria uma segunda regra, e a ALE-110 registrou o que
// acontece quando duas contas do mesmo custo discordam.
templ castSpellDialog(v fichaView, magia learnedSpellRow) {
	@aSobreposicao("conjura-"+magia.Command, magia.Name, "Sparkles", true) {
		<p class="text-xs text-muted-foreground">
			{ magia.Execution + " · " + magia.Range + " · " + magia.Duration }
		</p>
		<p class="text-xs text-foreground">{ magia.Effect }</p>
		<div class="flex items-baseline gap-2 rounded-sm border border-arcane/40 bg-arcane/10 px-3 py-2">
			<span class="text-xs uppercase tracking-widest text-arcane-ink">Custo</span>
			<span class="font-mono text-2xl font-bold text-arcane-ink" data-text={ aPreviaDoCusto(magia) }></span>
			<span class="ml-auto font-mono text-2xs text-muted-foreground">{ "PM " + strconv.FormatInt(v.Spells.PmCurrent, 10) }</span>
		</div>
		if len(magia.Augments) > 0 {
			<div class="space-y-1">
				<p class="text-xs font-bold uppercase tracking-widest text-muted-foreground">Aprimoramentos</p>
				for _, aprimoramento := range magia.Augments {
					@augmentPicker(aprimoramento)
				}
			</div>
		}
		<button
			type="button"
			data-on:click={ oPostDaFicha(v, "/magias/conjura/"+magia.Command) + "; $detalhe = ''" }
			class={ ui.ButtonClasses(ui.VariantPrimary, ui.SizeDefault, "w-full") }
		>{ "Conjurar " + magia.Name }</button>
	}
}

// augmentPicker é um aprimoramento: uma pilha, uma caixa, ou um cadeado.
//
// O TRANCADO aparece em vez de sumir. Quem não alcança o círculo merece saber
// que o aprimoramento existe e por que ele não está disponível — some-lo faria a
// lista parecer menor do que o livro diz que é. E a fronteira não é este
// cadeado: o servidor recusa o mesmo pedido (ALE-272, fatia 6).
templ augmentPicker(a augmentRow) {
	<div
		class={ "flex items-center gap-2 rounded-sm border px-2 py-1.5",
			templ.KV("border-grimorio-iron opacity-60", a.Locked),
			templ.KV("border-grimorio-iron", !a.Locked) }
	>
		if a.Locked {
			@ui.Icon("Lock", "size-3.5 shrink-0 text-warning-ink")
		}
		<span class="min-w-0 flex-1">
			<span class="block text-xs text-foreground">{ a.Description }</span>
			<span class="block font-mono text-3xs text-muted-foreground">
				if a.Locked {
					{ "+" + strconv.Itoa(a.PM) + " PM · exige o " + strconv.Itoa(a.RequiredCircle) + "º círculo" }
				} else {
					{ "+" + strconv.Itoa(a.PM) + " PM" }
				}
			</span>
		</span>
		if !a.Locked {
			@augmentStepper(a)
		}
	</div>
}

// augmentStepper é o contador de pilhas, ou um liga-desliga quando o
// aprimoramento é `muda` — trocar o tipo de dano duas vezes não é trocar duas
// vezes mais.
templ augmentStepper(a augmentRow) {
	<div class="flex shrink-0 items-center gap-1">
		if a.Stacks {
			<button
				type="button"
				aria-label={ "Menos de " + a.Description }
				data-on:click={ oSinalDoAprimoramento(a.Index) + " = Math.max(0, " + oSinalDoAprimoramento(a.Index) + " - 1)" }
				class="inline-flex size-7 items-center justify-center rounded-sm border border-grimorio-iron text-muted-foreground outline-none hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
			>−</button>
			<span class="w-5 text-center font-mono text-sm text-foreground" data-text={ oSinalDoAprimoramento(a.Index) }></span>
			<button
				type="button"
				aria-label={ "Mais de " + a.Description }
				data-on:click={ oSinalDoAprimoramento(a.Index) + "++" }
				class="inline-flex size-7 items-center justify-center rounded-sm border border-grimorio-iron text-muted-foreground outline-none hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
			>+</button>
		} else {
			<button
				type="button"
				role="switch"
				aria-label={ a.Description }
				data-attr:aria-checked={ oSinalDoAprimoramento(a.Index) + " > 0 ? 'true' : 'false'" }
				data-on:click={ oSinalDoAprimoramento(a.Index) + " = " + oSinalDoAprimoramento(a.Index) + " > 0 ? 0 : 1" }
				class="inline-flex min-h-7 items-center rounded-full border border-grimorio-iron px-2 text-3xs uppercase tracking-wider text-muted-foreground outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
			>Trocar</button>
		}
	</div>
}

// learnSpellDialog é o catálogo do Capítulo 4, filtrável.
templ learnSpellDialog(v fichaView) {
	<div
		data-show="$aprender"
		data-on:click="evt.target === el && ($aprender = false)"
		data-on:keydown__window="evt.key === 'Escape' && ($aprender = false)"
		class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 p-3 sm:p-4"
	>
		<div
			role="dialog"
			aria-modal="true"
			aria-label="Aprender magia"
			data-attr:data-expanded="$aprender"
			class="relative flex max-h-[85vh] w-full flex-col rounded-md border border-grimorio-iron bg-background p-4 sm:max-w-lg"
		>
			<p class="pr-10 font-heading uppercase tracking-wide text-grimorio-gold">Aprender magia</p>
			<button
				type="button"
				aria-label="Fechar aprender magia"
				data-on:click="$aprender = false"
				class="absolute right-2 top-2 flex size-11 items-center justify-center rounded-sm text-lg text-muted-foreground outline-none transition-colors hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
			>×</button>
			@spellFilters(v)
			// A LISTA ROLA DENTRO DA CAIXA, e é isso que sustenta mandar as 198 de
			// uma vez: sem o `min-h-0` aqui, a caixa cresce até a altura do
			// conteúdo e a página inteira estica.
			<div class="mt-2 min-h-0 flex-1 space-y-1 overflow-y-auto">
				if len(v.Spells.Catalogo) == 0 {
					<p class="py-3 text-center text-xs text-muted-foreground">Nenhuma magia com esses filtros.</p>
				} else {
					for _, magia := range v.Spells.Catalogo {
						<button
							type="button"
							data-on:click={ oPostDaFicha(v, "/magias/aprende/"+magia.Command) }
							class="block w-full rounded-sm border border-grimorio-iron px-2 py-1.5 text-left outline-none transition-colors hover:bg-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
						>
							<span class="flex items-baseline gap-2">
								<span class="shrink-0 font-mono text-3xs text-arcane-ink">{ magia.Circle }</span>
								<span class="min-w-0 flex-1 truncate text-sm text-foreground">{ magia.Name }</span>
								<span class="shrink-0 text-3xs text-muted-foreground">{ magia.School }</span>
							</span>
						</button>
					}
				}
			</div>
		</div>
	</div>
}

// spellFilters são a busca, o círculo e a escola.
templ spellFilters(v fichaView) {
	<div class="mt-3 flex flex-wrap gap-2">
		<div class="relative min-w-0 flex-1">
			@ui.Icon("Search", "pointer-events-none absolute left-2 top-1/2 size-3.5 -translate-y-1/2 text-muted-foreground")
			<input
				type="search"
				name="magiabusca"
				data-bind:magiabusca
				data-on:input__debounce.250ms={ oGetDaFicha(v) }
				value={ v.Spells.Search }
				placeholder="Buscar magia"
				aria-label="Buscar magia"
				class="h-8 w-full rounded-sm border border-input bg-transparent pl-7 pr-2 text-base outline-none focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-ring sm:text-sm"
			/>
		</div>
		<select
			name="magiacirculo"
			data-bind:magiacirculo
			data-on:change={ oGetDaFicha(v) }
			aria-label="Filtrar por círculo"
			class="h-8 cursor-pointer rounded-sm border border-input bg-transparent px-2 text-sm text-foreground outline-none focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-ring"
		>
			@circleOption("", "Todos os círculos", v.Spells.Circulo)
			@circleOption("0", "Truque", v.Spells.Circulo)
			@circleOption("1", "1º círculo", v.Spells.Circulo)
			@circleOption("2", "2º círculo", v.Spells.Circulo)
			@circleOption("3", "3º círculo", v.Spells.Circulo)
			@circleOption("4", "4º círculo", v.Spells.Circulo)
			@circleOption("5", "5º círculo", v.Spells.Circulo)
		</select>
		<select
			name="magiaescola"
			data-bind:magiaescola
			data-on:change={ oGetDaFicha(v) }
			aria-label="Filtrar por escola"
			class="h-8 cursor-pointer rounded-sm border border-input bg-transparent px-2 text-sm text-foreground outline-none focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-ring"
		>
			for _, opcao := range v.Spells.Escolas {
				if opcao.Ativo {
					<option value={ opcao.Valor } selected>{ opcao.Rotulo }</option>
				} else {
					<option value={ opcao.Valor }>{ opcao.Rotulo }</option>
				}
			}
		</select>
	</div>
}

templ circleOption(valor, rotulo, ativo string) {
	if valor == ativo {
		<option value={ valor } selected>{ rotulo }</option>
	} else {
		<option value={ valor }>{ rotulo }</option>
	}
}

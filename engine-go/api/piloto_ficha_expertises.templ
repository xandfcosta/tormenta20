package api

import (
	"fmt"
	"t20engine/web/ui"
)

// O painel de PERÍCIAS desenhado (ALE-272, fatia 4).
//
// Uma linha por perícia, em TODA largura — a fileira de crachás que a SPA
// desenha acima de 640px não existe aqui, por decisão do dono: ela repete o
// diálogo palavra por palavra, e a auditoria continua a um toque no número.
//
// # A BUSCA vai ao SERVIDOR, e é o padrão da casa
//
// `data-bind:busca` mais um `@get` com debounce, como a cena de campanhas. Ela
// custa uma ida — 2ms, e a cena volta comprimida desde a ALE-273 — e ganha o
// filtro sobrevivendo a qualquer outro gesto: o termo viaja como sinal em TODA
// requisição da ficha, então mexer no PV com a busca escrita devolve a lista
// ainda filtrada.
//
// O `?tab=` está no `@get` pela MESMA razão que está em todo `@post`: sem ele o
// resolvedor cai na primeira aba. É a sexta armadilha do Datastar, e aqui ela
// morderia um GET, que o guarda de varredura dos comandos não olha.

// oPainelDePericias é a seção inteira.
templ oPainelDePericias(v fichaView) {
	<section class="flex min-h-0 flex-1 flex-col">
		<div class="flex shrink-0 flex-wrap items-center gap-2 border-b border-grimorio-iron px-3 py-2 sm:px-4">
			<h2 class="font-heading text-sm uppercase tracking-[0.18em] text-muted-foreground">Perícias</h2>
			// AS DUAS PARCELAS QUE VALEM PARA TODAS, ditas uma vez. Sem esta linha
			// cada jogador redescobre o próprio treino abrindo um diálogo.
			<p class="text-3xs text-muted-foreground sm:text-xs">
				{ "treino " + v.Expertises.TrainingBonus + " • ½ nível " + v.Expertises.HalfLevel }
			</p>
			<div class="ml-auto flex items-center gap-2">
				@aBuscaDePericia(v)
				<button
					type="button"
					aria-label="Nova perícia"
					data-on:click="$novapericia = ''; $novoatributo = 'intelligence'; $oficio = true"
					class={ ui.ButtonClasses(ui.VariantSecondary, ui.SizeSmall, "") }
				>
					@ui.Icon("Plus", "size-4")
				</button>
			</div>
		</div>
		<div class="flex min-h-0 flex-1 flex-col gap-1 overflow-y-auto p-2 sm:p-3">
			if len(v.Expertises.Rows) == 0 {
				<p class="px-2 py-3 text-center text-xs text-muted-foreground">
					{ "Nenhuma perícia para \"" + v.Expertises.Search + "\"" }
				</p>
			} else {
				for _, linha := range v.Expertises.Rows {
					@aLinhaDaPericia(v, linha)
				}
			}
		</div>
	</section>
	for _, linha := range v.Expertises.Rows {
		@oDetalheDaPericia(linha)
	}
	@oDialogoDoOficio(v)
}

// aBuscaDePericia é o campo que filtra a lista.
//
// O `__debounce` não é afinação: sem ele isto é uma requisição POR TECLA. 250ms
// é o que separa "ainda digitando" de "parou de digitar", e é o mesmo número da
// cena de campanhas.
templ aBuscaDePericia(v fichaView) {
	<div class="relative w-40 sm:w-56">
		@ui.Icon("Search", "pointer-events-none absolute left-2 top-1/2 size-3.5 -translate-y-1/2 text-muted-foreground")
		<input
			type="search"
			name="busca"
			data-bind:busca
			data-on:input__debounce.250ms={ oGetDaFicha(v) }
			value={ v.Expertises.Search }
			placeholder="Buscar perícia"
			aria-label="Buscar perícia"
			class="h-8 w-full rounded-sm border border-input bg-transparent pl-7 pr-2 text-base outline-none focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-ring sm:text-xs"
		/>
	</div>
}

// aLinhaDaPericia é uma perícia: o número, o nome, o atributo e o treino.
templ aLinhaDaPericia(v fichaView, linha expertiseRow) {
	<div
		class={ "flex min-w-0 items-center gap-2 rounded-none border border-grimorio-iron p-1.5 transition-colors hover:border-grimorio-gold/50",
			templ.KV("bg-grimorio-panel", linha.Trained) }
	>
		@oTotalDaPericia(linha)
		<button
			type="button"
			aria-label={ "Detalhar " + linha.Name }
			data-on:click={ "$detalhe = '" + linha.Key + "'" }
			class="min-w-0 flex-1 truncate text-left text-sm text-foreground outline-none hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
		>{ linha.Name }</button>
		if linha.TrainedOnly {
			@aEstrelaDeSoTreinada(linha)
		}
		@oSeletorDeAtributo(v, linha)
		@oBotaoDeTreino(v, linha)
		if linha.Custom {
			<button
				type="button"
				aria-label={ "Remover " + linha.Name }
				data-on:click={ oPostDaFicha(v, "/pericias/remove/"+linha.Command) }
				class="inline-flex shrink-0 rounded-sm p-1 text-muted-foreground outline-none transition-colors hover:text-destructive-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
			>
				@ui.Icon("Trash2", "size-3.5")
			</button>
		}
	</div>
}

// oTotalDaPericia é o número, e ele ABRE a decomposição.
//
// A FALHA AUTOMÁTICA não tem número para mostrar (p394): o traço carrega o
// sentido no desenho e o rótulo acessível o diz por extenso. A composição
// continua no diálogo, porque quem falha automaticamente ainda quer saber o que
// perdeu.
templ oTotalDaPericia(linha expertiseRow) {
	<button
		type="button"
		aria-label={ oRotuloDoTotal(linha) }
		aria-haspopup="dialog"
		data-on:click={ "$detalhe = '" + linha.Key + "'" }
		class={ "flex size-11 shrink-0 items-center justify-center rounded-none border font-mono text-lg font-bold outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring",
			templ.KV("border-destructive/60 bg-destructive/10 text-penalty-ink", linha.AutoFail),
			templ.KV("border-dashed border-grimorio-iron text-muted-foreground", linha.Locked && !linha.AutoFail),
			templ.KV("border-grimorio-iron bg-grimorio-panel-raised text-grimorio-gold", !linha.Locked && !linha.AutoFail) }
	>
		if linha.AutoFail {
			{ "—" }
		} else {
			{ linha.Total }
		}
	</button>
}

// aEstrelaDeSoTreinada marca a perícia que o livro fecha sem treinamento (p115).
//
// Ela é um `<span>` com `title`, e não um botão com dica: um botão que não faz
// nada é uma parada muda para quem navega por teclado, e seriam nove delas.
templ aEstrelaDeSoTreinada(linha expertiseRow) {
	<span
		title="Pode ser usada apenas quando treinada"
		class={ "inline-flex shrink-0",
			templ.KV("text-warning-ink", linha.Locked),
			templ.KV("text-muted-foreground", !linha.Locked) }
	>
		@ui.Icon("Star", "size-3")
	</span>
}

// oSeletorDeAtributo escolhe com QUAL atributo a perícia rola.
//
// As opções mostram o modificador FINAL — raça e itens já dentro —, porque um
// valor cru aqui faria a linha discordar do próprio total.
templ oSeletorDeAtributo(v fichaView, linha expertiseRow) {
	<select
		aria-label={ linha.Name + " atributo" }
		data-on:change={ oComandoDoAtributo(v, linha.Command) }
		class="h-6 min-w-0 max-w-full shrink cursor-pointer rounded-full border border-grimorio-iron bg-transparent px-2 font-mono text-2xs text-foreground outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
	>
		for _, opcao := range v.Expertises.Attributes {
			if opcao.Key == linha.Attribute {
				<option value={ opcao.Key } selected>{ opcao.Label }</option>
			} else {
				<option value={ opcao.Key }>{ opcao.Label }</option>
			}
		}
	</select>
}

// oBotaoDeTreino liga e desliga o treino.
templ oBotaoDeTreino(v fichaView, linha expertiseRow) {
	<button
		type="button"
		role="switch"
		aria-checked={ fmt.Sprintf("%t", linha.Trained) }
		aria-label={ linha.Name + " treinada" }
		data-on:click={ oPostDaFicha(v, "/pericias/treino/"+linha.Command) }
		class={ "inline-flex shrink-0 items-center gap-1 rounded-full border px-2 py-0.5 text-3xs uppercase tracking-wider outline-none transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring",
			templ.KV("border-grimorio-gold/60 text-grimorio-gold", linha.Trained),
			templ.KV("border-grimorio-iron text-muted-foreground hover:border-grimorio-gold/40", !linha.Trained) }
	>
		@ui.Icon("Dumbbell", "size-3")
		Treino
	</button>
}

// oDetalheDaPericia é a decomposição de UMA perícia.
templ oDetalheDaPericia(linha expertiseRow) {
	@aSobreposicao(linha.Key, linha.Name, "Scroll", false) {
		@asLinhasDaDecomposicao(linha.Rows)
		<div class="flex items-center justify-between rounded-none border border-grimorio-iron bg-grimorio-panel-raised px-3 py-2">
			<span class="text-xs uppercase tracking-widest text-muted-foreground">Total</span>
			<span
				class={ "flex items-center gap-1.5 font-mono text-2xl font-bold",
					templ.KV("text-muted-foreground", linha.Locked),
					templ.KV("text-grimorio-gold", !linha.Locked) }
			>
				if linha.Locked {
					@ui.Icon("Lock", "size-4 text-warning-ink")
				}
				{ linha.Total }
			</span>
		</div>
	}
}

// oDialogoDoOficio cria uma perícia que o livro não tem.
//
// A TELA DIZ "nova perícia", e NUNCA "ofício" — a palavra é da SPA e é a certa:
// **Ofício É uma das 29 do livro** (p115), e chamar a perícia inventada de
// ofício poria duas coisas diferentes com o mesmo nome na MESMA lista. O
// identificador em Go continua falando de ofício porque é o conceito interno
// ("a que o jogador inventou"), e identificador não é o que a pessoa lê.
//
// Ele é UM só na cena e reaproveitado, então quem o ABRE limpa os dois campos —
// a regra do "remendo em nó compartilhado" do guia do Go: quem gera não sabe que
// vai haver um próximo, quem troca sabe que houve um anterior.
templ oDialogoDoOficio(v fichaView) {
	<div
		data-show="$oficio"
		data-on:click="evt.target === el && ($oficio = false)"
		data-on:keydown__window="evt.key === 'Escape' && ($oficio = false)"
		class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 p-3 sm:p-4"
	>
		<div
			role="dialog"
			aria-modal="true"
			aria-label="Nova perícia"
			data-attr:data-expanded="$oficio"
			class="relative w-full rounded-md border border-grimorio-iron bg-background p-4 sm:max-w-sm"
		>
			<p class="pr-10 font-heading uppercase tracking-wide text-grimorio-gold">Nova perícia</p>
			<button
				type="button"
				aria-label="Fechar nova perícia"
				data-on:click="$oficio = false"
				class="absolute right-2 top-2 flex size-11 items-center justify-center rounded-sm text-lg text-muted-foreground outline-none transition-colors hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
			>×</button>
			<div class="mt-3 space-y-3">
				<div>
					<label for="oficio-nome" class="text-xs uppercase tracking-widest text-muted-foreground">Nome</label>
					<input
						id="oficio-nome"
						type="text"
						maxlength="40"
						data-bind:novapericia
						placeholder="Ferreiro, Marinheiro…"
						class="mt-1 h-9 w-full rounded-sm border border-input bg-transparent px-2 text-base outline-none focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-ring sm:text-sm"
					/>
				</div>
				<div>
					<label for="oficio-atributo" class="text-xs uppercase tracking-widest text-muted-foreground">Atributo</label>
					<select
						id="oficio-atributo"
						data-bind:novoatributo
						class="mt-1 h-9 w-full cursor-pointer rounded-sm border border-input bg-transparent px-2 font-mono text-sm text-foreground outline-none focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-ring"
					>
						for _, opcao := range v.Expertises.Attributes {
							<option value={ opcao.Key }>{ opcao.Label }</option>
						}
					</select>
				</div>
				<button
					type="button"
					data-on:click={ oPostDaFicha(v, "/pericias/nova") + "; $oficio = false" }
					class={ ui.ButtonClasses(ui.VariantPrimary, ui.SizeDefault, "w-full") }
				>Criar perícia</button>
			</div>
		</div>
	</div>
}

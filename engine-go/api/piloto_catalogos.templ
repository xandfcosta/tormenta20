package api

import (
	"fmt"
	"t20engine/web/ui"
	"t20engine/book"
)

// OS CATÁLOGOS (ALE-258), segunda ferramenta da Mesa do Mestre.
//
// A cena manda as 992 entradas — decisão do dono, e o custo aceito é DOM. O que
// esse custo exige em troca é que a lista ROLE DENTRO DA CAIXA, e isso não é
// detalhe de estilo: a versão em React deixou a lista crescer até a altura do
// conteúdo e vazar de 1854 a 2566px para fora do cartão, nos seis formatos, sem
// a página rolar — então a asserção "a cena não rola" ficava VERDE por cima do
// defeito (ALE-149). Com 566 poderes desenhados de uma vez, o mesmo descuido
// aqui daria uma página de dezenas de milhares de pixels.
//
// Por isso o `min-h-0` aparece em cada elo da corrente até a lista, e o e2e
// mede a altura do documento em vez de confiar em classe.

templ cenaDosCatalogos(v catalogosView) {
	<section
		id="catalogos"
		class="mesa-palco flex min-h-0 flex-1 flex-col gap-3"
		aria-labelledby="mesa-catalogos"
		data-signals={ sinaisDosCatalogos(v) }
	>
		<div class="flex flex-wrap items-baseline gap-x-3">
			// O título é o da ABA, e não "Catálogos": desde que cada catálogo
			// virou uma parada do trilho, a cena é a das Condições — e repetir a
			// palavra genérica aqui deixaria a tela sem dizer onde se está.
			<h2 id="mesa-catalogos" class="font-heading text-lg tracking-wide text-foreground">{ rotuloDaAba(v.Aba) }</h2>
			<p class="text-xs text-muted-foreground">{ contagemDoAcervo(v) }</p>
		</div>
		<div class="relative shrink-0">
			@ui.Icon("Search", "pointer-events-none absolute left-2 top-1/2 size-4 -translate-y-1/2 text-muted-foreground")
			<input
				type="search"
				data-busca-da-cena
				name="busca"
				data-bind:busca
				data-on:input__debounce.250ms={ "@get('/mestre/" + v.Aba + "')" }
				value={ v.Busca }
				placeholder="Buscar em todos os catálogos"
				aria-label="Buscar nos catálogos"
				class="h-9 w-full rounded-sm border border-input bg-transparent pl-8 pr-3 text-base outline-none focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-ring md:text-sm"
			/>
		</div>
		// Os FILTROS somem durante a busca: com termo digitado a cena responde
		// outra pergunta — os oito catálogos, não este —, e um crachá de círculo
		// aceso sobre uma lista que tem itens e condições diria que ele está
		// filtrando o que não filtra.
		if !v.Buscando() && len(v.Filtros) > 0 {
			@filtrosDoAcervo(v)
		}
		// A fileira de abas SUMIU na ALE-264: cada catálogo virou uma parada do
		// trilho, e ter as duas coisas seria o mesmo estado desenhado em dois
		// lugares — o trilho dizendo "Condições" e a fileira dizendo de novo.
		//
		// O que a fileira fazia e continua valendo: com termo digitado, a busca
		// varre os OITO catálogos e mostra os grupos, não só o da cena. É a
		// ALE-22 — "bola de fogo" digitado em Condições achava "nada encontrado"
		// com a magia existindo.
		// A saída de quem chegou por um ELO com o endereço na barra (ctrl+clique,
		// link colado): a cena mostra UM verbete, e sem esta linha a pessoa fica
		// sem entender por que a aba tem uma entrada só.
		if v.Entrada != "" {
			<p class="shrink-0 text-xs text-muted-foreground">
				<a
					href={ templ.SafeURL("/mestre/catalogos?aba=" + v.Aba) }
					class="underline decoration-dotted underline-offset-2 outline-none transition-colors hover:text-grimorio-gold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
				>{ "‹ ver " + rotuloDaAba(v.Aba) + " inteiro" }</a>
			</p>
		}
		@resultadosDoAcervo(v)
	</section>
}

func contagemDoAcervo(v catalogosView) string {
	if v.Buscando() {
		return fmt.Sprintf("%d achados", v.Achados)
	}
	return fmt.Sprintf("%d entradas", v.Achados)
}


// resultadosDoAcervo é a caixa que ROLA. Ver o cabeçalho do arquivo.
//
// As colunas são CSS (`.acervo-em-colunas`) e não um número calculado em JS
// como na SPA. Lá o cálculo era necessário porque a lista é virtualizada e
// "duas colunas" tinha de ser um agrupamento dos DADOS antes de entregá-los;
// sem virtualização a grade nativa mede o contêiner de graça.
//
// A primeira versão usava `auto-fill minmax(22rem, 1fr)` puro, e MEDIDO deu
// QUATRO colunas a 1920 — a SPA teto em três, e o teto é medida de leitura, não
// gosto (ALE-170). O `max()` no piso é o que o impõe. Se eu não tivesse medido
// as quatro larguras, o teto teria sumido no porte sem ninguém notar.
templ resultadosDoAcervo(v catalogosView) {
	if v.Achados == 0 {
		<p class="p-4 text-center text-xs text-muted-foreground">Nada nos catálogos casa com essa busca.</p>
	} else {
		@ui.ScrollBox("Resultados dos catálogos", "space-y-4 rounded-sm border border-grimorio-iron p-2") {
			for _, g := range v.Grupos {
				<section aria-label={ g.Rotulo }>
					if v.Buscando() {
						// O cabeçalho de grupo só existe na busca unificada: sem
						// termo há um catálogo só na tela, e nomeá-lo duas vezes
						// (na aba e aqui) é repetição.
						@ui.SectionLabel("gold", "mb-1.5") {
							{ fmt.Sprintf("%s · %d", g.Rotulo, g.Quantos()) }
						}
					}
					<div class="acervo-em-colunas">
						for _, c := range g.Condicoes {
							@cartaoDeCondicao(c, v.Livro)
						}
						for _, m := range g.Magias {
							@cartaoDeMagia(m, v.Livro)
						}
						for _, p := range g.Poderes {
							@cartaoDePoder(p, v.Livro)
						}
						for _, i := range g.Itens {
							@cartaoDeItem(i, v.Livro)
						}
						for _, e := range g.Efeitos {
							@cartaoDeEfeito(e, v.Livro)
						}
						for _, e := range g.Escolas {
							@cartaoDeEscola(e, v.Livro)
						}
						for _, p := range g.Pericias {
							@cartaoDePericia(p, v.Livro)
						}
						for _, r := range g.Racas {
							@cartaoDeRaca(r, v.Livro)
						}
						for _, c := range g.Classes {
							@cartaoDeClasse(c, v.Livro)
						}
						for _, d := range g.Deuses {
							@cartaoDeDeus(d, v.Livro)
						}
					</div>
				</section>
			}
		}
	}
}

// ── os quatro cartões ────────────────────────────────────────────────────────

// A classe `cartao-do-acervo` é ANCORAGEM e não estilo: dentro da caixa do elo o
// cartão perde a moldura, porque lá a caixa já é a moldura — duas bordas
// concêntricas com três milímetros entre elas, que foi o que o dono viu. A regra
// vive no `piloto.src.css`, fora de `@layer`.
//
// `wrap-anywhere` (`overflow-wrap: anywhere`) no CARTÃO, e é conserto de um
// defeito que o dono viu na tela: a magia "Sopro da Salvação" lista as condições
// que remove como UM token sem espaço —
// `(abalado/atordoado/apavorado/…)`, 100 caracteres — e a BARRA não é
// oportunidade de quebra para o navegador. Medido: 1.343px de conteúdo numa
// coluna de 540px, pintando por cima dos cartões vizinhos.
//
// `anywhere` e não `break-word`: os cartões vivem numa grade, e só o `anywhere`
// entra na conta do tamanho MÍNIMO do conteúdo. Com `break-word` a coluna ainda
// pediria a largura do token inteiro.
//
// No cartão e não em cada descrição: são oito abas, e a nona nasce protegida.
templ cartaoDoAcervo() {
	<div class="cartao-do-acervo wrap-anywhere rounded-sm border border-grimorio-iron p-2.5 text-sm">
		{ children... }
	</div>
}

templ cartaoDeCondicao(c book.Condition, livro enderecoDoLivro) {
	@cartaoDoAcervo() {
		<p class="flex flex-wrap items-center gap-1.5 font-medium">
			{ c.Name }
			@seloDaPagina(livro, c.BookPage, c.Name)
		</p>
		<p class="mt-1 text-muted-foreground">
			// A descrição CITA outras condições ("Desprevenido e imóvel"), e são
			// 11 citações nas 35 — a densidade que justifica varrer o texto.
			for _, pedaco := range book.WithConditionLinks(c.Description, c.Name) {
				@pedacoDoTexto(pedaco, livro)
			}
			// O TIPO DE EFEITO fecha a descrição, em itálico, exatamente onde o
			// livro o imprime: "Abalado. O personagem sofre –2 … *Medo.*".
			//
			// Ele estava colado no NOME, e o dono leu "Abalado Medo" como se as
			// duas palavras fossem o mesmo verbete. Depois da explicação, e como
			// elo, ele se anuncia pelo que é: outro conceito, com página própria.
			for _, t := range c.Tags {
				{ " " }
				// `<em>` com o itálico do livro: ele é o que separa o TIPO da
				// frase que acabou de terminar, e é o desenho que o mestre já
				// conhece da página impressa.
				<em>
					@eloParaOAcervo("efeitos", t, book.EffectName(t)) {
						{ book.EffectName(t) + "." }
					}
				</em>
			}
		</p>
		if c.UpgradesTo != "" {
			<p class="mt-1 text-xs text-muted-foreground">
				Agrava para 
				@eloParaOAcervo("condicoes", c.UpgradesTo, book.ConditionName(c.UpgradesTo)) {
					{ book.ConditionName(c.UpgradesTo) }
				}
			</p>
		}
	}
}

// O cartão da PERÍCIA (ALE-264).
//
// As duas marcas do livro viram crachá porque elas mudam COMO a perícia se usa —
// "só treinada" decide se dá para rolar, e a penalidade decide se a armadura
// atrapalha. Ficam ao lado do atributo, que é a terceira coisa que se olha antes
// de rolar.
//
// "Treinada por" são só as classes que a treinam DE SAÍDA. Ver o comentário do
// carregador: a piscina de escolha tem quase tudo em quase toda classe.
templ cartaoDePericia(p book.Expertise, livro enderecoDoLivro) {
	@cartaoDoAcervo() {
		<p class="flex flex-wrap items-center gap-1.5 font-medium">
			{ p.Name }
			<span class="rounded-sm border border-grimorio-iron px-1.5 font-mono text-3xs text-muted-foreground">{ book.AttributeAbbrev(p.Attribute) }</span>
			if p.SoTreinada {
				<span class="rounded-sm border border-grimorio-iron px-1.5 text-3xs text-muted-foreground">Só treinada</span>
			}
			if p.PenalidadeDeArmadura {
				<span class="rounded-sm border border-grimorio-iron px-1.5 text-3xs text-muted-foreground">Penalidade de armadura</span>
			}
			@seloDaPagina(livro, p.BookPage, p.Name)
		</p>
		if len(p.Classes) > 0 {
			<p class="mt-1 text-xs text-muted-foreground">
				Treinada de saída por: 
				for i, classe := range p.Classes {
					if i > 0 {
						{ ", " }
					}
					@eloParaOAcervo("classes", book.KeyOfName(classe), classe) {
						{ classe }
					}
				}
			</p>
		}
	}
}

// O cartão da ESCOLA DE MAGIA (ALE-264): o destino dos elos que saem das magias.
//
// A ABREVIATURA fica ao lado do nome porque é o que as tabelas do livro imprimem
// — quem lê "Evoc" numa ficha precisa poder achar aqui. Ilusão não tem, e o
// crachá simplesmente não sai.
templ cartaoDeEscola(e book.SpellSchool, livro enderecoDoLivro) {
	@cartaoDoAcervo() {
		<p class="flex flex-wrap items-center gap-1.5 font-medium">
			{ e.Name }
			if e.Abrev != "" {
				<span class="rounded-sm border border-grimorio-iron px-1.5 text-3xs text-muted-foreground">{ e.Abrev }</span>
			}
			@seloDaPagina(livro, e.BookPage, e.Name)
		</p>
		<p class="mt-1 text-muted-foreground">
			for _, pedaco := range book.WithLinks(e.Description) {
				@pedacoDoTexto(pedaco, livro)
			}
		</p>
	}
}

// O cartão do TIPO DE EFEITO (ALE-264). Ele é o destino dos elos que saem das
// condições, e o livro o define em uma frase na p228.
templ cartaoDeEfeito(e book.EffectKind, livro enderecoDoLivro) {
	@cartaoDoAcervo() {
		<p class="flex flex-wrap items-center gap-1.5 font-medium">
			{ e.Name }
			@seloDaPagina(livro, e.BookPage, e.Name)
		</p>
		<p class="mt-1 text-muted-foreground">
			for _, pedaco := range book.WithLinks(e.Description) {
				@pedacoDoTexto(pedaco, livro)
			}
		</p>
	}
}

templ cartaoDeMagia(m book.Spell, livro enderecoDoLivro) {
	@cartaoDoAcervo() {
		<p class="flex flex-wrap items-center gap-1.5 font-medium">
			{ m.Name }
			<span class="rounded-sm border border-grimorio-iron px-1.5 text-3xs text-muted-foreground">
				{ fmt.Sprintf("%dº círculo", m.Circle) }
			</span>
			// A ESCOLA passou a aparecer no cartão, e como ELO (ALE-264): ela
			// decidia o filtro e não estava escrita em lugar nenhum — o mestre
			// filtrava por evocação e as magias não diziam que eram de evocação.
			@eloParaOAcervo("escolas", m.School, book.SchoolName(m.School)) {
				{ book.SchoolName(m.School) }
			}
			@seloDaPagina(livro, m.BookPage, m.Name)
		</p>
		<p class="mt-1 flex flex-wrap gap-x-3 gap-y-0.5 text-xs text-muted-foreground">
			<span>{ "Execução: " + book.CastingName(m.Execution) }</span>
			<span>{ "Alcance: " + book.RangeName(m.Range) }</span>
			<span>{ "Duração: " + m.Duration }</span>
			if m.Resistance != "" {
				<span>{ "Resistência: " + m.Resistance }</span>
			}
		</p>
		<p class="mt-1 text-muted-foreground">
			for _, pedaco := range book.WithLinks(m.BaseEffect) {
				@pedacoDoTexto(pedaco, livro)
			}
		</p>
		// Os APRIMORAMENTOS abrem numa caixa (ALE-264): eram uma CONTAGEM
		// ("3 aprimoramentos disponíveis"), que diz que existe algo e não deixa
		// lê-lo. São três a cinco linhas por magia — no cartão, empurrariam a
		// lista inteira para baixo; na caixa, aparecem quando se pergunta.
		if len(m.Augments) > 0 {
			<button
				type="button"
				data-nav-skip
				data-on:click={ abreOsAprimoramentos(m.ID) }
				class="mt-1 rounded-sm text-left text-xs text-muted-foreground underline decoration-dotted underline-offset-2 outline-none transition-colors hover:text-grimorio-gold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
			>{ aprimoramentosEscritos(len(m.Augments)) }</button>
		}
	}
}

templ cartaoDePoder(p book.Power, livro enderecoDoLivro) {
	@cartaoDoAcervo() {
		<p class="flex flex-wrap items-center gap-1.5 font-medium">
			{ p.Name }
			<span class="rounded-sm border border-grimorio-iron px-1.5 text-3xs text-muted-foreground">{ p.Fonte }</span>
			@seloDaPagina(livro, p.BookPage, p.Name)
		</p>
		<p class="mt-1 text-muted-foreground">
			for _, pedaco := range book.WithLinks(p.Description) {
				@pedacoDoTexto(pedaco, livro)
			}
		</p>
	}
}

templ cartaoDeItem(i book.Item, livro enderecoDoLivro) {
	@cartaoDoAcervo() {
		<p class="flex flex-wrap items-center gap-1.5 font-medium">
			{ i.Name }
			<span class="rounded-sm border border-grimorio-iron px-1.5 text-3xs text-muted-foreground">{ book.CategoryName(i.Category) }</span>
			@seloDaPagina(livro, i.BookPage, i.Name)
		</p>
		<p class="mt-1 flex flex-wrap gap-x-3 text-xs text-muted-foreground">
			<span>{ "Preço: " + precoEscrito(i.Price) }</span>
			<span>{ fmt.Sprintf("Espaços: %s", espacosEscritos(i.Slots)) }</span>
		</p>
	}
}

// ── os três cartões do personagem (ALE-264) ─────────────────────────────────

// O cartão da RAÇA diz o que muda numa ficha: os modificadores, o tamanho, o
// deslocamento e a visão. As habilidades vêm com o resumo de uma linha que o
// catálogo já guarda — o texto inteiro está no livro, a um clique de distância.
templ cartaoDeRaca(r book.Race, livro enderecoDoLivro) {
	@cartaoDoAcervo() {
		<p class="flex flex-wrap items-center gap-1.5 font-medium">
			{ r.Name }
			<span class="rounded-sm border border-grimorio-iron px-1.5 text-3xs text-muted-foreground">{ r.AttributeMod.Escrito() }</span>
			@seloDaPagina(livro, r.BookPage, r.Name)
		</p>
		<p class="mt-1 flex flex-wrap gap-x-3 text-xs text-muted-foreground">
			<span>{ book.TierName(r.Tier) }</span>
			<span>{ r.Tamanho }</span>
			<span>{ fmt.Sprintf("Deslocamento: %dm", r.Deslocamento) }</span>
			if r.VisaoNoEscuro {
				<span>Visão no escuro</span>
			} else if r.VisaoNaPenumbra {
				<span>Visão na penumbra</span>
			}
		</p>
		for _, h := range r.Abilities {
			<p class="mt-1 text-xs text-muted-foreground">
				<span class="font-medium text-foreground">{ h.Name }</span>
				{ " · " + h.Summary }
			</p>
		}
	}
}

// O cartão da CLASSE mostra só o que se DERIVA do repositório — ver o cabeçalho
// de `piloto_catalogos_do_personagem.go`. É pouco de propósito: o bloco da
// classe é uma tabela de vinte níveis, e transcrevê-la à mão seria a fonte de
// erro que esta issue inteira existe para evitar.
templ cartaoDeClasse(c book.Class, livro enderecoDoLivro) {
	@cartaoDoAcervo() {
		<p class="flex flex-wrap items-center gap-1.5 font-medium">
			{ c.Name }
			@seloDaPagina(livro, c.BookPage, c.Name)
		</p>
		<p class="mt-1 flex flex-wrap gap-x-3 text-xs text-muted-foreground">
			<span>{ fmt.Sprintf("%d poderes de classe", c.Poderes) }</span>
			// As perícias treinadas viram ELOS: a classe cita a perícia, e
			// citação sem destino é texto morto — o mesmo que valia para o
			// poder concedido do deus.
			if len(c.Pericias) > 0 {
				<span>
					Treinado em: 
					for i, pericia := range c.Pericias {
						if i > 0 {
							{ ", " }
						}
						@eloParaOAcervo("pericias", book.KeyOfName(pericia), pericia) {
							{ pericia }
						}
					}
				</span>
			}
			if c.Escolhe > 0 {
				<span>{ fmt.Sprintf("+ %d à escolha", c.Escolhe) }</span>
			}
		</p>
	}
}

// O cartão do DEUS traz o que o mestre consulta na hora: o que o deus cobra dos
// devotos e o que ele concede. O símbolo e a arma preferida entram porque são o
// que aparece na cena — o clérigo saca a arma preferida, o símbolo está no altar.
templ cartaoDeDeus(d book.God, livro enderecoDoLivro) {
	@cartaoDoAcervo() {
		<p class="flex flex-wrap items-center gap-1.5 font-medium">
			{ d.Name }
			// O crachá "Maior/Menor" SAIU: medido, `major` é verdadeiro nos
			// vinte deuses do catálogo, então ele dizia a mesma coisa em todos —
			// tinta gasta para não informar nada. Volta no dia em que o catálogo
			// tiver um deus menor.
			@seloDaPagina(livro, d.BookPage, d.Name)
		</p>
		<p class="mt-1 text-muted-foreground">{ d.Portfolio }</p>
		// Campo VAZIO não vira rótulo órfão: Lena e Marah não têm arma preferida
		// no livro (são deusas de paz e cura), e "Arma preferida:" seguido de
		// nada parece dado perdido em vez de ausência com significado.
		<p class="mt-1 flex flex-wrap gap-x-3 text-xs text-muted-foreground">
			if d.Energia != "" {
				<span>{ "Energia: " + d.Energia }</span>
			}
			if d.Simbolo != "" {
				<span>{ "Símbolo: " + d.Simbolo }</span>
			}
			if d.ArmaPreferida != "" {
				<span>{ "Arma preferida: " + d.ArmaPreferida }</span>
			}
		</p>
		// Concedidos e devotos são LISTAS DE NOMES de coisas que têm verbete —
		// o poder está em Poderes, o devoto é raça ou classe. Cada nome vira o
		// elo dele; o que não tem verbete (o "Quaisquer" de Aharadak) fica texto.
		if len(d.PoderesConcedidos) > 0 {
			<p class="mt-1 text-xs text-muted-foreground">
				Concede: 
				for i, poder := range d.PoderesConcedidos {
					if i > 0 {
						{ ", " }
					}
					if id := idDoPoder(poder); id != "" {
						@eloParaOAcervo("poderes", id, poder) {
							{ poder }
						}
					} else {
						{ poder }
					}
				}
			</p>
		}
		if len(d.Devotos) > 0 {
			<p class="mt-1 text-xs text-muted-foreground">
				Devotos: 
				for i, devoto := range d.Devotos {
					if i > 0 {
						{ ", " }
					}
					if aba, id := book.DevoteeLink(devoto); aba != "" {
						@eloParaOAcervo(aba, id, devoto) {
							{ devoto }
						}
					} else {
						{ devoto }
					}
				}
			</p>
		}
	}
}

// osAprimoramentosDaMagia é a outra coisa que a caixa mostra: o que a magia
// ganha quando se gasta mais mana.
//
// O mesmo id (`#verbete-do-elo`) porque é a mesma caixa — o que muda é o miolo,
// e quem decide é a rota.
templ osAprimoramentosDaMagia(m book.Spell, livro enderecoDoLivro) {
	<div id="verbete-do-elo" class="space-y-2 pr-8">
		<p class="flex flex-wrap items-center gap-1.5 font-medium">
			{ m.Name }
			@seloDaPagina(livro, m.BookPage, m.Name)
		</p>
		<ul class="space-y-1.5">
			for _, a := range m.Augments {
				// GRADE de duas colunas e não uma fileira: o texto do
				// aprimoramento tem três linhas, e numa fileira a segunda linha
				// volta para debaixo do custo. Com a grade, a coluna do texto é
				// uma caixa — tudo o que é texto começa na mesma vertical.
				//
				// `items-baseline` porque o custo é `text-xs` mono e o texto é
				// `text-sm`: alinhados pelo TOPO, o número flutua acima da
				// primeira linha, que foi o que o dono viu.
				<li class="grid grid-cols-[3.5rem_1fr] items-baseline gap-x-3 text-sm">
					// O CUSTO na frente e alinhado à DIREITA: é por ele que o
					// mestre varre a lista ("o que dá para fazer com 2 PM?"), e
					// número em coluna se lê pela unidade.
					<span class="text-right font-mono text-xs text-grimorio-gold">{ a.Escrito() }</span>
					<span class="text-muted-foreground">
						<span class="mr-1 text-3xs uppercase tracking-widest opacity-70">{ book.AugmentKindName(a.Kind) }</span>
						for _, pedaco := range book.WithLinks(a.Description) {
							@pedacoDoTexto(pedaco, livro)
						}
					</span>
				</li>
			}
		</ul>
	</div>
}

// verbeteDoElo é o miolo da caixa: os cartões do grupo, sem a moldura da cena.
//
// Reusa os MESMOS cartões da aba — o verbete tem um desenho só, e um segundo
// desenho "para a caixa" divergiria do primeiro na terceira issue.
templ verbeteDoElo(g grupoDoAcervo, livro enderecoDoLivro) {
	<div id="verbete-do-elo" class="pr-8">
		if g.Quantos() == 0 {
			<p class="text-xs text-muted-foreground">Este book.Entry não está no acervo.</p>
		}
		for _, c := range g.Condicoes {
			@cartaoDeCondicao(c, livro)
		}
		for _, m := range g.Magias {
			@cartaoDeMagia(m, livro)
		}
		for _, p := range g.Poderes {
			@cartaoDePoder(p, livro)
		}
		for _, i := range g.Itens {
			@cartaoDeItem(i, livro)
		}
		for _, e := range g.Efeitos {
			@cartaoDeEfeito(e, livro)
		}
		for _, r := range g.Racas {
			@cartaoDeRaca(r, livro)
		}
		for _, c := range g.Classes {
			@cartaoDeClasse(c, livro)
		}
		for _, d := range g.Deuses {
			@cartaoDeDeus(d, livro)
		}
	</div>
}

// filtrosDoAcervo são as linhas de crachá do catálogo da cena (ALE-264).
//
// Mesmo desenho dos tipos do bestiário — crachá que liga e desliga —, porque o
// mestre já aprendeu esse gesto lá. `fieldset` porque é conjunto de escolhas.
//
// O rótulo da linha é VISÍVEL aqui, e no bestiário ele é `sr-only`: lá há uma
// linha só e o contexto basta; aqui são até três, e sem o rótulo ninguém sabe
// se "Evocação" é escola ou classe.
templ filtrosDoAcervo(v catalogosView) {
	<div class="flex shrink-0 flex-col gap-1.5">
		for _, f := range v.Filtros {
			<fieldset class="flex flex-wrap items-center gap-1.5 border-0 p-0">
				<legend class="sr-only">{ "Filtrar por " + f.Rotulo }</legend>
				<span aria-hidden="true" class="w-24 shrink-0 font-heading text-3xs uppercase tracking-[0.14em] text-muted-foreground">
					{ f.Rotulo }
				</span>
				for _, o := range f.Opcoes {
					// `aria-pressed` com a STRING e não com booleano: o Datastar
					// trata valor booleano como atributo de PRESENÇA, e um
					// `aria-pressed=""` não anuncia estado nenhum.
					<button
						type="button"
						aria-pressed={ boolTexto(v.crachaAceso(f.Chave, o.Valor)) }
						data-on:click={ alternaOCracha(v.Aba, f.Chave, o.Valor) }
						if v.crachaAceso(f.Chave, o.Valor) {
							class="min-h-11 rounded-sm border border-grimorio-gold bg-accent px-2 py-0.5 text-2xs font-medium text-grimorio-gold transition-colors outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
						} else {
							class="min-h-11 rounded-sm border border-grimorio-iron px-2 py-0.5 text-2xs text-muted-foreground transition-colors outline-none hover:bg-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
						}
					>{ o.Rotulo }</button>
				}
			</fieldset>
		}
	</div>
}

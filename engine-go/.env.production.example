# Ambiente de PRODUÇÃO — molde. Copie e edite:
#
#   cp engine-go/.env.production.example engine-go/.env.production
#   openssl rand -hex 32        # cole o resultado no JWT_SECRET
#   pnpm start
#
# O `.env.production` NÃO é versionado (contém o segredo real da sua mesa).
# Produção aqui é UM binário servindo as CENAS, a API e o fluxo ao vivo na mesma
# porta, rodando na sua máquina e acessado pelos jogadores na LAN (ALE-119).

PORT=3001

# Banco PRÓPRIO: produção não compartilha dados com o `t20-dev.db`.
# O diretório é criado no primeiro boot; `pnpm db:backup` copia daqui.
DATABASE_URL=file:./data/t20-prod.db

# OBRIGATÓRIO. O servidor recusa subir se estiver vazio ou se for o segredo
# público de desenvolvimento — quem assina o token é dono de qualquer conta.
JWT_SECRET=

JWT_EXPIRES_IN=7d

# OBRIGATÓRIO (o servidor recusa subir sem). Quem administra a mesa: só estes
# e-mails criam convite, e só eles criam a própria conta sem um. Sem admin,
# ninguém consegue convidar ninguém e o servidor fica trancado por fora.
ADMIN_EMAILS=
COOKIE_NAME=t20_session

# Só ligue com HTTPS na frente. Em HTTP na LAN o browser DESCARTA um cookie
# Secure e o login não conclui — sem erro visível, a tela só volta pro início.
COOKIE_SECURE=false

# Vazio = sem CORS, que é o certo nos DOIS ambientes: as cenas são servidas por
# este mesmo processo, então toda chamada é mesma-origem e nenhum outro site
# precisa de acesso (ALE-321 tirou o valor de fábrica que o desenvolvimento
# ainda tinha, herdado da SPA no Vite).
#
# Isto vale para a mesa na LAN também: quem abre `http://192.168.0.10:3001` no
# celular manda essa origem e ela bate com o Host do próprio pedido, então
# passa. NÃO liste o IP da rede aqui — declarar origens faz o guarda passar a
# exigir a lista, e aí é a máquina de fora que fica de fora (ALE-185).
CORS_ORIGIN=

# Onde a tela de admin e o `pnpm db:backup` escrevem. Fora do repositório se
# você quiser os backups em outro disco.
BACKUP_DIR=../backups
# Backup automático (ALE-157). Zero em qualquer um dos dois desliga.
BACKUP_EVERY=24h
BACKUP_KEEP=7

CATALOG_PATH=parity/_catalogs.json

# HTTPS servido por ESTE processo (ALE-118) — é o que destrava instalar o app de
# verdade no telefone, porque nada de PWA vale fora de contexto seguro.
#
# Vazios = HTTP puro. O par tem de estar INTEIRO: com só um dos dois o servidor
# RECUSA subir. Cair para HTTP em silêncio seria pior — quem escreve meio par
# liga o COOKIE_SECURE junto, o navegador descarta o cookie de sessão, e o login
# não conclui sem erro em lugar nenhum.
#
# Ligando aqui, ligue COOKIE_SECURE=true acima e avise a mesa que o endereço
# passou a ser `https://` — o log já imprime assim, e um `http://` na mesma
# porta responde 400.
#
# QUAL certificado usar na LAN é decisão em aberto (ALE-118) e o README explica
# as duas saídas: mkcert com a CA instalada em cada aparelho, ou um domínio seu
# com Let's Encrypt por DNS-01 apontando para o IP privado. Terminar o TLS fora
# (um túnel, um proxy) também funciona: deixe estes dois VAZIOS e mantenha o
# COOKIE_SECURE ligado.
TLS_CERT_FILE=
TLS_KEY_FILE=

# Aqui morava o `STATIC_DIR=../frontend/dist`, que apontava o `dist` da SPA para
# este processo servir. A SPA saiu na ALE-272 e o `spaHandler` que lia a variável
# foi apagado junto; os estáticos de hoje viajam DENTRO do binário, por `go:embed`
# (ALE-321).

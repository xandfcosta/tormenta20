package ui

// A CASCA da cena, portada da `SceneShell` da SPA (ALE-219, agora em templ pela
// ALE-227).
//
// Ela nasceu de uma observação do dono olhando as duas telas do piloto: "existe
// um padding lateral, estamos usando o padrão de Shell do SolidJS?". Não
// estávamos — eu tinha escrito `mx-auto max-w-3xl p-3 sm:p-4` numa e
// `max-w-5xl` na outra, inventando duas. Medido, faltavam CINCO coisas, e só
// uma era o padding:
//
//  1. `.scene-grimorio` — é o ESCOPO dos tokens, e o `@custom-variant dark` da
//     casa dispara nele. Sem a classe, todo utilitário `dark:` das telas
//     silenciosamente não faz nada.
//  2. A textura de fundo e a vinheta, que são a identidade visual da cena.
//  3. `h-dvh` com overflow interno. A premissa do app é tela cheia com o
//     CONTEÚDO rolando, não o documento; sem isso a página rola por fora e a
//     faixa fixa da Mesa passa a competir com a barra do navegador.
//  4. `env(safe-area-inset-*)`. O `viewport-fit=cover` já estava no `<head>`,
//     mas sem `env()` ele só serve para o conteúdo entrar DEBAIXO do notch.
//  5. A escala de espaçamento da casa (`px-4 py-4` no denso), em vez da minha.
//
// Fica registrado como o TERCEIRO achado estrutural do piloto, depois da
// biblioteca de componentes e da faixa de teste: a casca também não atravessa
// sozinha, e é o que faz duas telas individualmente corretas parecerem de dois
// aplicativos.

// paginaPiloto é o que a casca precisa saber para montar o `<head>` e o
// `<body>` em volta de um corpo.
//
// O corpo NÃO viaja aqui: ele entra como `templ.Component`, e é essa a
// diferença que a ALE-227 comprou. Antes ele chegava como `template.HTML` —
// uma string já renderizada com a anotação "confie em mim" — porque o
// `html/template` não sabe invocar um sub-template por nome dinâmico. Render em
// duas passadas era a saída, e cada passada era uma chance de escapar errado.
type Page struct {
	// Asset monta o endereço VERSIONADO de um estático, e é injetado porque os
	// arquivos são embutidos noutro pacote. Escrever o caminho à mão continua
	// funcionando e é servido SEM cache — a página volta a piscar, em silêncio.
	Asset func(arquivo string) string
	// Overlays são os diálogos que vivem na casca e aparecem por cima de
	// qualquer cena: o livro, o verbete, o buscador. A casca NÃO os conhece — ela
	// só reserva o lugar —, porque os três leem catálogo e o pacote de
	// apresentação não pode.
	Overlays []templ.Component
	// Titulo é sempre o do `<title>`. O que aparece na TELA depende da Forma.
	Titulo string
	Forma  ShellShape
	// TituloVisivel e Voltar são da casca DENSA; Kicker é da casca TÍTULO.
	TituloVisivel string
	Voltar        string
	// SemEstadoDeCliente marca a superfície que não pode ter sinal NEM `data-init`
	// — hoje só a PORTA. Um sinal é estado do cliente e o Datastar o serializa em
	// TODA requisição seguinte, então qualquer estado ali faria a senha viajar de
	// novo a cada pedido da página. É o que o `TestTheDoorPutsNothingInADatastarSignal`
	// cobra, e ele me pegou: ao fazer o `data-init` da restauração de foco sair
	// sempre, eu o pus também na porta, que não tem trilho para restaurar.
	//
	// Campo EXPLÍCITO e não inferido da forma da casca: `cascaTitulo` descreve o
	// desenho, e amarrar uma regra de segurança a um nome de leiaute é a regra
	// sumindo no dia em que alguém usar a mesma casca noutra tela.
	SemEstadoDeCliente bool
	Kicker        string
	Sinais        string
	Init          string
	// Scripts são os módulos EXTRA de UMA cena. O `cena.js` vale para toda
	// página; estes são para o que é de uma só — hoje a folha de especificação,
	// que mede o desenho com canvas e `getComputedStyle` e ainda monta as peças
	// da SPA como elementos customizados (ALE-251). Somam ~77 KB, e carregá-los
	// em toda cena seria pôr o custo de uma tela de quem CONSTRÓI no caminho de
	// quem só quer jogar.
	Scripts []string
	// VoltarRotulo troca o "Voltar" por um destino NOMEADO. A folha de
	// especificação diz "Hub" porque é para lá que ela volta, e nomear o
	// destino é melhor que a seta genérica quando a cena não é filha óbvia de
	// ninguém.
	VoltarRotulo string
}

// formaDaCasca são as três posturas do `SceneShell` da SPA, e elas se excluem —
// um campo em vez de dois títulos opcionais, porque "TituloVisivel vazio E
// TituloDaCena cheio" é um estado que não deveria ser representável.
type ShellShape string

const (
	// cascaNua não desenha cabeçalho nenhum e não dá padding: a tela decide
	// tudo. É o que a Mesa usa, porque a faixa AO VIVO dela já é o cabeçalho e
	// duas fileiras de cromo tirariam o palco do combate.
	ShellBare ShellShape = ""
	// cascaDensa é o cabeçalho compacto das telas de conteúdo: voltar + título
	// pequeno, `px-4 py-4`.
	ShellDense ShellShape = "densa"
	// cascaTitulo é a TELA-TÍTULO — o nome do jogo em Cinzel grande e
	// centralizado, sem link de voltar, `px-5 py-14`. É a forma do Hub, e é a
	// da PORTA (ALE-229): quem está fora não tem para onde voltar.
	ShellTitled ShellShape = "titulo"
)

templ Layout(p Page, corpo templ.Component) {
	<!DOCTYPE html>
	<html lang="pt-BR">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"/>
			<title>{ p.Titulo }</title>
			<link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
			<link rel="stylesheet" href={ p.Asset("piloto.css") }/>
			<script type="module" src={ p.Asset("datastar.js") }></script>
			// `cena.js` é o teclado, os cues de áudio e o posicionamento do
			// popover — compilado dos MESMOS fontes que a SPA usa (ALE-231), não
			// de uma cópia. Vale para toda página do Datastar, e é `defer` por ser
			// módulo: ele consulta o DOM ao carregar.
			<script type="module" src={ p.Asset("cena.js") }></script>
			for _, modulo := range p.Scripts {
				<script type="module" src={ modulo }></script>
			}
		</head>
		// Os SINAIS e o `data-init` moram no <body>, que nunca é remendado.
		//
		// Não é arrumação: `data-init` dispara quando o atributo entra no DOM,
		// então dentro de um fragmento cada remendo o traria de volta e abriria
		// um segundo SSE a cada tique. E `data-signals` reinicializaria o que o
		// jogador está digitando, uma vez por tique.
		// O `data-init` sai SEMPRE, porque a restauração do foco do trilho vale
		// para toda cena; o que a página pediu vem depois, no mesmo atributo.
		// Dois `data-init` no mesmo nó não somam — o segundo substitui —, e foi
		// por isso que a restauração não virou um atributo próprio.
		<body
			class="antialiased"
			if p.Sinais != "" {
				data-signals={ p.Sinais }
			}
			if !p.SemEstadoDeCliente {
				if p.Init != "" {
					data-init={ RestoreRailFocus + "; " + p.Init }
				} else {
					data-init={ RestoreRailFocus }
				}
			}
		>
			// Os `data-slot` são o CONTRATO OBSERVÁVEL que a SPA publica, e não
			// enfeite: o e2e da porta lê `[data-slot=scene-shell]` para conferir
			// que os tokens resolvem a paleta da mesa e não o tema claro do
			// template. Sem eles a virada quebraria um guarda que continua válido
			// — a pergunta que ele faz não mudou, só o motor que desenha (ALE-229).
			// `data-voltar` é o que o Esc LÊ para saber para onde subir, e ele
			// nunca era emitido: o `p.Voltar` alimentava só o link visível de
			// voltar, então o driver procurava um atributo que ninguém escrevia e
			// o Esc estava morto em TODAS as cenas do piloto. Medido antes de
			// escrever a legenda de teclado, que por isso não o anuncia.
			//
			// Emitido AQUI, na casca, e não em cada cena: uma linha liga o Esc em
			// toda tela que tem para onde voltar, e a tela nova já nasce com ele.
			// Sem valor o atributo não sai, que é o caso do Hub — cena raiz, sem
			// nível acima, e um Esc que não faz nada é melhor que um que salta
			// para lugar nenhum.
			<section
				data-slot="scene-shell"
				data-on:keydown__window={ ShellShortcuts }
				if p.Voltar != "" {
					data-voltar={ p.Voltar }
				}
				class="scene-grimorio relative flex h-dvh flex-col overflow-hidden"
			>
				<div aria-hidden="true" data-slot="background-texture" data-variant="stone" data-vignette="true" class="grimorio-stone grimorio-vignette pointer-events-none absolute inset-0 -z-10"></div>
				if p.Forma == ShellDense {
					<header
						class="relative flex flex-wrap items-center gap-3 border-b border-grimorio-iron px-4 py-3"
						style="padding-top: max(0.75rem, env(safe-area-inset-top))"
					>
						// `min-h-11` é o alvo de toque da casa, e o link é um `<a>` de
						// verdade: a volta é navegação, e um botão com JavaScript
						// perderia o clique do meio, o "abrir em nova aba" e o teclado
						// que o navegador já dá.
						<a
							href={ templ.SafeURL(p.Voltar) }
							class="inline-flex min-h-11 items-center gap-1 px-3 font-heading text-sm tracking-wide text-muted-foreground outline-none transition-colors hover:text-grimorio-gold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
						>
							if p.VoltarRotulo != "" {
								{ "‹ " + p.VoltarRotulo }
							} else {
								‹ Voltar
							}
						</a>
						// Só quando HÁ título: um `<h1>` vazio entra na árvore de
						// acessibilidade como cabeçalho sem nome, e o leitor de
						// tela anuncia "título, nível 1" sobre o nada. A crônica
						// desenha o próprio `h1` com o nome da campanha, e a casca
						// não tem o que dizer por cima disso.
						if p.TituloVisivel != "" {
							<h1 class="font-heading text-xl tracking-wide text-foreground">{ p.TituloVisivel }</h1>
						}
					</header>
				}
				<div
					data-slot="scene-content"
					class={ "relative flex min-h-0 flex-1 flex-col overflow-x-hidden overflow-y-auto",
						templ.KV("px-4 py-4", p.Forma == ShellDense),
						templ.KV("px-5 py-14", p.Forma == ShellTitled) }
				>
					if p.Forma == ShellTitled {
						@SceneTitle(p.Titulo, p.Kicker)
					}
					@corpo
				</div>
				// O BUSCADOR (ALE-264) é desenhado por último e fora do que rola:
				// `<dialog>` nativo vai para a camada de topo do navegador, então
				// onde ele está no documento não muda onde ele aparece — mas
				// dentro do `overflow-y-auto` ele entraria na conta da rolagem.
				//
				// Não sai na PORTA: a caixa liga um sinal (`data-bind:buscador`),
				// e sinal é estado de cliente que o Datastar serializa em toda
				// requisição seguinte — o que faria a senha viajar de novo a cada
				// pedido. É o que o `TestTheDoorPutsNothingInADatastarSignal` cobra.
				if !p.SemEstadoDeCliente {
					for _, sobreposicao := range p.Overlays {
			@sobreposicao
		}
					// O livro por cima da cena (ALE-264). Nasce vazio: sem `src`
					// no `<iframe>`, quem nunca abre o livro não paga um byte do
					// pdf.js. Fora da porta pela mesma razão do buscador.
								// E a caixa do VERBETE citado por um elo. Mesma razão de
					// estar aqui: a cena dos catálogos é remendada a cada tecla
					// da busca, e o diálogo perderia o conteúdo junto.
							}
			</section>
		</body>
	</html>
}

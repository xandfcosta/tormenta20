package sheetui

import (
	"fmt"
	"strconv"
	"t20engine/web/ui"
)

// O painel de EFEITOS desenhado (ALE-272, fatia 5).
//
// Quatro blocos, e a ordem é a da SPA — condições primeiro porque são as que a
// mesa aplica no meio de um turno, e situação por último porque é o que se
// configura uma vez e se esquece.
//
// # Os componentes deste arquivo são nomeados em INGLÊS
//
// Decisão do dono nesta fatia: componente `templ` é função, e função é
// identificador. Os vizinhos das fatias 2 a 4 (`proficiencyPanel`,
// `combatPanel`, `expertisePanel`) ficam como estão — o guia manda o
// nome que se ESCREVE seguir a regra e o que se CHAMA seguir o que está lá, e
// varrer o que já existe apagaria a procedência de cada linha por estética.

// effectsPanelSection é a seção inteira.
templ effectsPanelSection(v View) {
	<section class="flex min-h-0 flex-1 flex-col">
		<div class="flex shrink-0 items-center gap-2 border-b border-grimorio-iron px-3 py-2 sm:px-4">
			<h2 class="font-heading text-sm uppercase tracking-[0.18em] text-muted-foreground">Efeitos</h2>
			if v.Effects.Count > 0 {
				// O par de tinta é o da casa (`CountBadge`): `bg-primary` é o
				// ouro do grimório e `text-primary-foreground` é a tinta que se
				// lê sobre ele. Aqui morava um `text-grimorio-ink` INVENTADO —
				// token que não existe não vira regra na folha, e o número saiu
				// dourado sobre dourado. Ver `TestEveryHouseTintExistsInTheStylesheet`.
				<span aria-hidden="true" class="rounded-full bg-primary px-1.5 text-3xs font-bold text-primary-foreground">
					{ strconv.Itoa(v.Effects.Count) }
				</span>
				// A pílula é decorativa e quem carrega o sentido é esta linha:
				// um "1" solto é lido como "1", e o número sozinho não diz de quê.
				<span class="sr-only">{ activeWrittenEffects(v.Effects.Count) }</span>
			}
		</div>
		<div class="flex min-h-0 flex-1 flex-col gap-3 overflow-y-auto p-3 sm:p-4">
			@bookConditionsBlock(v)
			@stancesBlock(v)
			@appliedEffectsBlock(v)
			@situationalBlock(v)
		</div>
	</section>
	for _, linha := range v.Effects.Applied {
		@appliedEffectDetail(linha)
	}
	for _, linha := range v.Effects.Situational {
		@situationalDetail(linha)
	}
	@conditionPickerDialog(v)
	@buffPickerDialog(v)
}

// bookConditionsBlock são as condições do livro em vigor (p394-395).
//
// Elas MOVEM os números, e o texto do efeito fica na própria linha em vez de
// atrás de um toque: uma condição que fosse só crachá foi o defeito da ALE-28, e
// dizer o que ela faz é o que impede a mesa de tratá-la como decoração.
templ bookConditionsBlock(v View) {
	<section class="rounded-none border border-grimorio-iron p-3">
		<div class="flex flex-wrap items-center justify-between gap-2">
			<h3 class="font-heading text-sm uppercase tracking-[0.18em] text-muted-foreground">Condições (p394)</h3>
			<button
				type="button"
				aria-label="Aplicar condição"
				data-on:click="$condicao = true"
				class={ ui.ButtonClasses(ui.VariantSecondary, ui.SizeSmall, "") }
			>
				@ui.Icon("Plus", "size-4")
			</button>
		</div>
		if len(v.Effects.Conditions) == 0 {
			<p class="mt-2 text-xs text-muted-foreground">Nenhuma condição ativa.</p>
		} else {
			<ul aria-label="Condições em vigor" class="mt-2 space-y-1">
				for _, linha := range v.Effects.Conditions {
					@bookConditionRow(v, linha)
				}
			</ul>
		}
	</section>
}

templ bookConditionRow(v View, linha conditionRow) {
	<li class="flex items-start gap-2 rounded-sm border border-destructive/40 bg-destructive/5 px-2 py-1.5">
		<div class="min-w-0 flex-1">
			<p class="flex flex-wrap items-baseline gap-1.5 text-sm font-semibold text-foreground">
				{ linha.Name }
				if linha.Page > 0 {
					<span class="font-mono text-3xs text-muted-foreground">{ "p" + strconv.Itoa(linha.Page) }</span>
				}
			</p>
			<p class="text-xs text-muted-foreground">{ linha.Effect }</p>
		</div>
		<button
			type="button"
			aria-label={ "Remover " + linha.Name }
			data-on:click={ sheetPost(v, "/efeitos/condicao/"+linha.Command) }
			class="inline-flex size-8 shrink-0 items-center justify-center rounded-sm text-muted-foreground outline-none transition-colors hover:text-destructive-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
		>
			@ui.Icon("X", "size-3.5")
		</button>
	</li>
}

// stancesBlock são as posturas em curso.
//
// O interruptor de LIGAR não está aqui, e a ausência é decisão de produto da
// SPA: entrar numa postura custa PM, e o PM é cobrado onde o poder mora. Aqui
// elas se leem — com o que cada uma custou — e se encerram.
templ stancesBlock(v View) {
	if len(v.Effects.Stances) > 0 {
		<section class="rounded-none border border-grimorio-iron p-3">
			<h3 class="font-heading text-sm uppercase tracking-[0.18em] text-muted-foreground">Posturas ativas</h3>
			<ul aria-label="Posturas em curso" class="mt-2 space-y-1">
				for _, linha := range v.Effects.Stances {
					<li class="flex items-center gap-2 rounded-sm border border-grimorio-gold/40 bg-grimorio-panel px-2 py-1.5">
						<span class="min-w-0 flex-1 truncate text-sm text-foreground">{ linha.Name }</span>
						if linha.Steps != "" {
							<span class="shrink-0 font-mono text-2xs text-grimorio-gold">{ linha.Steps }</span>
						}
						if linha.Paid != "" {
							<span class="shrink-0 font-mono text-2xs text-muted-foreground">{ linha.Paid }</span>
						}
						<button
							type="button"
							aria-label={ "Encerrar " + linha.Name }
							data-on:click={ sheetPost(v, "/efeitos/postura/"+linha.Command) }
							class={ ui.ButtonClasses(ui.VariantSecondary, ui.SizeSmall, "shrink-0") }
						>Encerrar</button>
					</li>
				}
			</ul>
		</section>
	}
}

// appliedEffectsBlock são os consumíveis usados e as magias de bônus aplicadas.
templ appliedEffectsBlock(v View) {
	<section class="rounded-none border border-grimorio-iron p-3">
		<div class="flex flex-wrap items-center justify-between gap-2">
			<h3 class="font-heading text-sm uppercase tracking-[0.18em] text-muted-foreground">Efeitos ativos</h3>
			<button
				type="button"
				aria-label="Aplicar magia"
				data-on:click="$buff = true"
				class={ ui.ButtonClasses(ui.VariantSecondary, ui.SizeSmall, "") }
			>
				@ui.Icon("Plus", "size-4")
			</button>
		</div>
		if len(v.Effects.Applied) == 0 {
			<p class="mt-2 text-xs text-muted-foreground">Nenhum consumível ativo. Use itens consumíveis na Mochila.</p>
		} else {
			<ul aria-label="Efeitos ativos" class="mt-2 space-y-1">
				for _, linha := range v.Effects.Applied {
					<li class="flex items-center gap-2 rounded-sm border border-arcane/40 bg-grimorio-panel px-2 py-1.5">
						<button
							type="button"
							aria-label={ "Detalhar " + linha.Name }
							aria-haspopup="dialog"
							data-on:click={ "$detalhe = 'efeito-" + linha.Command + "'" }
							class="min-w-0 flex-1 truncate text-left text-sm text-foreground outline-none hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
						>{ linha.Name }</button>
						<span class="shrink-0 text-2xs text-muted-foreground">{ linha.Scope }</span>
						<button
							type="button"
							aria-label={ "Encerrar " + linha.Name }
							data-on:click={ sheetPost(v, "/efeitos/encerra/"+linha.Command) }
							class="inline-flex size-8 shrink-0 items-center justify-center rounded-sm text-muted-foreground outline-none transition-colors hover:text-destructive-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
						>
							@ui.Icon("X", "size-3.5")
						</button>
					</li>
				}
			</ul>
		}
	</section>
}

// situationalBlock é o opt-in de contexto, mais as flags que não têm escolha.
templ situationalBlock(v View) {
	if len(v.Effects.Situational) > 0 || len(v.Effects.AlwaysOn) > 0 {
		<section class="space-y-2 rounded-none border border-grimorio-iron p-3">
			<h3 class="font-heading text-sm uppercase tracking-[0.18em] text-muted-foreground">Situação — opt-in por contexto</h3>
			@alwaysOnList(v)
			for _, linha := range v.Effects.Situational {
				@situationalToggle(v, linha)
			}
		</section>
	} else {
		<p class="rounded-none border border-grimorio-iron p-4 text-center text-xs text-muted-foreground">
			Nenhum efeito condicional disponível. Equipe itens com modificadores situacionais para vê-los aqui.
		</p>
	}
}

// alwaysOnList são as flags de item equipado que não se desligam.
//
// Elas aparecem em LEITURA, com cadeado, e a razão é não contradizer: a mesma
// flag produz aviso no cabeçalho da ficha, e um bloco dizendo "nenhum efeito"
// embaixo de um aviso faz a pessoa procurar defeito onde não há.
templ alwaysOnList(v View) {
	if len(v.Effects.AlwaysOn) > 0 {
		<div class="space-y-1">
			<p class="text-3xs font-bold uppercase tracking-widest text-muted-foreground">Sempre ativos (itens equipados)</p>
			<ul class="space-y-1">
				for _, linha := range v.Effects.AlwaysOn {
					<li class="flex items-center gap-2 rounded-sm border border-grimorio-iron bg-muted px-2 py-1.5">
						@ui.Icon("Lock", "size-3.5 shrink-0 text-muted-foreground")
						<span class="min-w-0 flex-1 truncate text-sm text-foreground">{ linha.Label }</span>
						<span class="shrink-0 truncate text-2xs text-muted-foreground">{ linha.Source }</span>
					</li>
				}
			</ul>
		</div>
	}
}

// situationalToggle é um condicional que a pessoa liga quando a situação pede.
templ situationalToggle(v View, linha situationalRow) {
	<div
		class={ "flex items-center gap-2 rounded-sm border px-2 py-1.5",
			templ.KV("border-bonus/50 bg-bonus/10", linha.Active),
			templ.KV("border-grimorio-iron", !linha.Active) }
	>
		<button
			type="button"
			role="switch"
			aria-checked={ fmt.Sprintf("%t", linha.Active) }
			aria-label={ linha.Label }
			data-on:click={ "$situacao = '" + linha.Key + "'; " + sheetPost(v, "/efeitos/situacao") }
			class="flex min-w-0 flex-1 items-center gap-2 text-left outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
		>
			if linha.Active {
				@ui.Icon("Check", "size-3.5 shrink-0 text-bonus-ink")
			} else {
				@ui.Icon("X", "size-3.5 shrink-0 text-muted-foreground")
			}
			<span class="min-w-0 flex-1">
				<span class="block truncate text-sm text-foreground">{ linha.Label }</span>
				<span class="block truncate text-2xs text-muted-foreground">{ linha.Source }</span>
			</span>
		</button>
		if linha.Folded {
			<button
				type="button"
				aria-label={ "Detalhar " + linha.Label }
				aria-haspopup="dialog"
				data-on:click={ "$detalhe = 'situacao-" + linha.Key + "'" }
				class="shrink-0 rounded-full border border-grimorio-iron px-2 py-0.5 text-3xs text-muted-foreground outline-none transition-colors hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
			>{ strconv.Itoa(len(linha.Modifiers)) + " mods" }</button>
		}
	</div>
}

// appliedEffectDetail diz o que um efeito em curso está fazendo.
templ appliedEffectDetail(linha appliedEffectRow) {
	@overlay("efeito-"+linha.Command, linha.Name, "Sparkles", true) {
		<p class="text-xs text-muted-foreground">{ linha.Scope }</p>
		if len(linha.Modifiers) == 0 {
			<p class="text-xs text-muted-foreground">Sem modificadores numéricos.</p>
		} else {
			@breakdownRows(linha.Modifiers)
		}
	}
}

// situationalDetail abre o grupo que liga mais de um modificador de uma vez.
templ situationalDetail(linha situationalRow) {
	if linha.Folded {
		@overlay("situacao-"+linha.Key, linha.Label, "Zap", false) {
			<p class="text-xs text-muted-foreground">{ linha.Source }</p>
			@breakdownRows(linha.Modifiers)
		}
	}
}

// conditionPickerDialog escolhe uma condição do livro para aplicar.
templ conditionPickerDialog(v View) {
	@pickerDialog("condicao", "Aplicar condição", v.Effects.ConditionOptions) {
		for _, opcao := range v.Effects.ConditionOptions {
			<button
				type="button"
				data-on:click={ sheetPost(v, "/efeitos/condicao/"+opcao.Command) + "; $condicao = false" }
				class="block w-full rounded-sm border border-grimorio-iron px-2 py-1.5 text-left outline-none transition-colors hover:bg-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
			>
				<span class="block text-sm text-foreground">{ opcao.Label }</span>
				<span class="block text-2xs text-muted-foreground">{ opcao.Detail }</span>
			</button>
		}
	}
}

// buffPickerDialog escolhe uma magia de bônus para aplicar em si.
//
// Uma magia de bônus NUNCA se aplica sozinha a partir de outro conjurador: quem
// recebe (ou o mestre) escolhe a fonte e aplica aqui. O escopo vem do catálogo.
templ buffPickerDialog(v View) {
	@pickerDialog("buff", "Aplicar magia", v.Effects.BuffOptions) {
		for _, opcao := range v.Effects.BuffOptions {
			<button
				type="button"
				data-on:click={ sheetPost(v, "/efeitos/aplica/"+opcao.Command) + "; $buff = false" }
				class="block w-full rounded-sm border border-grimorio-iron px-2 py-1.5 text-left outline-none transition-colors hover:bg-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
			>
				<span class="block text-sm text-foreground">{ opcao.Label }</span>
				<span class="block text-2xs text-muted-foreground">{ opcao.Detail }</span>
			</button>
		}
	}
}

// pickerDialog é a moldura dos dois escolhedores.
//
// Ela não tem busca, e é medido e não esquecido: são 35 condições e 31 magias
// com efeito aplicável — listas curtas, que cabem numa rolagem sem filtro. A
// virtualização que a SPA usa aqui existe porque lá a lista era do catálogo
// INTEIRO; a regra da casa é virtualizar as LONGAS, e estas não são.
templ pickerDialog(sinal, titulo string, opcoes []pickerOption) {
	<div
		data-show={ "$" + sinal }
		data-on:click={ "evt.target === el && ($" + sinal + " = false)" }
		data-on:keydown__window={ "evt.key === 'Escape' && ($" + sinal + " = false)" }
		class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 p-3 sm:p-4"
	>
		<div
			role="dialog"
			aria-modal="true"
			aria-label={ titulo }
			data-attr:data-expanded={ "$" + sinal }
			class="relative flex max-h-[85vh] w-full flex-col rounded-md border border-grimorio-iron bg-background p-4 sm:max-w-sm"
		>
			<p class="pr-10 font-heading uppercase tracking-wide text-grimorio-gold">{ titulo }</p>
			<button
				type="button"
				aria-label={ "Fechar " + titulo }
				data-on:click={ "$" + sinal + " = false" }
				class="absolute right-2 top-2 flex size-11 items-center justify-center rounded-sm text-lg text-muted-foreground outline-none transition-colors hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
			>×</button>
			if len(opcoes) == 0 {
				<p class="mt-3 text-xs text-muted-foreground">Nada a escolher aqui.</p>
			} else {
				<div class="mt-3 min-h-0 flex-1 space-y-1 overflow-y-auto">
					{ children... }
				</div>
			}
		</div>
	</div>
}

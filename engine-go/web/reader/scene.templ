package reader

import "fmt"

// A CENA DO LEITOR (ALE-264): o livro aberto na página do verbete.
//
// Ela é uma casca NUA e ocupa a tela inteira porque é para LER: cabeçalho de
// cena, trilho e migalhas roubariam altura da página do livro, que é o único
// conteúdo aqui. A barra fina de cima já diz onde se está e como andar.
//
// Todo o estado vive no `<div id="leitor">` como atributos de DADO, e não em
// sinais do Datastar. A razão é que quem lê isto não é o Datastar: é o
// `leitor.js`, um módulo próprio que roda uma vez na carga. Sinal seria estado
// de cliente viajando em toda requisição seguinte para nada.
templ readerScene(v readerView) {
	<div class="flex h-full min-h-0 flex-col">
		// `pr-16` dentro do diálogo: o ✕ que fecha é da MOLDURA, desenhado por
		// cima no canto direito, e sem esta folga ele cobre o "abrir fora" — o
		// dono viu na tela. A barra não pode reservar o espaço sempre: na aba
		// própria não há ✕ nenhum, e o buraco ficaria à toa.
		<div
			class={ "flex flex-wrap items-center gap-2 border-b border-grimorio-iron px-3 py-2",
				templ.KV("pr-16", v.InDialog) }
		>
			if !v.InDialog {
				<a
					href={ templ.SafeURL(v.Back) }
					class="inline-flex min-h-11 items-center px-2 font-heading text-sm tracking-wide text-muted-foreground outline-none transition-colors hover:text-grimorio-gold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
				>‹ Back</a>
			}
			if v.Term != "" {
				<p class="font-heading text-base tracking-wide text-grimorio-gold">{ v.Term }</p>
			}
			<div class="ml-auto flex items-center gap-1">
				@readerButton("anterior", "Página anterior") {
					‹
				}
				<span data-pagina-atual class="min-w-24 text-center font-mono text-xs text-muted-foreground">
					{ fmt.Sprintf("p%d", v.Page) }
				</span>
				@readerButton("proxima", "Próxima página") {
					›
				}
				@readerButton("menos", "Diminuir") {
					−
				}
				@readerButton("mais", "Aumentar") {
					+
				}
				// A SAÍDA para o visualizador do navegador, e ela não é enfeite:
				// este leitor mostra uma página por vez e destaca um termo. Busca,
				// miniaturas e impressão são do visualizador de verdade, e mandar
				// para lá é melhor que reimplementá-lo pela metade.
				<a
					href={ templ.SafeURL(v.PDF) }
					target="_blank"
					rel="noopener"
					class="inline-flex min-h-11 items-center rounded-sm border border-grimorio-iron px-2 text-3xs text-muted-foreground outline-none transition-colors hover:bg-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
				>abrir fora ↗</a>
			</div>
		</div>
		// `overflow-auto` no CONTÊINER e não no documento: a casca do piloto é
		// `h-dvh` com o conteúdo rolando por dentro, e deixar o documento rolar
		// faria a barra de cima sair da tela junto com a página.
		<div
			id="leitor"
			data-livro={ v.PDF }
			data-worker={ v.Worker }
			data-pagina={ fmt.Sprintf("%d", v.Page) }
			data-abertura={ fmt.Sprintf("%d", v.Opening) }
			data-termo={ v.Term }
			class="relative min-h-0 flex-1 overflow-auto p-4"
		>
			<div class="relative mx-auto w-fit">
				// Sem `max-w-full`: a largura é decidida no `leitor.ts` (ver
				// `LARGURA_MAXIMA`), e deixar o CSS encolher o canvas por cima
				// desalinharia as marcas, que são posicionadas na largura que o
				// pdf.js desenhou.
				<canvas class="block shadow-lg"></canvas>
				// As marcas ficam numa camada IRMÃ do canvas e não desenhadas nele:
				// pintar o destaque no bitmap obrigaria a redesenhar a página
				// inteira para tirá-lo, e o texto por baixo continuaria coberto de
				// tinta em vez de realçado.
				<div data-marcas aria-hidden="true" class="pointer-events-none absolute left-0 top-0"></div>
			</div>
		</div>
	</div>
}

// readerButton é o botão quadrado da barra. Um componente porque são quatro, e
// quatro cópias de nove classes divergem na primeira que alguém ajustar.
//
// UMA marca (`data-acao`) e não uma por família: o `leitor.js` procura pelo que
// o botão FAZ, e dois atributos diferentes obrigariam o componente a saber qual
// dos dois escrever — decisão de leiaute virando decisão de comportamento.
templ readerButton(acao, rotulo string) {
	<button
		type="button"
		aria-label={ rotulo }
		title={ rotulo }
		data-acao={ acao }
		disabled
		class="inline-flex size-11 items-center justify-center rounded-sm border border-grimorio-iron text-sm text-muted-foreground outline-none transition-colors hover:bg-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring disabled:cursor-not-allowed disabled:opacity-40"
	>{ children... }</button>
}

package hub

import (
	"fmt"
	"t20engine/serve/web/ds"
	"t20engine/serve/web/ui"
)

// O INÍCIO no sistema Tempestade (ALE-525), pelo mockup aprovado
// `inicio.html`: a marca e o avatar no topo, a saudação, a sessão ao vivo num
// cartão — é o gesto mais comum da noite, e por isso ele vem primeiro —, e os
// três destinos em linhas que dizem o que há dentro de cada um.
templ hub(v hubView) {
	<header class="ds-hub-top">
		<span class="ds-hub-brand"><span class="ds-hub-seal" aria-hidden="true">T20</span>Tormenta 20</span>
		<button type="button" class="ds-hub-me" popovertarget="player-menu" aria-label={ "Menu de " + v.Name }>
			<span class="ds-hub-avatar" aria-hidden="true">{ v.Initial }</span>
		</button>
	</header>
	<div class="ds-hub">
		<div class="ds-hub-hello">
			<h1>{ "Olá, " + v.Name }</h1>
			<p class="ds-row-meta">O que vai ser hoje?</p>
		</div>
		if v.Alive != nil {
			@liveCard(*v.Alive)
		}
		@hubMenu()
	</div>
	@playerMenu(v)
	if v.EhAdmin {
		@inviteDialog()
	}
}

// liveCard é a sessão AO VIVO: qual mesa (a campanha e o número da sessão) e o
// caminho de volta para ela.
templ liveCard(a hubLiveSession) {
	<a class="ds-hub-live" href={ templ.SafeURL(a.Route) }>
		<span class="ds-hub-live-dot" aria-hidden="true"></span>
		<span class="ds-hub-live-body">
			<span class="ds-row-meta">Continuar de onde parou</span>
			<b>{ a.CampaignName }</b>
			<span class="ds-row-meta">{ fmt.Sprintf("Sessão %d · ao vivo agora", a.SessionNumber) }</span>
		</span>
		<span class="ds-button">
			Voltar à mesa
			@ui.Icon("ChevronRight", "ds-icon")
		</span>
	</a>
}

// hubMenu são os três destinos. A frase de cada um diz o que há dentro: a
// palavra sozinha ("Ferramentas do mestre") não dizia que o bestiário mora lá.
templ hubMenu() {
	<nav class="ds-list" aria-label="Menu principal" data-nav-region="menu" data-nav-layout="column">
		@menuItem("Users2", "Meus heróis", "As suas fichas, e a forja de um novo", "/personagens")
		@menuItem("Scroll", "Campanhas", "As mesas que você joga ou mestra", "/campanhas")
		@menuItem("Wand2", "Ferramentas do mestre", "Bestiário, condições, encontros e improviso", "/mestre/bestiario")
	</nav>
}

templ menuItem(icon, label, meta, destination string) {
	<a href={ templ.SafeURL(destination) } class="ds-row ds-hub-row" data-nav-item data-cue-hover data-cue-select>
		<span class="ds-hub-icon" aria-hidden="true">
			@ui.Icon(icon, "ds-icon")
		</span>
		<span class="ds-hub-text">
			<span class="ds-row-title">{ label }</span>
			<span class="ds-row-meta">{ meta }</span>
		</span>
		@ui.Icon("ChevronRight", "ds-icon")
	</a>
}

// playerMenu é o menu do jogador, aberto pelo avatar: um popover nativo, que
// no celular sobe de baixo e no desktop fica preso ao canto. O que muda a
// preferência do aparelho (som, volume, tela cheia) é do `scene.ts`, e o modo
// de cor é o formulário do kit.
//
// O "Configurações" que existia aqui desativado saiu: um item que não faz nada
// é um item a menos de confiança no menu (ALE-525).
templ playerMenu(v hubView) {
	<div
		id="player-menu"
		popover
		data-sheet
		class="ds-hub-menu"
		data-signals="{sound: false, volume: 100, fullscreen: false}"
		data-init="const p = cena.preferencias(); $sound = p.som; $volume = p.volume"
	>
		<div class="ds-hub-menu-head">
			<span class="ds-hub-avatar" data-large aria-hidden="true">{ v.Initial }</span>
			<span class="ds-hub-text">
				<b>{ v.Name }</b>
				if v.Email != "" && v.Email != v.Name {
					<span class="ds-row-meta">{ v.Email }</span>
				}
			</span>
			@ds.IconButton(ds.ButtonGhost, "X", "Fechar o menu", templ.Attributes{"type": "button", "popovertarget": "player-menu", "popovertargetaction": "hide"})
		</div>
		<span class="ds-field-label">Aparência</span>
		@ds.ColorModeSwitch(v.ColorMode, "/")
		<span class="ds-field-label">Som</span>
		@ds.Switch("Efeitos sonoros", false, templ.Attributes{"data-bind:sound": true, "data-on:change": "cena.som()"})
		<label class="ds-hub-volume" data-show="$sound" style="display:none">
			<span class="ds-row-meta">Volume <span data-text="$volume + '%'"></span></span>
			<input type="range" min="0" max="100" data-bind:volume data-on:input="cena.volume($volume)"/>
		</label>
		<button type="button" class="ds-hub-menu-row" data-show="cena.temTelaCheia()" data-on:click="$fullscreen = cena.telaCheia()">
			@ui.Icon("Maximize", "ds-icon")
			<span data-text="$fullscreen ? 'Sair da tela cheia' : 'Tela cheia'">Tela cheia</span>
		</button>
		if v.EhAdmin {
			<span class="ds-field-label">Mesa</span>
			<button type="button" class="ds-hub-menu-row" commandfor="hub-invite" command="show-modal">
				@ui.Icon("UserPlus", "ds-icon")
				<span>Convidar jogador</span>
			</button>
			<a href="/admin" class="ds-hub-menu-row">
				@ui.Icon("ShieldCheck", "ds-icon")
				<span>Administração</span>
			</a>
		}
		<form method="post" action="/sair">
			<button type="submit" class="ds-hub-menu-row" data-danger>
				@ui.Icon("LogOut", "ds-icon")
				<span>Sair</span>
			</button>
		</form>
	</div>
}

// inviteDialog é o convite, no kit: o servidor devolve o link pronto
// (`mintedInvite`), e o gerar de novo é o mesmo gesto.
templ inviteDialog() {
	@ds.Dialog("hub-invite", "Convidar jogador", nil) {
		<p class="ds-help" data-signals="{error: '', copied: false}">Gere um link e envie para quem vai entrar. Ele vale uma vez só, expira em 7 dias, e a pessoa escolhe a própria senha.</p>
		<div id="invite-link"></div>
		<p class="ds-help ds-reg-error" data-show="$error" data-text="$error" style="display:none"></p>
		@ds.Button(ds.ButtonPrimary, templ.Attributes{"type": "button", "data-on:click": "@post('/convites')", "data-indicator:generating": true, "data-attr:disabled": "$generating"}) {
			Gerar convite
		}
	}
}

// mintedInvite é o link cunhado. Só o CAMINHO viaja: quem prefixa a origem é o
// navegador, porque o servidor não sabe por qual endereço a mesa o alcança.
templ mintedInvite(path string) {
	<div id="invite-link" class="ds-hub-invite">
		<input id="invite-url" class="ds-input" readonly aria-label="Link de convite" data-path={ path } data-init="el.value = location.origin + el.dataset.path"/>
		@ds.Button(ds.ButtonSecondary, templ.Attributes{"type": "button", "data-on:click": "navigator.clipboard.writeText(document.getElementById('invite-url').value); $copied = true"}) {
			@ui.Icon("Copy", "ds-icon")
			Copiar
		}
		<p class="ds-help" aria-live="polite" data-show="$copied" style="display:none">Link copiado.</p>
		<p class="ds-help">Cada convite serve para UMA conta. Gere outro para o próximo jogador.</p>
	</div>
}

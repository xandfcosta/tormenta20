package ds

import "t20engine/serve/web/ui"

// AS PEÇAS DE NAVEGAÇÃO do kit: as abas do desktop e a barra de baixo do
// celular, as duas com a troca macia (`SoftNav`) quando a tela sabe trocar só
// a cena, e o menu lateral entre as telas de uma mesma área.

// Tabs é a navegação DENTRO de uma tela, no desktop. No celular a mesma
// navegação é a `BottomNav`.
templ Tabs(label string) {
	<nav class="ds-tabs" aria-label={ label }>
		{ children... }
	</nav>
}

// Tab é uma aba. `attrs` leva o gesto da troca macia (`SoftNav`) quando a
// tela sabe trocar só a cena.
templ Tab(href templ.SafeURL, current bool, attrs templ.Attributes) {
	<a
		href={ href }
		if current {
			aria-current="page"
		}
		{ attrs... }
	>
		{ children... }
	</a>
}

// BottomNav é a barra fixa de baixo, no celular (decisão do dono, ALE-497).
templ BottomNav(label string) {
	<nav class="ds-bottom-nav" aria-label={ label }>
		{ children... }
	</nav>
}

templ BottomNavItem(href templ.SafeURL, icon string, current bool, attrs templ.Attributes) {
	<a
		href={ href }
		if current {
			aria-current="page"
		}
		{ attrs... }
	>
		if icon != "" {
			@ui.Icon(icon, "ds-icon")
		}
		{ children... }
	</a>
}

// SectionNav é a FILEIRA DE SEÇÕES (ver o GLOSSARY): as seções da ficha
// embutida na sessão, com os ícones da barra da ficha solta, numa fileira que
// desliza logo acima da barra da sessão. Os itens são `BottomNavItem`.
templ SectionNav(label string) {
	<nav class="ds-section-nav" aria-label={ label }>
		{ children... }
	</nav>
}

// SideMenu é o menu lateral do desktop: as telas de uma área, em seções. Abaixo do
// desktop ele some, e quem leva às telas é a barra de baixo. `attrs` leva o contrato
// com o driver de teclado, que é de quem usa.
templ SideMenu(label string, attrs templ.Attributes) {
	<nav class="ds-side-menu" aria-label={ label } { attrs... }>
		{ children... }
	</nav>
}

// SideMenuHead é o nome de uma seção. `<p>` e não título: a `<nav>` já tem nome, e as
// seções são separadores visuais dentro dela.
templ SideMenuHead(title string) {
	<p class="ds-list-head">{ title }</p>
}

// SideMenuLink é uma tela do menu. É LINK e não botão: trocar de tela é navegar, e o
// botão perde o clique do meio, o "abrir em nova aba" e o endereço que se cola no
// chat.
templ SideMenuLink(href templ.SafeURL, icon, hint string, current bool, attrs templ.Attributes) {
	<a
		href={ href }
		class="ds-side-menu-link"
		title={ hint }
		if current {
			aria-current="page"
		}
		{ attrs... }
	>
		@ui.Icon(icon, "ds-icon")
		<span>
			{ children... }
		</span>
	</a>
}

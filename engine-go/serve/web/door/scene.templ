package door

import (
	"strings"
	"t20engine/serve/web/ds"
	"t20engine/serve/web/ui"
)

// A PORTA desenhada: entrar, criar conta e redefinir senha, no sistema
// Tempestade (ALE-524), pelo mockup aprovado `porta.html`.
//
// A decisão que governa este arquivo: aqui NÃO se usa sinal do Datastar.
//
// O jeito idiomático seria `data-bind:senha` + `@post`. Um sinal, porém, é
// estado do CLIENTE, e o Datastar serializa os sinais em TODA requisição
// seguinte — pôr uma senha ali é a senha viajando de novo a cada `@get`/`@post`
// da página, para sempre. Então a porta é `<form method="post">` puro, e o olho
// que mostra a senha troca o `type` do campo no próprio navegador.
//
// O que se ganha junto não é consolo: funciona sem JavaScript nenhum, o
// gerenciador de senha do navegador funciona porque este é o caminho que ele
// conhece, e a validação de formato ganha as mensagens NATIVAS — já localizadas
// e já acessíveis — via `required`, `type="email"` e `minlength`.

// doorFrame é a marca, o cartão do kit, o rodapé e o aviso legal. A marca é
// tipográfica — o selo "T20" na cor da ação —, sem brasão: a direção da
// ALE-497 é sair da fantasia.
templ doorFrame(title, subtitle string, footer templ.Component) {
	<div class="ds-door">
		<div class="ds-door-brand">
			<span class="ds-door-seal" aria-hidden="true">T20</span>
			<span class="ds-door-name">
				Tormenta 20
				<small>Gerenciador de mesa</small>
			</span>
		</div>
		<section class="ds-door-card">
			<div class="ds-door-title">
				<h1>{ title }</h1>
				if subtitle != "" {
					<p>{ subtitle }</p>
				}
			</div>
			{ children... }
		</section>
		if footer != nil {
			<p class="ds-door-foot">
				@footer
			</p>
		}
		<p class="ds-door-fine">Gerenciador não-oficial de Tormenta 20.</p>
	</div>
}

// formNotice é a recusa que não pertence a nenhum campo, numa faixa logo acima
// do botão, onde o olho está.
//
// `role="alert"` porque ela aparece DEPOIS de um envio, sem navegação e sem
// mover o foco: quem não vê a tela não teria como saber que a tentativa falhou.
templ formNotice(notice string) {
	if notice != "" {
		<p role="alert" class="ds-door-alert">
			@ui.Icon("CircleAlert", "ds-icon")
			<span>{ notice }</span>
		</p>
	}
}

// fieldError junta os erros de um campo numa frase, que o kit desenha no
// lugar da dica.
func fieldError(errs []string) string { return strings.Join(errs, " ") }

// ── entrar ───────────────────────────────────────────────────────────────────

templ signInPage(v signInView) {
	@doorFrame("Entrar", "Bem-vindo de volta, aventureiro.", signInFooter()) {
		<form method="post" action="/entrar" class="ds-door-form">
			if v.Destination != "" {
				<input type="hidden" name="destino" value={ v.Destination }/>
			}
			@ds.TextField(ds.Field{ID: "email", Name: "email", Label: "E-mail", Type: "email", Value: v.Email, Placeholder: "voce@exemplo.com", Error: fieldError(v.Errors["email"])}, templ.Attributes{"autocomplete": "email", "required": true})
			@ds.PasswordField(ds.Field{ID: "senha", Name: "senha", Label: "Senha", Error: fieldError(v.Errors["senha"])}, templ.Attributes{"autocomplete": "current-password", "required": true})
			@formNotice(v.Notice)
			@ds.Button(ds.ButtonPrimary, templ.Attributes{"type": "submit", "data-wide": true}) {
				Entrar
			}
		</form>
	}
}

// Não há link para criar conta, e a ausência é a decisão: esta mesa é por
// convite, e quem tem um chega pela URL do convite, não por aqui.
templ signInFooter() {
	Esta mesa é por convite — peça o link a quem administra.
}

// ── criar conta ──────────────────────────────────────────────────────────────

templ signUpPage(v signUpView) {
	@doorFrame("Criar conta", "Você foi convidado para a mesa.", footerWithSignIn()) {
		<form method="post" action="/criar-conta" class="ds-door-form">
			<input type="hidden" name="convite" value={ v.Invite }/>
			@ds.TextField(ds.Field{ID: "email", Name: "email", Label: "E-mail", Type: "email", Value: v.Email, Placeholder: "voce@exemplo.com", Error: fieldError(v.Errors["email"])}, templ.Attributes{"autocomplete": "email", "required": true})
			@ds.TextField(ds.Field{ID: "nome", Name: "nome", Label: "Nome", Value: v.Name, Help: "Opcional — é como a mesa te chama.", Error: fieldError(v.Errors["nome"])}, templ.Attributes{"autocomplete": "name", "maxlength": "80"})
			@ds.PasswordField(ds.Field{ID: "senha", Name: "senha", Label: "Senha", Help: "Ao menos 8 caracteres.", Error: fieldError(v.Errors["senha"])}, templ.Attributes{"autocomplete": "new-password", "required": true, "minlength": "8", "maxlength": "128"})
			@passwordConfirmation(v.Errors["confirmar"])
			@formNotice(v.Notice)
			@ds.Button(ds.ButtonPrimary, templ.Attributes{"type": "submit", "data-wide": true}) {
				Criar conta
			}
		</form>
	}
}

templ footerWithSignIn() {
	Já tem conta?&nbsp;<a href="/entrar">Entrar</a>
}

// ── redefinir senha ──────────────────────────────────────────────────────────

templ resetPage(v resetView) {
	if v.LinkIsValid {
		@doorFrame("Escolher nova senha", linkSubtitle(v), footerWithSignIn()) {
			<form method="post" action="/redefinir-senha" class="ds-door-form">
				<input type="hidden" name="token" value={ v.Token }/>
				@ds.PasswordField(ds.Field{ID: "senha", Name: "senha", Label: "Nova senha", Help: "Ao menos 8 caracteres.", Error: fieldError(v.Errors["senha"])}, templ.Attributes{"autocomplete": "new-password", "required": true, "minlength": "8", "maxlength": "128"})
				@passwordConfirmation(v.Errors["confirmar"])
				@formNotice(v.Notice)
				@ds.Button(ds.ButtonPrimary, templ.Attributes{"type": "submit", "data-wide": true}) {
					Salvar nova senha
				}
			</form>
		}
	} else {
		// O LINK QUE NÃO VALE não tem formulário: um vazio do kit diz o que houve
		// e o que fazer, com o caminho para Entrar.
		@doorFrame("Escolher nova senha", "", nil) {
			@ds.Empty(deadLinkTitle, noticeDeadLink)
			@ds.LinkButton(ds.ButtonSecondary, templ.SafeURL("/entrar"), templ.Attributes{"data-wide": true}) {
				Ir para Entrar
			}
		}
	}
}

func linkSubtitle(v resetView) string {
	if v.AccountEmail != "" {
		return "Para " + v.AccountEmail
	}
	return "Um link de redefinição foi usado para chegar aqui."
}

// passwordConfirmation é o campo que existe só para pegar o typo.
//
// Ele é conferido nos DOIS lados, e os dois são necessários por razões
// diferentes: o `data-on:input` dá o aviso na hora, e o SERVIDOR é quem de fato
// recusa — sem ele a página deixaria de funcionar com JavaScript desligado.
//
// A comparação lê o campo irmão pelo DOM (`el.form.senha.value`) em vez de por
// um sinal, e isso é o ponto: a senha não entra em estado de cliente nenhum.
templ passwordConfirmation(errs []string) {
	@ds.PasswordField(ds.Field{ID: "confirm", Name: "confirmar", Label: "Confirmar senha", Error: fieldError(errs)}, templ.Attributes{
		"autocomplete":  "new-password",
		"required":      true,
		"data-on:input": "el.setCustomValidity(el.value === el.form.senha.value ? '' : '" + noticePasswordMismatch + "')",
	})
}

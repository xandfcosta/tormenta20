package master

import (
	"fmt"
	"t20engine/domain/book"
	"t20engine/serve/web/ds"
	"t20engine/serve/web/ui"
)

// O CONSTRUTOR DE ENCONTROS (mockup `encontros.html`).
//
// O VEREDITO fica sempre à vista: a ferramenta existe para responder "esse encontro é
// duro demais?". O ND é o número grande, a dificuldade vem ao lado com o peso que
// merece, e o XP fica secundário porque ele é consequência, não decisão.
//
// As 80 criaturas não empurram o veredito: no desktop elas rolam na coluna delas, e no
// celular moram num diálogo que fica aberto a cada criatura acrescentada, porque quem
// monta um encontro costuma acrescentar várias.

// O `data-url` mora na cena porque é ela que o remendo atualiza. O botão de copiar fica
// no cabeçalho, que o remendo não alcança, e lê o endereço daqui.
templ encountersScene(v encountersView) {
	<section
		id="encounters"
		class="ds-encounter"
		aria-label="Construtor de encontros"
		data-url={ encounterAddress(v) }
		data-signals={ encounterSignals(v) }
	>
		<div class="ds-encounter-left">
			@verdict(v)
			<div class="ds-encounter-build">
				@encounterPartyPanel(v)
				@composition(v)
				<button
					type="button"
					class="ds-button ds-encounter-add"
					commandfor="encounter-add"
					command="show-modal"
				>
					@ui.Icon("Plus", "ds-icon")
					Acrescentar criatura
				</button>
			</div>
		</div>
		<aside class="ds-encounter-side" aria-label="Acrescentar criatura">
			@creatureSearch(v, "encounter-side-search", templ.Attributes{"data-busca-da-cena": true})
			@encounterCreatureList(v, templ.Attributes{"data-nav-region": "criaturas", "data-nav-layout": "column"})
		</aside>
		@ds.Dialog("encounter-add", "Acrescentar criatura", nil) {
			@ds.FilterBar() {
				@creatureSearch(v, "encounter-add-search", nil)
			}
			@ds.DialogScroll() {
				@encounterCreatureList(v, nil)
			}
		}
	</section>
}

// copyEncounterButton entrega o encontro como ENDEREÇO, sob demanda.
//
// O link é montado no servidor e viaja pronto no `data-url` da cena: montá-lo no
// cliente exigiria repetir ali a codificação do formato `id:count`, e formato escrito
// em dois lugares é formato que diverge.
//
// O aviso troca o texto do próprio botão por dois segundos em vez de abrir um balão:
// quem clicou está olhando para ele, e uma confirmação que aparece em outro canto da
// tela é uma confirmação que se perde.
templ copyEncounterButton() {
	@ds.Button(ds.ButtonGhost, templ.Attributes{
		"type":          "button",
		"data-on:click": "navigator.clipboard.writeText(location.origin + document.getElementById('encounters').dataset.url); $copied = true; setTimeout(() => $copied = false, 2000)",
	}) {
		@ui.Icon("Copy", "ds-icon")
		<span data-show="!$copied">Copiar link</span>
		<span style="display:none" data-show="$copied">Link copiado</span>
	}
}

templ verdict(v encountersView) {
	<section class="ds-encounter-verdict" aria-label="O veredito">
		<div class="ds-encounter-nd">
			<span class="ds-row-meta">ND do encontro</span>
			<b>{ roundedCR(v.ND()) }</b>
		</div>
		<div class="ds-encounter-says">
			// Sem criatura não há o que julgar, embora a conta dê uma faixa para ND 0.
			if !v.Empty() {
				@ds.Seal(v.Difficulty().Label, difficultyTone(v.Difficulty().Tom))
			}
			<span class="ds-row-meta"><b>{ xpWritten(v.XPPerCharacter()) }</b> XP por personagem</span>
		</div>
	</section>
}

templ encounterPartyPanel(v encountersView) {
	<section class="ds-encounter-party" aria-label="O grupo">
		@partyField("party_level", "encounter-level", "Nível do grupo", v.Level, partyLevelMin, partyLevelMax)
		@partyField("party_size", "encounter-size", "Personagens", v.Group, partySizeMin, partySizeMax)
	</section>
}

// partyField fica fora da navegação por setas: no campo de número a seta muda o valor,
// e quem passasse por ali trocaria o nível do grupo sem querer. Chega-se pelo TAB.
templ partyField(signal, id, label string, value, min, max int) {
	@ds.TextField(ds.Field{ID: id, Label: label, Type: "number", Value: ui.Int(value)}, templ.Attributes{
		"min": ui.Int(min), "max": ui.Int(max), "inputmode": "numeric", "data-bind": signal,
		"data-on:input__debounce.300ms": "@get('/mestre/encontros')",
	})
}

// composition: a região só existe com criatura, porque região sem item deixa o driver
// de teclado tentar entrar e o foco sumir.
templ composition(v encountersView) {
	if v.Empty() {
		@ds.Empty("Nenhuma criatura no encontro", "Escolha uma criatura para acrescentar.")
	} else {
		@ds.List("No encontro", creaturesWritten(v.CreatureCount())) {
			<div class="ds-encounter-rows" data-nav-region="composicao" data-nav-layout="grid">
				for _, l := range v.Rows {
					<div class="ds-row">
						<div>
							<div class="ds-row-title">{ l.Entry.Name }</div>
							<div class="ds-row-meta">{ rowWorthWritten(l) }</div>
						</div>
						<div class="ds-encounter-steps">
							@quantityStep(l.Entry, "menos", "Minus")
							<b>{ ui.Int(l.Count) }</b>
							@quantityStep(l.Entry, "mais", "Plus")
							@ds.IconButton(ds.ButtonGhost, "X", "Remover "+l.Entry.Name+" do encontro", templ.Attributes{
								"type": "button", "data-on:click": fmt.Sprintf("@post('/mestre/encontros/remover/%s')", l.Entry.ID),
							})
						</div>
					</div>
				}
			</div>
		}
	}
}

// quantityStep: o nome acessível diz o VERBO e a criatura, porque numa lista de seis
// linhas "mais" sozinho não distingue os seis botões iguais — e nem o `getByRole` nem
// um leitor de tela separam homônimos.
templ quantityStep(m book.Entry, step, icon string) {
	@ds.IconButton(ds.ButtonSecondary, icon, stepLabel(step, m.Name), templ.Attributes{
		"type": "button", "data-on:click": fmt.Sprintf("@post('/mestre/encontros/%s/%s')", step, m.ID),
	})
}

// creatureSearch reusa a busca do bestiário: o mestre que aprendeu a procurar criatura
// lá não reaprende aqui.
templ creatureSearch(v encountersView, id string, field templ.Attributes) {
	@ds.SearchField(id, "Buscar criatura", joinAttrs(templ.Attributes{
		"name": "creature_search", "value": v.Term, "data-bind:creature_search": true,
		"data-on:input__debounce.250ms": "@get('/mestre/encontros')",
	}, field))
}

// encounterCreatureList são as criaturas para acrescentar, na coluna do desktop e no diálogo.
// `region` vai só na da coluna: no diálogo a seta é dele. O crachá diz quantas já estão
// no encontro, para o mestre não precisar olhar para o outro lado.
templ encounterCreatureList(v encountersView, region templ.Attributes) {
	if len(v.Findings) == 0 {
		@ds.Empty("Nenhuma criatura", "Nenhuma criatura com esse nome.")
	} else {
		@ds.List("Criaturas", ui.Int(len(v.Findings))) {
			<div class="ds-encounter-rows" { region... }>
				for _, m := range v.Findings {
					<button
						type="button"
						class="ds-row ds-encounter-pick"
						aria-label={ "Acrescentar " + m.Name + " ao encontro" }
						data-on:click={ fmt.Sprintf("@post('/mestre/encontros/adicionar/%s')", m.ID) }
					>
						<div>
							<div class="ds-row-title">{ m.Name }</div>
							<div class="ds-row-meta">{ fmt.Sprintf("%s · %s · ND %s", book.TypeName(m.Kind), book.SizeName(m.Size), book.CRWritten(m.ND)) }</div>
						</div>
						<div class="ds-encounter-pick-end">
							if n := v.CountOf(m.ID); n > 0 {
								<span class="ds-badge" data-variant="outline" title={ fmt.Sprintf("%d no encontro", n) }>{ fmt.Sprintf("%d×", n) }</span>
							}
							<span class="ds-row-meta">{ fmt.Sprintf("PV %d · Def %d", m.HP, m.Defense) }</span>
							@ui.Icon("Plus", "ds-icon")
						</div>
					</button>
				}
			</div>
		}
	}
}

package master

import (
	"fmt"
	"t20engine/serve/web/bookui"
	"t20engine/serve/web/ds"
	"t20engine/serve/web/ui"
)

// O IMPROVISO — as tabelas do Cap 6, o esqueleto de masmorra, e o Baralho.
//
// AS PÁGINAS DAQUI FORAM CONFERIDAS CONTRA O PDF, uma a uma:
//
//	Ruína              p269   (não é tabela numerada, é prosa)
//	Tabela 6-5         p274
//	Tabela 6-2         p263
//	Tabela 6-7         p279
//	Baralho do Caos    p347   (Cap 8 — é a regra própria de um ARTEFATO)
//
// A 6-7 é a armadilha: a p278 é onde o texto MENCIONA a tabela ("usando a
// Tabela 6-7: Consequências de Buscas"), e o corpo dela começa na p279. Citação
// de tabela aponta para onde a tabela ESTÁ, e não para onde o livro fala dela —
// quem segue a citação quer conferir um resultado.
//
// O Baralho é de OUTRO capítulo, e por isso tem faixa própria em vez de entrar
// na grade do Cap 6: a faixa é o que diz ao mestre que aquela tabela só vale
// quando o artefato está na mesa. Sem ela, "Baralho do Caos" ao lado de
// "Perseguição" leria como quinta ferramenta de improviso.
//
// Mockup `improviso.html`. Três tabelas lado a lado e a masmorra embaixo. A grade não é
// a dos catálogos: aqui os cartões são CONTROLES com histórico curto, não prosa de regra,
// então a medida de leitura que rege os catálogos não se aplica.

// A região é a cena inteira porque os itens da seta são os botões dos cartões, e o campo
// de salas fica de fora: num campo de número a seta muda o valor.
templ improvScene(v improvView) {
	<section
		id="improv"
		class="ds-improv"
		aria-label="Improviso"
		data-signals={ improvSignals(v) }
		data-nav-region="tabelas"
		data-nav-layout="grid"
	>
		@improvSection("Tabelas do Cap 6") {
			@rollingTable("ruina", "Ermos — Ruína", "d6", "", 269, "Ruína", v.Ruin, v)
			@rollingTable("perseguicao", "Perseguição — evento", "d20", "Tabela 6-5", 274, "Tabela 6-5", v.Chase, v)
			@rollingTable("recompensa", "Consequências de buscas", "d6", "Tabela 6-7", 279, "Tabela 6-7", v.Reward, v)
		}
		@improvSection("Masmorra") {
			@rollingTable("ideias", "Ideias de masmorra", "d20", "Tabela 6-2", 263, "Tabela 6-2", v.Ideas, v)
			@dungeonPlanner(v)
		}
		@improvSection("Artefato") {
			@rollingTable("baralho", "Baralho do Caos — carta", "1d%", "", 347, "Baralho do Caos", v.Chaos, v)
		}
	</section>
}

templ improvSection(title string) {
	<section class="ds-improv-section" aria-label={ title }>
		<h2 class="ds-list-head">{ title }</h2>
		<div class="ds-improv-grid">
			{ children... }
		</div>
	</section>
}

// tableCitation é a citação à direita do nome: a tabela, quando tem número, e a página
// como elo para o livro. O número do dado só vale se dá para conferir, e o elo deixa a
// conferência a um toque.
templ tableCitation(table string, page int, term string, v improvView) {
	if table != "" {
		{ table + " · " }
	}
	@bookui.PageSealInMeta(v.Book, page, term)
}

// rollingTable é o cartão de uma tabela: o botão, o último resultado grande, e as
// anteriores em voz baixa. O botão vem ANTES do resultado para não sair do lugar: o
// resultado cresce para baixo, e quem rola várias vezes não precisa perseguir o botão.
//
// O NÚMERO aparece sempre, ao lado do texto. Ele não é detalhe de implementação: "saiu 4"
// é metade da resposta, e uma tabela cujo resultado não se confere contra o livro é um
// oráculo, não uma ferramenta.
//
// `<section aria-label>` e não `<div>`: um cartão com cabeçalho próprio É uma região, e
// sem nome acessível ele vira caixa anônima para quem navega por regiões. De quebra, é o
// que deixa o teste apontar para UM cartão em vez de contar filhos de `div`.
templ rollingTable(id, title, die, table string, page int, term string, history []roll, v improvView) {
	<section aria-label={ title } class="ds-improv-table">
		@ds.EntryCard(title, nil, tableCitation(table, page, term, v)) {
			<div class="ds-improv-acts">
				@ds.Button(ds.ButtonSecondary, templ.Attributes{
					"type": "button", "data-on:click": fmt.Sprintf("@post('/mestre/improviso/%s')", id),
				}) {
					@ui.Icon("Dices", "ds-icon")
					{ "Rolar " + die }
				}
				// LIMPAR só aparece com histórico: um botão que não tem o que fazer ocupa a
				// linha e ensina errado.
				if len(history) > 0 {
					@ds.Button(ds.ButtonGhost, templ.Attributes{
						"type": "button", "aria-label": "Limpar o histórico de " + title,
						"data-on:click": fmt.Sprintf("@post('/mestre/improviso/%s/limpar')", id),
					}) {
						Limpar
					}
				}
			</div>
			if len(history) == 0 {
				<p class="ds-row-meta">Nada rolado ainda.</p>
			} else {
				// O `aria-live` fica no BLOCO do resultado e não no botão: quem usa leitor de
				// tela precisa ouvir o que saiu, e o botão só diria que foi clicado. `polite`
				// porque a rolagem é do próprio usuário — `assertive` interromperia a leitura
				// dele por uma coisa que ele acabou de pedir.
				<div class="ds-improv-last" aria-live="polite">
					<b>{ ui.Int(history[0].Roll) }</b>
					<p>{ history[0].Text }</p>
					if history[0].Detail != "" {
						<p class="ds-improv-detail">{ history[0].Detail }</p>
					}
				</div>
				// As anteriores existem porque o mestre que rola duas vezes na mesma cena quer
				// COMPARAR — guardar só a última joga fora a comparação no instante da segunda
				// rolagem.
				if len(history) > 1 {
					<ul class="ds-improv-older">
						for _, s := range history[1:] {
							<li>
								<b>{ ui.Int(s.Roll) }</b>
								<span>{ s.Text }</span>
							</li>
						}
					</ul>
				}
			}
		}
	</section>
}

// dungeonPlanner não rola dado: ele responde uma CONTA sobre o número de salas — que
// tamanho o livro chama isso, quanto tempo de mesa ele ocupa, e quantas ameaças
// distribuir (uma a cada três salas, p263).
templ dungeonPlanner(v improvView) {
	<section aria-label="Esqueleto da masmorra" class="ds-improv-table">
		@ds.EntryCard("Esqueleto", nil, tableCitation("", 263, "Tabela 6-2", v)) {
			<div class="ds-improv-rooms">
				@ds.TextField(ds.Field{ID: "improv-rooms", Label: "Salas", Type: "number", Value: ui.Int(v.Rooms)}, templ.Attributes{
					"min": ui.Int(roomsMin), "max": ui.Int(roomsMax), "inputmode": "numeric", "data-bind:rooms": true,
					"data-on:input__debounce.300ms": "@get('/mestre/improviso')",
				})
			</div>
			if v.OverCeiling {
				// Acima do teto não é ERRO: é o livro recomendando parar. A tela diz isso em vez
				// de esconder o resultado ou fingir um tamanho.
				<p class="ds-row-meta">
					Acima do maior tamanho de masmorra do livro. Ele recomenda parar aqui e quebrar em masmorras menores.
				</p>
			} else if v.Size != nil {
				<dl class="ds-entry-fields">
					<dt>Tamanho</dt>
					<dd>{ v.Size.Label }</dd>
					<dt>Ritmo</dt>
					<dd>{ pacingName(v.Size.Pacing) }</dd>
					<dt>Ameaças a distribuir</dt>
					<dd>{ ui.Int(v.Threats) }</dd>
					if v.Size.MaxSecondaryObjectives > 0 {
						<dt>Objetivos secundários (até)</dt>
						<dd>{ ui.Int(v.Size.MaxSecondaryObjectives) }</dd>
					}
				</dl>
			}
		}
	</section>
}

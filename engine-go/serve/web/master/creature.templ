package master

import (
	"fmt"
	"strconv"

	"t20engine/domain/book"
	"t20engine/serve/web/bookui"
	"t20engine/serve/web/ds"
)

// A CRIATURA NO KIT, uma vez para o app inteiro: o Bestiário da Mesa do Mestre e
// as Consultas da mesa desenham os mesmos filtros, o mesmo cabeçalho, o mesmo
// bloco e a mesma folha. Cada tela põe em volta só o que é dela — a gramática de
// teclado aqui, o ajuste de PV e a fila lá.

// CreatureFilters é a busca, a faixa de ND e os tipos. A busca é o gesto do meio
// do combate e fica à vista; o ND e os tipos ficam numa gaveta no desktop e num
// diálogo abaixo dele. A troca é do CSS, na largura em que o menu lateral aparece, e
// o `data-preserve-attr` segura a gaveta aberta porque a cena é remendada a cada
// tecla da busca (o `ds.Dialog` faz o mesmo por ele).
// `region` vai no contêiner, `search` na busca e `field` em todo campo da gaveta. No
// diálogo a seta é dele, e `field` não vale.
//
//	@CreatureFilters(v, "bestiario", templ.Attributes{"data-nav-region": "filtros"}, nil, nil)
templ CreatureFilters(v BestiaryView, idPrefix string, region, search, field templ.Attributes) {
	<div class="ds-gm-bestiary-filters" { region... }>
		@ds.SearchField(idPrefix+"-search", "Buscar criatura", joinAttrs(templ.Attributes{
			"name": "busca", "value": v.Term, "data-bind:search": true,
			"data-on:input__debounce.250ms": fmt.Sprintf("@get('%s')", v.BestiaryBase()),
		}, search, field))
		<details class="ds-gm-filters-more ds-gm-filters-wide" data-preserve-attr="open">
			<summary class="ds-button" data-variant="ghost" { field... }>{ filtersWritten(v.litCount()) }</summary>
			@creatureFilterFields(v, idPrefix, field)
		</details>
		<button
			type="button"
			class="ds-button ds-gm-filters-open"
			data-variant="ghost"
			commandfor={ idPrefix + "-filters" }
			command="show-modal"
		>{ filtersWritten(v.litCount()) }</button>
	</div>
	@ds.Dialog(idPrefix+"-filters", "Filtros", nil) {
		@creatureFilterFields(v, idPrefix+"-sheet", nil)
	}
}

// creatureFilterFields é o ND e os tipos, desenhados na gaveta e no diálogo: dois
// desenhos do mesmo filtro seriam dois lugares para consertar. O `idPrefix` é o que
// separa os dois, porque id repetido faz o rótulo de um focar o campo do outro.
templ creatureFilterFields(v BestiaryView, idPrefix string, field templ.Attributes) {
	<div class="ds-gm-cr">
		@crField(v, idPrefix+"-cr-min", "ND mínimo", "ndMin", CRInBox(v.CRMin), field)
		@crField(v, idPrefix+"-cr-max", "ND máximo", "ndMax", CRInBox(v.CRMax), field)
	</div>
	<div class="ds-options" role="group" aria-label="Filtrar por tipo">
		for _, t := range book.CreatureTypes {
			@ds.Option(v.TypeOn(t), templ.Attributes{"data-on:click": fmt.Sprintf("@post('%s/tipo/%s')", v.BestiaryBase(), t)}) {
				{ book.TypeName(t) }
			}
		}
	</div>
}

// crField é um campo de ND. O `step` de 0,25 é do livro: o ND anda em quartos
// abaixo de 1. O `min`/`max` nativos não são a trava — o servidor aperta a faixa
// de novo, porque o número chega pela URL e qualquer um a edita à mão.
templ crField(v BestiaryView, id, label, signal, value string, field templ.Attributes) {
	@ds.TextField(ds.Field{ID: id, Label: label, Type: "number", Value: value}, joinAttrs(templ.Attributes{
		"min": "0", "max": "20", "step": "0.25", "inputmode": "decimal", "data-bind": signal,
		"data-on:input__debounce.400ms": fmt.Sprintf("@get('%s')", v.BestiaryBase()),
	}, field))
}

// CreatureHead é o nome com o tipo, o porte, o ND, o XP e a página do livro. Eles
// ficam junto do nome porque são curtos, e no corpo sumiam na primeira rolagem.
templ CreatureHead(m book.Entry, bookRef bookui.BookAddress) {
	<span class="ds-gm-creature-name">
		<span class="ds-dialog-title">{ m.Name }</span>
		<span class="ds-row-meta">
			{ fmt.Sprintf("%s · %s · ND %s · XP %d · ", book.TypeName(m.Kind), book.SizeName(m.Size), book.CRWritten(m.ND), book.XPForCR(m.ND)) }
			@bookui.PageSealInMeta(bookRef, m.BookPage, m.Name)
		</span>
	</span>
}

// CreatureSheet é a folha da criatura por cima da tela, aberta por `$sheet_open`
// (que o remendo redeclara, ver `BestiarySignals`). `foot` é o que a tela põe
// embaixo do bloco — o ajuste e a fila, na mesa —, e nulo não desenha nada.
//
// NASCE ESCONDIDA pelo `style` estático: o `data-show` só vale depois que o
// Datastar processa o DOM, e até lá a sobreposição pintaria o pano escuro sobre
// a tela. `data-expanded` é o que faz o driver de teclado se recolher atrás dela.
templ CreatureSheet(m book.Entry, bookRef bookui.BookAddress, foot templ.Component) {
	<div
		class="ds-gm-overlay"
		data-show="$sheet_open"
		style="display:none"
		data-on:click="evt.target === el && ($sheet_open = false)"
		data-on:keydown__window="evt.key === 'Escape' && ($sheet_open = false)"
	>
		<div class="ds-gm-float" role="dialog" aria-modal="true" data-attr:data-expanded="$sheet_open" aria-label={ m.Name }>
			<div class="ds-dialog-head">
				@CreatureHead(m, bookRef)
				@ds.IconButton(ds.ButtonGhost, "X", "Fechar a ficha de "+m.Name, templ.Attributes{"type": "button", "data-on:click": "$sheet_open = false"})
			</div>
			<div class="ds-gm-creature-body">
				@CreatureBlock(m, bookRef)
			</div>
			if foot != nil {
				@foot
			}
		</div>
	</div>
}

// CreatureBlock é o bloco do livro. A ORDEM é regra: os números de agora, e logo
// os Ataques e as Habilidades — o mestre abre o bestiário no meio do combate
// para saber o que a criatura rola AGORA, e não para atravessar doze números.
// Os dois grupos viram DUAS COLUNAS quando o bloco tem largura para isso (ver
// `.ds-gm-creature` no `ds.css`): numa coluna estreita no meio de uma tela
// larga, as habilidades caíam abaixo da dobra.
templ CreatureBlock(m book.Entry, bookRef bookui.BookAddress) {
	<div class="ds-gm-creature">
		<div class="ds-gm-creature-now">
			@ds.Stats() {
				@ds.Stat("PV", strconv.Itoa(m.HP))
				@ds.Stat("Defesa", strconv.Itoa(m.Defense))
				@ds.Stat("Iniciativa", book.WithSign(m.Initiative))
				@ds.Stat("Percepção", book.WithSign(m.Perception))
				@ds.Stat("Deslocamento", m.Speed)
				if m.PM != nil {
					@ds.Stat("PM", strconv.Itoa(*m.PM))
				}
			}
			if len(m.Attacks) > 0 {
				@ds.List("Ataques", "") {
					for _, a := range m.Attacks {
						<div class="ds-row">
							<span class="ds-gm-member-body">
								<span class="ds-row-title">{ a.Name }</span>
								if a.Special != "" {
									<span class="ds-row-meta">{ a.Special }</span>
								}
							</span>
							<span class="ds-row-value">{ book.WithSign(a.AttackBonus) + " · " + a.Damage }</span>
						</div>
					}
				}
			}
			if len(m.SpecialAbilities) > 0 {
				<section class="ds-gm-creature-part">
					<h3 class="ds-field-label">Habilidades especiais</h3>
					for _, h := range m.SpecialAbilities {
						<p>
							for _, chunk := range book.WithLinks(h) {
								@bookui.Chunk(chunk, bookRef)
							}
						</p>
					}
				</section>
			}
		</div>
		<div class="ds-gm-creature-rest">
			<section class="ds-gm-creature-part">
				<h3 class="ds-field-label">Resistências</h3>
				@ds.Stats() {
					@ds.Stat("Fort", book.WithSign(m.Fortitude))
					@ds.Stat("Ref", book.WithSign(m.Reflex))
					@ds.Stat("Von", book.WithSign(m.Will))
				}
			</section>
			<section class="ds-gm-creature-part">
				<h3 class="ds-field-label">Atributos</h3>
				@ds.Stats() {
					@ds.Stat("For", book.WithSignPtr(m.Strength))
					@ds.Stat("Des", book.WithSignPtr(m.Dexterity))
					@ds.Stat("Con", book.WithSignPtr(m.Constitution))
					@ds.Stat("Int", book.WithSignPtr(m.Intelligence))
					@ds.Stat("Sab", book.WithSignPtr(m.Wisdom))
					@ds.Stat("Car", book.WithSignPtr(m.Charisma))
				}
			</section>
			if len(m.Skills) > 0 {
				<section class="ds-gm-creature-part">
					<h3 class="ds-field-label">Perícias</h3>
					<p>
						for i, p := range m.Skills {
							if i > 0 {
								{ " · " }
							}
							{ p.Name + " " + book.WithSign(p.Bonus) }
							if p.Note != "" {
								{ " (" + p.Note + ")" }
							}
						}
					</p>
				</section>
			}
			if m.Equipment != "" {
				<section class="ds-gm-creature-part">
					<h3 class="ds-field-label">Equipamento</h3>
					<p>
						for _, chunk := range book.WithLinks(m.Equipment) {
							@bookui.Chunk(chunk, bookRef)
						}
					</p>
				</section>
			}
			if m.Treasure != "" {
				<section class="ds-gm-creature-part">
					<h3 class="ds-field-label">Tesouro</h3>
					<p>
						for _, chunk := range book.WithLinks(m.Treasure) {
							@bookui.Chunk(chunk, bookRef)
						}
					</p>
				</section>
			}
		</div>
	</div>
}

package master

import (
	"fmt"

	"t20engine/domain/book"
	"t20engine/serve/web/ds"
)

// A MESA DO MESTRE: as ferramentas do mestre, em `/mestre/`.
//
// O endereço não é o da sessão (`/campanhas/{campanha}/sessoes/{sessao}`)
// porque as ferramentas do mestre valem fora de qualquer partida, e
// pendurá-las ali daria à mesma
// palavra dois sentidos no mesmo espaço de endereço — o que o GLOSSARY.md
// proíbe. O TÍTULO na tela continua "Mesa do Mestre": renomear tela que o
// mestre já conhece é outro assunto.

// ── o bestiário ──────────────────────────────────────────────────────────────

// bestiaryScene é o catálogo de criaturas: a lista à esquerda e a criatura
// escolhida ao lado, no desktop; no celular só a lista, e a criatura abre por
// cima (`CreatureSheet`). O que é desta tela e não da mesa é a gramática de
// teclado: as três regiões, e o foco da seta que já mostra a criatura.
templ bestiaryScene(v BestiaryView) {
	<section id="bestiary" class="ds-master-catalog-scene" aria-label="Bestiário" data-signals={ BestiarySignals(v) }>
		<div class="ds-master-list">
			// Os filtros são uma REGIÃO, e `grid` porque o bloco é bidimensional:
			// os dois campos de ND lado a lado. A busca é campo de texto, e ali a
			// seta edita em vez de navegar — sai-se pelo TAB ou pelo Esc.
			@ds.FilterBar() {
				@CreatureFilters(v, "bestiario",
					templ.Attributes{"data-nav-region": "filtros", "data-nav-layout": "grid"},
					templ.Attributes{"data-busca-da-cena": true}, navigableField())
			}
			@creatureList(v)
		</div>
		// A FICHA é região, e o alvo do foco é o miolo: o driver só considera
		// item o que é focável DENTRO da região. As bordas verticais apontam para
		// ela mesma para a seta ROLAR a ficha em vez de saltar para a lista — a
		// busca por vizinho exclui a própria região, devolve nulo e deixa a tecla
		// para a rolagem nativa. Horizontal troca de painel; vertical rola.
		<section
			class="ds-master-entry"
			data-nav-region="ficha"
			data-nav-layout="column"
			data-nav-edge-up="ficha"
			data-nav-edge-down="ficha"
			aria-label="Criatura escolhida"
		>
			<div tabindex="0" data-nav-item class="ds-master-entry-body">
				if v.Chosen != nil {
					<div class="ds-dialog-head">
						@CreatureHead(*v.Chosen, v.Book)
					</div>
					@CreatureBlock(*v.Chosen, v.Book)
				} else {
					@ds.Empty("Nenhuma criatura escolhida", "Escolha uma criatura na lista.")
				}
			</div>
		</section>
		if v.Chosen != nil {
			@CreatureSheet(*v.Chosen, v.Book, nil)
		}
	</section>
}

// creatureList é a lista, sem virtualização: são 80 criaturas, e virtualizar é
// maquinaria para lista que não cabe.
//
// FOCO ATIVA, como em jogo: a seta anda na lista e a criatura ao lado segue
// junto, sem Enter. O foco NÃO abre a folha e o clique abre (`abrir=1`): no
// celular a folha é um `role=dialog` que prende o driver, e abri-la no foco
// prenderia a pessoa no primeiro passo da seta.
//
// O `:focus-visible` guarda o pedido do foco porque o clique TAMBÉM foca: sem o
// guarda, uma linha tocada mandaria dois pedidos, e quem chegasse por último
// decidiria se a folha fica aberta. O `__throttle` segura a seta presa, que de
// outro jeito pediria as 80 fichas.
templ creatureList(v BestiaryView) {
	if len(v.Entries) == 0 {
		@ds.Empty("Nenhuma criatura", "Nenhuma criatura casa com os filtros.")
	} else {
		@ds.List("Criaturas", fmt.Sprintf("%d de %d", len(v.Entries), v.Total)) {
			<div class="ds-master-rows" data-nav-region="lista" data-nav-layout="column">
				for _, m := range v.Entries {
					<a
						class="ds-row ds-gm-entry"
						href={ templ.SafeURL(v.BestiaryBase() + "?criatura=" + m.ID) }
						data-on:click={ fmt.Sprintf("evt.preventDefault(); $creature = %q; @get('%s')", m.ID, OpenTheEntry(v.BestiaryBase())) }
						data-on:focus__throttle.100ms.leading={ fmt.Sprintf("el.matches(':focus-visible') && ($creature = %q, @get('%s'))", m.ID, v.BestiaryBase()) }
						if v.Chosen != nil && v.Chosen.ID == m.ID {
							aria-current="true"
						}
					>
						<span class="ds-gm-member-body">
							<span class="ds-row-title">{ m.Name }</span>
							<span class="ds-row-meta">{ book.TypeName(m.Kind) + " · " + book.SizeName(m.Size) + " · ND " + book.CRWritten(m.ND) }</span>
						</span>
						<span class="ds-row-meta ds-gm-entry-nums">{ fmt.Sprintf("PV %d · Def %d", m.HP, m.Defense) }</span>
					</a>
				}
			</div>
		}
	}
}

package master

import (
	"fmt"
	"t20engine/serve/web/ds"
	"t20engine/serve/web/ui"
)

// OS CATÁLOGOS da Mesa do Mestre: a busca, os filtros e os verbetes inteiros em
// cartões. Os cartões moram em `collection_cards.templ`, porque a caixa do elo
// desenha os mesmos.
//
// A cena manda as 992 entradas — decisão do dono, e o custo aceito é DOM. O que
// esse custo exige em troca é que a lista ROLE DENTRO DA CAIXA: deixada crescer
// até a altura do conteúdo ela vaza milhares de pixels para fora dela SEM a
// página rolar, e uma asserção "a cena não rola" fica VERDE por cima do defeito.
// Por isso o e2e mede quem rola em vez de confiar em classe.
templ collectionScene(v collectionView) {
	// O título é o da ABA, e não "Catálogos", e mora no cabeçalho da moldura: quem
	// diz onde se está é o menu, e repetir a palavra aqui seria o mesmo estado
	// desenhado em dois lugares.
	<section id="catalogs" class="ds-catalog" aria-label={ tabLabel(v.Aba) } data-signals={ collectionSignals(v) }>
		// A busca é campo de texto, e ali a seta edita em vez de navegar — sai-se
		// pelo TAB ou pelo Esc. Os crachás andam pela seta, em grade, e a borda de
		// baixo aponta para os verbetes: o driver acha o vizinho pelo centro da caixa,
		// e o da região dos verbetes fica mais longe que o do menu lateral.
		<div class="ds-catalog-tools" data-nav-region="filtros" data-nav-layout="grid" data-nav-edge-down="verbetes">
			@ds.SearchField("catalog-search", "Buscar em todos os catálogos", joinAttrs(templ.Attributes{
				"name": "busca", "value": v.Term, "data-bind:search": true, "data-busca-da-cena": true,
				"data-on:input__debounce.250ms": "@get('/mestre/" + v.Aba + "')",
			}, navigableField()))
			// Os FILTROS somem durante a busca: com termo digitado a cena responde
			// outra pergunta — todos os catálogos, não este —, e um crachá de círculo
			// aceso sobre uma lista que tem itens e condições diria que ele está
			// filtrando o que não filtra.
			if v.offersFilters() {
				<div class="ds-catalog-filter-rows ds-catalog-filters-inline">
					@collectionFilters(v)
				</div>
				<button
					type="button"
					class="ds-button ds-catalog-filters-open"
					data-variant="ghost"
					commandfor="catalog-filters"
					command="show-modal"
				>{ filtersWritten(v.litCount()) }</button>
			}
		</div>
		@collectionResults(v)
		// Dentro da cena, e o remendo passa por baixo dele: o `ds.Dialog` preserva o
		// `open`, e cada crachá ligado redesenha o estado dos outros aqui dentro.
		if v.offersFilters() {
			@ds.Dialog("catalog-filters", "Filtros", nil) {
				<div class="ds-catalog-filter-rows">
					@collectionFilters(v)
				</div>
			}
		}
	</section>
}

// collectionResults é a caixa que ROLA, e a região é a casca dela: o driver só
// considera item o que é focável DENTRO da região. As bordas verticais apontam
// para ela mesma para a seta ROLAR os verbetes em vez de saltar para os filtros,
// como na ficha do Bestiário.
//
// Com termo digitado a busca varre TODOS os catálogos e mostra os grupos, não só o
// da cena — senão "bola de fogo" digitado em Condições acha "nada encontrado" com
// a magia existindo.
templ collectionResults(v collectionView) {
	<div class="ds-catalog-region" data-nav-region="verbetes" data-nav-layout="column" data-nav-edge-up="verbetes" data-nav-edge-down="verbetes">
		@ui.ScrollBox("Resultados dos catálogos", "ds-catalog-results") {
			// A saída de quem chegou por um ELO com o endereço na barra (ctrl+clique,
			// link colado): a cena mostra UM verbete, e sem esta linha a pessoa fica
			// sem entender por que o catálogo tem uma entrada só.
			if v.Entry != "" {
				<p class="ds-catalog-more">
					<a href={ templ.SafeURL("/mestre/" + v.Aba) } data-nav-skip>{ "‹ ver " + tabLabel(v.Aba) + " inteiro" }</a>
				</p>
			}
			if v.Findings == 0 {
				@ds.Empty("Nada encontrado", "Nada nos catálogos casa com essa busca.")
			} else {
				if v.Searching() {
					<p class="ds-row-meta">{ findingsWritten(v.Findings) }</p>
				}
				for _, g := range v.Groups {
					<section class="ds-catalog-group" aria-label={ g.Label }>
						@ds.ListHead(g.Label, v.groupCount(g))
						<div class="ds-catalog-grid">
							@groupCards(g, v.Book)
						</div>
					</section>
				}
			}
		}
	</div>
}

// collectionFilters são as linhas de crachá do catálogo da cena, à vista no desktop
// e num diálogo abaixo dele. A troca é do CSS, na largura em que o menu lateral
// aparece, e o mesmo componente desenha os dois: dois desenhos do mesmo filtro seriam
// dois lugares para consertar.
//
// O rótulo da linha é VISÍVEL: são até três linhas, e sem ele ninguém sabe se
// "Evocação" é escola ou classe.
templ collectionFilters(v collectionView) {
	for _, f := range v.Filters {
		<div class="ds-catalog-filter" role="group" aria-label={ "Filtrar por " + f.Label }>
			<span class="ds-field-label" aria-hidden="true">{ f.Label }</span>
			<div class="ds-options">
				for _, o := range f.Options {
					@ds.Option(v.badgeOn(f.Key, o.Value), templ.Attributes{"data-on:click": toggleBadge(v.Aba, f.Key, o.Value)}) {
						{ o.Label }
					}
				}
			</div>
		</div>
	}
}

// findingsWritten concorda em número.
func findingsWritten(n int) string {
	if n == 1 {
		return "1 achado em todos os catálogos"
	}
	return fmt.Sprintf("%d achados em todos os catálogos", n)
}

package admin

import (
	"fmt"
	"t20engine/serve/web/ds"
	"t20engine/serve/web/ui"
)

// A tela de administração desenhada (mockup `admin.html`).
templ adminScene(v adminView) {
	<main class="ds-admin">
		// REGIÃO de conteúdo, `grid` porque a repartição é bidimensional de verdade: os
		// jogadores numa coluna larga, o resto empilhado na outra. Uma região só, e não uma
		// por painel: o que o driver move é o FOCO entre itens por geometria, e várias
		// regiões obrigariam a cruzar borda para andar entre coisas lado a lado.
		<div class="ds-admin-grid" data-nav-region="content" data-nav-layout="grid">
			@playersPanel(v)
			<div class="ds-admin-side">
				@invitesPanel(v)
				@serverPanel(v)
				@backupsPanel(v)
			</div>
		</div>
		@confirmDialog()
		@resetDialog()
		// O miolo é o mesmo do início: cunhar convite é uma coisa só. Aqui a rota devolve
		// também a lista de convites abertos.
		@ds.Dialog("admin-invite", "Convidar jogador", nil) {
			@ds.InviteBody("/admin/convites")
		}
		<p class="ds-help ds-reg-error" data-show="$error != ''" data-text="$error" style="display:none"></p>
	</main>
}

templ playersPanel(v adminView) {
	<section id="players-panel">
		@ds.List("Jogadores", ui.Int(len(v.Players))) {
			for _, j := range v.Players {
				<div class="ds-row">
					<div>
						<div class="ds-row-title">
							{ j.Name }
							if j.IsMe {
								@ds.Badge("você", true)
							}
						</div>
						<div class="ds-row-meta">{ j.Email }</div>
						<div class="ds-row-meta">{ j.Belongings }</div>
					</div>
					<div class="ds-admin-acts">
						// Redefinir vale para TODA conta, inclusive a sua: o admin que esqueceu a
						// própria senha usa a mesma porta. É só apagar que tem a guarda do `IsMe`,
						// porque essa não tem volta.
						//
						// O `#reset-link` é LIMPO ao abrir, e isso não é zelo: sem limpar, gerar um
						// link para a Ana, fechar e abrir a caixa da Bia mostra o link da ANA sob o
						// nome da BIA — um link de redefinição entregue à pessoa errada.
						@ds.IconButton(ds.ButtonGhost, "KeyRound", "Redefinir a senha de "+j.Name, templ.Attributes{
							"type": "button", "data-id": fmt.Sprint(j.ID), "data-name": j.Name,
							"data-on:click": "$target_id = el.dataset.id; $target_name = el.dataset.name; $copied = false; document.getElementById('reset-link').innerHTML = ''; document.getElementById('reset').showModal()",
						})
						// O nome e o custo viajam em `data-*` e NUNCA dentro da expressão. Interpolar
						// o nome num `data-on:click` seria injetar texto de usuário em JavaScript: o
						// escape é para contexto de ATRIBUTO, não sabe que ali dentro há uma expressão,
						// e um nome com aspas fecharia a string. O vermelho fica na confirmação: numa
						// lista ele se repetiria em toda linha.
						if !j.IsMe {
							@ds.IconButton(ds.ButtonGhost, "Trash2", "Apagar a conta de "+j.Name, templ.Attributes{
								"type": "button", "data-id": fmt.Sprint(j.ID), "data-name": j.Name, "data-cost": j.Cost,
								"data-on:click": "$target_id = el.dataset.id; $target_cost = el.dataset.cost; document.querySelector('#confirm .ds-dialog-title').textContent = 'Apagar a conta de ' + el.dataset.name + '?'; document.getElementById('confirm').showModal()",
							})
						}
					</div>
				</div>
			}
		}
	</section>
}

templ invitesPanel(v adminView) {
	<section id="invites-panel" class="ds-admin-panel">
		<header class="ds-admin-head">
			<h2 class="ds-list-head">{ fmt.Sprintf("Convites abertos · %d", len(v.Invites)) }</h2>
			@ds.Button(ds.ButtonSecondary, templ.Attributes{
				"type": "button", "data-on:click": "$copied = false; document.getElementById('invite-link').innerHTML = ''; document.getElementById('admin-invite').showModal()",
			}) {
				@ui.Icon("UserPlus", "ds-icon")
				Convidar
			}
		</header>
		if len(v.Invites) == 0 {
			<p class="ds-row-meta">Nenhum convite pendente. Todo mundo que foi convidado já entrou.</p>
		} else {
			@ds.List("", "") {
				for _, c := range v.Invites {
					<div class="ds-row">
						<div>
							<div class="ds-row-title">{ c.Label }</div>
							<div class="ds-row-meta">{ "Expira em " + c.Expires + "." }</div>
						</div>
						<div class="ds-admin-acts">
							@ds.Button(ds.ButtonGhost, templ.Attributes{
								"type": "button", "data-url": c.URL, "aria-label": "Copiar o " + c.Label,
								"data-on:click": ui.CopyThen("location.origin + el.dataset.url", "$copied = true"),
							}) {
								@ui.Icon("Copy", "ds-icon")
								Copiar
							}
							// Sem confirmação: o pior caso é gerar outro link e mandar de novo.
							@ds.IconButton(ds.ButtonGhost, "Trash2", "Revogar o "+c.Label, templ.Attributes{
								"type": "button", "data-on:click": fmt.Sprintf("@post('/admin/convites/%d/revogar')", c.ID),
							})
						</div>
					</div>
				}
			}
			// `aria-live` porque copiar não muda nada visível sozinho: sem isto, quem não vê a
			// tela não recebe confirmação nenhuma de que o clique fez algo.
			<p class="ds-row-meta" aria-live="polite" data-show="$copied" style="display:none">Link copiado.</p>
		}
	</section>
}

templ serverPanel(v adminView) {
	<section id="server-panel" class="ds-admin-panel">
		<header class="ds-admin-head">
			<h2 class="ds-list-head">Servidor</h2>
		</header>
		<div class="ds-card">
			<dl class="ds-entry-fields">
				<dt>Ambiente</dt>
				<dd>{ v.Machine.Environment }</dd>
				<dt>Banco</dt>
				<dd>{ v.Machine.Database + " · " + v.Machine.DatabaseSize }</dd>
				<dt>Conteúdo</dt>
				<dd>{ v.Machine.Contents }</dd>
			</dl>
		</div>
	</section>
}

// backupsPanel é a lista dos backups guardados, só para consulta.
//
// Sem stream nenhum nesta tela: quem redesenha é a RESPOSTA do POST, que volta com o
// remendo deste painel. A Mesa precisa de SSE porque lá a mudança vem de outra pessoa;
// aqui, de quem clicou.
templ backupsPanel(v adminView) {
	<section id="backups-panel" class="ds-admin-panel">
		<header class="ds-admin-head">
			<h2 class="ds-list-head">{ backupsHeading(v) }</h2>
			@ds.Button(ds.ButtonSecondary, templ.Attributes{
				"type": "button", "data-indicator:saving": true, "data-attr:disabled": "$saving",
				"data-on:click": "@post('/admin/backup')",
			}) {
				Fazer backup
			}
		</header>
		if len(v.Backups) == 0 {
			<p class="ds-row-meta">Nenhum backup ainda.</p>
		} else {
			@ds.List("", "") {
				for _, b := range v.Backups {
					<div class="ds-row">
						<div>
							<div class="ds-row-title">{ b.When }</div>
							<div class="ds-row-meta">{ b.Name }</div>
						</div>
						<span class="ds-row-meta">{ b.Size }</span>
					</div>
				}
			}
		}
	</section>
}

// confirmDialog é o DESTRUTIVO. UM diálogo para todas as linhas, e não um por jogador: o
// conteúdo vem de sinais, e um por linha seria N cópias de DOM para um que se usa por vez.
// Por isso ele não recebe a view. O nome no título chega por `textContent`, que é texto e
// nunca marcação.
templ confirmDialog() {
	@ds.Dialog("confirm", "Apagar a conta", confirmFoot()) {
		<p class="ds-card-text" data-text="$target_cost"></p>
	}
}

// `method="dialog"` fecha sem JavaScript nenhum — e é o que faz o botão de cancelar
// continuar funcionando se a expressão do Datastar falhar.
templ confirmFoot() {
	<form method="dialog" class="contents">
		@ds.Button(ds.ButtonGhost, nil) {
			Cancelar
		}
	</form>
	@ds.Button(ds.ButtonDanger, templ.Attributes{
		"type": "button", "data-on:click": "@post('/admin/usuarios/' + $target_id + '/apagar'); document.getElementById('confirm').close()",
	}) {
		Apagar conta
	}
}

// resetDialog entrega o link de uso único que troca a senha de UMA conta: o admin gera e
// manda, e quem recebe escolhe a própria senha — o admin nunca vê nem digita senha de
// ninguém.
//
// O token chega por REMENDO do servidor (`#reset-link`) e NUNCA por sinal: sinal de cliente
// viaja de volta ao servidor em toda requisição seguinte da página, e um token de uso único
// que abre uma conta EXISTENTE é a última coisa que se quer nesse caminho.
templ resetDialog() {
	@ds.Dialog("reset", "Redefinir senha", resetFoot()) {
		<p class="ds-card-text">
			Envie o link para <span data-text="$target_name"></span>. Vale uma vez só, expira em 24 horas, e quem recebe escolhe a própria senha — você não vê nem digita senha de ninguém.
		</p>
		<div id="reset-link"></div>
	}
}

templ resetFoot() {
	@ds.Button(ds.ButtonPrimary, templ.Attributes{
		"type": "button", "data-indicator:generating": true, "data-attr:disabled": "$generating",
		"data-on:click": "@post('/admin/usuarios/' + $target_id + '/redefinir')",
	}) {
		Gerar link
	}
}

// mintedReset é o remendo que volta do POST, e carrega o CAMINHO — nunca a URL inteira. A
// origem é do NAVEGADOR: montada com o `r.Host`, ela nasce apontando para a porta errada
// sempre que alguma coisa reescreva o cabeçalho no caminho, e link de redefinição existe
// para ser MANDADO — host errado é link morto.
templ mintedReset(path string) {
	<div id="reset-link" class="ds-hub-invite">
		<input id="reset-url" class="ds-input" readonly aria-label="Link de redefinição" data-path={ path } data-init="el.value = location.origin + el.dataset.path"/>
		@ds.Button(ds.ButtonSecondary, templ.Attributes{
			"type": "button", "data-on:click": ui.CopyThen("document.getElementById('reset-url').value", "$copied = true"),
		}) {
			@ui.Icon("Copy", "ds-icon")
			Copiar
		}
		<p class="ds-help" aria-live="polite" data-show="$copied" style="display:none">Link copiado.</p>
		<p class="ds-help">Enquanto o link não for usado, a senha atual continua valendo.</p>
	</div>
}

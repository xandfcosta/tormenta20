package forge

import (
	"strconv"
	"strings"
	"t20engine/serve/web/ds"
	"t20engine/serve/web/ui"
)

// A FORJA no Tempestade (ALE-535), pelo mockup aprovado `forja.html`: o nome,
// raça, classe e origem como linhas que abrem uma folha com busca, o
// equipamento num cartão e Forjar preso embaixo.
//
// O ESTADO TEM UMA CASA SÓ: o próprio formulário. O que precisa do servidor é o
// EQUIPAMENTO, que muda com a classe, e a linha que diz o que foi escolhido; o
// `@post` do Datastar manda o formulário inteiro (`contentType: 'form'`) e a
// folha volta redesenhada.
//
// AS FOLHAS MORAM FORA DO FORMULÁRIO. O `ds.Dialog` traz o próprio `<form
// method="dialog">` para o fechar, e um formulário dentro de outro o HTML
// ignora — o fechar passaria a ENVIAR a forja. Cada rádio se liga ao formulário
// pelo atributo `form`, e o `@post` acha o formulário pelo `selector`.
//
// O NOME NÃO É `required` no navegador de propósito: o `@post` chamaria
// `checkValidity()` antes de redesenhar, e a primeira escolha antes do batismo
// viraria um "preencha este campo". Quem recusa nome vazio é o servidor.
templ forgeSheet(v forgeView) {
	@forgeBody(v)
}

// forgeBody é o que o Datastar remenda quando uma escolha muda — daí o `id`.
templ forgeBody(v forgeView) {
	<div id="forge" class="ds-forge" data-signals="{race_query: '', class_query: '', origin_query: ''}">
		<form id="forge-form" method="post" action="/personagens/nova" class="ds-forge-form" data-nav-region="content" data-nav-layout="column">
			@fieldRefusals(v.OrphanRefusals)
			@ds.TextField(ds.Field{ID: "forge-name", Name: "name", Label: "Nome", Value: v.Name, Placeholder: "Como a mesa vai chamar o herói", Error: strings.Join(v.Errors["name"], " ")}, templ.Attributes{"maxlength": strconv.Itoa(heroNameMax)})
			<div class="ds-list">
				@pickRow("race", "Raça", "forge-race", v.racePick())
				@pickRow("class", "Classe", "forge-class", v.classPick())
				@pickRow("origin", "Origem", "forge-origin", v.originPick())
			</div>
			@fieldRefusals(v.Errors["race"])
			@fieldRefusals(v.Errors["class"])
			@fieldRefusals(v.Errors["origin"])
			if v.Gear != nil {
				@gearChoice(*v.Gear, v.Errors)
			} else {
				@ds.Empty("Equipamento inicial", "Ele aparece com a classe: é ela que diz que armas e armaduras o kit oferece.")
			}
			<p class="ds-help">Poderes, benefícios de origem, treino de perícia e as escolhas da raça se terminam na ficha.</p>
			<div class="ds-forge-foot">
				@ds.LinkButton(ds.ButtonSecondary, templ.SafeURL("/personagens"), nil) {
					Cancelar
				}
				@ds.Button(ds.ButtonPrimary, templ.Attributes{"type": "submit"}) {
					Forjar
				}
			</div>
		</form>
		@ds.Dialog("forge-race", "Raça", nil) {
			@ds.FilterBar() {
				@pickSearch("race_query", "Buscar raça")
			}
			@ds.DialogScroll() {
				<div class="ds-forge-options">
					for _, c := range v.Races {
						@racePickOption(c)
					}
				</div>
			}
		}
		@ds.Dialog("forge-class", "Classe", nil) {
			@ds.FilterBar() {
				@pickSearch("class_query", "Buscar classe")
			}
			@ds.DialogScroll() {
				<div class="ds-forge-options">
					for _, c := range v.Classes {
						@classPickOption(c)
					}
				</div>
			}
		}
		@ds.Dialog("forge-origin", "Origem", nil) {
			@ds.FilterBar() {
				@pickSearch("origin_query", "Buscar origem")
			}
			@ds.DialogScroll() {
				<div class="ds-forge-options">
					for _, o := range v.Origins {
						@originPickOption(o)
					}
				</div>
			}
		}
	</div>
}

// forgeRedraw é o comando que redesenha a folha com o formulário do jeito que
// ele está agora. Ele NÃO grava nada — quem cria o herói é o `submit`.
func forgeRedraw() string {
	return "@post('/personagens/nova/esboco', {contentType: 'form', selector: '#forge-form'})"
}

// pickRow é a linha que abre a folha de uma escolha: o rótulo, o que foi
// escolhido (ou o convite) e a seta.
templ pickRow(field, label, dialogID string, chosen pickSummary) {
	<button type="button" class="ds-row ds-forge-pick" id={ "forge-pick-" + field } commandfor={ dialogID } command="show-modal">
		<span class="ds-forge-pick-key">{ label }</span>
		if chosen.Title != "" {
			<span class="ds-forge-pick-value">
				<span class="ds-row-title">{ chosen.Title }</span>
				<span class="ds-row-meta">{ chosen.Meta }</span>
			</span>
		} else {
			<span class="ds-row-title ds-forge-pick-empty">Escolher</span>
		}
		@ui.Icon("ChevronRight", "ds-icon")
	</button>
}

templ pickSearch(signal, label string) {
	@ds.SearchField("forge-"+signal, label, templ.Attributes{"data-bind:" + signal: true})
}

// As OPÇÕES de cada folha: o rádio cobre a linha inteira (`ds-pick`), e ele
// pertence ao formulário da forja pelo atributo `form`.
templ racePickOption(c raceCard) {
	<label class="ds-pick ds-forge-option" data-find={ c.Find } data-show={ pickFilter("race_query") }>
		<input type="radio" name="race" form="forge-form" value={ c.ID } checked?={ c.Chosen } data-on:change={ pickChosen() }/>
		<span class="ds-row-title">{ c.Name }</span>
		if c.Attributes != "" {
			<span class="ds-forge-option-accent">{ c.Attributes }</span>
		}
		<span class="ds-row-meta">
			{ c.Size + " · " + strconv.Itoa(c.Displacement) + "m" }
			if c.Abilities != "" {
				{ " · " + c.Abilities }
			}
		</span>
	</label>
}

// A classe pede ao servidor a cada troca: é ela que diz o que o kit de p140
// oferece, e essa regra não é copiada para uma expressão do navegador.
templ classPickOption(c classCard) {
	<label class="ds-pick ds-forge-option" data-find={ c.Find } data-show={ pickFilter("class_query") }>
		<input type="radio" name="class" form="forge-form" value={ c.Name } checked?={ c.Chosen } data-on:change={ pickChosen() }/>
		<span class="ds-row-title">{ c.Name }</span>
		<span class="ds-forge-option-accent">{ "PV " + strconv.Itoa(c.PV) + " · PM " + strconv.Itoa(c.PM) }</span>
		<span class="ds-row-meta">{ c.Expertises }</span>
	</label>
}

templ originPickOption(o originOption) {
	<label class="ds-pick ds-forge-option" data-find={ o.Find } data-show={ pickFilter("origin_query") }>
		<input type="radio" name="origin" form="forge-form" value={ o.ID } checked?={ o.Chosen } data-on:change={ pickChosen() }/>
		<span class="ds-row-title">{ o.Name }</span>
		if o.Benefit != "" {
			<span class="ds-row-meta">{ o.Benefit }</span>
		}
	</label>
}

// gearChoice é o Equipamento Inicial de p140, já estreitado pela classe. Ele só
// aparece depois da classe escolhida porque antes disso não existe kit para
// oferecer — e oferecer o errado é pior que não oferecer.
templ gearChoice(g startingGear, errs map[string][]string) {
	@ds.Card("Equipamento inicial", nil) {
		<p class="ds-card-text">
			Mochila, saco de dormir e traje de viajante vêm com todo mundo, mais T$ 4d6
			rolados na hora (p140).
		</p>
		@itemSelect("weaponSimple", "Arma simples", g.SimpleWeapons, errs["weaponSimple"])
		if len(g.MartialWeapons) > 0 {
			@itemSelect("weaponMartial", "Arma marcial", g.MartialWeapons, errs["weaponMartial"])
		}
		if len(g.Armors) > 0 {
			@itemSelect("armor", "Armadura", g.Armors, errs["armor"])
		} else {
			<p class="ds-card-text">Arcanistas começam sem armadura.</p>
		}
		if g.Shield != "" {
			@ds.Switch(g.Shield, g.ShieldChosen, templ.Attributes{"name": "shield", "value": "1"})
		}
		if len(g.ToResolve) > 0 {
			<div class="ds-forge-still">
				<span class="ds-field-label">A origem ainda dá, e isto se escolhe na Mochila</span>
				for _, label := range g.ToResolve {
					<span class="ds-row-meta">{ label }</span>
				}
			</div>
		}
	}
}

templ itemSelect(name, label string, options []itemOption, errs []string) {
	<div
		class="ds-field"
		if len(errs) > 0 {
			data-invalid
		}
	>
		<label for={ name }>{ label }</label>
		<select class="ds-input" id={ name } name={ name }>
			<option value="">Escolha…</option>
			for _, o := range options {
				<option value={ o.ID } selected?={ o.Chosen }>{ o.Label }</option>
			}
		</select>
		@fieldRefusals(errs)
	</div>
}

templ fieldRefusals(messages []string) {
	for _, m := range messages {
		<p class="ds-forge-refusal" role="alert">{ m }</p>
	}
}

package characters

import (
	"fmt"
	"strconv"
	"t20engine/serve/web/ds"
	"t20engine/serve/web/ui"
)

// O ELENCO no sistema Tempestade (ALE-528), pelo mockup aprovado
// `personagens.html`: o cabeçalho com a forja no +, a busca presa no topo e um
// cartão por herói. O carrossel com palco, trilho e dossiê saiu — tudo o que o
// dossiê mostrava está na ficha, a um toque (decisão do dono).
//
// A capa e o texto do cartão são as peças do cartão de campanha; o cartão em
// si é próprio porque o link dele cobre o cartão inteiro.

// SceneBody embrulha a cena no elemento que o remendo da busca substitui — o
// `id` é o que o morph casa.
templ SceneBody(v View) {
	<div id="characters-scene" class="ds-cast-scene">
		@castBar(v)
		<div class="ds-cast">
			if !v.HasAny {
				@ds.Empty("Seu elenco está vazio", "O primeiro herói começa na forja.") {
					<div class="ds-camps-empty-acts">
						@ds.LinkButton(ds.ButtonPrimary, templ.SafeURL("/personagens/nova"), nil) {
							Forjar um herói
						}
					</div>
				}
			} else {
				// A BUSCA NÃO ROLA COM A LISTA (revisão do dono): ela fica presa no
				// topo de quem rola, e só os cartões passam por baixo dela.
				@ds.FilterBar() {
					@ds.SearchField("characters-search", "Buscar personagem", templ.Attributes{
						"name": "busca", "value": v.Search, "data-busca": true, "data-bind:search": true,
						"data-on:input__debounce.250ms": "@get('/personagens')",
					})
				}
				if v.FilteredAll {
					@ds.Empty(fmt.Sprintf("Nenhum herói casa com %q", v.Search), "Tente outro nome, classe, origem ou raça — ou limpe a busca.") {
						<div class="ds-camps-empty-acts">
							@ds.Button(ds.ButtonSecondary, templ.Attributes{"type": "button", "data-on:click": "$search = ''; @get('/personagens')"}) {
								Limpar a busca
							}
						</div>
					}
				} else {
					<div class="ds-cast-grid" data-nav-region="personagens" data-nav-layout="grid">
						for _, h := range v.Heroes {
							@heroCardView(h)
						}
					</div>
				}
			}
		</div>
	</div>
}

// castBar é o cabeçalho: a seta para o início, o título e a forja no +. Com o
// elenco vazio o + não sai, porque o próprio vazio já leva à forja.
templ castBar(v View) {
	<header class="ds-header" data-signals={ fmt.Sprintf("{search: %q}", v.Search) }>
		<a href="/" class="ds-header-back" aria-label="Voltar para o início">
			@ui.Icon("ChevronLeft", "ds-icon")
		</a>
		<h1 class="ds-header-title">Personagens</h1>
		if v.HasAny {
			<span class="ds-header-acts">
				<a href="/personagens/nova" class="ds-button" data-icon aria-label="Forjar um herói" title="Forjar um herói">
					@ui.Icon("Plus", "ds-icon")
				</a>
			</span>
		}
	</header>
}

// heroCardView é o cartão: a capa de iniciais, o nome e a placa, DEF/PV/PM em
// três blocos iguais e a linha de devoção, origem e tamanho.
//
// A Defesa nunca some — sem motor ela é um travessão —, e o PM fica apagado em
// quem não tem mana: um "0/0" em destaque não diz nada a quem não conjura.
templ heroCardView(h HeroCard) {
	<article class="ds-cast-card">
		<a class="ds-cast-head" href={ templ.SafeURL("/personagens/" + strconv.FormatInt(h.ID, 10)) } aria-label={ "Abrir ficha de " + h.Name }>
			<span class="ds-camp-cover" aria-hidden="true" style={ "background: " + h.Gradient }>{ h.Monogram }</span>
			<span class="ds-camp-text">
				<b>{ h.Name }</b>
				<span class="ds-row-meta">{ h.Role }</span>
			</span>
		</a>
		<dl class="ds-cast-vitals">
			<div>
				<dt>DEF</dt>
				<dd>{ h.Defense }</dd>
			</div>
			// A PALAVRA DE QUEM CAIU (p236) vai na linha do rótulo, como na ficha:
			// ao lado do número, "0/51 estável" vazava do bloco a 390px.
			<div data-tone={ h.PVTone }>
				<dt>
					PV
					if h.PVDown != "" {
						<span class="ds-cast-down">{ h.PVDown }</span>
					}
				</dt>
				<dd>{ h.PV }</dd>
			</div>
			<div
				data-kind="pm"
				if h.NoMana {
					data-dim
				}
			>
				<dt>PM</dt>
				<dd>{ h.PM }</dd>
			</div>
		</dl>
		if h.Summary != "" {
			<p class="ds-cast-line">{ h.Summary }</p>
		}
	</article>
}

package campaigns

import (
	"fmt"
	"strconv"
	"strings"

	"t20engine/domain/campaign"
	"t20engine/serve/web/ds"
	"t20engine/serve/web/routes"
	"t20engine/serve/web/ui"
)

// A CRÔNICA no Tempestade (ALE-526), pelo mockup aprovado `campanhas.html`: a
// capa, o papel e o nome; a sessão ao vivo no mesmo cartão do início; e as
// seções como abas do kit.
//
// A ABA é um LINK e não um botão com estado, e isso é a decisão que sustenta a
// cena inteira: `?tab=sessoes` é endereço, então ele volta no histórico, abre em
// nova aba, e é o que alguém cola no chat da mesa. No servidor o parâmetro É o
// estado e chega junto com o pedido — não há o que espelhar.

templ oneBody(v oneView) {
	<div class="ds-camps-scene">
		// O cabeçalho é da cena, e não da casca densa, porque o `<h1>` é o nome da
		// campanha logo abaixo, e a barra só diz onde se está.
		<header class="ds-header">
			<a href="/campanhas" class="ds-header-back" aria-label="Voltar para Campanhas" title="Voltar para Campanhas">
				@ui.Icon("ChevronLeft", "ds-icon")
			</a>
			<p class="ds-header-title">Campanha</p>
		</header>
		<div class="ds-camps">
			@oneHead(v)
			if v.LiveSessionID > 0 {
				@oneLiveCard(v)
			}
			// No celular as cinco abas do mestre não cabem e a faixa rola; a aba
			// ATIVA é trazida para a vista, senão "Configurações" abre cortada.
			<nav
				class="ds-tabs"
				aria-label="Seções da campanha"
				data-nav-region="rail"
				data-nav-layout="row"
				data-nav-edge-down="content"
				data-init="el.querySelector('[aria-current]')?.scrollIntoView({block: 'nearest', inline: 'nearest'})"
			>
				for _, a := range v.Tabs {
					@ds.Tab(templ.SafeURL(fmt.Sprintf("/campanhas/%d?tab=%s", v.ID, a.ID)), a.Active, templ.Attributes{"data-nav-item": true}) {
						{ a.Label }
					}
				}
			</nav>
			<div class="ds-camp-pane" data-nav-region="content" data-nav-layout={ tabLayout(v.AbaAtiva()) } data-nav-edge-up="rail">
				switch v.AbaAtiva() {
					case "sessoes":
						@sessionsTab(v)
					case "membros":
						@membersTab(v)
					case "lugares":
						@placesTab(v)
					case "config":
						@configTab(v)
					default:
						@overviewTab(v)
				}
			</div>
		</div>
	</div>
}

// oneHead é a capa, o papel ACIMA do nome — ele responde "o que eu sou nesta
// mesa", que é a primeira pergunta de quem abre a página — e o nome.
templ oneHead(v oneView) {
	<div class="ds-camp-detail-head">
		<span class="ds-camp-cover" data-big aria-hidden="true" style={ "background: " + ui.NameGradient(v.Name) }>{ ui.Monogram(v.Name) }</span>
		<span class="ds-camp-text">
			<span class="ds-row-meta">{ tableMeta(v) }</span>
			<h1 class="ds-camp-detail-name">{ v.Name }</h1>
		</span>
	</div>
}

// oneLiveCard é a sessão viva, no desenho do cartão do início.
templ oneLiveCard(v oneView) {
	<a class="ds-hub-live" href={ templ.SafeURL(routes.Session(v.ID, v.LiveSessionID)) }>
		<span class="ds-hub-live-dot" aria-hidden="true"></span>
		<span class="ds-hub-live-body">
			<span class="ds-row-meta">Em andamento</span>
			<b>{ fmt.Sprintf("Sessão %d", v.LiveSessionNumber) }</b>
			if v.LiveSessionTitle != "" {
				<span class="ds-row-meta">{ v.LiveSessionTitle }</span>
			}
		</span>
		<span class="ds-button">
			Voltar à mesa
			@ui.Icon("ChevronRight", "ds-icon")
		</span>
	</a>
}

// roleAtTable é o que EU sou aqui. O nome do dono só aparece para ADMIN que não
// é dono — para o jogador, marcar a mesa trocaria o "Jogando" dele por "Mesa de
// Fulano".
func roleAtTable(v oneView) string {
	switch {
	case v.OtherOwner != "":
		return "Mesa de " + v.OtherOwner
	case v.IsGM:
		return "Mestrando"
	default:
		return "Jogando"
	}
}

// tableMeta é a linha acima do nome: o papel e desde quando a mesa existe.
func tableMeta(v oneView) string {
	row := roleAtTable(v)
	if v.CreatedAt != "" {
		row += " · criada em " + v.CreatedAt
	}
	return row
}

// tabLayout: o elenco é grade; o resto são listas. É o que faz a seta andar
// como o olho vê.
func tabLayout(aba string) string {
	if aba == "membros" {
		return "grid"
	}
	return "column"
}

// ── as seções ────────────────────────────────────────────────────────────────

// A visão geral: a sinopse, os números, o grupo e as sessões recentes.
//
// Os números vêm CONTADOS do servidor. Calculados na tela a partir de duas
// consultas com estados de carregamento próprios, há um instante em que a página
// diz "0 heróis" porque uma das duas ainda não voltou.
templ overviewTab(v oneView) {
	if v.Description != "" {
		<p class="ds-camp-detail-syn">{ v.Description }</p>
	}
	<div class="ds-stats ds-camp-stats">
		@ds.Stat("Heróis", strconv.Itoa(v.TotalHeroes))
		@ds.Stat("Sessões", strconv.Itoa(v.TotalSessions))
		@ds.Stat("Encerradas", strconv.Itoa(v.EndedSessions))
	</div>
	<div class="ds-camp-two">
		@ds.List("Grupo", countOf(int64(v.TotalHeroes), "herói", "heróis")) {
			if len(v.Heroes) == 0 {
				<p class="ds-row ds-row-meta">Nenhum personagem inscrito ainda.</p>
			}
			for _, h := range firstHeroes(v.Heroes, 6) {
				@heroRow(h)
			}
			if len(v.Heroes) > 6 {
				@seeAll(v.ID, "membros", fmt.Sprintf("Ver os %d membros", len(v.Heroes)))
			}
		}
		@ds.List("Sessões", strconv.Itoa(v.TotalSessions)) {
			if len(v.Sessions) == 0 {
				<p class="ds-row ds-row-meta">Nenhuma sessão ainda.</p>
			}
			for _, sess := range firstSessions(v.Sessions, 3) {
				@sessionLine(v.ID, sess)
			}
			if len(v.Sessions) > 3 {
				@seeAll(v.ID, "sessoes", "Ver todas as sessões")
			}
		}
	</div>
}

templ seeAll(campaignID int64, aba, text string) {
	<a class="ds-row ds-camp-more" href={ templ.SafeURL(fmt.Sprintf("/campanhas/%d?tab=%s", campaignID, aba)) }>
		{ text }
		@ui.Icon("ChevronRight", "ds-icon")
	</a>
}

// heroRow é um herói do grupo. Quem mestra leva a COROA e não a palavra
// "mestre": o crachá de texto competia com o nome pela mesma largura.
templ heroRow(h heroAtTable) {
	<div class="ds-row ds-camp-row">
		<span class="ds-camp-hero-mark" aria-hidden="true" style={ "background: " + h.Gradient }>{ h.Initials }</span>
		<span class="ds-camp-text">
			<span class="ds-row-title">{ h.Name }</span>
			<span class="ds-row-meta">{ h.Meta }</span>
		</span>
		if h.IsGM {
			<span class="ds-camp-crown" role="img" aria-label="mestre da mesa">
				@ui.Icon("Crown", "ds-icon")
			</span>
		}
	</div>
}

// A linha da sessão é uma LINHA DO TEMPO: número, título, estado e data. Sem a
// data, "Sessão 4" não diz se foi ontem ou em março. A AO VIVO é destaque da
// própria linha, como no cartão da lista, e não crachá.
templ sessionLine(campaignID int64, sess sessionRow) {
	<a
		class="ds-row ds-camp-row"
		href={ templ.SafeURL(routes.Session(campaignID, sess.ID)) }
		data-nav-item
		if sess.Alive {
			data-live
		}
	>
		<span class="ds-camp-num">{ strconv.FormatInt(sess.Number, 10) }</span>
		<span class="ds-camp-text">
			<span class="ds-row-title">{ sessionName(sess) }</span>
			<span class="ds-row-meta">{ sessionMeta(sess) }</span>
		</span>
		@ui.Icon("ChevronRight", "ds-icon")
	</a>
}

// Sessão sem título vira "Sessão N" e não uma linha em branco — linha vazia
// numa lista não se clica com confiança.
func sessionName(sess sessionRow) string {
	if sess.Title == "" {
		return "Sessão " + strconv.FormatInt(sess.Number, 10)
	}
	return sess.Title
}

// sessionMeta é o estado e a data: "ao vivo agora", "encerrada · 12/10/2026".
func sessionMeta(sess sessionRow) string {
	if sess.Alive {
		return "ao vivo agora"
	}
	state := strings.ToLower(sess.State)
	if sess.Data == "" {
		return state
	}
	return state + " · " + sess.Data
}

// O Nova sessão é do MESTRE, e a trava é do caso de uso; para o jogador a aba é
// só a linha do tempo. Ele abre um DIÁLOGO e não cria direto: um clique solto
// criaria uma sessão que ninguém pediu (revisão do dono).
templ sessionsTab(v oneView) {
	if v.IsGM {
		@ds.Button(ds.ButtonSecondary, templ.Attributes{"type": "button", "data-on:click": "document.getElementById('new-session').showModal()"}) {
			@ui.Icon("Plus", "ds-icon")
			Nova sessão
		}
		@newSessionDialog(v)
	}
	@ds.List("Sessões", strconv.Itoa(v.TotalSessions)) {
		if len(v.Sessions) == 0 {
			<p class="ds-row ds-row-meta">Nenhuma sessão ainda.</p>
		}
		for _, sess := range v.Sessions {
			if v.IsGM {
				@sessionLineWithDelete(v.ID, sess)
			} else {
				@sessionLine(v.ID, sess)
			}
		}
	}
}

// newSessionDialog: o nome é opcional, e o número já vem dito — sem nome, ela é
// a "Sessão N" que o diálogo anuncia.
templ newSessionDialog(v oneView) {
	@ds.Dialog("new-session", "Nova sessão", nil) {
		<form method="post" action={ templ.SafeURL(fmt.Sprintf("/campanhas/%d/nova-sessao", v.ID)) } class="ds-camp-form">
			@ds.TextField(ds.Field{ID: "session-title", Name: "title", Label: "Nome (opcional)", Placeholder: "A caçada ao Bicho-papão", Help: fmt.Sprintf("Ela será a sessão %d, planejada. Você a inicia na mesa.", v.NextSessionNumber)}, nil)
			@ds.Button(ds.ButtonPrimary, templ.Attributes{"type": "submit"}) {
				Criar sessão
			}
		</form>
	}
}

// sessionLineWithDelete é a linha do mestre: o link para a mesa e, ao lado, o
// apagar. O apagar é a MESMA rota da mesa (`DELETE` no endereço da sessão), com
// a mesma trava e a mesma limpeza de memória — uma regra, um lugar.
templ sessionLineWithDelete(campaignID int64, sess sessionRow) {
	<div
		class="ds-row ds-camp-row ds-camp-session"
		if sess.Alive {
			data-live
		}
	>
		<a class="ds-camp-session-link" href={ templ.SafeURL(routes.Session(campaignID, sess.ID)) } data-nav-item>
			<span class="ds-camp-num">{ strconv.FormatInt(sess.Number, 10) }</span>
			<span class="ds-camp-text">
				<span class="ds-row-title">{ sessionName(sess) }</span>
				<span class="ds-row-meta">{ sessionMeta(sess) }</span>
			</span>
		</a>
		@ds.IconButton(ds.ButtonGhost, "Trash2", "Apagar "+sessionName(sess), templ.Attributes{"type": "button", "data-on:click": fmt.Sprintf("document.getElementById('%s').showModal()", deleteSessionDialogID(sess))})
		@ds.Dialog(deleteSessionDialogID(sess), fmt.Sprintf("Apagar a sessão %d?", sess.Number), deleteSessionFoot(campaignID, sess)) {
			<p class="ds-help">A fila, o tabuleiro e o histórico desta sessão vão junto. As fichas e a campanha ficam como estão. Não dá para desfazer.</p>
		}
	</div>
}

func deleteSessionDialogID(sess sessionRow) string {
	return "delete-session-" + strconv.FormatInt(sess.ID, 10)
}

// deleteSessionFoot: `DELETE` com Datastar, e não `form` — o `form` do HTML só
// faz `GET` e `POST` (ALE-344). Quem navega depois é o `sse.Redirect` da rota.
templ deleteSessionFoot(campaignID int64, sess sessionRow) {
	<form method="dialog">
		@ds.Button(ds.ButtonSecondary, templ.Attributes{"type": "submit"}) {
			Cancelar
		}
	</form>
	@ds.Button(ds.ButtonDanger, templ.Attributes{"type": "button", "data-on:click": fmt.Sprintf("document.getElementById('%s').close(); @delete('%s')", deleteSessionDialogID(sess), routes.Session(campaignID, sess.ID))}) {
		Apagar a sessão
	}
}

templ membersTab(v oneView) {
	@ds.List("Grupo", countOf(int64(v.TotalHeroes), "herói", "heróis")) {
		if len(v.Heroes) == 0 {
			<p class="ds-row ds-row-meta">Nenhum personagem inscrito ainda.</p>
		}
		for _, h := range v.Heroes {
			@heroRow(h)
		}
	}
}

// A aba de CONFIGURAÇÕES: o cadastro, o link, as regras opcionais e o excluir —
// nesta ordem. Regra opcional é ajuste CORRIQUEIRO e não destruição, então ela
// fica antes do que apaga; posta depois, herdaria o tom de risco.
templ configTab(v oneView) {
	@campaignForm(v)
	@invitePanel(v)
	@rulesPanel(v)
	@dangerZone(v)
}

// O cadastro grava pela mesma regra da nova campanha (`campaign.Name` /
// `campaign.Description`), então "salvar" e "criar" não discordam sobre o que é
// um nome válido.
templ campaignForm(v oneView) {
	@ds.Card("Editar campanha", nil) {
		<form method="post" action={ templ.SafeURL(fmt.Sprintf("/campanhas/%d/editar", v.ID)) } class="ds-camp-form">
			@ds.TextField(ds.Field{ID: "name", Name: "name", Label: "Nome", Value: v.Name, Error: joinErrors(v.Errors["name"])}, templ.Attributes{"required": true, "maxlength": strconv.Itoa(campaign.MaxNameLength)})
			@textArea("description", "Descrição", v.Description, "", "", joinErrors(v.Errors["description"]), campaign.MaxDescriptionLength)
			if v.Notice != "" {
				<p class="ds-help ds-reg-error" role="alert">{ v.Notice }</p>
			}
			@ds.Button(ds.ButtonPrimary, templ.Attributes{"type": "submit"}) {
				Salvar
			}
		</form>
	}
}

// O LINK DA MESA. Sem ele ninguém entra — e por isso ele fica na configuração,
// ao lado do nome, e não escondido atrás de um diálogo.
//
// A mesa sem link é uma campanha antiga, e o que cabe é o botão de gerar. Não
// há migração de dados por causa dela: um `UPDATE` varrendo o banco escreveria
// token para mesas que o dono talvez nem use mais.
//
// Só o CAMINHO viaja: quem prefixa a origem é o navegador — ver a razão em
// `ds.MintedInvite`.
templ invitePanel(v oneView) {
	<section id="invite-panel" class="ds-card" aria-labelledby="invite-panel-title" data-signals="{copied: false}">
		<h3 class="ds-card-title" id="invite-panel-title">Link da mesa</h3>
		if v.InviteLink != "" {
			<div class="ds-hub-invite">
				<input id="invite-url" class="ds-input" readonly aria-label="Link da mesa" data-path={ v.InviteLink } data-init="el.value = location.origin + el.dataset.path"/>
				@ds.Button(ds.ButtonSecondary, templ.Attributes{"type": "button", "data-on:click": ui.CopyThen("document.getElementById('invite-url').value", "$copied = true")}) {
					@ui.Icon("Copy", "ds-icon")
					Copiar
				}
			</div>
			<p class="ds-help" aria-live="polite" data-show="$copied" style="display:none">Link copiado.</p>
			<p class="ds-help">Quem abrir este link entra com um herói. Gerar outro derruba o atual: quem ainda não entrou vai precisar do novo.</p>
		} else {
			<p class="ds-help">Esta mesa não tem link. Sem um, só você entra nela.</p>
		}
		<form method="post" action={ templ.SafeURL(fmt.Sprintf("/campanhas/%d/convite", v.ID)) }>
			@ds.Button(ds.ButtonGhost, templ.Attributes{"type": "submit"}) {
				if v.InviteLink != "" {
					Gerar novo link
				} else {
					Gerar link
				}
			}
		</form>
	</section>
}

// As regras opcionais são o único lugar da crônica com Datastar: alternar um
// interruptor e recarregar a página perderia a posição de quem lê. O remendo
// volta só este painel, e a falha aparece INLINE nele.
templ rulesPanel(v oneView) {
	<section id="rules-panel" class="ds-card" aria-labelledby="rules-panel-title">
		<h3 class="ds-card-title" id="rules-panel-title">Regras opcionais</h3>
		for _, rule := range optionalRules {
			@ruleSwitch(v, rule)
		}
		<p class="ds-help ds-reg-error" data-show="$rule_error != ''" data-text="$rule_error"></p>
	</section>
}

// O interruptor é o do kit, com o título como nome e a explicação como
// descrição: o leitor de tela anuncia "Limites de carga, interruptor, ligado" e
// lê a página do livro em seguida.
templ ruleSwitch(v oneView, rule optionalRule) {
	<label class="ds-switch ds-camp-rule">
		<span class="ds-camp-text">
			<span class="ds-row-title">{ rule.Title }</span>
			<span class="ds-row-meta" id={ "rule-" + rule.ID + "-help" }>{ rule.Description }</span>
		</span>
		<input
			type="checkbox"
			role="switch"
			aria-label={ rule.Title }
			aria-describedby={ "rule-" + rule.ID + "-help" }
			checked?={ v.RegraEmVigor(rule.ID) }
			data-indicator:saving
			data-attr:disabled="$saving"
			data-on:change={ fmt.Sprintf("@post('/campanhas/%d/regras/%s')", v.ID, rule.ID) }
		/>
	</label>
}

// Excluir diz o PREÇO — o que some e o que fica —, em vez de um genérico "não
// pode ser desfeito", que não distingue apagar uma mesa vazia de apagar a de dois
// anos de crônica. Os heróis DA MESA são cópias (ALE-33) e vão junto; a ficha de
// onde cada um saiu fica com o jogador.
templ dangerZone(v oneView) {
	<section class="ds-card" data-danger aria-labelledby="danger-title">
		<h3 class="ds-card-title" id="danger-title">Excluir campanha</h3>
		<p class="ds-help">Apaga as sessões, o acervo e os heróis desta mesa. As fichas de onde eles saíram ficam com os jogadores.</p>
		// O primeiro clique ABRE o diálogo; quem apaga é o botão de dentro.
		@ds.Button(ds.ButtonSecondary, templ.Attributes{"type": "button", "data-danger": true, "data-on:click": "document.getElementById('delete').showModal()"}) {
			@ui.Icon("Trash2", "ds-icon")
			Excluir campanha
		}
		@ds.Dialog("delete", fmt.Sprintf("Excluir \"%s\"?", v.Name), deleteFoot(v)) {
			<p class="ds-help">Isto não pode ser desfeito.</p>
		}
	</section>
}

// deleteFoot: apagar é formulário de VERDADE e não `@post` — ele leva embora a
// página, e o que vem depois é uma navegação para a lista.
templ deleteFoot(v oneView) {
	<form method="dialog">
		@ds.Button(ds.ButtonSecondary, templ.Attributes{"type": "submit"}) {
			Cancelar
		}
	</form>
	<form method="post" action={ templ.SafeURL(fmt.Sprintf("/campanhas/%d/excluir", v.ID)) }>
		@ds.Button(ds.ButtonDanger, templ.Attributes{"type": "submit"}) {
			Excluir
		}
	</form>
}

func firstHeroes(hs []heroAtTable, n int) []heroAtTable {
	if len(hs) > n {
		return hs[:n]
	}
	return hs
}

func firstSessions(ss []sessionRow, n int) []sessionRow {
	if len(ss) > n {
		return ss[:n]
	}
	return ss
}

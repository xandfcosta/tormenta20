package campaigns

import (
	"fmt"

	"t20engine/serve/web/ds"
	"t20engine/serve/web/ui"
)

func improvementURL(campaignID int64, path string) string {
	return fmt.Sprintf("/campanhas/%d/melhorias-da-mesa%s", campaignID, path)
}

func openImprovementEditor(campaignID int64, improvementID string) string {
	query := ""
	if improvementID != "" {
		query = "?melhoria=" + improvementID
	}
	// Esvazia antes, pela razão do editor de regra.
	return fmt.Sprintf("document.getElementById('table-improvement-form').replaceChildren(); document.getElementById('table-improvement-editor').showModal(); @post('%s')", improvementURL(campaignID, "/editor"+query))
}

func improvementDraftPost(v improvementEditorView) string {
	return fmt.Sprintf("@post('%s')", improvementURL(v.CampaignID, "/rascunho"))
}

// A LISTA DA ABA: sem interruptor, porque criar não muda ficha nenhuma. Quem a faz valer é colocá-la
// num item.
templ tableImprovementsSection(v oneView) {
	if v.IsGM {
		<div>
			@ds.Button(ds.ButtonSecondary, templ.Attributes{"type": "button", "data-on:click": openImprovementEditor(v.ID, "")}) {
				@ui.Icon("Plus", "ds-icon")
				Nova melhoria
			}
		</div>
	}
	if len(v.TableImprovements) > 0 {
		@ds.List("Melhorias da mesa", countOf(int64(len(v.TableImprovements)), "melhoria", "melhorias")) {
			for _, improvement := range v.TableImprovements {
				<div class="ds-row ds-table-rule">
					<div class="min-w-0">
						<div class="ds-row-title">{ improvement.Name }</div>
						<div class="ds-row-meta">{ improvement.Meta }</div>
					</div>
					if v.IsGM {
						@ds.Button(ds.ButtonGhost, templ.Attributes{"type": "button", "data-on:click": openImprovementEditor(v.ID, improvement.ID)}) {
							Editar
						}
					}
				</div>
			}
		}
	}
	if v.IsGM {
		@ds.Dialog("table-improvement-editor", "Melhoria da mesa", nil) {
			<div id="table-improvement-form"></div>
		}
	}
}

// improvementEditorForm é o editor, redesenhado inteiro a cada troca. O texto digitado fica nos sinais:
// os dois campos de escrever não levam `value`, pela razão do editor de regra.
templ improvementEditorForm(v improvementEditorView) {
	<div id="table-improvement-form" class="ds-camp-form">
		if v.Refusal != "" {
			<p role="alert" class="ds-alert">{ v.Refusal }</p>
		}
		<div class="ds-field">
			<label for="table-improvement-name">Nome</label>
			<input id="table-improvement-name" class="ds-input" data-bind:table_improvement_name/>
			<span class="ds-help">É como ela aparece na lista do item e na conta da ficha.</span>
		</div>
		<div class="ds-field">
			<span class="ds-field-label">Quem pode usar</span>
			<div class="ds-options">
				@ds.Option(v.Draft.Scope != "um", templ.Attributes{"data-on:click": "$table_improvement_scope = 'mesa'; " + improvementDraftPost(v)}) {
					Toda a mesa
				}
				@ds.Option(v.Draft.Scope == "um", templ.Attributes{"data-on:click": "$table_improvement_scope = 'um'; " + improvementDraftPost(v)}) {
					Um personagem
				}
			</div>
			if v.Draft.Scope == "um" {
				@ruleSelect(improvementDraftPost(v), "Personagem", "table_improvement_character", v.Draft.Character, v.Characters)
			}
		</div>
		<div class="ds-field">
			<span class="ds-field-label">Cabe em</span>
			<div class="ds-options">
				for _, family := range v.Families {
					@ds.Option(v.Draft.Family == family.ID, templ.Attributes{"data-on:click": fmt.Sprintf("$table_improvement_family = '%s'; %s", family.ID, improvementDraftPost(v))}) {
						{ family.Name }
					}
				}
			</div>
		</div>
		<div class="ds-field">
			<span class="ds-field-label">Efeito: soma em</span>
			<div class="ds-rule-line">
				@ruleSelect(improvementDraftPost(v), "Em quê", "table_improvement_target", v.Draft.Target, v.Targets)
				if v.Draft.Target == "expertise" {
					@ruleSelect(improvementDraftPost(v), "Qual perícia", "table_improvement_skill", v.Draft.Skill, v.Skills)
				}
				<input class="ds-input ds-rule-amount" aria-label="Quanto" type="number" data-bind:table_improvement_amount data-on:change={ improvementDraftPost(v) }/>
			</div>
		</div>
		<div class="ds-field">
			<span class="ds-field-label">Prévia</span>
			<div class="ds-rule-preview">
				<p class="ds-card-text">{ v.Preview }</p>
				<p class="ds-card-text">{ v.Audience }</p>
			</div>
		</div>
		<div class="ds-rule-actions">
			if v.Draft.ID != "" {
				@ds.Button(ds.ButtonDanger, templ.Attributes{"type": "button", "data-on:click": "document.getElementById('table-improvement-remove').showModal()"}) {
					Excluir
				}
			}
			<form method="dialog">
				@ds.Button(ds.ButtonSecondary, templ.Attributes{"type": "submit"}) {
					Cancelar
				}
			</form>
			@ds.Button(ds.ButtonPrimary, templ.Attributes{"type": "button", "data-on:click": fmt.Sprintf("@post('%s')", improvementURL(v.CampaignID, "/gravar"))}) {
				Gravar
			}
		</div>
		if v.Draft.ID != "" {
			@ds.Dialog("table-improvement-remove", "Excluir esta melhoria?", removeImprovementFoot(v)) {
				<p class="ds-help">{ "Ela está " + v.Uses + ", e sai na hora da ficha de quem a usa. Não dá para desfazer." }</p>
			}
		}
	</div>
}

templ removeImprovementFoot(v improvementEditorView) {
	<form method="dialog">
		@ds.Button(ds.ButtonSecondary, templ.Attributes{"type": "submit"}) {
			Cancelar
		}
	</form>
	@ds.Button(ds.ButtonDanger, templ.Attributes{"type": "button", "data-on:click": fmt.Sprintf("document.getElementById('table-improvement-remove').close(); @post('%s')", improvementURL(v.CampaignID, "/"+v.Draft.ID+"/excluir"))}) {
		Excluir
	}
}

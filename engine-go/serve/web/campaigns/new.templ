package campaigns

import (
	"strconv"
	"strings"
	"t20engine/domain/campaign"
	"t20engine/serve/web/ds"
)

// A NOVA CAMPANHA no kit (ALE-526): o nome e a descrição, num cartão. O
// formulário é `<form method="post">` puro, como era, e a recusa volta com o que
// foi digitado.
templ newBody(v newView) {
	<div class="ds-camps-form" data-nav-region="content" data-nav-layout="column">
		<form method="post" action="/campanhas/nova" class="ds-camps-card">
			@ds.TextField(ds.Field{ID: "name", Name: "name", Label: "Nome", Value: v.Name, Placeholder: "A Ponte de Pedra", Error: strings.Join(v.Errors["name"], " ")}, templ.Attributes{"required": true, "maxlength": strconv.Itoa(campaign.MaxNameLength)})
			@textArea("description", "Descrição", v.Description, "O que esta mesa promete, em uma ou duas frases", "Opcional — aparece no cartão da campanha.", strings.Join(v.Errors["description"], " "), campaign.MaxDescriptionLength)
			if v.Notice != "" {
				<p class="ds-help ds-reg-error" role="alert">{ v.Notice }</p>
			}
			<div class="ds-camps-two">
				@ds.LinkButton(ds.ButtonSecondary, templ.SafeURL("/campanhas"), nil) {
					Cancelar
				}
				@ds.Button(ds.ButtonPrimary, templ.Attributes{"type": "submit"}) {
					Criar campanha
				}
			</div>
		</form>
	</div>
}

// textArea é a caixa de várias linhas no desenho do campo do kit: o rótulo, a
// dica e o erro no lugar dela.
templ textArea(id, label, value, placeholder, help, err string, max int) {
	<div
		class="ds-field"
		if err != "" {
			data-invalid
		}
	>
		<label for={ id }>{ label }</label>
		<textarea
			class="ds-input"
			id={ id }
			name={ id }
			rows="4"
			maxlength={ strconv.Itoa(max) }
			placeholder={ placeholder }
			if err != "" || help != "" {
				aria-describedby={ id + "-help" }
			}
		>{ value }</textarea>
		if err != "" {
			<span class="ds-help" id={ id + "-help" }>{ err }</span>
		} else if help != "" {
			<span class="ds-help" id={ id + "-help" }>{ help }</span>
		}
	</div>
}

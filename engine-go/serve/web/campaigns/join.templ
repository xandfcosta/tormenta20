package campaigns

import (
	"strconv"
	"strings"
	"t20engine/serve/web/ds"
)

// ENTRAR NUMA MESA no kit (ALE-526). Quem chega pelo link do convite vê para
// qual mesa foi chamado; quem chega sem ele digita o número que o mestre
// mandou. A escolha do herói é um grupo de rádios vestido de opções do kit.
templ JoinBody(v joinView) {
	<div class="ds-camps-form" data-nav-region="content" data-nav-layout="column">
		<form method="post" action="/campanhas/entrar" class="ds-camps-card">
			if v.HasInvite {
				<input type="hidden" name="token" value={ v.Invite }/>
				@inviteLetter(v)
			} else {
				<p class="ds-help">O mestre manda o link da mesa. Se ele mandou só o número, digite aqui.</p>
				@ds.TextField(ds.Field{ID: "campaignId", Name: "campaignId", Label: "Número da campanha", Type: "number", Value: v.TypedNumber, Error: strings.Join(v.Errors["campaignId"], " ")}, templ.Attributes{"required": true, "inputmode": "numeric"})
			}
			if len(v.Heroes) == 0 {
				@noHeroesToSeat()
			} else {
				@heroChoice(v)
			}
			if v.Notice != "" {
				<p class="ds-help ds-reg-error" role="alert">{ v.Notice }</p>
			}
			if len(v.Heroes) > 0 && (!v.HasInvite || v.InviteValid) {
				@ds.Button(ds.ButtonPrimary, templ.Attributes{"type": "submit", "data-wide": true}) {
					Entrar na mesa
				}
			}
		</form>
	</div>
}

// inviteLetter diz para qual mesa o link chama — ou que ele não vale mais,
// para a pessoa pedir outro em vez de olhar um botão que não envia (ALE-80).
templ inviteLetter(v joinView) {
	if v.InviteValid {
		<p class="ds-camps-invite">Você foi convidado para <b>{ v.CampaignName }</b>.</p>
	} else {
		<p class="ds-help ds-reg-error" role="alert">Convite inválido ou expirado. Peça um novo link ao mestre.</p>
	}
}

templ heroChoice(v joinView) {
	<fieldset class="ds-camps-heroes">
		<legend class="ds-field-label">Com qual herói você entra?</legend>
		for _, h := range v.Heroes {
			<label class="ds-pick">
				<input type="radio" name="characterId" value={ strconv.FormatInt(h.ID, 10) } checked?={ h.ID == v.ChosenID } required/>
				<span class="ds-camp-hero-mark" aria-hidden="true" style={ "background: " + h.Gradient }>{ h.Initials }</span>
				<span class="ds-camp-text">
					<b>{ h.Name }</b>
					<span class="ds-row-meta">{ h.Subtitle }</span>
				</span>
			</label>
		}
		if len(v.Errors["characterId"]) > 0 {
			<p class="ds-help ds-reg-error">{ strings.Join(v.Errors["characterId"], " ") }</p>
		}
	</fieldset>
}

templ noHeroesToSeat() {
	@ds.Empty("Você ainda não tem heróis", "Crie um antes de entrar numa mesa.") {
		<div class="ds-camps-empty-acts">
			@ds.LinkButton(ds.ButtonSecondary, templ.SafeURL("/personagens/nova"), nil) {
				Criar herói
			}
		</div>
	}
}

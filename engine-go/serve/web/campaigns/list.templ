package campaigns

import (
	"fmt"
	"strconv"
	"t20engine/serve/web/ds"
	"t20engine/serve/web/routes"
	"t20engine/serve/web/ui"
)

// A LISTA DE CAMPANHAS no sistema Tempestade (ALE-526), pelo mockup aprovado
// `campanhas.html`: o cabeçalho com a seta e o título, a busca e o filtro de
// papel, e um cartão por campanha. A campanha AO VIVO é destaque do próprio
// cartão — a faixa e o fundo verdes, "Sessão N ao vivo agora" e o "Voltar à
// mesa" —, e não um crachá, que mudava a altura do cartão (revisão do dono).

templ SceneBody(v listView) {
	<div id="campaigns-scene" class="ds-camps-scene">
		@listBody(v)
	</div>
}

templ listBody(v listView) {
	@listBar(v)
	<div class="ds-camps">
		if !v.HasAny {
			@ds.Empty("Nenhuma campanha ainda", "Comece a sua, ou entre numa com o link que o mestre enviou.") {
				<div class="ds-camps-empty-acts">
					@ds.LinkButton(ds.ButtonPrimary, templ.SafeURL("/campanhas/nova"), nil) {
						Nova campanha
					}
					@ds.LinkButton(ds.ButtonSecondary, templ.SafeURL("/campanhas/entrar"), nil) {
						Entrar numa mesa
					}
				</div>
			}
		} else {
			@listTools(v)
			if v.FilteredAll {
				@searchWithoutResult(v)
			} else {
				<div class="ds-camp-grid" data-nav-region="campanhas" data-nav-layout="grid">
					for _, c := range v.Campaigns {
						@campaignCardView(c)
					}
				</div>
			}
		}
	</div>
}

// listBar é o cabeçalho: a seta para o início, o título, e Entrar numa mesa e
// Nova campanha à direita. Ele é da cena, e não da casca, porque carrega as duas
// ações.
templ listBar(v listView) {
	<header class="ds-header" data-signals={ fmt.Sprintf("{search: %q, role: %q}", v.Search, v.Role) }>
		<a href="/" class="ds-header-back" aria-label="Voltar para o início">
			@ui.Icon("ChevronLeft", "ds-icon")
		</a>
		<h1 class="ds-header-title">Campanhas</h1>
		<span class="ds-header-acts">
			<a href="/campanhas/entrar" class="ds-button" data-variant="secondary" data-icon aria-label="Entrar numa mesa" title="Entrar numa mesa">
				@ui.Icon("UserPlus", "ds-icon")
			</a>
			<a href="/campanhas/nova" class="ds-button" data-icon aria-label="Nova campanha" title="Nova campanha">
				@ui.Icon("Plus", "ds-icon")
			</a>
		</span>
	</header>
}

// listTools é a busca e o filtro de papel. A busca vai ao servidor: a regra de
// casar nome e sinopse é a do `search.Matches`.
templ listTools(v listView) {
	<div class="ds-camps-tools">
		@ds.SearchField("campaigns-search", "Buscar campanha", templ.Attributes{
			"name": "busca", "value": v.Search, "data-busca": true, "data-bind:search": true,
			"data-on:input__debounce.250ms": "@get('/campanhas')",
		})
		@ds.Segmented("Filtrar por papel") {
			@roleChip(v, "todas", "Todas")
			@roleChip(v, "gm", "Mestrando")
			@roleChip(v, "player", "Jogando")
		}
	</div>
}

templ roleChip(v listView, value, label string) {
	@ds.SegmentedOption(v.Role == value, templ.Attributes{"data-on:click": fmt.Sprintf("$role = %q; @get('/campanhas')", value)}) {
		{ label }
	}
}

// campaignCardView é o cartão: a capa de iniciais, o nome, o papel e a
// contagem (ou a sessão ao vivo), a sinopse em duas linhas e o seu herói. O
// cartão inteiro leva à campanha; o "Voltar à mesa" leva direto à sessão.
templ campaignCardView(c campaignCard) {
	<article
		class="ds-camp"
		if c.Live {
			data-live
		}
	>
		<a class="ds-camp-head" href={ templ.SafeURL("/campanhas/" + strconv.FormatInt(c.ID, 10)) }>
			<span class="ds-camp-cover" aria-hidden="true" style={ "background: " + c.Gradient }>{ c.Initials }</span>
			<span class="ds-camp-text">
				<b>{ c.Name }</b>
				<span class="ds-row-meta">{ cardMeta(c) }</span>
			</span>
		</a>
		if c.Synopsis != "" {
			<p class="ds-camp-syn">{ c.Synopsis }</p>
		}
		if c.Mine != nil {
			<span class="ds-camp-hero">
				<span class="ds-camp-hero-mark" aria-hidden="true" style={ "background: " + c.Mine.Gradient }>{ c.Mine.Initials }</span>
				<span>{ c.Mine.Name }</span>
				<span class="ds-row-meta">{ c.Mine.Classes }</span>
			</span>
		}
		if c.Live {
			<a class="ds-button" data-wide href={ templ.SafeURL(routes.Session(c.ID, c.SessionID)) }>
				Voltar à mesa
				@ui.Icon("ChevronRight", "ds-icon")
			</a>
		}
	</article>
}

// searchWithoutResult diz o que se procurou e o que fazer.
templ searchWithoutResult(v listView) {
	@ds.Empty(searchMissTitle(v), "Tente outro nome, ou limpe a busca.") {
		<div class="ds-camps-empty-acts">
			@ds.Button(ds.ButtonSecondary, templ.Attributes{"type": "button", "data-on:click": "$search = ''; $role = 'todas'; @get('/campanhas')"}) {
				Limpar a busca
			}
		</div>
	}
}

func searchMissTitle(v listView) string {
	if v.Search != "" {
		return fmt.Sprintf("Nenhuma campanha casa com %q", v.Search)
	}
	return "Nenhuma campanha neste filtro"
}

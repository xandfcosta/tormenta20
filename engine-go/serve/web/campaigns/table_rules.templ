package campaigns

import (
	"fmt"
	"strconv"

	"t20engine/domain/book"
	"t20engine/domain/engine"
	"t20engine/serve/web/ds"
	"t20engine/serve/web/ui"
)

// A ABA REGRAS DA MESA, pelo mockup aprovado. As regras opcionais do livro seguem em
// Configurações: elas são o livro, e estas são o que a mesa muda nele.
templ tableRulesTab(v oneView) {
	<div class="ds-camp-form">
		if v.IsGM {
			<div hidden data-signals={ tableRulesSignals() }></div>
			<p class="ds-help">O que esta mesa muda no livro. Nenhuma regra vem ligada, e os jogadores leem as que estão ligadas.</p>
			@ds.Button(ds.ButtonSecondary, templ.Attributes{"type": "button", "data-on:click": openRuleEditor(v.ID, "")}) {
				@ui.Icon("Plus", "ds-icon")
				Nova regra
			}
		} else {
			<p class="ds-help">O que esta mesa muda no livro.</p>
		}
		@tableRulesList(v)
		if v.IsGM {
			@ds.Dialog("table-rule-editor", "Regra da mesa", nil) {
				<div id="table-rule-form"></div>
			}
		}
	</div>
}

func openRuleEditor(campaignID int64, ruleID string) string {
	query := ""
	if ruleID != "" {
		query = "?regra=" + ruleID
	}
	// Esvazia antes: até a resposta chegar, o diálogo mostraria a regra aberta da última vez, com Excluir.
	return fmt.Sprintf("document.getElementById('table-rule-form').replaceChildren(); document.getElementById('table-rule-editor').showModal(); @post('%s')", ruleURL(campaignID, "/editor"+query))
}

templ tableRulesList(v oneView) {
	<div id="table-rules-list">
		if len(v.TableRules) == 0 {
			@ds.Empty("Nenhuma regra", tableRulesEmptyText(v.IsGM))
		} else {
			@ds.List("", countOf(int64(len(v.TableRules)), "regra", "regras")) {
				for _, rule := range v.TableRules {
					<div class="ds-row ds-table-rule">
						<div class="min-w-0">
							<div class="ds-row-title">{ rule.Name }</div>
							<div class="ds-row-meta">{ rule.Meta }</div>
						</div>
						if v.IsGM {
							@ds.Button(ds.ButtonGhost, templ.Attributes{"type": "button", "data-on:click": openRuleEditor(v.ID, rule.ID)}) {
								Editar
							}
							@ds.Switch("", rule.Enabled, templ.Attributes{
								"aria-label":     "Ligar " + rule.Name,
								"data-on:change": fmt.Sprintf("@post('%s')", ruleURL(v.ID, "/"+rule.ID+"/ligar")),
							})
						}
					</div>
				}
			}
		}
	</div>
}

func tableRulesEmptyText(isGM bool) string {
	if isGM {
		return "Crie a primeira com \"Nova regra\"."
	}
	return "Esta mesa joga como o livro manda."
}

func draftPost(v ruleEditorView, query string) string {
	return fmt.Sprintf("@post('%s')", ruleURL(v.CampaignID, "/rascunho"+query))
}

templ ruleSelect(v ruleEditorView, label, signal, current string, options []book.RuleOption) {
	<select
		class="ds-input ds-select"
		aria-label={ label }
		{ templ.Attributes{"data-bind:" + signal: true, "data-on:change": draftPost(v, "")}... }
	>
		for _, option := range options {
			<option value={ option.ID } selected?={ option.ID == current }>{ option.Name }</option>
		}
	</select>
}

// ruleEditorForm é o editor: Nome, Vale para, Quando, Efeito e Prévia. Ele é redesenhado inteiro a
// cada troca, e o texto digitado fica nos sinais: os dois campos de escrever não levam `value`, senão
// o redesenho poria neles o texto da hora do pedido.
templ ruleEditorForm(v ruleEditorView) {
	<div id="table-rule-form" class="ds-camp-form">
		if v.Refusal != "" {
			<p role="alert" class="ds-alert">{ v.Refusal }</p>
		}
		<div class="ds-field">
			<label for="table-rule-name">Nome</label>
			<input id="table-rule-name" class="ds-input" data-bind:table_rule_name/>
			<span class="ds-help">É como ela aparece na conta da ficha.</span>
		</div>
		<div class="ds-field">
			<span class="ds-field-label">Vale para</span>
			<div class="ds-options">
				@ds.Option(v.Draft.Scope != "um", templ.Attributes{"data-on:click": "$table_rule_scope = 'mesa'; " + draftPost(v, "")}) {
					Toda a mesa
				}
				@ds.Option(v.Draft.Scope == "um", templ.Attributes{"data-on:click": "$table_rule_scope = 'um'; " + draftPost(v, "")}) {
					Um personagem
				}
			</div>
			if v.Draft.Scope == "um" {
				@ruleSelect(v, "Personagem", "table_rule_character", v.Draft.Character, v.Characters)
			}
		</div>
		<div class="ds-field">
			<span class="ds-field-label">Quando</span>
			for _, line := range v.Lines {
				<div class="ds-rule-line">
					@ruleSelect(v, "Tipo da condição "+strconv.Itoa(line.Slot), ruleKindSignal(line.Slot), line.Kind, v.Kinds)
					if line.Kind != engine.RuleOnVested {
						@ruleSelect(v, "Qual, na condição "+strconv.Itoa(line.Slot), ruleValueSignal(line.Slot), line.Value, line.Options)
					}
					@ds.IconButton(ds.ButtonGhost, "X", "Tirar a condição "+strconv.Itoa(line.Slot), templ.Attributes{"type": "button", "data-on:click": draftPost(v, "?tira="+strconv.Itoa(line.Slot))})
				</div>
			}
			if len(v.Lines) == 0 {
				<span class="ds-help">Sem condição, ela vale sempre.</span>
			}
			if v.CanAdd {
				<div>
					@ds.Button(ds.ButtonSecondary, templ.Attributes{"type": "button", "data-on:click": draftPost(v, "?mais=1")}) {
						@ui.Icon("Plus", "ds-icon")
						Condição
					}
				</div>
			}
		</div>
		<div class="ds-field">
			<span class="ds-field-label">Efeito: soma em</span>
			<div class="ds-rule-line">
				@ruleSelect(v, "Em quê", "table_rule_target", v.Draft.Target, v.Targets)
				if v.Draft.Target == "expertise" {
					@ruleSelect(v, "Qual perícia", "table_rule_skill", v.Draft.Skill, v.Skills)
				}
				<input class="ds-input ds-rule-amount" aria-label="Quanto" type="number" data-bind:table_rule_amount data-on:change={ draftPost(v, "") }/>
			</div>
		</div>
		<div class="ds-field">
			<span class="ds-field-label">Prévia</span>
			<div class="ds-rule-preview">
				<p class="ds-card-text">{ v.Preview }</p>
				<p class="ds-card-text">{ v.Reaches }</p>
			</div>
		</div>
		<div class="ds-rule-actions">
			if v.Draft.ID != "" {
				@ds.Button(ds.ButtonDanger, templ.Attributes{"type": "button", "data-on:click": "document.getElementById('table-rule-remove').showModal()"}) {
					Excluir
				}
			}
			<form method="dialog">
				@ds.Button(ds.ButtonSecondary, templ.Attributes{"type": "submit"}) {
					Cancelar
				}
			</form>
			@ds.Button(ds.ButtonPrimary, templ.Attributes{"type": "button", "data-on:click": fmt.Sprintf("@post('%s')", ruleURL(v.CampaignID, "/gravar"))}) {
				Gravar
			}
		</div>
		if v.Draft.ID != "" {
			@ds.Dialog("table-rule-remove", "Excluir esta regra?", removeRuleFoot(v)) {
				<p class="ds-help">Ela sai na hora da ficha de quem ela alcança, e não dá para desfazer.</p>
			}
		}
	</div>
}

// O POST mora aqui, e não no botão do editor: a regra ligada está na ficha dos jogadores.
templ removeRuleFoot(v ruleEditorView) {
	<form method="dialog">
		@ds.Button(ds.ButtonSecondary, templ.Attributes{"type": "submit"}) {
			Cancelar
		}
	</form>
	@ds.Button(ds.ButtonDanger, templ.Attributes{"type": "button", "data-on:click": fmt.Sprintf("document.getElementById('table-rule-remove').close(); @post('%s')", ruleURL(v.CampaignID, "/"+v.Draft.ID+"/excluir"))}) {
		Excluir
	}
}

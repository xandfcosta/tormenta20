package campaigns

import (
	"fmt"

	"t20engine/serve/web/ds"
	"t20engine/serve/web/routes"
	"t20engine/serve/web/ui"
)

// O ACERVO DE LUGARES da crônica: onde o mestre prepara a próxima cena, fora da
// sessão.
//
// A mesma lista existe DENTRO da Mesa, e as duas não são cópia uma da outra
// porque respondem a perguntas diferentes. Lá o gesto é "traga esta cena para a
// mesa AGORA", com a sessão rolando; aqui é "abra esta cena para eu montar",
// numa quinta-feira sem ninguém conectado. O que elas compartilham é a única
// coisa que não pode divergir — quem está numa mesa agora —, e essa conta é do
// servidor, num lugar só (`BoardStore.PlacesOnATable`).
//
// LISTA e não grade, pela mesma razão que a da Mesa: o que decide entre a
// taverna e a cripta é o NOME, e nome é texto que se lê em coluna. Miniatura
// exigiria imagem, e a cena guardada é estado.

templ placesTab(v oneView) {
	// A FRASE explica o que esta tela é, e ela precisa: a palavra "lugar"
	// aparece na Mesa querendo dizer a mesma coisa com outro gesto, e sem a
	// linha o mestre não sabe o que "Montar" vai abrir.
	<p class="ds-help">As cenas guardadas desta campanha. Montar abre o mapa para você preparar a cena com calma — a mesa não vê nada até você reabrir o lugar numa sessão.</p>
	@ds.Button(ds.ButtonSecondary, templ.Attributes{"type": "button", "data-on:click": "document.getElementById('new-place').showModal()"}) {
		@ui.Icon("Plus", "ds-icon")
		Novo lugar
	}
	if len(v.Places) == 0 {
		// O VAZIO diz o que fazer, e não só que está vazio: este é o estado do
		// primeiro dia da campanha.
		@ds.Empty("Nenhum lugar guardado ainda", "Eles nascem quando você encerra um tabuleiro na mesa — ou aqui, com \"Novo lugar\".")
	} else {
		@ds.List("Acervo", placeCount(len(v.Places))) {
			for _, l := range v.Places {
				@placeRow(v, l)
			}
		}
	}
	@newPlaceDialog(v)
}

func placeCount(n int) string {
	return countOf(int64(n), "lugar", "lugares")
}

// placeRow é uma cena guardada, com os gestos que ela aceita.
templ placeRow(v oneView, l PlaceRow) {
	<div class="ds-row ds-camp-place">
		<span class="ds-camp-text">
			<span class="ds-row-title">{ l.Name }</span>
			<span class="ds-row-meta">
				if l.AtTableID > 0 {
					{ "nesta mesa agora · " + ui.TokenCount(l.Tokens) }
				} else {
					{ fmt.Sprintf("%s · guardado em %s", ui.TokenCount(l.Tokens), shortDate(l.When)) }
				}
			</span>
		</span>
		<span class="ds-camp-place-acts">
			if l.AtTableID > 0 {
				// O QUE ESTÁ NA MESA NÃO SE MONTA NEM SE APAGA: as duas coisas seriam
				// desfeitas pelo `Archive` quando a aba encerrasse — o rascunho some,
				// e o lugar apagado volta. As travas de verdade são do servidor; isto
				// é não oferecer o gesto que ele recusa.
				@ds.LinkButton(ds.ButtonSecondary, templ.SafeURL(routes.Session(v.ID, l.AtTableID)), nil) {
					Ver na mesa
				}
			} else {
				@ds.LinkButton(ds.ButtonSecondary, templ.SafeURL(routes.PlaceDraft(v.ID, l.ID)), nil) {
					Montar
				}
				// APAGAR é um `form` e não um link: ele DESTRÓI, e um `GET` que
				// destrói é apagado pelo pré-carregamento do navegador sem ninguém
				// clicar em nada.
				<form method="post" action={ templ.SafeURL(fmt.Sprintf("/campanhas/%d/lugares/%d/excluir", v.ID, l.ID)) }>
					@ds.IconButton(ds.ButtonGhost, "Trash2", "Apagar "+l.Name, templ.Attributes{"type": "submit"})
				</form>
			}
		</span>
	</div>
}

// O LUGAR NOVO: o nome e o chão, e mais nada.
//
// O NOME é a identidade do lugar dentro da campanha — é por ele que o `Archive`
// decide se sobrescreve —, e a frase diz isso com todas as letras: repetir um
// nome que já existe leva ÀQUELE lugar em vez de criar um segundo quase igual.
//
// SEM `maxlength`, ao contrário do formulário da campanha: o teto do nome do
// lugar é do `tabuleiro`, que esta cena não alcança, e repeti-lo aqui seria a
// segunda verdade sobre quantas letras cabem.
templ newPlaceDialog(v oneView) {
	@ds.Dialog("new-place", "Novo lugar", nil) {
		<p class="ds-help">A cena que você vai montar. Um nome que já existe no acervo abre aquele lugar, em vez de criar outro.</p>
		<form method="post" action={ templ.SafeURL(fmt.Sprintf("/campanhas/%d/lugares/novo", v.ID)) } class="ds-camp-form">
			@ds.TextField(ds.Field{ID: "place-name", Name: "name", Label: "Nome do lugar", Error: joinErrors(v.Errors["place"])}, templ.Attributes{"required": true})
			<div class="ds-field">
				<label for="place-ground">Chão</label>
				<select class="ds-input ds-select" id="place-ground" name="ground">
					for _, c := range v.Chaos {
						<option value={ c.ID }>{ c.Label }</option>
					}
				</select>
			</div>
			@ds.Button(ds.ButtonPrimary, templ.Attributes{"type": "submit"}) {
				Montar
			}
		</form>
	}
}

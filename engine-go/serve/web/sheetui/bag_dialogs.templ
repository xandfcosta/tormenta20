package sheetui

import (
	"strconv"
	"strings"
	"t20engine/serve/web/ui"
)

// OS DIÁLOGOS DA MOCHILA: um por item, mais dois compartilhados — adicionar do
// catálogo e criar um item custom.
//
// Todos são desenhados de uma vez e alternados pelo sinal `$detail`: o custo é
// HTML a mais no fio, e o ganho é que abrir uma caixa não pede nada ao servidor.
//
// QUEM TROCA DE ITEM LIMPA: o gesto que ABRE zera os campos compartilhados
// (`$item_name`, `$item_qty`, `$item_slots`, as rolagens), senão o que foi
// digitado numa caixa reaparece na próxima.

// itemSheetDialog é a ficha de UM item — o alvo de todo toque na Mochila.
templ itemSheetDialog(v View, sheet itemSheet) {
	@overlay("item-"+sheet.Command, sheet.Name, "Backpack", false) {
		<p class="text-xs text-muted-foreground">
			{ writtenWeight(sheet) }
			if sheet.NoProficiency {
				<span class="ml-2 font-semibold text-penalty-ink">sem proficiência</span>
			}
		</p>
		if len(sheet.Equip) > 0 {
			<div class="space-y-1">
				<p class={ ui.FieldLabelClasses("muted", "") }>Equipar</p>
				<div class="grid grid-cols-2 gap-2">
					for _, place := range sheet.Equip {
						<button
							type="button"
							data-on:click={ equipCommand(v, sheet, place) + "; $detail = ''" }
							class={ ui.ButtonClasses(ui.VariantSecondary, ui.SizeSmall, "") }
						>{ place.Label }</button>
					}
				</div>
			</div>
		}
		if sheet.Consumable != nil {
			@consumeBlock(v, sheet)
		}
		if sheet.Book != nil {
			@bookBlock(sheet)
		}
		if len(sheet.Overlays) > 0 {
			<div class="space-y-1 rounded-sm border border-grimorio-iron p-2">
				<p class={ ui.FieldLabelClasses("muted", "") }>Melhorias & material</p>
				for _, improvement := range sheet.Overlays {
					<p class="text-xs">
						<span class="font-semibold text-grimorio-gold">{ improvement.Name }</span>
						<span class="ml-2 text-muted-foreground">{ improvement.Effect }</span>
					</p>
				}
			</div>
		}
		<div class="flex flex-wrap gap-2 border-t border-grimorio-iron pt-2">
			if sheet.Overlayable {
				<button
					type="button"
					aria-label={ "Melhorias de " + sheet.Name }
					aria-haspopup="dialog"
					data-on:click={ thatOpensTheImprovementsGesture(sheet) }
					class={ ui.ButtonClasses(ui.VariantSecondary, ui.SizeSmall, "") }
				>Melhorias</button>
			}
			<button
				type="button"
				aria-label={ "Editar " + sheet.Name }
				aria-haspopup="dialog"
				data-on:click={ thatOpensEditGesture(sheet) }
				class={ ui.ButtonClasses(ui.VariantSecondary, ui.SizeSmall, "") }
			>Editar</button>
			<button
				type="button"
				aria-label={ "Remover " + sheet.Name }
				data-on:click={ sheetPost(v, "/itens/"+sheet.Command+"/remover") + "; $detail = ''" }
				class={ ui.ButtonClasses(ui.VariantDestructive, ui.SizeSmall, "ml-auto") }
			>Remover</button>
		</div>
	}
	if sheet.Overlayable {
		@overlayDialog(v, sheet)
	}
	@itemFormDialog(v, "editar-"+sheet.Command, "Editar "+sheet.Name, "Salvar",
		sheetPost(v, "/itens/"+sheet.Command+"/edita"))
}

// consumeBlock é o "Usar", com o campo da rolagem quando o ganho é por dado.
//
// O DADO É DA MESA: quem rola é a pessoa, e o servidor aceita o número que ela
// mandar. A ficha rolando por conta própria tiraria da mesa o gesto que ela
// gosta de fazer — e obrigaria a inventar uma política para o crítico, para o
// dado emprestado e para o "rolei de novo porque caiu no chão".
templ consumeBlock(v View, sheet itemSheet) {
	<div class="space-y-1 rounded-sm border border-grimorio-iron p-2">
		<p class={ ui.FieldLabelClasses("muted", "") }>
			{ "Usar · " + sheet.Consumable.Scope }
		</p>
		if sheet.Consumable.HpDice != "" {
			@rollField("item_roll_hp", "PV rolados ("+sheet.Consumable.HpDice+")")
		}
		if sheet.Consumable.MpDice != "" {
			@rollField("item_roll_mp", "PM rolados ("+sheet.Consumable.MpDice+")")
		}
		<button
			type="button"
			aria-label={ "Usar " + sheet.Name }
			data-on:click={ sheetPost(v, "/itens/"+sheet.Command+"/usa") + "; $detail = ''" }
			class={ ui.ButtonClasses(ui.VariantPrimary, ui.SizeSmall, "w-full") }
		>Usar</button>
	</div>
}

templ rollField(signal, label string) {
	<label class="block space-y-1">
		<span class="text-3xs text-muted-foreground">{ label }</span>
		<input
			type="number"
			min="0"
			data-bind={ signal }
			class="h-8 w-full rounded-sm border border-grimorio-iron bg-background px-2 text-sm text-foreground outline-none"
		/>
	</label>
}

// bookBlock é o que o livro diz do item.
templ bookBlock(sheet itemSheet) {
	<div class="space-y-1 rounded-sm border border-grimorio-iron p-2 text-xs text-muted-foreground">
		<p>{ sheet.Book.Category + " · T$ " + sheet.Book.Price + " · p" + strconv.Itoa(sheet.Book.Page) }</p>
		for _, row := range sheet.Book.Rows {
			<p>{ row }</p>
		}
	</div>
}

// overlayDialog escolhe melhorias e material.
//
// As duas listas já vêm FILTRADAS pela família do item — não se põe corda de
// arco num escudo —, e quem recusa o resto é o servidor: o filtro aqui é
// conveniência, `fitsItemImprovement` é a fronteira.
templ overlayDialog(v View, sheet itemSheet) {
	@overlay("melhorias-"+sheet.Command, "Melhorias de "+sheet.Name, "Sparkles", false) {
		<div class="space-y-1">
			<p class={ ui.FieldLabelClasses("muted", "") }>Melhorias</p>
			for _, choice := range sheet.Improvements {
				<button
					type="button"
					role="switch"
					aria-checked={ ui.AriaBool(choice.Active) }
					aria-label={ choice.Name }
					data-on:click={ thatTogglesImprovementGesture(choice) }
					data-attr:data-escolhida={ improvementSignal(choice) }
					class="flex w-full items-baseline gap-2 rounded-sm border border-grimorio-iron px-2 py-1 text-left text-xs outline-none transition-colors data-[escolhida]:border-grimorio-gold/60 data-[escolhida]:bg-accent"
				>
					<span class="font-semibold text-foreground">{ choice.Name }</span>
					<span class="min-w-0 flex-1 truncate text-muted-foreground">{ choice.Effect }</span>
					<span class="shrink-0 font-mono text-3xs text-muted-foreground">{ "T$ " + choice.Price }</span>
				</button>
			}
		</div>
		<div class="space-y-1">
			<p class={ ui.FieldLabelClasses("muted", "") }>Material</p>
			<select
				data-bind:item_material
				aria-label={ "Material de " + sheet.Name }
				class="h-9 w-full rounded-sm border border-grimorio-iron bg-background px-2 text-sm text-foreground outline-none"
			>
				<option value="">Nenhum</option>
				for _, choice := range sheet.Materials {
					<option value={ choice.ID } selected?={ choice.Active }>
						{ choice.Name + " · T$ " + choice.Price }
					</option>
				}
			</select>
		</div>
		<button
			type="button"
			data-on:click={ sheetPost(v, "/itens/"+sheet.Command+"/melhorias") + "; $detail = ''" }
			class={ ui.ButtonClasses(ui.VariantPrimary, ui.SizeDefault, "w-full") }
		>Aplicar</button>
	}
}

// catalogAddDialog é o Capítulo 3 buscável.
templ catalogAddDialog(v View) {
	@overlay("catalogo", "Adicionar do catálogo", "Plus", false) {
		<div class="flex gap-2">
			<input
				type="search"
				data-bind:catalog_search
				data-on:input__debounce.250ms={ sheetGet(v) }
				value={ v.Bag.CatalogSearch }
				placeholder="Buscar no catálogo…"
				aria-label="Buscar no catálogo"
				class="h-9 min-w-0 flex-1 rounded-sm border border-grimorio-iron bg-background px-2 text-sm text-foreground outline-none placeholder:text-muted-foreground"
			/>
			<select
				data-bind:catalog_category
				data-on:change={ sheetGet(v) }
				aria-label="Categoria do catálogo"
				class="h-9 max-w-[45%] rounded-sm border border-grimorio-iron bg-background px-2 text-sm text-foreground outline-none"
			>
				for _, option := range v.Bag.CatalogCategories {
					<option value={ option.Value } selected?={ option.Active }>{ option.Label }</option>
				}
			</select>
		</div>
		<label class="block space-y-1">
			<span class={ ui.FieldLabelClasses("muted", "") }>quantidade</span>
			<input
				type="number"
				min="1"
				max="9999"
				data-bind:item_qty
				class="h-9 w-full rounded-sm border border-grimorio-iron bg-background px-2 text-sm text-foreground outline-none"
			/>
		</label>
		if len(v.Bag.Catalog) == 0 {
			<p class="py-4 text-center text-xs text-muted-foreground">Nenhum item para essa busca.</p>
		} else {
			<div class="max-h-[45vh] space-y-1 overflow-y-auto">
				for _, row := range v.Bag.Catalog {
					<button
						type="button"
						aria-label={ "Adicionar " + row.Name }
						data-on:click={ sheetPost(v, "/itens/adiciona/"+row.ID) + "; $detail = ''" }
						class="flex w-full items-baseline gap-2 rounded-sm border border-grimorio-iron px-2 py-1 text-left text-xs outline-none transition-colors hover:border-grimorio-gold/50"
					>
						<span class="min-w-0 flex-1 truncate text-foreground">{ row.Name }</span>
						<span class="shrink-0 text-3xs text-muted-foreground">{ row.Category }</span>
						<span class="shrink-0 font-mono text-3xs text-muted-foreground">
							{ "esp " + row.Slots + " · T$ " + row.Price }
						</span>
					</button>
				}
			</div>
		}
	}
}

// itemFormDialog é o formulário de um item CUSTOM — nome, quantidade e espaços.
// Ele serve tanto ao "novo" quanto ao "editar", que é o mesmo formulário com
// outro destino.
templ itemFormDialog(v View, key, title, button, command string) {
	@overlay(key, title, "Pencil", false) {
		<label class="block space-y-1">
			<span class={ ui.FieldLabelClasses("muted", "") }>nome</span>
			<input
				type="text"
				maxlength="80"
				data-bind:item_name
				class="h-9 w-full rounded-sm border border-grimorio-iron bg-background px-2 text-sm text-foreground outline-none"
			/>
		</label>
		<div class="grid grid-cols-2 gap-2">
			<label class="block space-y-1">
				<span class={ ui.FieldLabelClasses("muted", "") }>quantidade</span>
				<input
					type="number"
					min="1"
					max="9999"
					data-bind:item_qty
					class="h-9 w-full rounded-sm border border-grimorio-iron bg-background px-2 text-sm text-foreground outline-none"
				/>
			</label>
			<label class="block space-y-1">
				<span class={ ui.FieldLabelClasses("muted", "") }>espaços</span>
				<input
					type="number"
					min="0"
					step="0.5"
					data-bind:item_slots
					class="h-9 w-full rounded-sm border border-grimorio-iron bg-background px-2 text-sm text-foreground outline-none"
				/>
			</label>
		</div>
		<button
			type="button"
			data-on:click={ command + "; $detail = ''" }
			class={ ui.ButtonClasses(ui.VariantPrimary, ui.SizeDefault, "w-full") }
		>{ button }</button>
	}
}

// bagAddButtons são os dois gestos do cabeçalho: catálogo e item custom.
templ bagAddButtons(v View) {
	<div class="flex items-center gap-1">
		<button
			type="button"
			aria-label="Adicionar do catálogo"
			aria-haspopup="dialog"
			data-on:click="$item_qty = 1; $catalog_search = ''; $catalog_category = ''; $detail = 'catalogo'"
			class={ ui.ButtonClasses(ui.VariantSecondary, ui.SizeSmall, "gap-1") }
		>
			@ui.Icon("Plus", "size-3.5")
			Catálogo
		</button>
		<button
			type="button"
			aria-label="Adicionar item custom"
			aria-haspopup="dialog"
			data-on:click="$item_name = ''; $item_qty = 1; $item_slots = 1; $detail = 'item-custom'"
			class={ ui.ButtonClasses(ui.VariantSecondary, ui.SizeSmall, "gap-1") }
		>
			@ui.Icon("Plus", "size-3.5")
			Custom
		</button>
	</div>
}

// writtenWeight é "2 × 0,5 espaço = 1", que é o que a carga conta.
func writtenWeight(sheet itemSheet) string {
	return strconv.FormatInt(sheet.Quantity, 10) + " × " + sheet.Slots + " espaço = " + sheet.Total
}

// equipCommand escreve o `@post` do lugar escolhido — guardar tem rota
// própria, porque guardar não passa por teto nenhum.
func equipCommand(v View, sheet itemSheet, place equipChoice) string {
	if place.Slot == "" {
		return sheetPost(v, "/itens/"+sheet.Command+"/guarda")
	}
	return sheetPost(v, "/itens/"+sheet.Command+"/equipa/"+place.Slot)
}

// improvementSignal é a expressão que diz se a melhoria está escolhida AGORA.
func improvementSignal(choice overlayChoice) string {
	return "$item_improvements.includes('" + choice.ID + "')"
}

// thatTogglesImprovementGesture liga ou desliga uma melhoria na lista do sinal.
//
// A lista é COPIADA antes de ser mexida (`[...$item_improvements]`): o sinal é um
// proxy, e escrever dentro dele item a item é a armadilha que o guia do Go
// registra — ler um índice que não existe o CRIA.
func thatTogglesImprovementGesture(choice overlayChoice) string {
	return "const escolhidas = [...$item_improvements]; const onde = escolhidas.indexOf('" + choice.ID + "'); " +
		"if (onde >= 0) { escolhidas.splice(onde, 1) } else { escolhidas.push('" + choice.ID + "') }; " +
		"$item_improvements = escolhidas"
}

// thatOpensTheImprovementsGesture carrega o que o item JÁ tem antes de abrir.
//
// Quem TROCA de item limpa: sem isto, as melhorias marcadas numa espada
// apareceriam marcadas na armadura aberta em seguida — e o botão Aplicar
// gravaria nela o que era de outra.
func thatOpensTheImprovementsGesture(sheet itemSheet) string {
	return "$item_improvements = " + improvementWrittenList(sheet) +
		"; $item_material = '" + chosenMaterial(sheet) + "'" +
		"; $detail = 'melhorias-" + sheet.Command + "'"
}

// thatOpensEditGesture põe os valores atuais no formulário.
func thatOpensEditGesture(sheet itemSheet) string {
	return "$item_name = " + strconv.Quote(sheet.Name) +
		"; $item_qty = " + strconv.FormatInt(sheet.Quantity, 10) +
		"; $item_slots = " + strings.Replace(sheet.Slots, ",", ".", 1) +
		"; $detail = 'editar-" + sheet.Command + "'"
}

func improvementWrittenList(sheet itemSheet) string {
	ids := []string{}
	for _, choice := range sheet.Improvements {
		if choice.Active {
			ids = append(ids, "'"+choice.ID+"'")
		}
	}
	return "[" + strings.Join(ids, ", ") + "]"
}

func chosenMaterial(sheet itemSheet) string {
	for _, choice := range sheet.Materials {
		if choice.Active {
			return choice.ID
		}
	}
	return ""
}

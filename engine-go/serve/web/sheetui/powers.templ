package sheetui

import (
	"strconv"
	"t20engine/serve/web/ui"
)

// O painel de PODERES desenhado.
//
// UMA lista, a da mesa: as AÇÕES em cima, prontas para usar, e as PASSIVAS
// recolhidas atrás de um "mostrar (N)". Escolher poder é administração e mora
// num diálogo — na tela fica o que se usa jogando.
//
// A BUSCA achata tudo: com um termo digitado as duas seções somem e o que
// aparece é uma lista só, por nome. Na mesa o jogador sabe como o poder se
// chama, não qual fonte o concedeu.

// powersPanelSection é a seção inteira.
templ powersPanelSection(v View) {
	<section class="flex min-h-0 flex-1 flex-col">
		<div class="flex shrink-0 items-center gap-2 border-b border-grimorio-iron px-3 py-2 sm:px-4">
			<h2 class={ ui.SectionTitleClasses("painel", "", "") }>Poderes</h2>
			<p class="text-3xs text-muted-foreground sm:text-xs">{ writtenPowers(v.Powers.Total) }</p>
			<span class="ml-auto">
				@choicesButton(v)
			</span>
		</div>
		<div class="flex min-h-0 flex-1 flex-col gap-2 overflow-y-auto p-2 sm:p-3">
			@powerSearch(v)
			if v.Powers.Search != "" {
				@powerSearchResults(v)
			} else {
				@actionsBlock(v)
				@passivesBlock(v)
			}
		</div>
	</section>
	for _, row := range v.Powers.Actions {
		if row.Stance != nil && row.Stance.MaxSteps > 0 {
			@stanceStepperDialog(v, row)
		}
	}
	@choicesDialog(v)
}

templ powerSearch(v View) {
	<input
		type="search"
		data-bind:power_search
		data-on:input__debounce.250ms={ sheetGet(v) }
		value={ v.Powers.Search }
		placeholder="Buscar poder ou habilidade…"
		aria-label="Buscar poder ou habilidade"
		class="h-8 w-full rounded-sm border border-grimorio-iron bg-background px-2 text-xs text-foreground outline-none placeholder:text-muted-foreground"
	/>
}

// powerSearchResults é a lista achatada da busca.
templ powerSearchResults(v View) {
	if len(v.Powers.Results) == 0 {
		<p class="py-4 text-center text-xs italic text-muted-foreground">
			{ "Nenhum poder para \"" + v.Powers.Search + "\"." }
		</p>
	} else {
		<ul class="space-y-1.5">
			for _, row := range v.Powers.Results {
				@powerRowItem(v, row)
			}
		</ul>
	}
}

// actionsBlock são os poderes que se ATIVAM.
templ actionsBlock(v View) {
	<section class="space-y-1.5">
		<h3 class={ ui.SectionLabelClasses("muted", "") }>Ações</h3>
		if len(v.Powers.Actions) == 0 {
			// A SEÇÃO FICA MESMO VAZIA, e explica (decisão do dono): um arcanista de
			// nível 20 tem ZERO ações ativáveis — 26 habilidades, todas passivas.
			// Sumir com a seção faria a tela mudar de forma por classe, e duas
			// pessoas na mesma mesa veriam leiautes diferentes. A frase manda para
			// as Magias só quem conjura; mandar um guerreiro para lá seria mandá-lo
			// a uma aba vazia.
			<p class="text-xs italic text-muted-foreground">{ noActionsPhrase(v.Powers.IsCaster) }</p>
		} else {
			<ul class="space-y-1.5">
				for _, row := range v.Powers.Actions {
					@powerRowItem(v, row)
				}
			</ul>
		}
	</section>
}

// passivesBlock são as passivas, recolhidas.
//
// Elas já entram nos números da ficha, então na mesa são referência. O que NÃO
// se recolhe é a passiva de gatilho com o gatilho no ar: ela está fazendo
// efeito agora, e escondê-la seria a tela mentir sobre o que está em vigor.
templ passivesBlock(v View) {
	if len(v.Powers.Passives) > 0 {
		<section class="space-y-1.5">
			@ui.Button(ui.VariantGhost, ui.SizeInline, "gap-1 text-2xs font-semibold uppercase tracking-wide", templ.Attributes{"type": "button", "data-on:click": "$show_passives = !$show_passives", "data-attr:aria-expanded": "$show_passives ? 'true' : 'false'"}) {
				<span data-show="!$show_passives">{ "Passivas · mostrar (" + strconv.Itoa(len(v.Powers.Passives)) + ")" }</span>
				<span style="display:none" data-show="$show_passives">Passivas · ocultar</span>
			}
			<div data-show="!$show_passives" class="space-y-1">
				for _, row := range v.Powers.LiveTriggers {
					<p class="text-2xs text-bonus-ink">{ "● gatilho ativo: " + row.Name }</p>
				}
			</div>
			<ul style="display:none" data-show="$show_passives" class="space-y-1.5">
				for _, row := range v.Powers.Passives {
					@powerRowItem(v, row)
				}
			</ul>
		</section>
	}
}

// powerRowItem é um poder, numa linha.
//
// O texto da regra fica CORTADO numa linha e o toque no nome abre o resto: são
// 26 a 34 poderes num personagem de nível 20, e a descrição inteira de cada um
// faria a lista virar um livro que ninguém percorre no meio de um turno.
templ powerRowItem(v View, row powerRow) {
	<li class="rounded-none border border-grimorio-iron p-2">
		<div class="flex flex-wrap items-start gap-1.5">
			<button
				type="button"
				aria-label={ "Detalhes de " + row.Name }
				data-on:click={ "$power = $power === '" + row.ID + "' ? '' : '" + row.ID + "'" }
				data-attr:aria-expanded={ "$power === '" + row.ID + "' ? 'true' : 'false'" }
				class="flex min-w-0 flex-1 basis-40 flex-col gap-0.5 text-left outline-none"
			>
				<span class="flex flex-wrap items-center gap-1.5">
					@ui.Icon(row.Glyph, "size-3.5 shrink-0 text-muted-foreground")
					<span class="text-xs font-semibold text-foreground">{ row.Name }</span>
					<span class="rounded-none bg-muted px-1 text-3xs text-muted-foreground">{ row.Source }</span>
				</span>
				<span data-show={ "$power !== '" + row.ID + "'" } class="line-clamp-1 text-2xs leading-snug text-muted-foreground">
					{ row.Detail }
				</span>
			</button>
			@powerActionSlot(v, row)
		</div>
		<p data-show={ "$power === '" + row.ID + "'" } class="mt-1 text-2xs leading-snug text-muted-foreground">
			{ row.Detail }
			if row.Page > 0 {
				<span class="ml-1 opacity-70">{ "(p" + strconv.Itoa(row.Page) + ")" }</span>
			}
		</p>
	</li>
}

// powerActionSlot é o que dá para fazer com o poder, no fim da linha.
templ powerActionSlot(v View, row powerRow) {
	<span class="ml-auto flex shrink-0 flex-wrap items-center justify-end gap-1">
		if row.Cost != "" {
			<span class={ powerBadge(row.Kind) }>{ row.Cost }</span>
		}
		if row.Spent != "" {
			<span class={ powerBadge("") }>{ row.Spent }</span>
		} else if row.Limit != "" {
			<span class={ powerBadge("") }>{ row.Limit }</span>
		}
		if row.Stance != nil {
			@stanceButton(v, row)
		} else if row.Kind == "instant" {
			<button
				type="button"
				aria-label={ "Usar " + row.Name }
				disabled?={ !row.Can }
				title={ row.Why }
				data-on:click={ sheetPost(v, "/poderes/usa/"+row.Command) }
				class={ ui.ButtonClasses(ui.VariantSecondary, ui.SizeSmall, "gap-1") }
			>
				@ui.Icon("Zap", "size-3")
				Usar
			</button>
		}
	</span>
}

// stanceButton entra ou encerra a postura.
//
// Uma postura de custo FIXO entra num toque só; a que escala com o nível abre o
// contador de degraus, porque aí o preço depende de uma escolha.
templ stanceButton(v View, row powerRow) {
	if row.Stance.Active {
		<button
			type="button"
			aria-label={ "Encerrar " + row.Name }
			data-on:click={ sheetPost(v, "/efeitos/postura/"+row.Stance.Flag) }
			class={ ui.ButtonClasses(ui.VariantDestructive, ui.SizeSmall, "") }
		>ATIVA · Encerrar</button>
	} else if row.Stance.MaxSteps > 0 {
		<button
			type="button"
			aria-label={ "Ativar " + row.Name }
			aria-haspopup="dialog"
			disabled?={ !row.Can }
			title={ row.Why }
			data-on:click={ "$stance_degrees = 0; $detail = 'postura-" + row.Stance.Flag + "'" }
			class={ ui.ButtonClasses(ui.VariantSecondary, ui.SizeSmall, "gap-1") }
		>
			@ui.Icon("Flame", "size-3")
			Ativar
		</button>
	} else {
		<button
			type="button"
			aria-label={ "Ativar " + row.Name }
			disabled?={ !row.Can }
			title={ row.Why }
			data-on:click={ "$stance_degrees = 0; " + sheetPost(v, "/poderes/postura/"+row.Stance.Flag+"/entra") }
			class={ ui.ButtonClasses(ui.VariantSecondary, ui.SizeSmall, "gap-1") }
		>
			@ui.Icon("Flame", "size-3")
			{ "Ativar " + strconv.Itoa(row.Stance.BasePm) + " PM" }
		</button>
	}
}

// stanceStepperDialog escolhe quantos degraus pagar.
//
// O custo aparece antes de confirmar, somado por expressão sobre números que o
// servidor mandou — é PRÉVIA, e quem cobra é o servidor com a regra inteira.
templ stanceStepperDialog(v View, row powerRow) {
	@overlay("postura-"+row.Stance.Flag, row.Name, "Flame", false) {
		<p class="text-xs text-muted-foreground">{ row.Stance.StepLabel }</p>
		<div class="flex items-center justify-center gap-3">
			<button
				type="button"
				aria-label="Menos um degrau"
				data-on:click="$stance_degrees = Math.max(0, $stance_degrees - 1)"
				class={ ui.ButtonClasses(ui.VariantSecondary, ui.SizeSmall, "") }
			>−</button>
			<span class="font-mono text-lg text-foreground" data-text="$stance_degrees"></span>
			<button
				type="button"
				aria-label="Mais um degrau"
				data-on:click={ "$stance_degrees = Math.min(" + strconv.Itoa(row.Stance.MaxSteps) + ", $stance_degrees + 1)" }
				class={ ui.ButtonClasses(ui.VariantSecondary, ui.SizeSmall, "") }
			>+</button>
		</div>
		<p class="text-center text-xs text-muted-foreground">
			<span data-text={ costStancePreview(row) }></span>
		</p>
		<button
			type="button"
			aria-label={ "Confirmar " + row.Name }
			data-on:click={ sheetPost(v, "/poderes/postura/"+row.Stance.Flag+"/entra") + "; $detail = ''" }
			class={ ui.ButtonClasses(ui.VariantPrimary, ui.SizeDefault, "w-full") }
		>Ativar</button>
	}
}

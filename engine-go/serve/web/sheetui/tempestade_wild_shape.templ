package sheetui

import (
	"t20engine/domain/engine"
	"t20engine/serve/web/ds"
)

// wildShapeDialog é a escolha da Forma Selvagem (p62-63): a forma, o nível que a ficha tem, o dano da arma
// natural e, na Veloz, o deslocamento. O resumo e o preço seguem os sinais; quem cobra e recusa é o servidor.
templ wildShapeDialog(v View) {
	@sheetDialog(v, wildShapeDialogID, "Forma Selvagem", wildShapeConfirm(v)) {
		<div class="ds-field">
			<span class="ds-field-label">Forma</span>
			<div class="ds-options" role="group" aria-label="Forma">
				for _, form := range engine.WildForms {
					@ds.Option(false, templ.Attributes{
						"data-on:click":          "$wild_form = '" + string(form) + "'; $wild_move = ''",
						"data-attr:aria-pressed": "String($wild_form === '" + string(form) + "')",
					}) {
						{ wildFormShortName(form) }
					}
				}
			</div>
			<p class="ds-help" data-text={ v.WildShape.wildSummaryExpr() }></p>
		</div>
		<div class="ds-field">
			<span class="ds-field-label">Nível</span>
			<div class="ds-options" role="group" aria-label="Nível">
				for _, tier := range v.WildShape.Tiers {
					@ds.Option(false, templ.Attributes{
						"data-on:click":          "$wild_tier = '" + string(tier.Tier) + "'; $wild_move = ''",
						"data-attr:aria-pressed": "String($wild_tier === '" + string(tier.Tier) + "')",
					}) {
						{ tier.Label }
					}
				}
			</div>
		</div>
		<div class="ds-field">
			<span class="ds-field-label">Dano da arma natural</span>
			<div class="ds-options" role="group" aria-label="Dano da arma natural">
				for _, damage := range engine.WildShapeDamageTypes {
					@ds.Option(false, templ.Attributes{
						"data-on:click":          "$wild_damage = '" + damage + "'",
						"data-attr:aria-pressed": "String($wild_damage === '" + damage + "')",
					}) {
						{ wildDamageLabels[damage] }
					}
				}
			</div>
		</div>
		for _, tier := range v.WildShape.Tiers {
			<div class="ds-field" data-show={ "$wild_form === 'veloz' && $wild_tier === '" + string(tier.Tier) + "'" }>
				<span class="ds-field-label">Deslocamento</span>
				<div class="ds-options" role="group" aria-label="Deslocamento">
					for _, move := range v.WildShape.Moves[tier.Tier] {
						@ds.Option(false, templ.Attributes{
							"data-on:click":          "$wild_move = '" + string(move.Move) + "'",
							"data-attr:aria-pressed": "String($wild_move === '" + string(move.Move) + "')",
						}) {
							{ move.Label }
						}
					}
				</div>
			</div>
		}
		<div class="ds-field">
			<p class="ds-help">Na forma você não fala, não empunha itens nem lança magias. O equipamento some, mas os itens vestidos continuam valendo (p63).</p>
		</div>
	}
}

templ wildShapeConfirm(v View) {
	@ds.Button(ds.ButtonPrimary, templ.Attributes{
		"type": "button", "aria-label": "Transformar", "commandfor": wildShapeDialogID, "command": "close",
		"data-text": v.WildShape.wildCostExpr(), "data-on:click": sheetPost(v, "/poderes/forma-selvagem"),
	}) {
		Transformar
	}
}

// wildShapeOpener é o gesto da linha do poder: abre a escolha, com os sinais zerados.
templ wildShapeOpener(row powerRow) {
	@ds.Button(ds.ButtonSecondary, powerGestureAttrs(row, "Transformar com "+row.Name, templ.Attributes{
		"commandfor": wildShapeDialogID, "command": "show-modal", "aria-haspopup": "dialog", "data-on:click": wildShapeOpens,
	})) {
		Transformar
	}
}

// wildShapeActiveRow é a forma em vigor, na aba Efeitos, com a volta ao normal — que não devolve o PM.
templ wildShapeActiveRow(v View, line wildShapeLine) {
	<div class="ds-row">
		<div>
			<div class="ds-row-title">{ line.Name }</div>
			<div class="ds-row-meta">{ line.Meta }</div>
		</div>
		@ds.Button(ds.ButtonSecondary, templ.Attributes{"type": "button", "aria-label": "Voltar ao normal da " + line.Name, "data-on:click": sheetPost(v, "/efeitos/forma-selvagem")}) {
			Voltar ao normal
		}
	</div>
}

// agileBothButton é o segundo botão do card na Forma Ágil: declarar o ataque com as duas armas naturais
// (p63). Declarado, ele some: o que desfaz é o Encerrar dos Efeitos.
templ agileBothButton(v View, state agileBothState) {
	if !state.Declared {
		@ds.Button(ds.ButtonSecondary, templ.Attributes{"type": "button", "aria-label": "Atacar com as duas armas naturais", "data-on:click": sheetPost(v, agileBothPath)}) {
			As duas
		}
	}
}

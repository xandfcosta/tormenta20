package sheetui

import "strconv"
import "t20engine/serve/web/ui"

// A SUPERFÍCIE AÇÕES desenhada.
//
// UMA LISTA e nenhuma grade: a grade da aba Combate existe para seis números que
// se comparam entre si, e aqui a pergunta é outra — cada linha é um verbo com um
// número à direita, e o olho desce a coluna de números sem atravessar a tela.
//
// O GESTO FICA COLADO NO NÚMERO que ele usa, que é a mesma tese dos chips: o
// `+8` e o "Rolar" na mesma linha dispensam procurar onde se rola aquilo. Quem
// precisa de ALVO lê o sinal que a barra da Mesa escreve, e nasce desabilitado
// até haver um.

// ActionsBody é a superfície inteira. Exportada porque quem a desenha é a MESA:
// a ficha não tem esta aba, e o orçamento do turno que a acompanha é da sessão.
templ ActionsBody(v View) {
	<div id="actions-scene" class="flex min-h-0 flex-1 flex-col gap-3">
		// A RECUSA MORA NAS DUAS SUPERFÍCIES, e isso não é duplicação de frase: é
		// o MESMO componente desenhado onde o gesto pode ter saído. Um gesto das
		// Ações recusado só pelo `#sheet-scene` é recusado dentro de um nó que o
		// `data-show` está escondendo — o jogador aperta Rolar e a tela dele não
		// muda nada (medido no navegador, ALE-423).
		@ruleRefusal(v)
		if len(v.Actions.Groups) == 0 {
			<p class="self-center py-8 text-center text-sm italic text-muted-foreground">
				Esta ficha ainda não tem o que fazer num turno. Empunhe uma arma na Mochila.
			</p>
		}
		for _, group := range v.Actions.Groups {
			@actionSection(v, group)
		}
		if v.Actions.Passives > 0 {
			@passiveTally(v.Actions.Passives)
		}
		// OS CONTADORES DE DEGRAU, desenhados TAMBÉM aqui.
		//
		// O chip de uma postura que escala não entra: ele ABRE esta
		// sobreposição. E uma sobreposição que só existisse na aba Poderes
		// estaria dentro do nó que o `data-show` da Ficha esconde — o toque
		// escreveria `$detail` e NINGUÉM leria, o que em JavaScript não é erro:
		// é o botão não fazer nada.
		//
		// É o MESMO componente da aba Poderes, então a rota, a prévia do custo e
		// a validação continuam sendo uma só. As duas cópias convivem quando a
		// Ficha está aberta na aba Poderes, e a escondida não pinta: ancestral em
		// `display:none` não desenha sobreposição `fixed` nenhuma.
		for _, row := range v.Powers.Actions {
			if row.Stance != nil && row.Stance.MaxSteps > 0 {
				@stanceStepperDialog(v, row)
			}
			if row.Degrees != nil && row.Degrees.opensDialog() {
				@useStepperDialog(v, row)
			}
		}
	</div>
}

templ actionSection(v View, group actionGroup) {
	<section>
		<p class="mb-1.5 flex flex-wrap items-baseline gap-2">
			<span class={ ui.SectionLabelClasses("gold", "") }>{ group.Title }</span>
			if group.Note != "" {
				<span class={ ui.SectionLabelClasses("muted", "text-3xs") }>{ group.Note }</span>
			}
		</p>
		if len(group.Chips) > 0 {
			@chipStrip(v, group.Chips)
		}
		<ul class="divide-y divide-grimorio-iron rounded-sm border border-grimorio-iron">
			for _, row := range group.Rows {
				@actionLine(v, row)
			}
		</ul>
	</section>
}

// actionLine é uma coisa que dá para fazer.
//
// A LINHA RECUSADA APARECE APAGADA em vez de sumir, e o motivo vai escrito: "a
// Fúria não está aqui" manda procurar na ficha, e "Fúria — falta PM" responde.
templ actionLine(v View, row actionRow) {
	<li class={ "px-3 py-2", templ.KV("opacity-60", !row.Can) }>
		<div class="flex items-center justify-between gap-2">
		<div class="min-w-0">
			<p class="flex min-w-0 flex-wrap items-center gap-1.5">
				<span class="truncate text-sm text-foreground">{ row.Name }</span>
				if row.Live {
					<span class="rounded-sm border border-grimorio-gold/60 px-1.5 py-0.5 text-3xs font-semibold uppercase tracking-widest text-grimorio-gold">
						em curso
					</span>
				}
			</p>
			// O DETALHE QUEBRA LINHA, e o nome é que trunca.
			//
			// Invertido — detalhe truncado — a 390px a Investida saía "…−2 na
			// Defesa até a sua", cortando a consequência que é a razão de a linha
			// existir. Um nome cortado custa estética; uma regra cortada custa a
			// decisão de quem está lendo.
			if row.Detail != "" && len(row.Boosts) > 0 {
				<p class="text-2xs text-muted-foreground" data-text={ boostPreviewExpr(row.Weapon, row.Boosts, "detail", row.Detail) }>{ row.Detail }</p>
			} else if row.Detail != "" {
				<p class="text-2xs text-muted-foreground">{ row.Detail }</p>
			}
			if !row.Can && row.Why != "" {
				<p class="text-2xs text-penalty-ink">{ row.Why }</p>
			}
		</div>
		<div class="flex shrink-0 items-center gap-2">
			if row.Cost != "" {
				<span class="rounded-sm border border-grimorio-iron px-1.5 py-0.5 font-mono text-3xs tabular-nums text-muted-foreground">
					{ row.Cost }
				</span>
			}
			if len(row.Boosts) > 0 {
				<span
					data-show={ boostOnExpr(row.Weapon) }
					data-text={ boostCostExpr(row.Weapon, row.Boosts) }
					class="rounded-sm border border-grimorio-iron px-1.5 py-0.5 font-mono text-3xs tabular-nums text-muted-foreground"
				></span>
				<span
					data-text={ boostPreviewExpr(row.Weapon, row.Boosts, "attack", row.Value) }
					data-class={ chosenLookExpr("text-grimorio-gold", "text-foreground", boostOnExpr(row.Weapon)) }
					class="font-mono text-base font-bold tabular-nums text-foreground"
				>{ row.Value }</span>
			} else if row.Value != "" {
				<span class="font-mono text-base font-bold tabular-nums text-foreground">{ row.Value }</span>
			}
			if len(row.Rolls) == 1 && len(row.Boosts) > 0 {
				@rollButton(v, row.Rolls[0], "bg-primary font-semibold text-primary-foreground", rollClearsTheBoost())
			} else if len(row.Rolls) == 1 {
				@rollButton(v, row.Rolls[0], "bg-primary font-semibold text-primary-foreground", "")
			}
		</div>
		</div>
		if len(row.Rolls) > 1 {
			@rollStrip(v, row.Rolls)
		}
		if len(row.Boosts) > 0 {
			@boostStrip(row)
		}
	</li>
}

// rollStrip é a tira de verbos de uma linha que oferece MAIS DE UM gesto, que
// hoje é só a Manobra.
//
// EMBAIXO e não à direita do número: cinco botões na coluna da direita
// empurrariam o nome da linha para fora da tela a 390px, e o que se perde ali é
// o que a linha É.
templ rollStrip(v View, rolls []actionRoll) {
	<div class="mt-2 flex flex-wrap items-center gap-1.5 border-t border-grimorio-iron pt-2">
		for _, roll := range rolls {
			@rollButton(v, roll, "border border-grimorio-iron text-muted-foreground", "")
		}
	</div>
}

// rollButton é o gesto de rolar, nas duas aparências.
//
// O QUE PRECISA DE ALVO SÓ EXISTE DENTRO DA SESSÃO, e a trava é não desenhar:
// fora dela não há fila, o sinal `$turn_target` não foi declarado, e a
// expressão leria `undefined` — que em JavaScript não é erro, é o botão não
// fazer nada. O teste de perícia continua desenhado nos dois lugares, porque
// ele rola igual: sem mesa, o que não acontece é a publicação na faixa.
//
// O `after` roda DEPOIS de mandar o gesto — o ataque zera o impulso escolhido.
templ rollButton(v View, roll actionRoll, look string, after string) {
	if !roll.NeedsTarget || v.Embedded {
		<button
			type="button"
			data-attr:disabled={ rollWaitsForATarget(roll) }
			title={ rollTitle(roll) }
			if roll.Opens != "" {
				aria-haspopup="dialog"
			}
			data-on:click={ rollCommand(v, roll, after) }
			class={ "inline-flex min-h-11 shrink-0 items-center gap-1.5 whitespace-nowrap rounded-sm px-3 text-sm outline-none transition-opacity hover:opacity-90 disabled:opacity-40",
				look }
		>
			{ roll.Label }
		</button>
	}
}

// boostStrip é a tira do impulso de PM, embaixo da linha de ataque — no lugar
// da tira da Manobra, e pela mesma razão: na coluna da direita ela empurraria o
// nome da arma para fora a 390px. Ver `attack_boost.go`.
templ boostStrip(row actionRow) {
	<div class="mt-2 flex flex-wrap items-center gap-1.5 border-t border-grimorio-iron pt-2">
		<span class={ ui.SectionLabelClasses("muted", "text-3xs") }>com</span>
		for _, boost := range row.Boosts {
			<button
				type="button"
				disabled?={ !boost.Can }
				title={ boost.Why }
				data-attr:aria-pressed={ ariaBoolExpr(boostChosenExpr(row.Weapon, boost.PowerID)) }
				data-on:click={ boostToggleCommand(row.Weapon, boost) }
				data-class={ chosenLookExpr("border-2 border-grimorio-gold bg-grimorio-gold/10 font-semibold text-grimorio-gold",
					"border-grimorio-iron text-muted-foreground", boostChosenExpr(row.Weapon, boost.PowerID)) }
				class="inline-flex min-h-11 items-center gap-1 rounded-sm border border-grimorio-iron px-2.5 text-xs text-muted-foreground transition-colors disabled:opacity-40"
			>
				{ boost.Name }
				<span class="font-mono text-3xs tabular-nums" data-show={ "!(" + boostChosenExpr(row.Weapon, boost.PowerID) + ")" }>
					{ strconv.Itoa(boost.BasePM) + " PM" }
				</span>
			</button>
			<span class="inline-flex flex-wrap items-center gap-1.5" data-show={ boostChosenExpr(row.Weapon, boost.PowerID) }>
				if boost.MaxSteps > 0 {
					<button
						type="button"
						aria-label={ "Menos um degrau de " + boost.Name }
						data-on:click={ boostStepCommand(boost, -1) }
						class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-sm border border-grimorio-iron text-foreground"
					>−</button>
				}
				<span class="whitespace-nowrap font-mono text-sm tabular-nums text-foreground" data-text={ boostStepLabelExpr(boost) }></span>
				if boost.MaxSteps > 0 {
					<button
						type="button"
						aria-label={ "Mais um degrau de " + boost.Name }
						data-on:click={ boostStepCommand(boost, 1) }
						class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-sm border border-grimorio-iron text-foreground"
					>+</button>
				}
				if boost.Split {
					<span role="radiogroup" aria-label={ "Para onde vai o bônus de " + boost.Name } class="inline-flex overflow-hidden rounded-sm border border-grimorio-iron">
						for _, side := range boostSplits {
							<button
								type="button"
								role="radio"
								data-attr:aria-checked={ ariaBoolExpr(boostSplitIsExpr(side.Value)) }
								data-on:click={ boostSplitCommand(side.Value) }
								data-class={ chosenLookExpr("bg-grimorio-gold/10 font-semibold text-grimorio-gold",
									"text-muted-foreground", boostSplitIsExpr(side.Value)) }
								class="min-h-11 whitespace-nowrap px-2.5 text-xs text-muted-foreground"
							>{ side.Label }</button>
						}
					</span>
				}
			</span>
		}
	</div>
}

// chipStrip é a tira de interruptores ACIMA dos números que eles mudam.
//
// COM o rótulo "com" na frente: sem ele a tira é uma fileira de botões cuja
// relação com a lista de baixo o olho tem de adivinhar. Uma palavra de três
// letras compra essa relação.
//
// O CHIP QUE PERGUNTA NÃO É INTERRUPTOR, e por isso ele troca o `aria-pressed`
// pelo `aria-haspopup`: "não pressionado" promete que o toque liga alguma
// coisa, e o toque dele abre um contador. Quem ouve a tela recebe a promessa
// certa nos dois casos.
templ chipStrip(v View, chips []actionChip) {
	<div class="mb-1.5 flex flex-wrap items-center gap-1.5">
		<span class={ ui.SectionLabelClasses("muted", "text-3xs") }>com</span>
		for _, chip := range chips {
			<button
				type="button"
				disabled?={ !chip.Can }
				title={ chipTitle(chip) }
				if chip.Asks {
					aria-haspopup="dialog"
				} else {
					aria-pressed={ ariaBool(chip.On) }
				}
				data-on:click={ chipCommand(v, chip) }
				class={ "inline-flex min-h-11 items-center gap-1 rounded-sm border px-2.5 text-xs transition-colors",
					templ.KV("border-2 border-grimorio-gold bg-grimorio-gold/10 font-semibold text-grimorio-gold", chip.On),
					templ.KV("border-grimorio-iron text-muted-foreground", !chip.On) }
			>
				{ chip.Label }
				if chip.Cost != "" {
					<span class="font-mono text-3xs tabular-nums">{ chip.Cost }</span>
				}
				if chip.Bonus != "" {
					<span class="font-mono text-3xs tabular-nums">{ chip.Bonus }</span>
				}
			</button>
		}
	</div>
}

// passiveTally é a CONTAGEM das passivas, e ela fecha a superfície.
//
// Ela não abre nada: quem quer a lista tem a aba Poderes, e duplicá-la aqui
// daria duas listas da mesma coisa para manter em dia. O que a linha entrega é a
// garantia de que a superfície não escondeu nada — "você tem mais seis, e elas
// já estão nos seus números".
templ passiveTally(count int) {
	<p class="rounded-sm border border-dashed border-grimorio-iron px-3 py-2 text-2xs text-muted-foreground">
		Passivas · { strconv.Itoa(count) } · já estão nos seus números, nada a acionar
	</p>
}

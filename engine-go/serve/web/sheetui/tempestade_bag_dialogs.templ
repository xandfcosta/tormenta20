package sheetui

import (
	"strconv"

	"t20engine/serve/web/ds"
	"t20engine/serve/web/ui"
)

// OS DIÁLOGOS DA MOCHILA PARALELA: a folha de cada item, as melhorias e o
// editar dele, e três compartilhados — adicionar, item próprio e dinheiro.
// Todo gesto que grava fecha o diálogo no mesmo toque (`command="close"`).

// itemSheetDs é a folha do item (ver o GLOSSARY).
templ itemSheetDs(v View, s itemSheet) {
	@sheetDialog(v, itemSheetID(s.Command), s.Name, itemSheetFoot(v, s)) {
		<p class="ds-help">{ writtenWeight(s) }</p>
		if s.NoProficiency {
			<p role="alert" class="ds-alert">Sem proficiência: a penalidade da p142 já está no ataque.</p>
		}
		if len(s.Equip) > 0 {
			<div class="ds-field">
				<span class="ds-field-label">Equipar</span>
				<div class="ds-options">
					for _, place := range s.Equip {
						@ds.Button(ds.ButtonSecondary, templ.Attributes{"type": "button", "commandfor": itemSheetID(s.Command), "command": "close", "data-on:click": equipCommand(v, s, place)}) {
							{ place.Label }
						}
					}
				</div>
			</div>
		}
		if s.Consumable != nil {
			// O DADO É DA MESA: quem rola é a pessoa, e o servidor aceita o
			// número que ela mandar (ver `consumeBlock`).
			<div class="ds-field">
				<span class="ds-field-label">{ "Usar · " + s.Consumable.Scope }</span>
				if s.Consumable.HpDice != "" {
					@ds.TextField(ds.Field{ID: "roll-hp-" + s.Command, Label: "PV rolados (" + s.Consumable.HpDice + ")", Type: "number"}, templ.Attributes{"min": "0", "data-bind:item_roll_hp": true})
				}
				if s.Consumable.MpDice != "" {
					@ds.TextField(ds.Field{ID: "roll-mp-" + s.Command, Label: "PM rolados (" + s.Consumable.MpDice + ")", Type: "number"}, templ.Attributes{"min": "0", "data-bind:item_roll_mp": true})
				}
				@ds.Button(ds.ButtonPrimary, templ.Attributes{"type": "button", "aria-label": "Usar " + s.Name, "commandfor": itemSheetID(s.Command), "command": "close", "data-on:click": sheetPost(v, "/itens/"+s.Command+"/usa")}) {
					Usar
				}
			</div>
		}
		if s.Doses != nil {
			@itemSheetDosesDs(v, s)
		}
		if s.Book != nil {
			<div class="ds-field">
				<span class="ds-field-label">{ s.Book.Category + " · T$ " + s.Book.Price + " · p" + strconv.Itoa(s.Book.Page) }</span>
				for _, row := range s.Book.Rows {
					<p class="ds-help">{ row }</p>
				}
			</div>
		}
		if s.School != nil {
			<div class="ds-field">
				<span class="ds-field-label">Escola · +2 na CD das magias arcanas dela (p160)</span>
				if s.School.Chosen == "" {
					<p class="ds-help">Escolha a escola: sem ela, o tomo não muda nenhuma CD.</p>
				}
				<div class="ds-options" role="group" aria-label="Escola">
					for _, school := range s.School.Options {
						@ds.Option(school.ID == s.School.Chosen, templ.Attributes{"data-on:click": sheetPost(v, "/itens/"+s.Command+"/escola/"+school.ID)}) {
							{ school.Name }
						}
					}
				</div>
			</div>
		}
		if s.God != nil {
			@itemGodField(v, s)
		}
		if len(s.Overlays) > 0 {
			@ds.BareList("Melhorias e material", "") {
				for _, o := range s.Overlays {
					@ds.Row(o.Name, o.Effect, "", "")
				}
			}
		}
		if s.Spell != nil {
			@itemSpellField(v, s)
		}
		// O TEXTO NO `.ds-field`, como as linhas do livro logo acima: é ele que dá ao `.ds-help` o corpo pequeno e
		// a tinta de ajuda. Solto, o texto saía no corpo do diálogo e gritava mais que o interruptor que explica. O
		// interruptor fica FORA: um `label` filho do `.ds-field` vira rótulo de campo, e encolhia junto.
		if s.Weapon {
			@ds.Switch("Arma de categoria maior", s.Oversized, templ.Attributes{"data-on:change": sheetPost(v, "/itens/"+s.Command+"/categoria-maior")})
			<div class="ds-field">
				<p class="ds-help">–5 no ataque, ou –2 com Empunhadura Poderosa; um passo de dano a mais e um espaço a mais (p106, p125, p143).</p>
			</div>
		}
		// O ENCANTO SE LÊ AQUI, e quem encanta é o mestre, pelo "Encantos" do pé (p333).
		if len(s.Enchants) > 0 {
			@ds.BareList("Encantos", "") {
				for _, o := range s.Enchants {
					@ds.Row(o.Name, o.Effect, "", "")
				}
			}
		}
	}
	if s.Overlayable {
		@improvementsDs(v, s)
	}
	if s.Enchantable {
		@enchantsDs(v, s)
	}
	@sheetDialog(v, itemEditID(s.Command), "Editar "+s.Name, itemFormFoot(itemEditID(s.Command), "Salvar", sheetPost(v, "/itens/"+s.Command+"/edita"))) {
		@itemFormFields(itemEditID(s.Command))
	}
}

// itemGodField é o deus do símbolo sagrado (p157). O da ficha vem sozinho, com um toque, e os outros ficam
// atrás de "Outro deus", aberto quando o escolhido é um deles (decisão do dono). A frase de cima diz se o +1
// vale, porque é ela a pergunta que o jogador faz ao abrir a folha.
templ itemGodField(v View, s itemSheet) {
	<div class="ds-field">
		<span class="ds-field-label">Deus · o +1 em resistência é de quem é devoto dele (p157)</span>
		switch {
			case s.God.Chosen == "":
				<p class="ds-help">Escolha o deus do símbolo: sem ele, o +1 não vale.</p>
			case s.God.Devout():
				<p class="ds-help">{ s.God.ChosenName + " é o deus da ficha: o +1 em resistência vale." }</p>
			case s.God.Own == "":
				<p class="ds-help">{ "A ficha não é devota de " + s.God.ChosenName + ": o +1 em resistência não vale." }</p>
			default:
				<p class="ds-help">{ s.God.ChosenName + " não é o deus da ficha (" + s.God.OwnName + "): o +1 em resistência não vale." }</p>
		}
		if s.God.Own != "" {
			<div class="ds-options" role="group" aria-label="Deus da ficha">
				@ds.Option(s.God.Devout(), templ.Attributes{"data-on:click": sheetPost(v, "/itens/"+s.Command+"/deus/"+s.God.Own)}) {
					{ s.God.OwnName + " · o seu" }
				}
			</div>
		}
		<details class="ds-more-options" open?={ s.God.Own == "" || (s.God.Chosen != "" && !s.God.Devout()) }>
			<summary>
				<span>{ "Outro deus (" + strconv.Itoa(len(s.God.Others)) + ")" }</span>
				@ui.Icon("ChevronDown", "ds-icon")
			</summary>
			<div class="ds-options" role="group" aria-label="Outro deus">
				for _, god := range s.God.Others {
					@ds.Option(god.ID == s.God.Chosen, templ.Attributes{"data-on:click": sheetPost(v, "/itens/"+s.Command+"/deus/"+god.ID)}) {
						{ god.Name }
					}
				}
			</div>
		</details>
	</div>
}

// itemSpellField é a magia do Harmonizado (p165), embaixo das melhorias, que é onde ele se lê. A escolhida
// fica à vista, e as outras se acham pela busca no livro inteiro (decisão do dono): 198 opções soltas não
// cabem numa folha.
templ itemSpellField(v View, s itemSheet) {
	<div class="ds-field">
		<span class="ds-field-label">Magia do Harmonizado · −1 PM no custo dela (p165)</span>
		if s.Spell.Chosen == "" {
			<p class="ds-help">Escolha a magia: sem ela, o Harmonizado não corta nenhuma.</p>
		} else {
			<p class="ds-help">{ s.Spell.ChosenName + " custa 1 PM a menos com o esotérico na mão." }</p>
			if s.Spell.Search == "" {
				<div class="ds-options" role="group" aria-label="Magia escolhida">
					@ds.Option(true, templ.Attributes{"data-on:click": sheetPost(v, improvementSpellPath(s, s.Spell.Chosen))}) {
						{ s.Spell.ChosenName }
					}
				</div>
			}
		}
		@ds.SearchField("improvement-spell-search-"+s.Command, "Buscar magia no livro", templ.Attributes{
			"value": s.Spell.Search, "data-bind:improvement_spell_search": true, "data-on:input__debounce.250ms": sheetGet(v),
		})
		if s.Spell.Search != "" {
			if len(s.Spell.Found) == 0 {
				<p class="ds-help">{ "Nenhuma magia do livro com \"" + s.Spell.Search + "\"." }</p>
			}
			<div class="ds-options" role="group" aria-label="Magias achadas">
				for _, spell := range s.Spell.Found {
					@ds.Option(spell.ID == s.Spell.Chosen, templ.Attributes{"data-on:click": sheetPost(v, improvementSpellPath(s, spell.ID))}) {
						{ spell.Name }
					}
				}
			</div>
		}
		<p class="ds-help">Trocar a magia leva um ritual de um dia e T$ 100 (p165): o app troca, e o custo é do mestre.</p>
	</div>
}

// itemSheetFoot é o pé da folha: o Remover à esquerda, longe do resto, e o
// Melhorias e o Editar, que abrem os diálogos deles carregando o item.
templ itemSheetFoot(v View, s itemSheet) {
	@ds.Button(ds.ButtonDanger, templ.Attributes{"type": "button", "aria-label": "Remover " + s.Name, "commandfor": itemSheetID(s.Command), "command": "close", "data-on:click": sheetPost(v, "/itens/"+s.Command+"/remover")}) {
		Remover
	}
	if s.Overlayable {
		@ds.Button(ds.ButtonSecondary, templ.Attributes{"type": "button", "aria-label": "Melhorias de " + s.Name, "commandfor": itemImprovementsID(s.Command), "command": "show-modal", "aria-haspopup": "dialog", "data-on:click": improvementsOpens(s)}) {
			Melhorias
		}
	}
	if s.Enchantable {
		@enchantsOpener(s)
	}
	@ds.Button(ds.ButtonSecondary, templ.Attributes{"type": "button", "aria-label": "Editar " + s.Name, "commandfor": itemEditID(s.Command), "command": "show-modal", "aria-haspopup": "dialog", "data-on:click": editOpens(s)}) {
		Editar
	}
}

// improvementsDs escolhe melhorias e material. As listas já vêm filtradas pela
// família do item, e quem recusa o resto é o servidor (`fitsItemImprovement`,
// `book.FitsImprovementCount`). A conta das quatro vagas fica no topo, e o que
// passaria dela trava antes do Aplicar.
templ improvementsDs(v View, s itemSheet) {
	@sheetDialog(v, itemImprovementsID(s.Command), "Melhorias de "+s.Name, improvementsFoot(v, s)) {
		<p class="ds-row-meta" data-text={ improvementsCountText(s) }>{ writtenImprovementsCount(s) }</p>
		@ds.BareList("Melhorias", "") {
			for _, c := range s.Improvements {
				<div class="ds-row ds-pick-row">
					<div class="min-w-0">
						<div class="ds-row-title">
							{ c.Name }
							if c.FromTable {
								@ds.Badge("da mesa", true)
							}
						</div>
						if !c.FromTable {
							<div class="ds-row-meta">{ "T$ " + c.Price }</div>
						}
						<div class="ds-pick-detail">{ c.Effect }</div>
					</div>
					@ds.Switch("", c.Active, templ.Attributes{"aria-label": c.Name, "data-on:change": thatTogglesImprovementGesture(c), "data-effect": "el.checked = " + improvementSignal(c), "data-attr:disabled": improvementLocked(c, s)})
				</div>
			}
		}
		if len(s.Materials) > 0 {
			<div class="ds-field">
				<label for={ "material-" + s.Command }>Material</label>
				<select class="ds-input" id={ "material-" + s.Command } aria-describedby={ "material-" + s.Command + "-help" } data-bind:item_material data-attr:disabled={ materialLocked(s) }>
					<option value="">Nenhum</option>
					for _, c := range s.Materials {
						<option value={ c.ID } selected?={ c.Active }>{ c.Name + " · T$ " + c.Price }</option>
					}
				</select>
				<p class="ds-help" id={ "material-" + s.Command + "-help" }>Ocupa uma das quatro vagas de melhoria (p165).</p>
			</div>
		}
	}
}

templ improvementsFoot(v View, s itemSheet) {
	@ds.Button(ds.ButtonPrimary, templ.Attributes{"type": "button", "commandfor": itemImprovementsID(s.Command), "command": "close", "data-on:click": sheetPost(v, "/itens/"+s.Command+"/melhorias")}) {
		Aplicar
	}
}

// itemAddDialog é o "Adicionar item": o Capítulo 3 com a busca e a categoria
// fixas e só a lista rolando, e no pé o item próprio, para o que o livro não
// tem — Catálogo e Custom viraram um gesto só (decisão do dono).
templ itemAddDialog(v View) {
	@sheetLazyDialog(v, "item-add", "Adicionar item", itemAddFoot()) {
		@ds.FilterBar() {
			@ds.SearchField("catalog-search", "Buscar no livro", templ.Attributes{
				"value": v.Bag.CatalogSearch, "data-bind:catalog_search": true, "data-on:input__debounce.250ms": sheetGet(v),
			})
			<div class="ds-options ds-options-line" data-scrolls-x role="group" aria-label="Categoria do livro">
				for _, o := range v.Bag.CatalogCategories {
					@ds.Option(o.Active, templ.Attributes{"data-on:click": "$catalog_category = '" + o.Value + "'; " + sheetGet(v)}) {
						{ o.Label }
					}
				}
			</div>
		}
		@ds.DialogScroll() {
			@ds.List("No livro", strconv.Itoa(len(v.Bag.Catalog))) {
				if len(v.Bag.Catalog) == 0 {
					@ds.Row("Nenhum item para essa busca", "", "", "")
				}
				for _, row := range v.Bag.Catalog {
					<div class="ds-row ds-pick-row">
						<div class="min-w-0">
							<div class="ds-row-title">{ row.Name }</div>
							<div class="ds-row-meta">{ row.Category + " · " + row.Slots + " espaço · T$ " + row.Price }</div>
						</div>
						@ds.Button(ds.ButtonSecondary, templ.Attributes{"type": "button", "aria-label": "Adicionar " + row.Name, "commandfor": "item-add", "command": "close", "data-on:click": sheetPost(v, "/itens/adiciona/"+row.ID)}) {
							Adicionar
						}
					</div>
				}
			}
		}
	}
}

templ itemAddFoot() {
	@ds.Button(ds.ButtonSecondary, templ.Attributes{"type": "button", "commandfor": "item-custom", "command": "show-modal", "aria-haspopup": "dialog", "data-on:click": "$item_name = ''; $item_qty = 1; $item_slots = 1"}) {
		Item fora do livro
	}
}

// customItemDialog é o item fora do livro — nome, quantidade e espaços. O
// editar de cada item é o mesmo formulário, com outro destino.
templ customItemDialog(v View) {
	@sheetDialog(v, "item-custom", "Item fora do livro", itemFormFoot("item-custom", "Adicionar", sheetPost(v, "/itens/custom"))) {
		@itemFormFields("item-custom")
	}
}

templ itemFormFields(id string) {
	@ds.TextField(ds.Field{ID: id + "-name", Label: "Nome"}, templ.Attributes{"maxlength": "80", "data-bind:item_name": true})
	<div class="grid grid-cols-2 gap-3">
		@ds.TextField(ds.Field{ID: id + "-qty", Label: "Quantidade", Type: "number"}, templ.Attributes{"min": "1", "max": "9999", "data-bind:item_qty": true})
		@ds.TextField(ds.Field{ID: id + "-slots", Label: "Espaços", Type: "number"}, templ.Attributes{"min": "0", "step": "0.5", "data-bind:item_slots": true})
	</div>
}

templ itemFormFoot(id, button, command string) {
	@ds.Button(ds.ButtonPrimary, templ.Attributes{"type": "button", "commandfor": id, "command": "close", "data-on:click": command}) {
		{ button }
	}
}

// bagMoneyDialog são as três coisas que se fazem com dinheiro na mesa:
// receber, gastar e escrever o total (ver `moneyModes`).
templ bagMoneyDialog(v View) {
	@sheetDialog(v, "bag-money", "Dinheiro", bagMoneyFoot(v)) {
		<p class="ds-help">{ "Você tem T$ " + v.Bag.Money.Tibar + "." }</p>
		<div class="ds-options" role="group" aria-label="O que fazer com o dinheiro">
			for _, mode := range moneyModes {
				@ds.Option(mode.Value == "receber", templ.Attributes{
					"data-on:click":          "$tibar_mode = '" + mode.Value + "'",
					"data-attr:aria-pressed": "String($tibar_mode === '" + mode.Value + "')",
				}) {
					{ mode.Label }
				}
			}
		</div>
		@ds.TextField(ds.Field{ID: "tibar-value", Label: "Valor em T$", Type: "number"}, templ.Attributes{"min": "0", "step": "0.01", "data-bind:tibar_value": true})
	}
}

templ bagMoneyFoot(v View) {
	@ds.Button(ds.ButtonPrimary, templ.Attributes{"type": "button", "commandfor": "bag-money", "command": "close", "data-on:click": sheetPost(v, "/dinheiro")}) {
		Confirmar
	}
}

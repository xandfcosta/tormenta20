package sheetui

import (
	"net/url"
	"slices"
	"strconv"

	"t20engine/domain/sheet"
	"t20engine/serve/web/ds"
	"t20engine/serve/web/ui"
)

// tempestadeChoicesDialog é o Escolher da ficha, em passos (ver o
// GLOSSARY): a lista do que falta e um passo de cada vez. No celular a lista
// some quando um passo abre, e o cabeçalho do passo toma o lugar do do
// diálogo, com a seta de voltar; no desktop as duas camadas ficam lado a lado,
// e a lista não rola junto com o passo.
templ tempestadeChoicesDialog(v View) {
	@ds.Dialog("power-choices", "Escolher", nil) {
		<div class="ds-steps" data-attr:data-step-open="String($choice_step !== '')">
			{{ steps := choiceStepsOf(v) }}
			<nav class="ds-steps-list" aria-label="Escolhas">
				if len(steps) == 0 {
					<p class="ds-help">Esta ficha não pede escolha.</p>
				} else {
					@ds.List(stepsTitle(steps), "") {
						for _, step := range steps {
							<button
								type="button"
								class="ds-row ds-step-row"
								data-on:click={ "$choice_step = '" + step.ID + "'" }
								data-attr:aria-current={ "$choice_step === '" + step.ID + "' ? 'step' : 'false'" }
							>
								<span class="min-w-0">
									<span class="ds-row-title">{ step.Title }</span>
									<span class="ds-row-meta">{ step.Meta }</span>
								</span>
								<span class="ds-step-tag" data-done?={ step.Done }>{ step.Tag() }</span>
								@ui.Icon("ChevronRight", "ds-icon")
							</button>
						}
					}
				}
			</nav>
			for _, step := range steps {
				@choiceStepSection(v, step)
			}
		</div>
	}
}

// choiceStepSection é um passo aberto: o cabeçalho com a contagem, os filtros
// fixos quando a lista é longa, e a parte que rola.
templ choiceStepSection(v View, step choiceStep) {
	<section class="ds-step" id={ "choice-step-" + step.ID } aria-label={ step.Title } data-show={ "$choice_step === '" + step.ID + "'" } style="display: none">
		<div class="ds-step-head">
			<span class="ds-step-back">
				@ds.IconButton(ds.ButtonGhost, "ChevronLeft", "Voltar às escolhas", templ.Attributes{"type": "button", "data-on:click": "$choice_step = ''"})
			</span>
			<h3 class="ds-step-title">{ step.Title }</h3>
			if step.Count != "" {
				<span class="ds-step-count">{ step.Count }</span>
			}
			<form method="dialog" class="ds-step-close">
				@ds.IconButton(ds.ButtonGhost, "X", "Fechar", nil)
			</form>
		</div>
		// ACIMA DO QUE ROLA: tocada lá embaixo na lista, a opção recusada continua à vista
		// da frase.
		if v.Refusal != "" {
			<div class="ds-step-refusal">
				@refusalInDialog(v)
			</div>
		}
		if step.Kind == "powers" {
			@powersStepFilters(v, step.Class)
		}
		@ds.DialogScroll() {
			switch step.Kind {
				case "race":
					@raceStepBody(v, step.Race)
				case "origin":
					@originStepBody(v, *v.Choices.Origin)
				case "powers":
					if step.Class.GrantedNote != "" {
						<p class="ds-card-text">{ step.Class.GrantedNote }</p>
					}
					@ds.List("", "") {
						for _, power := range step.Class.Powers {
							@powerPickRow(v, power, true)
						}
					}
				case "path":
					@classPickerDs(v, step.Class.ClassName, "caminho", "Caminho", *step.Class.Path)
				case "devotion":
					@devotionStepBody(v, v.Choices.Devotion)
				case "counted":
					@countedChoiceDs(v, step.Counted)
				case "general":
					@ds.List("", "") {
						@powerPickRow(v, step.Power, false)
					}
				case "training":
					@classTrainingDs(v, *v.Choices.Training)
			}
		}
	</section>
}

// classTrainingDs é o passo das perícias da classe. O gesto é o mesmo interruptor
// de treino da aba Perícias, e por isso uma tela nunca desfaz a outra.
templ classTrainingDs(v View, training sheet.ClassTraining) {
	for _, block := range training.Blocks {
		<div class="ds-field">
			<div class="ds-pick-head">
				<span class="ds-field-label">{ block.Name }</span>
				<span class="ds-row-meta">{ strconv.Itoa(block.Chosen) + " de " + strconv.Itoa(block.Limit) }</span>
			</div>
			<div class="ds-options">
				for _, name := range block.Offered {
					@ds.Option(slices.Contains(block.Trained, name), templ.Attributes{"aria-label": block.Name + ": " + name, "data-on:click": sheetPost(v, "/pericias/treino/"+url.PathEscape(name))}) {
						{ name }
					}
				}
			</div>
		</div>
	}
	<span class="ds-help">A perícia que a origem ou um poder já treina não aparece aqui, porque não gasta escolha.</span>
}

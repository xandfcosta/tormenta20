package sheetui

import (
	"strconv"
	"t20engine/domain/sheet"
	"t20engine/serve/web/ui"
)

// O DIÁLOGO DE ESCOLHER PODERES (ALE-272, fatia 8).
//
// Três abas de FONTE — Raça, Origem, Classe —, e elas fazem sentido AQUI: no
// preparo a pergunta é "de onde vem o que eu ainda posso escolher". Na mesa a
// pergunta é outra, e por isso a lista de trás não tem abas.
//
// As PENDÊNCIAS aparecem no topo e são o que traz a pessoa: quem abriu o
// diálogo veio por causa delas.

// choicesButton é o gesto que abre, com o crachá do que falta.
templ choicesButton(v View) {
	<button
		type="button"
		aria-label="Escolher poderes"
		aria-haspopup="dialog"
		data-on:click={ "$power_source = '" + firstPendingSource(v) + "'; $detail = 'escolher-poderes'" }
		class={ ui.ButtonClasses(ui.VariantSecondary, ui.SizeSmall, "shrink-0 gap-1") }
	>
		Escolher
		if len(v.Choices.Pending) > 0 {
			<span aria-hidden="true" class="rounded-full bg-primary px-1.5 text-3xs font-bold text-primary-foreground">
				{ strconv.Itoa(len(v.Choices.Pending)) }
			</span>
			<span class="sr-only">{ writtenPendings(len(v.Choices.Pending)) }</span>
		}
	</button>
}

// choicesDialog é a administração da ficha.
templ choicesDialog(v View) {
	@overlay("escolher-poderes", "Escolher poderes", "Star", false) {
		if len(v.Choices.Pending) > 0 {
			<div class="space-y-1 rounded-sm border border-grimorio-gold/40 bg-accent p-2">
				<p class={ ui.FieldLabelClasses("gold", "") }>
					{ writtenPendings(len(v.Choices.Pending)) }
				</p>
				for _, p := range v.Choices.Pending {
					@ui.Button(ui.VariantLink, ui.SizeInline, "block w-full text-left text-xs", templ.Attributes{"type": "button", "data-on:click": "$power_source = '" + p.Source + "'"}) {
						{ p.Label }
					}
				}
			</div>
		}
		<div class="flex gap-1">
			for _, source := range sourceThree {
				<button
					type="button"
					data-on:click={ "$power_source = '" + source + "'" }
					data-attr:aria-pressed={ "$power_source === '" + source + "' ? 'true' : 'false'" }
					class="flex-1 rounded-sm border border-grimorio-iron px-2 py-1 text-xs uppercase tracking-wider text-muted-foreground outline-none transition-colors aria-pressed:border-grimorio-gold/60 aria-pressed:bg-accent aria-pressed:text-grimorio-gold"
				>{ writtenSource(source) }</button>
			}
		</div>
		<div data-show="$power_source === 'raca'" class="space-y-3">
			@raceChoicesBlock(v)
		</div>
		<div data-show="$power_source === 'origem'" class="space-y-3">
			@originChoicesBlock(v)
		</div>
		<div data-show="$power_source === 'classe'" class="space-y-3">
			@classChoicesBlock(v)
		</div>
	}
}

// raceChoicesBlock é o bônus de atributo e as variantes de habilidade.
templ raceChoicesBlock(v View) {
	if len(v.Choices.Races) == 0 {
		<p class="py-2 text-xs italic text-muted-foreground">A raça desta ficha não pede escolha.</p>
	} else {
		for _, card := range v.Choices.Races {
			<section class="space-y-2 rounded-sm border border-grimorio-iron p-2">
				<h4 class={ ui.SectionLabelClasses("gold", "") }>{ card.Race }</h4>
				if card.Attribute != nil {
					@attributeChoiceBlock(v, *card.Attribute)
				}
				for _, variante := range card.Variants {
					<div class="space-y-1">
						<p class={ ui.FieldLabelClasses("muted", "") }>{ variante.Name }</p>
						<div class="flex flex-wrap gap-1">
							for _, o := range variante.Options {
								<button
									type="button"
									role="switch"
									aria-checked={ ui.AriaBool(o.Active) }
									aria-label={ o.Label }
									data-on:click={ sheetPost(v, "/poderes/variante/"+o.Value) }
									class={ choiceChip(o.Active) }
								>{ o.Label }</button>
							}
						</div>
					</div>
				}
			</section>
		}
	}
}

// attributeChoiceBlock distribui o bônus da raça.
//
// Os atributos entram num sinal de LISTA e vão juntos num comando só: a regra do
// motor é sobre o CONJUNTO — três distintos, nenhum no proibido —, então mandar
// um de cada vez faria o servidor recusar os dois primeiros cliques de uma
// escolha que vai ficar válida no terceiro.
templ attributeChoiceBlock(v View, choice attributeChoice) {
	<div class="space-y-1">
		<p class={ ui.FieldLabelClasses("muted", "") }>{ attributeWrittenChoice(choice) }</p>
		if choice.Kind == "ascendencia" {
			<div class="flex flex-wrap gap-1">
				for _, o := range choice.Options {
					<button
						type="button"
						role="switch"
						aria-checked={ ui.AriaBool(contemTraco(choice.Chosen, o.Value)) }
						aria-label={ o.Label }
						data-on:click={ sheetPost(v, "/poderes/ascendencia/"+o.Value) }
						class={ choiceChip(contemTraco(choice.Chosen, o.Value)) }
					>{ o.Label }</button>
				}
			</div>
		} else {
			<div class="flex flex-wrap gap-1">
				for _, o := range choice.Options {
					<button
						type="button"
						role="switch"
						aria-checked={ ui.AriaBool(contemTraco(choice.Chosen, o.Value)) }
						aria-label={ o.Label }
						data-on:click={ thatTogglesAttributeGesture(o.Value) }
						data-attr:data-escolhido={ "$race_attributes.includes('" + o.Value + "')" }
						class={ ui.BadgeClasses("inline-flex items-center border-grimorio-iron text-3xs uppercase tracking-wider text-muted-foreground data-[escolhido]:border-grimorio-gold/60 data-[escolhido]:bg-accent data-[escolhido]:text-grimorio-gold") }
					>{ o.Label }</button>
				}
			</div>
			<button
				type="button"
				aria-label="Gravar a distribuição de atributos"
				data-on:click={ sheetPost(v, "/poderes/atributos") }
				class={ ui.ButtonClasses(ui.VariantPrimary, ui.SizeSmall, "w-full") }
			>Gravar distribuição</button>
		}
	</div>
}

// originChoicesBlock são os benefícios da origem, com o teto de dois.
templ originChoicesBlock(v View) {
	if v.Choices.Origin == nil {
		<p class="py-2 text-xs italic text-muted-foreground">Esta origem não está no livro.</p>
	} else {
		<section class="space-y-2 rounded-sm border border-grimorio-iron p-2">
			<div class="flex items-baseline justify-between">
				<h4 class={ ui.SectionLabelClasses("gold", "") }>{ v.Choices.Origin.Name }</h4>
				<span class="font-mono text-2xs text-muted-foreground">
					{ strconv.Itoa(len(v.Choices.Origin.Chosen)) + " de " + strconv.Itoa(sheet.BenefitsOriginLimit) }
				</span>
			</div>
			for _, o := range v.Choices.Origin.Options {
				<button
					type="button"
					role="switch"
					aria-checked={ ui.AriaBool(o.Active) }
					aria-label={ o.Label }
					data-on:click={ sheetPost(v, "/poderes/origem/"+o.Value) }
					class={ choiceChip(o.Active) + " block w-full text-left" }
				>{ o.Label }</button>
			}
		</section>
	}
}

// classChoicesBlock são as vagas de poder, o caminho e o devoto de cada classe.
templ classChoicesBlock(v View) {
	for _, card := range v.Choices.Classes {
		<section class="space-y-2 rounded-sm border border-grimorio-iron p-2">
			<div class="flex items-baseline justify-between">
				<h4 class={ ui.SectionLabelClasses("gold", "") }>
					{ card.ClassName + " " + strconv.FormatInt(card.Level, 10) }
				</h4>
				<span class="font-mono text-2xs text-muted-foreground">{ classWrittenSlots(card) }</span>
			</div>
			if card.Path != nil {
				@classPicker(v, card.ClassName, "caminho", "Caminho", *card.Path)
			}
			if card.Devotee != nil {
				@classPicker(v, card.ClassName, "devoto", "Devoto", *card.Devotee)
			}
			<input
				type="search"
				data-bind:power_search
				data-on:input__debounce.250ms={ sheetGet(v) }
				value={ v.Powers.Search }
				placeholder="Buscar poder…"
				aria-label={ "Buscar poder de " + card.ClassName }
				class="h-8 w-full rounded-sm border border-grimorio-iron bg-background px-2 text-xs text-foreground outline-none placeholder:text-muted-foreground"
			/>
			<div class="max-h-[40vh] space-y-1 overflow-y-auto">
				for _, power := range card.Powers {
					<button
						type="button"
						role="switch"
						aria-checked={ ui.AriaBool(power.Chosen) }
						aria-label={ power.Name }
						data-on:click={ sheetPost(v, "/poderes/escolhe/"+power.ID) }
						class={ "flex w-full items-baseline gap-2 rounded-sm border px-2 py-1 text-left text-xs outline-none transition-colors",
							templ.KV("border-grimorio-gold/60 bg-accent", power.Chosen),
							templ.KV("border-grimorio-iron", !power.Chosen) }
					>
						<span class="font-semibold text-foreground">{ power.Name }</span>
						<span class="min-w-0 flex-1 truncate text-muted-foreground">{ power.Detail }</span>
						<span class="shrink-0 text-3xs text-muted-foreground">{ power.Source }</span>
					</button>
				}
			</div>
		</section>
	}
}

// classPicker é uma escolha de valor único — caminho ou devoto.
templ classPicker(v View, class, choice, label string, selector pickerChoice) {
	<div class="space-y-1">
		<p class={ ui.FieldLabelClasses("muted", "") }>{ label }</p>
		<div class="flex flex-wrap gap-1">
			for _, o := range selector.Options {
				<button
					type="button"
					role="switch"
					aria-checked={ ui.AriaBool(o.Active) }
					aria-label={ o.Label }
					data-on:click={ choiceClassCommand(v, class, choice, o.Value) }
					class={ choiceChip(o.Active) }
				>{ o.Label }</button>
			}
		</div>
	</div>
}

package table

import "t20engine/serve/web/ui"

// A FAIXA E O CARTÃO (ver GLOSSARY, **rolagem informada** e **cartão flutuante**): a faixa é o que todos leem, o
// cartão é a ação em que alguém escolhe. Cada um é UM componente, dono da própria estrutura — o contorno e a
// cabeça da faixa; o `data-float`, a alça de arrastar, a alça visível e a seta do cartão —, e quem os usa entrega
// só a cabeça e o corpo dele. Escritos à mão em cada tela, um cartão novo nascia sem a seta, e ninguém via.

// strikeBand é a faixa: a região `id`, com o nome acessível `label`, a cabeça `head` e o corpo nos filhos. Os
// `attrs` são o que é só dela (o `data-test`).
templ strikeBand(id, label string, attrs templ.Attributes, head templ.Component) {
	<section id={ id } class="ds-strike" { attrs... } role="status" aria-label={ label }>
		<div class="ds-strike-head">
			@head
		</div>
		{ children... }
	</section>
}

// floatCard é o cartão flutuante: a região `id`, com o nome acessível `label`, a cabeça `head` entre a alça e a
// seta (que diz recolher ou abrir `what`), e o corpo nos filhos. Os `attrs` são o que é só dele (`data-attack`,
// `data-banner`, `data-float-fleeting`).
templ floatCard(id, label, what string, attrs templ.Attributes, head templ.Component) {
	<section id={ id } class="ds-strike" { attrs... } data-float aria-label={ label }>
		<div class="ds-strike-head" data-float-handle>
			@floatGrip()
			@head
			@floatFold(what)
		</div>
		{ children... }
	</section>
}

// floatGrip é a alça: até aqui o arrastar só se anunciava no cursor. Ela e a seta são do desktop, onde o cartão
// flutua; no celular o CSS as tira. Quem as liga é o `lib/float-card.ts`.
templ floatGrip() {
	<span class="ds-float-grip" data-float-grip aria-hidden="true">
		@ui.Icon("GripVertical", "ds-icon")
	</span>
}

// floatFold é a seta de recolher. O `aria-expanded` vem do aparelho: o `float-card.ts` o acerta a cada remendo.
templ floatFold(what string) {
	<button type="button" class="ds-button ds-float-fold" data-variant="ghost" data-icon data-float-fold aria-expanded="true" aria-label={ "Recolher ou abrir " + what } title={ "Recolher ou abrir " + what }>
		@ui.Icon("ChevronDown", "ds-icon")
	</button>
}

package table

import (
	"fmt"
	"t20engine/serve/web/ui"
	"t20engine/domain/markdown"
)

// AS NOTAS DA SESSÃO: o que aconteceu, XP, tesouro — em markdown, com o texto de
// um lado e o resultado do outro. Elas NÃO têm botão de salvar: o mestre escreve
// no meio do combate e não vai lembrar de confirmar; salvam sozinhas depois da
// pausa.
//
// ELAS ABREM COLUNA E EMPURRAM O MAPA, em vez de cobri-lo — é a única exceção
// aos overlays da cena: escreve-se enquanto se narra OLHANDO o tabuleiro, e um
// painel por cima do mapa não serve a esse gesto. Abaixo de 1024 não há espaço
// para duas, e elas viram gaveta como as outras consultas.
//
// ── A ARMADILHA QUE GOVERNA ESTE ARQUIVO ────────────────────────────────────
//
// A CAIXA DE TEXTO NÃO É REGIÃO, e não pode ser. A cena é remendada a cada
// mudança de qualquer um na mesa — um jogador registrando iniciativa, um turno
// virando —, e um `<textarea>` remendado no meio de uma frase apaga o que o
// mestre está escrevendo. Entrada em curso é do teclado de quem digita, nunca
// estado da aplicação.
//
// Por isso o desenho aqui é assimétrico de propósito:
//
//   - a CAIXA é semeada UMA vez, na carga da página, e o servidor nunca mais a
//     toca por HTML. Quem a atualiza — quando atualiza — é o SINAL `notas`, que
//     o `data-bind` reflete sem trocar o nó nem mexer no cursor;
//   - a PRÉVIA é região (`mesa-notas-previa`) e é remendada pela resposta do
//     próprio salvamento.
//
// E as notas NÃO entram no `TableRegions`: elas são de um leitor só — o mestre —
// e nada fora desta aba as muda.

// O CORPO: a caixa e a prévia, lado a lado quando há largura.
//
// O "lado a lado" EMPILHA numa coluna estreita em vez de virar "Escrever": quem
// decide onde cabem duas colunas é a consulta de contêiner na folha, porque o Go
// não mede caixa. Empilhar mantém a promessa do modo — ver o que se escreve e o
// que sai, ao mesmo tempo — sem a faixa anunciar um modo diferente do que está
// acontecendo.
templ notesBody(v View) {
	<div
		data-class="{'notes-split': $notes_mode === 'duplo'}"
		class="notes-layout grid min-h-0 flex-1 gap-2"
	>
		<textarea
			data-bind:notes
			data-show="$notes_mode != 'ler'"
			data-on:input__debounce.1200ms={ saveNotes(v) }
			data-indicator:notes_saving
			aria-label="Notas da sessão"
			placeholder={ "# Cena 1\n- O ogro **fugiu** pela ponte\n> \"voltarei\", ele disse" }
			class="field-sizing-fixed h-full min-h-0 w-full resize-none rounded-sm border border-input bg-background p-2 font-mono text-xs outline-none"
		>{ v.Notes }</textarea>
		<div data-show="$notes_mode != 'escrever'" class="min-h-0 overflow-y-auto rounded-sm border border-grimorio-iron p-3">
			@tableNotesPreview(v)
		</div>
	</div>
}

// A PRÉVIA é a região remendada — ver o comentário no topo do arquivo.
//
// A raiz existe SEMPRE, inclusive com a nota vazia: região que some leva o id
// junto, e o remendo seguinte não acha onde pousar.
templ tableNotesPreview(v View) {
	<div id="table-notes-preview" class="space-y-2 text-sm">
		if len(v.NoteBlocks) == 0 {
			<p class="text-sm text-muted-foreground">Nenhuma nota ainda.</p>
		} else {
			for _, b := range v.NoteBlocks {
				@noteBlock(v, b)
			}
		}
	</div>
}

// noteBlock desenha UM bloco da árvore.
//
// Elementos e não HTML: o parser devolve dados, e é o templ que monta os nós —
// então não existe `innerHTML` no caminho e o texto do mestre é escapado de
// graça. É por isso que este port dispensa sanitizador.
templ noteBlock(v View, b markdown.Block) {
	switch b.Kind {
		case "heading":
			@noteTitle(b)
		case "paragraph":
			<p class="whitespace-pre-wrap">
				for i, row := range b.Rows {
					if i > 0 {
						<br/>
					}
					@noteSpans(row)
				}
			</p>
		case "list":
			@noteList(v, b)
		case "quote":
			<blockquote class="border-l-2 border-grimorio-gold/50 pl-3 text-muted-foreground">
				@noteSpans(b.Spans)
			</blockquote>
		case "rule":
			<hr class="border-grimorio-iron"/>
	}
}

// O título da nota começa em `h2`: o `h1` é da página, e uma nota não abre o
// documento. Três níveis, que é o que a gramática conhece.
templ noteTitle(b markdown.Block) {
	switch b.Level {
		case 1:
			<h2 class="font-heading text-base tracking-wide text-grimorio-gold">
				@noteSpans(b.Spans)
			</h2>
		case 2:
			<h3 class="font-heading text-sm tracking-wide text-grimorio-gold">
				@noteSpans(b.Spans)
			</h3>
		default:
			<h4 class="text-sm font-semibold text-foreground">
				@noteSpans(b.Spans)
			</h4>
	}
}

// A lista, com o quadrinho de tarefa CLICÁVEL.
//
// O clique carrega a LINHA de origem no caminho, e é isso que faz o quadrinho
// reescrever a nota em vez de guardar estado ao lado dela. Um checkbox que não
// reescrevesse o texto seria enfeite, e o estado não sobreviveria a um F5.
templ noteList(v View, b markdown.Block) {
	if b.Sorted {
		<ol class="list-decimal space-y-0.5 pl-5">
			for _, it := range b.Items {
				<li>
					@noteItem(v, it)
				</li>
			}
		</ol>
	} else {
		<ul class="space-y-0.5 pl-1">
			for _, it := range b.Items {
				<li class="flex items-start gap-1.5">
					if it.Task == nil {
						<span aria-hidden="true" class="select-none text-muted-foreground">•</span>
					}
					@noteItem(v, it)
				</li>
			}
		</ul>
	}
}

templ noteItem(v View, it markdown.Item) {
	if it.Task != nil {
		<button
			type="button"
			role="checkbox"
			aria-checked={ marked(it.Task.Marked) }
			data-on:click={ toggleTaskNote(v, *it.Task) }
			class="flex min-h-6 items-start gap-1.5 text-left outline-none"
		>
			if it.Task.Marked {
				@ui.Icon("SquareCheck", "size-4 shrink-0 text-grimorio-gold")
			} else {
				@ui.Icon("Square", "size-4 shrink-0 text-muted-foreground")
			}
			<span class={ templ.KV("text-muted-foreground line-through", it.Task.Marked) }>
				@noteSpans(it.Spans)
			</span>
		</button>
	} else {
		<span>
			@noteSpans(it.Spans)
		</span>
	}
}

// Os trechos de uma linha. O `default` é texto puro, que é a falha certa desta
// gramática: o que ela não conhece aparece como foi escrito, nunca some.
templ noteSpans(spans []markdown.Span) {
	for _, s := range spans {
		switch s.Kind {
			case "strong":
				<strong class="font-semibold text-foreground">{ s.Text }</strong>
			case "em":
				<em>{ s.Text }</em>
			case "code":
				<code class="rounded-sm bg-muted px-1 font-mono text-xs">{ s.Text }</code>
			case "link":
				<a
					href={ templ.SafeURL(s.Href) }
					target="_blank"
					rel="noopener noreferrer"
					class="text-grimorio-gold underline underline-offset-2"
				>{ s.Text }</a>
			default:
				{ s.Text }
		}
	}
}

// A FAIXA DE MODOS: escrever, ler, ou os dois.
//
// A escolha GRUDA no `localStorage` (`t20:notas-view`) — é preferência de
// trabalho, não estado da sessão.
//
// `fieldset` e não `div role="group"`: o elemento nativo já É o grupo. Ele
// precisa de `min-w-0` porque o padrão do navegador é `min-content` e ele se
// recusa a encolher dentro de um flex.
templ modesRange() {
	<fieldset class="flex min-w-0 shrink-0 gap-1" aria-label="Modo de visualização das notas">
		@notesMode("escrever", "Escrever")
		@notesMode("ler", "Ler")
		@notesMode("duplo", "Lado a lado")
		// EMPILHADO é um jeito de mostrar OS DOIS, e por isso ele fica na mesma
		// fileira em vez de virar um segundo eixo: "onde as duas metades ficam"
		// só significa alguma coisa quando as duas estão à mostra, então a
		// gramática é UM eixo com quatro valores, e não dois eixos com seis
		// botões.
		//
		// O que ele muda é o arranjo deixar de ser resposta AUTOMÁTICA à largura
		// e passar a ser escolha — a 1024 a coluna já empilha sozinha.
		@notesMode("empilhado", "Empilhado")
	</fieldset>
}

templ notesMode(value, label string) {
	<button
		type="button"
		data-attr:aria-pressed={ fmt.Sprintf("$notes_mode === '%s' ? 'true' : 'false'", value) }
		data-on:click={ pickNotesMode(value) }
		class="inline-flex h-7 items-center rounded-sm border border-grimorio-iron px-2 text-2xs outline-none transition-colors hover:bg-accent aria-pressed:bg-primary aria-pressed:text-primary-foreground aria-pressed:hover:bg-primary"
	>{ label }</button>
}

// SEM BOTÃO DE SALVAR, o estado do texto tem de estar VISÍVEL o tempo todo.
//
// Três estados e não dois: enquanto a pausa não chega o texto está "Não salvo",
// e dizer "Salvando…" ali seria mentira. Quem separa os dois é o
// `data-indicator`, que só é verdadeiro com o pedido no ar.
//
// `$notes_saved` é escrito pelo SERVIDOR quando a gravação dá certo — é a
// resposta que afirma "isto está no banco", e não o cliente supondo.
//
// O ERRO é TEXTO e não só cor: faixa vermelha sem frase deixa o mestre vendo que
// algo deu errado sem ter onde ler o quê — e a janela bloqueada pelo navegador
// chega por este mesmo canal.
templ autosaveState() {
	<span
		aria-live="polite"
		data-text="$notes_error != '' ? $notes_error : ($notes_saving ? 'Salvando…' : ($notes === $notes_saved ? 'Salvo' : 'Não salvo'))"
		data-class="{'text-destructive-ink': $notes_error != '', 'text-muted-foreground': $notes_error == ''}"
		class="text-xs"
	></span>
}


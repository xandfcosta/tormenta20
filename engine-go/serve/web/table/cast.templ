package table

import (
	"fmt"
	"t20engine/serve/web/ui"
)

// O ELENCO DA CAMPANHA — os jogadores.
//
// **Iniciativa não é lista de combatentes**: o elenco responde "quem existe
// nesta campanha", e quem põe alguém no combate é o mestre, QUANDO ele quiser.
//
// A caixa mostra o que o mestre precisa DA MESA — quem é, como está, e o
// caminho para o combate — e não a ficha inteira, que é outra tela.
//
// UM DIÁLOGO POR MEMBRO, e não um só reaproveitado — o inverso da escolha das
// condições, de propósito. Lá são 35 crachás × 9 linhas e um diálogo por linha
// seriam 315 nós redesenhados; aqui são quatro ou cinco jogadores. O que se
// compra é a armadilha do nó COMPARTILHADO que recebe escrita depois da
// renderização: ele mostra o dado do item ANTERIOR sob o nome do próximo. Com
// um diálogo por pessoa não há o que limpar, porque não há o que sobreviver à
// troca.

// gmCast é o segundo bloco do trilho esquerdo — a vaga do `gmCast`.
//
// Ele ROLA, e a fila acima dele não: a assimetria é deliberada. A posição na
// fila CARREGA significado (acima já agiu, abaixo ainda vai) e rolar
// embaralharia isso; o elenco é lista sem ordem própria.
templ gmCast(v View) {
	if len(v.Grupo) > 0 {
		<nav
			aria-label="Elenco"
			class="flex min-h-0 flex-1 flex-col gap-1 overflow-y-auto border border-grimorio-iron bg-grimorio-panel p-1"
		>
			for _, m := range v.Grupo {
				@castPortrait(v, m)
			}
		</nav>
		for _, m := range v.Grupo {
			@castSheet(v, m)
		}
	}
}

// O retrato em 80px: monogram, presença, e o clique que abre a pessoa.
//
// O NOME INTEIRO viaja no `aria-label` e no `title`, com a presença junto,
// porque duas letras não são um nome e cor não existe para quem usa leitor de
// tela.
templ castPortrait(v View, m Member) {
	<button
		type="button"
		title={ castLabel(m) }
		aria-label={ castLabel(m) }
		data-on:click={ openSheetCast(m) }
		class="relative flex flex-col items-center rounded-sm border border-grimorio-iron px-1 py-1.5 outline-none transition-colors hover:bg-accent"
	>
		<span class="text-sm font-semibold text-foreground">{ m.Iniciais }</span>
		if m.Presenca != nil {
			<span
				aria-hidden="true"
				class={ "absolute right-0.5 top-0.5 size-2 rounded-full",
					templ.KV("bg-hp-full", m.Presenca.NaMesa),
					templ.KV("bg-grimorio-iron", !m.Presenca.NaMesa) }
			></span>
		}
	</button>
}

// A ficha do elenco: quem é, como está, e o caminho para o combate.
templ castSheet(v View, m Member) {
	<dialog
		id={ fmt.Sprintf("elenco-%d", m.CharacterID) }
		data-preserve-attr="open"
		aria-labelledby={ fmt.Sprintf("elenco-%d-titulo", m.CharacterID) }
		class="scene-grimorio m-auto w-[min(26rem,calc(100vw-2rem))] rounded-sm border border-grimorio-iron bg-grimorio-panel p-4 text-foreground backdrop:bg-black/60"
	>
		<div class="flex items-start justify-between gap-3">
			<div class="min-w-0">
				<h2 id={ fmt.Sprintf("elenco-%d-titulo", m.CharacterID) } class="truncate font-heading text-lg tracking-wide text-grimorio-gold">{ m.Nome }</h2>
				<p class="text-xs text-muted-foreground">
					Nível { fmt.Sprint(m.Nivel) }
					if m.Classes != "" {
						· { m.Classes }
					}
				</p>
			</div>
			<button
				type="button"
				aria-label="Fechar"
				data-on:click={ closeSheetCast(m) }
				class="flex size-8 shrink-0 items-center justify-center rounded-sm border border-grimorio-iron outline-none transition-colors hover:bg-accent"
			>
				@ui.Icon("X", "size-4")
			</button>
		</div>
		if m.Presenca != nil {
			<p class="mt-2 flex items-center gap-1.5 text-xs text-muted-foreground">
				<span
					aria-hidden="true"
					class={ "size-2 rounded-full",
						templ.KV("bg-hp-full", m.Presenca.NaMesa),
						templ.KV("bg-grimorio-iron", !m.Presenca.NaMesa) }
				></span>
				{ m.Presenca.Frase }
			</p>
		}
		<dl class="mt-3 space-y-2">
			@castBar(v, m, "hp", "PV", m.PV)
			@castBar(v, m, "mp", "PM", m.PM)
		</dl>
		<p class="mt-3 flex items-baseline justify-between gap-2 border-t border-grimorio-iron pt-3 text-sm">
			<span class="text-muted-foreground">Defesa</span>
			<span class="font-mono tabular-nums text-foreground">{ m.Defesa }</span>
		</p>
		<div class="mt-4 flex justify-end">
			if m.NaFila {
				<p class="text-xs text-muted-foreground">Já está na fila do combate.</p>
			} else {
				<button
					type="button"
					data-on:click={ closeSheetCast(m) + " " + poeNaFila(v, m) }
					class="inline-flex min-h-11 items-center gap-1.5 rounded-sm bg-primary px-3 text-sm font-semibold text-primary-foreground outline-none transition-opacity hover:opacity-90"
				>
					@ui.Icon("Swords", "size-4")
					Pôr na iniciativa
				</button>
			}
		</div>
	</dialog>
}

// castBar é uma barra do elenco com os passos que mexem NELA.
//
// Ela é irmã do `trackerBar` da fila e não a mesma função, e a diferença é o que
// as separa: a da fila leva o OLHO, porque esconder é decisão sobre o que a mesa
// vê de uma LINHA da iniciativa; o elenco é painel do mestre e não tem
// espectador para esconder de.
//
// O gesto entra por outra porta pelo mesmo motivo: as rotas da fila são por
// `entryId`, e metade do elenco não tem linha na iniciativa na maior parte da
// sessão. Quem manda nos dois é a FICHA, que é o que impede as duas telas de
// divergirem sobre o mesmo herói.
templ castBar(v View, m Member, pool, rotulo string, b tableBar) {
	<div class="flex items-center gap-1">
		@barra(rotulo, b)
		@castStep(v, m, pool, "curar", "+", healVerb(pool))
		@castStep(v, m, pool, "ferir", "−", harmVerb(pool))
	</div>
}

// castStep: clique tira ou devolve 1, Shift+clique 5 — a MESMA escada da fila.
//
// Dois números diferentes fariam o mestre chamar de "um golpe" coisas
// diferentes em duas telas da mesma sessão.
templ castStep(v View, m Member, pool, verb, sign, label string) {
	<button
		type="button"
		aria-label={ label + " " + m.Nome }
		title={ label + " " + m.Nome + " — clique 1, Shift+clique 5" }
		data-on:click={ castVital(v, m, pool, verb) }
		class="flex size-9 shrink-0 items-center justify-center rounded-sm border border-grimorio-iron font-mono text-sm outline-none transition-colors hover:bg-accent"
	>{ sign }</button>
}

package table

import "t20engine/serve/web/ui"

// O gesto de PÔR NO MAPA. A regra e as expressões estão em `tokens.go`; aqui é
// só o desenho.

// botaoDePorNoMapa: UM botão, DOIS gestos, e o padrão é o seguro.
//
// Esquerdo abre o diálogo com as fichas já escolhidas; direito põe as fichas
// direto. Pôr as fichas no mapa é o gesto de abrir cena e não revela nada — eles
// sabem onde estão. Todo o resto é informação que o mestre controla, e
// informação que o mestre controla nunca sai por atalho.
//
// O `title` conta o gesto direito porque um gesto que ninguém descobre é o mesmo
// que não existir — e ele nunca é o único caminho: o diálogo faz o mesmo.
templ botaoDePorNoMapa(v BoardView) {
	if v.GM {
		<button
			type="button"
			aria-label="Pôr no mapa"
			title="Escolher quem vem para o mapa. Clique direito põe só as fichas."
			data-on:click={ openMap() }
			data-on:contextmenu={ sheetsShortcut(v) }
			class="inline-flex min-h-11 shrink-0 items-center gap-1.5 rounded-sm border border-grimorio-iron px-2 text-sm outline-none transition-colors hover:bg-accent sm:px-3"
		>
			// O ÍCONE aparece e o texto sai no telefone: um gesto que só existe no
			// desktop é um gesto que a mesa jogada no sofá não tem.
			//
			// `UserPlus` e não `Users2`: o que ele faz é TRAZER alguém para o mapa,
			// e o `Users2` já é o grupo no trilho do mestre — dois desenhos iguais
			// para coisas diferentes é como se aprende a errar o clique.
			@ui.Icon("UserPlus", "size-4")
			<span class="hidden sm:inline">Pôr no mapa</span>
		</button>
	}
}


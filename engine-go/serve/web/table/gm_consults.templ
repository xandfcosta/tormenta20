package table

import (
	"fmt"
	"strconv"
	"t20engine/domain/book"
	"t20engine/serve/web/bookui"
	"t20engine/serve/web/ds"
	"t20engine/serve/web/master"
	"t20engine/serve/web/ui"
)

// AS CONSULTAS DO MESTRE (ALE-522, fatia 3): o que se abre com uma pergunta na
// cabeça — as notas, o grupo, o elenco e o bestiário —, em abas na coluna da
// direita. As rotas, os sinais e os remendos são os do palco de hoje; muda onde
// cada coisa mora e o que ela veste.
//
// As abas são SINAL (`$gm_consult`) e não endereço: trocar de aba no meio do
// combate não pode recarregar a mesa, e cada corpo guarda o que o mestre
// digitou nele.
templ gmConsults(v View, b master.BestiaryView) {
	<div class="ds-gm-consult-head">
		<nav class="ds-tabs ds-gm-consult-tabs" aria-label="Consultas do mestre">
			for i, tab := range gmConsultTabs {
				<button
					type="button"
					if i == 0 {
						aria-current="page"
					}
					data-attr:aria-current={ consultCurrent(tab.ID) }
					data-on:click={ fmt.Sprintf("$gm_consult = %q", tab.ID) }
				>{ tab.Label }</button>
			}
		</nav>
		@ds.IconButton(ds.ButtonGhost, "PanelRightClose", "Recolher as consultas", templ.Attributes{"type": "button", "data-gm-collapse": true, "data-on:click": "$gm_consults_open = false"})
	</div>
	<div class="ds-session-scroll ds-gm-consult" data-show={ consultShown(gmConsultNotes) }>
		@gmNotes(v)
	</div>
	<div class="ds-session-scroll ds-gm-consult" data-show={ consultShown(gmConsultGroup) } style="display:none">
		@gmGroup(v)
	</div>
	<div class="ds-session-scroll ds-gm-consult" data-show={ consultShown(gmConsultCast) } style="display:none">
		@gmCastList(v)
	</div>
	<div class="ds-session-scroll ds-gm-consult" data-show={ consultShown(gmConsultBestiary) } style="display:none">
		@gmBestiary(b)
	</div>
	@gmNpcEditor(v)
}

// gmNotes é o caderno da sessão, e ele nasce LENDO (decisão do dono): o texto
// formatado ocupa a coluna, o toque nele abre a caixa, e o Esc ou sair dela
// volta à leitura. A caixa é a do palco de hoje — semeada uma vez e nunca
// remendada, porque um remendo no meio da frase apagaria o que o mestre
// escreve — e a prévia é a região `table-notes-preview`, remendada a cada
// gravação. Com as notas numa janela à parte, a aba só avisa: duas caixas
// sobre a mesma linha do banco gravariam uma por cima da outra.
templ gmNotes(v View) {
	<section class="ds-gm-notes" data-init={ seedNotes(v) } data-on:storage__window={ watchesTheNotesWindow(v) }>
		<div class="ds-gm-notes-head">
			<span class="ds-row-meta" data-show="!$gm_notes_editing">Toque no texto para escrever</span>
			<span class="ds-row-meta" data-show="$gm_notes_editing" style="display:none">Esc para voltar à leitura</span>
			@autosaveState()
			@ds.IconButton(ds.ButtonGhost, "ExternalLink", "Abrir as notas numa janela", templ.Attributes{"type": "button", "title": "Abrir as notas numa janela — para o segundo monitor", "data-on:click": opensTheNotesWindow(v)})
		</div>
		<p class="ds-help" data-show="$notes_window" style="display:none">As notas estão abertas numa janela à parte.</p>
		<div class="ds-gm-notes-body" data-show="!$notes_window">
			// A LEITURA é um alvo de toque inteiro, e o teclado chega nela: o
			// Enter abre a caixa como o clique. O clique numa tarefa ou num link
			// DENTRO dela é da tarefa e do link, e não abre a edição.
			<div
				class="ds-gm-notes-read"
				tabindex="0"
				role="button"
				aria-label="Editar as notas da sessão"
				data-show="!$gm_notes_editing"
				data-on:click={ "evt.target.closest('input, a, button') || (" + startsEditingNotes + ")" }
				data-on:keydown={ "evt.key === 'Enter' && (evt.preventDefault(), " + startsEditingNotes + ")" }
			>
				@tableNotesPreview(v)
			</div>
			<textarea
				id="gm-notes-text"
				class="ds-input ds-gm-notes-text"
				style="display:none"
				data-show="$gm_notes_editing"
				data-bind:notes
				data-on:input__debounce.1200ms={ saveNotes(v) }
				data-indicator:notes_saving
				data-on:blur="$gm_notes_editing = false"
				data-on:keydown="evt.key === 'Escape' && (evt.stopPropagation(), evt.preventDefault(), el.blur())"
				aria-label="Notas da sessão"
				placeholder={ "# Cena 1\n- O ogro **fugiu** pela ponte\n> \"voltarei\", ele disse" }
			>{ v.Notes }</textarea>
		</div>
	</section>
}

// gmGroup são os personagens da campanha: quem joga, se está na mesa, o PV e o
// PM, e a ficha completa numa aba à parte. O − e o + são os do elenco de hoje
// (`castVital`): o mestre cura quem não está na fila também.
templ gmGroup(v View) {
	if len(v.Group) == 0 {
		@ds.Empty("Nenhum personagem na campanha", "Os personagens aparecem aqui quando entram na campanha.")
	} else {
		@ds.FilterBar() {
			@ds.SearchField("gm-group-search", "Buscar no grupo", templ.Attributes{"data-bind:gm_group_search": true})
		}
		@ds.List("Grupo", groupAtTable(v.Group)) {
			for _, m := range v.Group {
				<div class="ds-row ds-gm-member" data-show={ nameMatches("gm_group_search", m.Name) }>
					<span class="ds-gm-monogram" aria-hidden="true">{ m.Initials }</span>
					<span class="ds-gm-member-body">
						<span class="ds-row-title">
							if m.Presence != nil {
								<span class="ds-gm-presence" data-at-table?={ m.Presence.AtTable } title={ m.Presence.Sentence }></span>
							}
							{ m.Name }
						</span>
						<span class="ds-row-meta">{ memberMeta(m) }</span>
					</span>
					<a href={ templ.SafeURL(fmt.Sprintf("/personagens/%d", m.CharacterID)) } target="_blank" rel="noopener" class="ds-button" data-variant="ghost" data-icon aria-label={ "Abrir a ficha completa de " + m.Name } title={ "Abrir a ficha completa de " + m.Name }>
						@ui.Icon("ExternalLink", "ds-icon")
					</a>
					// AS BARRAS descem para a largura toda da linha, com o − e o +
					// ao lado: na coluna de 19rem do desktop, nome, barras e três
					// botões numa fileira só deixavam o texto passar por baixo deles.
					<span class="ds-gm-member-vitals">
						<span class="ds-gm-member-body">
							@gmPoolLine("PV", "pv", poolOrNothing(m.PV))
							@gmPoolLine("PM", "pm", poolOrNothing(m.PM))
						</span>
						<span class="ds-gm-steps">
							@ds.IconButton(ds.ButtonSecondary, "Minus", "Tirar 1 PV de "+m.Name, templ.Attributes{"type": "button", "title": "Tirar PV de " + m.Name + " — clique 1, Shift+clique 5", "data-on:click": castVital(v, m, "hp", "ferir")})
							@ds.IconButton(ds.ButtonSecondary, "Plus", "Devolver 1 PV a "+m.Name, templ.Attributes{"type": "button", "title": "Devolver PV a " + m.Name + " — clique 1, Shift+clique 5", "data-on:click": castVital(v, m, "hp", "curar")})
						</span>
					</span>
				</div>
			}
		}
	}
}

// gmCastList é o elenco da campanha, e é a REGIÃO `table-npcs`: ela muda quando
// o mestre guarda ou apaga um NPC, no ritmo dele e não no da fila.
//
// "Do bestiário" troca de aba em vez de abrir um segundo caminho: guardar do
// livro é o gesto da criatura aberta (`gmCreature`), e um segundo lugar para
// ele divergiria do primeiro.
templ gmCastList(v View) {
	<div id="table-npcs" class="ds-gm-cast">
		<div class="ds-gm-cast-intro">
			<p class="ds-help">Quem existe nesta campanha fora do combate. Eles voltam semana que vem.</p>
			<span class="ds-gm-cast-new">
				@ds.Button(ds.ButtonSecondary, templ.Attributes{"type": "button", "aria-label": "Novo no elenco", "data-on:click": openEditor(v, 0)}) {
					@ui.Icon("UserPlus", "ds-icon")
					Novo
				}
				@ds.Button(ds.ButtonGhost, templ.Attributes{"type": "button", "data-on:click": fmt.Sprintf("$gm_consult = %q", gmConsultBestiary)}) {
					@ui.Icon("BookOpen", "ds-icon")
					Do bestiário
				}
			</span>
		</div>
		if len(v.NPCs) == 0 {
			@ds.Empty("Nenhum NPC guardado ainda", "Crie um com o Novo, ou abra uma criatura no Bestiário e guarde no elenco.")
		} else {
			@ds.FilterBar() {
				@ds.SearchField("gm-cast-search", "Buscar no elenco", templ.Attributes{"data-bind:gm_cast_search": true})
			}
			@ds.List("Elenco da campanha", strconv.Itoa(len(v.NPCs))) {
				for _, npc := range v.NPCs {
					<div class="ds-row ds-gm-npc" data-show={ nameMatches("gm_cast_search", npc.Name) }>
						<span class="ds-gm-member-body">
							<span class="ds-row-title">{ npc.Name }</span>
							if npc.Summary != "" {
								<span class="ds-row-meta">{ npcMeta(npc) }</span>
							} else {
								<span class="ds-row-meta ds-gm-unreadable">O bloco deste NPC está ilegível — dá para apagar.</span>
							}
						</span>
						<span class="ds-gm-steps">
							if npc.PV > 0 {
								@ds.Button(ds.ButtonSecondary, templ.Attributes{"type": "button", "data-on:click": npcCommand(v, npc, "na-fila")}) {
									Pôr na fila
								}
							}
							@ds.IconButton(ds.ButtonGhost, "Pencil", "Editar o bloco de "+npc.Name, templ.Attributes{"type": "button", "data-on:click": openEditor(v, npc.ID)})
							@ds.IconButton(ds.ButtonGhost, "Trash2", "Apagar "+npc.Name+" do elenco", templ.Attributes{"type": "button", "data-on:click": npcCommand(v, npc, "apagar")})
						</span>
					</div>
				}
			}
		}
	</div>
}

// gmNpcEditor é o editor de bloco de hoje (`blockEditor`) numa folha do kit.
// Quem a abre é o SERVIDOR, ligando `$draft_open` ao devolver o rascunho
// semeado — por isso ela é sobreposição com `data-show`, e não `<dialog>`:
// um `showModal()` precisaria de um gesto no cliente que o servidor não dá.
templ gmNpcEditor(v View) {
	<div class="ds-gm-overlay" data-show="$draft_open" style="display:none">
		<div class="ds-gm-float ds-gm-npc-editor" role="dialog" aria-modal="true" aria-label="Bloco do NPC">
			@blockEditor(v)
		</div>
	</div>
}

// gmBestiary é a aba Bestiário, e é a raiz que as rotas do painel remendam
// (`table-bestiary`). Os filtros e a lista são os da cena do mestre.
//
// O `data-signals` fica AQUI, na raiz remendada, e por isso ele reinicializa a
// cada remendo — de propósito: a busca, os tipos e a criatura são o que o
// servidor acabou de desenhar. Os campos do AJUSTE não estão nele: eles são
// rascunho do mestre, nascem na página, e só o servidor os semeia ao abrir
// OUTRA criatura (`entryDraft`).
templ gmBestiary(b master.BestiaryView) {
	<div id="table-bestiary" class="ds-gm-bestiary" data-signals={ master.BestiarySignals(b) }>
		@ds.FilterBar() {
			@gmBestiaryFilters(b)
		}
		@gmEntryList(b)
		if b.Chosen != nil {
			@gmCreature(b, *b.Chosen)
		}
	</div>
}

// gmCreature é a criatura aberta: o bloco do livro, o ajuste de PV, iniciativa
// e cópias, e os dois verbos — guardar no elenco e pôr na fila. Ela é a mesma
// sobreposição do `master.CreatureDialog` (aberta por `$sheet_open`, que o
// remendo redeclara), vestida no kit.
templ gmCreature(b master.BestiaryView, m book.Entry) {
	<div
		class="ds-gm-overlay"
		data-show="$sheet_open"
		style="display:none"
		data-on:click="evt.target === el && ($sheet_open = false)"
		data-on:keydown__window="evt.key === 'Escape' && ($sheet_open = false)"
	>
		<div class="ds-gm-float" role="dialog" aria-modal="true" data-attr:data-expanded="$sheet_open" aria-label={ m.Name }>
			// O TIPO, O PORTE E O ND ficam no cabeçalho, junto do nome: são
			// curtos, e no corpo eles sumiam na primeira rolagem.
			<div class="ds-dialog-head">
				<span class="ds-gm-creature-name">
					<span class="ds-dialog-title">{ m.Name }</span>
					<span class="ds-row-meta">
						{ fmt.Sprintf("%s · %s · ND %s · XP %d · ", book.TypeName(m.Kind), book.SizeName(m.Size), book.CRWritten(m.ND), book.XPForCR(m.ND)) }
						@bookui.PageSeal(b.Book, m.BookPage, m.Name)
					</span>
				</span>
				@ds.IconButton(ds.ButtonGhost, "X", "Fechar a ficha de "+m.Name, templ.Attributes{"type": "button", "data-on:click": "$sheet_open = false"})
			</div>
			<div class="ds-gm-creature-body">
				@gmCreatureBlock(m, b.Book)
			</div>
			<div class="ds-gm-creature-foot">
				<div class="ds-gm-edit-nums">
					@ds.TextField(ds.Field{ID: "gm-entry-hp", Label: "PV", Type: "number"}, templ.Attributes{"data-bind:entry_hp": true, "min": "1", "max": "999", "inputmode": "numeric"})
					@ds.TextField(ds.Field{ID: "gm-entry-ini", Label: "Iniciativa", Type: "number"}, templ.Attributes{"data-bind:entry_initiative": true, "min": "-5", "max": "40", "inputmode": "numeric"})
					@ds.TextField(ds.Field{ID: "gm-entry-copies", Label: "Cópias", Type: "number"}, templ.Attributes{"data-bind:entry_copies": true, "min": "1", "max": strconv.Itoa(maxCopiasDeUmVerbete), "inputmode": "numeric"})
				</div>
				@ds.TextField(ds.Field{ID: "gm-npc-name", Label: "Nome no elenco", Placeholder: "em branco, fica o do livro"}, templ.Attributes{"data-bind:npc_name": true})
				<div class="ds-gm-two">
					@ds.Button(ds.ButtonSecondary, templ.Attributes{"type": "button", "data-on:click": saveToCastPost(b)}) {
						Guardar no elenco
					}
					@ds.Button(ds.ButtonPrimary, templ.Attributes{"type": "button", "data-indicator:sending": true, "data-attr:disabled": "$sending", "data-on:click": fmt.Sprintf("@post('%s/enviar')", b.BestiaryBase())}) {
						<span data-text="'Pôr ' + $entry_copies + ' na fila'">Pôr na fila</span>
					}
				</div>
			</div>
		</div>
	</div>
}

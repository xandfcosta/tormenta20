package table

import (
	"fmt"
	"t20engine/serve/web/ds"
)

// O CICLO DA SESSÃO na tela. A DECISÃO mora no `domain/live`
// (`ChangeToStatus`), a orquestração no `app/session` e o caminho no
// `session.go`; aqui é o desenho.

// AS CONFIGURAÇÕES DA SESSÃO — uma linha, uma decisão.
//
// A FRASE de cada linha é o que deixa o botão ser curto ("Encerrar" em vez de
// "Encerrar sessão") sem virar adivinhação. E a hierarquia é deliberada —
// excluir, a ação mais rara e a única irreversível, NÃO é o elemento mais forte
// da tela; o vermelho fica onde a decisão acontece, que é a confirmação.
//
// Os verbos são travados pelo ESTADO: iniciar só aparece no que ainda não
// começou, encerrar só no que está no ar. O servidor recusa o resto, e oferecer
// o que será recusado é desenhar um erro.
//
// tableConfigSession é a REGIÃO do diálogo: ele muda com o CICLO da sessão, que
// não é o ritmo do mapa nem o da fila. Quem o abre é o ⋯ do mestre
// (`openConfigSession`).
templ tableConfigSession(v View) {
	<div id="table-session-config">
		if v.GM != nil {
			@sessionConfig(v)
		}
	</div>
}

templ sessionConfig(v View) {
	@ds.Dialog("session-config", fmt.Sprintf("Sessão %d · %s", v.SessionNum, portugueseCycle(v.Status)), nil) {
		<div class="ds-session-config">
			// O CAMPO NÃO RECEBE `value` DO SERVIDOR, e quem o semeia é a
			// ABERTURA: esta região é remendada a cada troca de ciclo, e um
			// `value` vindo de lá apagaria o que o mestre está escrevendo.
			<div class="ds-session-config-title">
				@ds.TextField(ds.Field{ID: "session-title", Label: "Título", Placeholder: "A cripta do rio", Help: "O apelido da noite. Pode ficar em branco — quem identifica a sessão é o número."}, templ.Attributes{"data-bind:session_title": true})
				@ds.Button(ds.ButtonSecondary, templ.Attributes{"type": "button", "data-on:click": sessionTitlePatch(v)}) {
					Salvar
				}
			</div>
			if v.Status != "active" {
				@adjustRow("Iniciar sessão", "A mesa passa a ver a partida ao vivo.") {
					@ds.Button(ds.ButtonPrimary, templ.Attributes{"type": "button", "data-on:click": sessionStatusPatch(v, "active")}) {
						if v.Status == "ended" {
							Reabrir
						} else {
							Iniciar
						}
					}
				}
			}
			if v.Status == "active" {
				@adjustRow("Encerrar sessão", "A partida sai do ar para a mesa. A campanha e as fichas ficam como estão.") {
					@ds.Button(ds.ButtonSecondary, templ.Attributes{"type": "button", "data-on:click": "document.getElementById('session-config').close(); " + sessionStatusPatch(v, "ended")}) {
						Encerrar
					}
				}
			}
			// REINICIAR fica ao lado de ENCERRAR de propósito, e é por isso que as
			// duas frases dizem o que ACONTECE: os dois verbos se parecem e fazem
			// coisas diferentes, e é aqui que a confusão custaria a noite de alguém.
			@adjustRow("Reiniciar o combate", "Esvazia a fila e os turnos. A partida CONTINUA no ar.") {
				@ds.Button(ds.ButtonSecondary, templ.Attributes{"type": "button", "data-on:click": restartCombatCommand(v)}) {
					Reiniciar
				}
			}
			@adjustRow("Excluir sessão", "Apaga a sessão e o histórico dela. Não dá para desfazer.") {
				@ds.Button(ds.ButtonSecondary, templ.Attributes{"type": "button", "commandfor": "delete-session", "command": "show-modal", "data-on:click": "document.getElementById('session-config').close()"}) {
					Excluir
				}
			}
		</div>
	}
	@confirmDeleteSession(v)
}

// A CONFIRMAÇÃO de excluir, onde o vermelho pertence.
//
// Ela é `DELETE` com `sse.Redirect`, e não um `form`: o elemento `form` do HTML
// só faz `GET` e `POST` (ALE-344). O preço é que o botão não funciona com o
// JavaScript desligado.
templ confirmDeleteSession(v View) {
	@ds.Dialog("delete-session", fmt.Sprintf("Excluir a sessão %d?", v.SessionNum), deleteSessionFoot(v)) {
		<p class="ds-help">A fila, o tabuleiro e o histórico desta noite vão junto. As fichas e a campanha ficam como estão. Não dá para desfazer.</p>
	}
}

templ deleteSessionFoot(v View) {
	<form method="dialog">
		@ds.Button(ds.ButtonSecondary, nil) {
			Cancelar
		}
	</form>
	@ds.Button(ds.ButtonDanger, templ.Attributes{"type": "button", "data-on:click": "document.getElementById('delete-session').close(); " + deleteSessionCommand(v)}) {
		Excluir a sessão
	}
}

// adjustRow: uma decisão por linha — o nome, o que ela faz numa frase, e o
// botão à direita. A frase não é enfeite: é ela que deixa o botão ser curto.
templ adjustRow(name, sentence string) {
	<div class="ds-session-config-row">
		<span class="ds-gm-member-body">
			<span class="ds-row-title">{ name }</span>
			<span class="ds-row-meta">{ sentence }</span>
		</span>
		{ children... }
	</div>
}

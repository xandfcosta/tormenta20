package table

import (
	"fmt"
	"strconv"
	"t20engine/domain/book"
	"t20engine/serve/web/ds"
	"t20engine/serve/web/master"
	"t20engine/serve/web/ui"
)

// AS PÁGINAS À PARTE DO MESTRE (ALE-608): o cabeçalho que as abre e o corpo
// de cada uma. As regiões são as que a coluna das Consultas desenhava; muda o
// documento em que elas moram. Ver `gm_side_pages.go`.

// gmSidePages são os elos do cabeçalho, escritos DUAS vezes: soltos a partir de
// 64rem, que é onde a mesa do mestre troca de leiaute, e num menu "Ferramentas"
// abaixo disso. O ícone de nova aba fica em cada elo, e não no gatilho do menu:
// é o elo que abre outra aba, e o gatilho só abre o menu.
templ gmSidePages(v View) {
	<span class="ds-gm-side">
		<span class="ds-gm-side-wide">
			for _, l := range sidePageLinks {
				@ds.LinkButton(ds.ButtonSecondary, templ.SafeURL(sidePageAddress(v, l.Path)), templ.Attributes{"target": sidePageTarget(v, l.Path), "title": "Abrir " + l.Label + " em outra aba"}) {
					{ l.Label }
					@ui.Icon("ExternalLink", "ds-icon")
				}
			}
		</span>
		<span class="ds-gm-side-narrow">
			<button type="button" class="ds-button" data-variant="secondary" popovertarget="gm-side-menu" aria-haspopup="menu">Ferramentas</button>
			<div id="gm-side-menu" popover class="ds-gm-menu-pop ds-gm-side-menu" role="menu">
				for _, l := range sidePageLinks {
					<a role="menuitem" class="ds-gm-menu-row ds-gm-side-row" href={ templ.SafeURL(sidePageAddress(v, l.Path)) } target={ sidePageTarget(v, l.Path) } data-on:click="document.getElementById('gm-side-menu').hidePopover()">
						<span>
							<b>{ l.Label }</b>
							<span class="ds-row-meta">{ l.Hint }</span>
						</span>
						@ui.Icon("ExternalLink", "ds-icon")
					</a>
				}
			</div>
		</span>
	</span>
}

// gmGroupPage é o Grupo numa aba. A BUSCA mora FORA da região: o fluxo remenda
// o `table-group` a cada mudança de PV, e um campo remendado no meio da
// digitação perderia o que o mestre escreve.
templ gmGroupPage(v View) {
	<main class="ds-gm-page" data-signals="{gm_group_search: ''}">
		<h1 class="ds-sheet-name">{ sidePageTitle(v, "Grupo") }</h1>
		<p class="ds-help">Ao lado da mesa, e se atualiza sozinho. A ficha de cada um abre em outra aba.</p>
		if len(v.Group) > 0 {
			@ds.FilterBar() {
				@ds.SearchField("gm-group-search", "Buscar no grupo", templ.Attributes{"data-bind:gm_group_search": true})
			}
		}
		@gmPageRefusal()
		@gmGroup(v)
	</main>
}

// gmPageRefusal é onde uma página à parte diz a recusa de um gesto dela. Na
// mesa ela mora na linha do turno, que a página não tem; sem ela, o − recusado
// no Grupo não faria nada e não diria nada.
templ gmPageRefusal() {
	<p class="ds-help ds-reg-error" aria-live="assertive" data-show="$command_error != ''" data-text="$command_error" style="display:none"></p>
}

// gmCastPage é o Elenco numa aba, com o editor do bloco que o lápis e o Novo
// abrem.
templ gmCastPage(v View) {
	<main class="ds-gm-page" data-signals="{gm_cast_search: ''}">
		<h1 class="ds-sheet-name">{ sidePageTitle(v, "Elenco") }</h1>
		@gmPageRefusal()
		@gmCastList(v)
		@gmNpcEditor(v)
	</main>
}

// gmBestiaryPage é o Bestiário numa aba, com o Pôr na fila da sessão: é por
// ele que esta página é da sessão, e não o `/mestre/bestiario`.
templ gmBestiaryPage(v View, b master.BestiaryView) {
	<main class="ds-gm-page" data-signals={ bestiaryPageDraft(b) }>
		<h1 class="ds-sheet-name">{ sidePageTitle(v, "Bestiário") }</h1>
		@gmBestiary(b)
	</main>
}

// gmGroup são os personagens da campanha: quem joga, se está na mesa, o PV e o
// PM, e a ficha completa numa aba à parte. O − e o + são os do elenco de hoje
// (`castVital`): o mestre cura quem não está na fila também. É a REGIÃO
// `table-group` da página do Grupo.
templ gmGroup(v View) {
	<div id="table-group">
	if len(v.Group) == 0 {
		@ds.Empty("Nenhum personagem na campanha", "Os personagens aparecem aqui quando entram na campanha.")
	} else {
		@ds.List("Grupo", groupAtTable(v.Group)) {
			for _, m := range v.Group {
				<div class="ds-row ds-gm-member" data-show={ nameMatches("gm_group_search", m.Name) }>
					<span class="ds-gm-monogram" aria-hidden="true">{ m.Initials }</span>
					<span class="ds-gm-member-body">
						<span class="ds-row-title">
							if m.Presence != nil {
								<span class="ds-gm-presence" data-at-table?={ m.Presence.AtTable } title={ m.Presence.Sentence }></span>
							}
							{ m.Name }
						</span>
						<span class="ds-row-meta">{ memberMeta(m) }</span>
					</span>
					<a href={ templ.SafeURL(fmt.Sprintf("/personagens/%d", m.CharacterID)) } target="_blank" rel="noopener" class="ds-button" data-variant="ghost" data-icon aria-label={ "Abrir a ficha completa de " + m.Name } title={ "Abrir a ficha completa de " + m.Name }>
						@ui.Icon("ExternalLink", "ds-icon")
					</a>
					// AS BARRAS descem para a largura toda da linha, com o − e o +
					// ao lado: nome, barras e três botões numa fileira só deixam o
					// texto passar por baixo deles numa tela estreita.
					<span class="ds-gm-member-vitals">
						<span class="ds-gm-member-body">
							@gmPoolLine("PV", "pv", poolOrNothing(m.PV))
							@gmPoolLine("PM", "pm", poolOrNothing(m.PM))
						</span>
						<span class="ds-gm-steps">
							@ds.IconButton(ds.ButtonSecondary, "Minus", "Tirar 1 PV de "+m.Name, templ.Attributes{"type": "button", "title": "Tirar PV de " + m.Name + " — clique 1, Shift+clique 5", "data-on:click": castVital(v, m, "hp", "ferir")})
							@ds.IconButton(ds.ButtonSecondary, "Plus", "Devolver 1 PV a "+m.Name, templ.Attributes{"type": "button", "title": "Devolver PV a " + m.Name + " — clique 1, Shift+clique 5", "data-on:click": castVital(v, m, "hp", "curar")})
						</span>
					</span>
				</div>
			}
		}
	}
	</div>
}

// gmCastList é o elenco da campanha, e é a REGIÃO `table-npcs`: ela muda quando
// o mestre guarda ou apaga um NPC, no ritmo dele e não no da fila.
//
// "Do bestiário" leva à página do Bestiário em vez de abrir um segundo
// caminho: guardar do livro é o gesto da criatura aberta (`gmCreature`), e um
// segundo lugar para ele divergiria do primeiro.
templ gmCastList(v View) {
	<div id="table-npcs" class="ds-gm-cast">
		<div class="ds-gm-cast-intro">
			<p class="ds-help">Quem existe nesta campanha fora do combate. Eles voltam semana que vem.</p>
			<span class="ds-gm-cast-new">
				@ds.Button(ds.ButtonSecondary, templ.Attributes{"type": "button", "aria-label": "Novo no elenco", "data-on:click": openEditor(v, 0)}) {
					@ui.Icon("UserPlus", "ds-icon")
					Novo
				}
				@ds.LinkButton(ds.ButtonGhost, templ.SafeURL(sidePageAddress(v, string(pageBestiary))), templ.Attributes{"target": sidePageTarget(v, string(pageBestiary))}) {
					@ui.Icon("BookOpen", "ds-icon")
					Do bestiário
				}
			</span>
		</div>
		if len(v.NPCs) == 0 {
			@ds.Empty("Nenhum NPC guardado ainda", "Crie um com o Novo, ou abra uma criatura no Bestiário e guarde no elenco.")
		} else {
			@ds.FilterBar() {
				@ds.SearchField("gm-cast-search", "Buscar no elenco", templ.Attributes{"data-bind:gm_cast_search": true})
			}
			@ds.List("Elenco da campanha", strconv.Itoa(len(v.NPCs))) {
				for _, npc := range v.NPCs {
					<div class="ds-row ds-gm-npc" data-show={ nameMatches("gm_cast_search", npc.Name) }>
						<span class="ds-gm-member-body">
							<span class="ds-row-title">{ npc.Name }</span>
							if npc.Summary != "" {
								<span class="ds-row-meta">{ npcMeta(npc) }</span>
							} else {
								<span class="ds-row-meta ds-gm-unreadable">O bloco deste NPC está ilegível — dá para apagar.</span>
							}
						</span>
						<span class="ds-gm-steps">
							if npc.PV > 0 {
								@ds.Button(ds.ButtonSecondary, templ.Attributes{"type": "button", "data-on:click": npcCommand(v, npc, "na-fila")}) {
									Pôr na fila
								}
							}
							@ds.IconButton(ds.ButtonGhost, "Pencil", "Editar o bloco de "+npc.Name, templ.Attributes{"type": "button", "data-on:click": openEditor(v, npc.ID)})
							@ds.IconButton(ds.ButtonGhost, "Trash2", "Apagar "+npc.Name+" do elenco", templ.Attributes{"type": "button", "data-on:click": npcCommand(v, npc, "apagar")})
						</span>
					</div>
				}
			}
		}
	</div>
}

// gmNpcEditor é o editor de bloco de hoje (`blockEditor`) numa folha do kit.
// Quem a abre é o SERVIDOR, ligando `$draft_open` ao devolver o rascunho
// semeado — por isso ela é sobreposição com `data-show`, e não `<dialog>`:
// um `showModal()` precisaria de um gesto no cliente que o servidor não dá.
templ gmNpcEditor(v View) {
	<div class="ds-gm-overlay" data-show="$draft_open" style="display:none">
		<div class="ds-gm-float ds-gm-npc-editor" role="dialog" aria-modal="true" aria-label="Bloco do NPC">
			@blockEditor(v)
		</div>
	</div>
}

// gmBestiary é o corpo da página do Bestiário, e é a raiz que as rotas do painel remendam
// (`table-bestiary`). Os filtros e a lista são os da cena do mestre.
//
// O `data-signals` fica AQUI, na raiz remendada, e por isso ele reinicializa a
// cada remendo — de propósito: a busca, os tipos e a criatura são o que o
// servidor acabou de desenhar. Os campos do AJUSTE não estão nele: eles são
// rascunho do mestre, nascem na página, e só o servidor os semeia ao abrir
// OUTRA criatura (`entryDraft`).
templ gmBestiary(b master.BestiaryView) {
	<div id="table-bestiary" class="ds-gm-bestiary" data-signals={ master.BestiarySignals(b) }>
		@ds.FilterBar() {
			@master.CreatureFilters(b, "gm-bestiary", nil, nil, nil)
		}
		@gmEntryList(b)
		if b.Chosen != nil {
			@gmCreature(b, *b.Chosen)
		}
	</div>
}

// gmCreature é a criatura aberta: a folha da Mesa do Mestre, com o pé da mesa —
// o ajuste de PV, iniciativa e cópias, e os dois verbos, guardar no elenco e
// pôr na fila.
templ gmCreature(b master.BestiaryView, m book.Entry) {
	@master.CreatureSheet(m, b.Book, gmCreatureFoot(b))
}

templ gmCreatureFoot(b master.BestiaryView) {
	<div class="ds-gm-creature-foot">
		<div class="ds-gm-edit-nums">
			@ds.TextField(ds.Field{ID: "gm-entry-hp", Label: "PV", Type: "number"}, templ.Attributes{"data-bind:entry_hp": true, "min": "1", "max": "999", "inputmode": "numeric"})
			@ds.TextField(ds.Field{ID: "gm-entry-ini", Label: "Iniciativa", Type: "number"}, templ.Attributes{"data-bind:entry_initiative": true, "min": "-5", "max": "40", "inputmode": "numeric"})
			@ds.TextField(ds.Field{ID: "gm-entry-copies", Label: "Cópias", Type: "number"}, templ.Attributes{"data-bind:entry_copies": true, "min": "1", "max": strconv.Itoa(maxCopiasDeUmVerbete), "inputmode": "numeric"})
		</div>
		@ds.TextField(ds.Field{ID: "gm-npc-name", Label: "Nome no elenco", Placeholder: "em branco, fica o do livro"}, templ.Attributes{"data-bind:npc_name": true})
		<div class="ds-gm-two">
			@ds.Button(ds.ButtonSecondary, templ.Attributes{"type": "button", "data-on:click": saveToCastPost(b)}) {
				Guardar no elenco
			}
			@ds.Button(ds.ButtonPrimary, templ.Attributes{"type": "button", "data-indicator:sending": true, "data-attr:disabled": "$sending", "data-on:click": fmt.Sprintf("@post('%s/enviar?%s=%s')", b.BestiaryBase(), pageParam, pageBestiary)}) {
				<span data-text="'Pôr ' + $entry_copies + ' na fila'">Pôr na fila</span>
			}
		</div>
		// A fila está noutra aba: sem esta frase, o clique não teria resposta.
		<p class="ds-help" aria-live="polite" data-text="$entry_sent"></p>
		@gmPageRefusal()
	</div>
}

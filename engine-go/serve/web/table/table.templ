package table

import (
	"fmt"
	"t20engine/serve/web/ui"
	"t20engine/domain/book"
	"t20engine/serve/web/sheetui"
)

// A Mesa do jogador desenhada. Nenhuma REGRA aqui: o que decide mora em
// `view.go`, onde se testa sem HTML.

templ tableScene(v View) {
	// A largura de leitura é de cada PÁGINA, não da casca: a Mesa é uma coluna e
	// o admin é uma grade de dois painéis. Sem isto, as linhas da fila esticam
	// 1500px e o número da iniciativa fica a meia tela do nome.
	//
	// `mesa-palco` é a classe da casa que dá ALTURA MEDIDA a uma cena
	// (`container-type: size`, index.css), e ela exige caixa com altura definida
	// — daí o `main` PREENCHER o palco (`flex-1`) com o miolo rolando por dentro,
	// em vez de crescer com o conteúdo e deixar a casca rolar por fora. Com isso
	// as duas faixas deixam de precisar de `sticky`.
	//
	// O `data-attr:style` traz as variáveis do ARRASTO, e elas moram AQUI porque
	// o `#table` é a única raiz que o remendo nunca toca — as variáveis descem
	// por herança até quem está sendo arrastado. Na peça ou no plano, o primeiro
	// remendo de outro jogador as apagaria no meio do gesto.
	<main
		id="table"
		data-attr:style="`--arrasto-x:${$drag_x}px; --arrasto-y:${$drag_y}px`"
		class="mesa-palco flex min-h-0 w-full flex-1 flex-col"
	>
		@tableHeader(v)
		@surfaceSelector(v)
		// MINHA FICHA fica FORA de `TableRegions` de propósito: o stream nunca a
		// toca, e quem a mantém em dia são os comandos dela, que remendam o
		// `#sheet-scene` por conta.
		if v.MySheet != nil {
			// O OUVIDO DA FICHA: o stream só avisa que o personagem mudou, e é o
			// CLIENTE que repede a ficha — na aba em que a pessoa está, que só
			// ele sabe.
			//
			// FORA do `#sheet-scene` de propósito: aquele nó é substituído a cada
			// remendo da ficha, e um ouvinte que se apaga e renasce no meio do
			// caminho pode perder o aviso que o fez nascer.
			//
			// O filtro é obrigatório: sem ele o ouvinte dispara em QUALQUER
			// remendo de sinal, e o stream também escreve `superficie` quando o
			// mestre puxa alguém para o mapa — a ficha seria repedida por causa
			// de um gesto que não tem nada a ver com ela.
			<div
				data-on-signal-patch-filter="{include: /^sheet_version$/}"
				data-on-signal-patch={ sheetui.SheetRefetch(*v.MySheet) }
				class="hidden"
			></div>
			<div data-show={ surface(superficieDaFicha) } class="flex min-h-0 flex-1 flex-col">
				@sheetui.SceneBody(*v.MySheet)
			</div>
		}
		// A MESA: quem está na cena e em que ordem. Rola por dentro, nunca a
		// página. A largura de leitura mora AQUI e não no `main`: uma coluna de
		// 48rem é a medida certa para a fila e para o grupo, e a errada para o
		// mapa.
		<div data-show={ surface(superficieDaMesa) } class="mx-auto min-h-0 w-full max-w-3xl flex-1 space-y-4 overflow-y-auto p-3 sm:p-4">
			@tableRegisterRegion(v)
			@tableParty(v)
			@tableTracker(v)
		</div>
		// O TABULEIRO ocupa a tela inteira, sem coluna: espremido numa coluna de
		// leitura, o mapa cabia em 8×4 quadrados.
		<div data-show={ surface(superficieDoTabuleiro) } class="flex min-h-0 flex-1 flex-col p-2 sm:p-3">
			@tableBoard(v)
		</div>
		// AS REGIÕES QUE NÃO SÃO SUPERFÍCIE ficam fora das duas: são diálogos (e,
		// para o jogador, cascas vazias), e o stream remenda POR ID.
		@tableMap(v)
		@tableCollectionPlaces(v)
		@tableConfigSession(v)
		@tableCommands(v)
	</main>
}

// O SELETOR DE SUPERFÍCIE do jogador.
//
// DOIS níveis e não um: aqui se escolhe A SUPERFÍCIE, e dentro de cada uma
// continuam as seções dela. Uma fileira única misturando "partes de mim" com
// "partes da mesa" fica ilegível no telefone.
//
// Ancorado no topo e sempre visível: a premissa do app é tela cheia, com ninguém
// rolando a página atrás de menu.
templ surfaceSelector(v View) {
	// A MESMA largura de leitura da superfície Mesa, e não a linha inteira:
	// esticado em 1920px, cada aba viraria um botão de centenas de pixels.
	// Centrado, ele encabeça a coluna na Mesa e continua alcançável no
	// Tabuleiro.
	<div role="group" aria-label="O que ver na sessão" class="mx-auto flex w-full max-w-3xl shrink-0 gap-1 px-3 pt-2 sm:px-4">
		for _, superficie := range surfaces(v) {
			<button
				type="button"
				data-attr:aria-pressed={ fmt.Sprintf("%s ? 'true' : 'false'", surface(superficie.ID)) }
				data-class={ surfaceStyling(superficie.ID) }
				data-on:click={ pickSurface(superficie.ID) }
				class="flex min-h-11 min-w-0 flex-1 items-center justify-center gap-1.5 rounded-none border px-2 text-xs uppercase tracking-wide outline-none transition-colors"
			>
				@ui.Icon(superficie.Icon, "size-4 shrink-0")
				<span class="truncate">{ superficie.Label }</span>
			</button>
		}
	</div>
}

// AS REGIÕES DA MESA: cada uma tem raiz com id ESTÁVEL e hash próprio, e o
// stream manda só as que mudaram. Remendar a cena inteira a cada mudança de
// qualquer um substituiria o elemento debaixo do dedo de quem arrasta uma peça,
// cancelando o gesto.
//
// A raiz existe SEMPRE, com o condicional por dentro. Uma região que some leva o
// id junto, e o remendo seguinte não acha onde pousar — o vazio precisa de casca.

// tableHeader é a faixa AO VIVO. Acende em DOURADO na vez do jogador, porque
// dourado é o que já diz "a vez" na iniciativa e no tabuleiro.
templ tableHeader(v View) {
		<div
			id="table-header"
			class={ "flex shrink-0 flex-wrap items-center justify-between gap-x-4 gap-y-1 border-b px-2 py-1 sm:px-3",
				templ.KV("border-grimorio-gold/60 bg-grimorio-gold/10", v.Turn.Kind == "mine"),
				templ.KV("border-grimorio-iron bg-grimorio-panel", v.Turn.Kind != "mine") }
		>
			<p class="flex items-center gap-2">
				<span class="relative flex size-2.5">
					<span class="absolute inline-flex size-full animate-ping rounded-full bg-hp-full opacity-75"></span>
					<span class="relative inline-flex size-2.5 rounded-full bg-hp-full"></span>
				</span>
				<span class={ ui.SectionLabelClasses("herda", "text-hp-full") }>Ao vivo</span>
				<span class="text-sm text-muted-foreground">· Sessão { fmt.Sprint(v.SessionNum) }</span>
			</p>
			// `aria-live` é obrigatório aqui e não é enfeite: num app de morph a vez
			// muda sem navegação nenhuma, então quem não vê a tela não tem OUTRO
			// sinal de que chegou a vez dele.
			@savingWarning(v)
			@sessionVerbs(v)
			<div class="flex min-w-0 items-center gap-2 text-sm" aria-live="polite">
				if v.Turn.Kind != "idle" {
					<span class="shrink-0 text-muted-foreground">Rodada { fmt.Sprint(v.Round) }</span>
				}
				switch v.Turn.Kind {
					case "mine":
						<span class="flex shrink-0 animate-pulse items-center gap-1 bg-primary px-2 py-0.5 text-xs font-bold uppercase tracking-widest text-primary-foreground">Sua vez</span>
					case "idle":
						<span class="truncate text-muted-foreground">Aguardando iniciativa</span>
				}
				// A faixa convive com o "Sua vez" em vez de substituí-lo: aquele é
				// um ALERTA para quem não está olhando a tela, e esta é uma
				// leitura.
				@turnStrip(v)
			</div>
		</div>
}

// A FAIXA: agora › depois › depois, com a volta da rodada marcada.
//
// UMA LINHA dentro do cabeçalho e não uma tira própria: o cabeçalho já existe,
// já é `aria-live`, e uma faixa nova custaria altura numa tela que reparte
// altura entre o mapa, a fila e a ficha.
//
// A SETA é `aria-hidden` e a ordem é dita pela LISTA: um `<ol>` já anuncia
// "item 1 de 3" em leitor de tela, e o `›` desenhado seria lido como "sinal de
// maior" no meio de cada nome.
templ turnStrip(v View) {
	if len(v.Upcoming) > 0 {
		<ol class="flex min-w-0 items-center gap-1.5 text-sm">
			for i, p := range v.Upcoming {
				if i > 0 {
					<li aria-hidden="true" class="shrink-0 text-muted-foreground/50">›</li>
				}
				// A VIRADA DA RODADA é desenhada ANTES de quem a começa, porque é
				// ali que ela acontece. O símbolo tem `title` e nome acessível:
				// um `⟲` mudo seria enfeite para quem enxerga e nada para quem
				// não.
				if p.WrapsRound {
					<li
						title={ fmt.Sprintf("Daqui começa a rodada %d", v.Round+1) }
						class="shrink-0 text-sm text-grimorio-gold"
					>
						<span aria-hidden="true">⟲</span>
						<span class="sr-only">{ fmt.Sprintf("começa a rodada %d:", v.Round+1) }</span>
					</li>
				}
				<li class={ turnStripInk(p) }>{ turnStripName(p) }</li>
			}
		</ol>
	}
}

// turnStripName escreve "você" no lugar do próprio nome — quando ele é UM.
//
// Com dois meus na faixa a palavra deixa de responder e passa a atrapalhar
// ("você › Tanque › você"), e aí o nome volta. Quem decide isso é o `SaysYou`,
// que enxerga a faixa inteira; aqui só se escreve o que ele já decidiu.
func turnStripName(p turnAhead) string {
	if p.SaysYou {
		return "você"
	}
	return p.Label
}

// turnStripInk: a da VEZ é a que se lê primeiro, a minha é dourada, o resto é
// discreto.
//
// UM `class` só e não três condicionais empilhadas: atributo repetido não
// existe no templ, e o segundo some sem erro.
func turnStripInk(p turnAhead) string {
	switch {
	case p.Now:
		return "min-w-0 truncate font-semibold text-foreground"
	case p.Mine:
		return "min-w-0 truncate text-grimorio-gold"
	default:
		return "min-w-0 truncate text-muted-foreground"
	}
}

// A GRAVAÇÃO FALHANDO, no cabeçalho e só para o mestre.
//
// A mesa roda de MEMÓRIA e escreve no disco a cada mutação. Quando a escrita
// falha, os stores marcam a sessão e SEGUEM servindo da memória: a tela fica
// certa, o combate anda, e o disco não tem nada.
//
// No CABEÇALHO e não num canto: ele fica ao lado do "Ao vivo", que é a promessa
// que este aviso desmente. Um alarme escondido num rodapé que rola chega tarde.
//
// `role="alert"` e não `aria-live="polite"`: o "polite" ao lado espera a leitura
// terminar, o que está certo para "chegou a sua vez" e errado para isto. E o
// texto diz O QUE FAZER, porque quem lê é o mestre no meio de uma sessão.
//
// A TINTA é a combinação que o `npc_editor.templ` já usa, copiada em vez de
// inventada de propósito: o medidor de contraste só mede o que ele VISITA, e
// nenhum caminho do e2e desenha este aviso — uma variante nova aqui nasceria
// sem medição.
templ savingWarning(v View) {
	if v.GM != nil && v.GM.SaveFailing {
		<p
			role="alert"
			class="flex shrink-0 items-center gap-1.5 rounded-sm border border-destructive/60 bg-destructive/10 px-2 py-1 text-xs font-semibold text-destructive-ink"
		>
			@ui.Icon("TriangleAlert", "size-3.5 shrink-0")
			<span>A mesa não está sendo salva — encerre e chame o dono do servidor.</span>
		</p>
	}
}

// Registrar iniciativa — a ÚNICA mutação desta superfície. Some fora de cena
// porque gravaria o combatente na fila do mestre sem mudar nada na tela de quem
// clicou.
templ tableRegisterRegion(v View) {
	<div id="table-register">
		if v.SceneActive && v.Eu != nil {
			@tableRegister(v)
		}
	</div>
}

// Grupo — como todo mundo está, que é pergunta diferente de "quem age quando".
templ tableParty(v View) {
	<div
		id="table-party"
		class={ templ.KV("flex min-h-0 flex-1 flex-col", v.GM != nil) }
	>
		if v.GM != nil {
			@gmCast(v)
		} else {
			@cardsParty(v)
		}
	</div>
}

// O GRUPO em cartões, a superfície do JOGADOR. Aparece FORA de cena de
// propósito: PV do grupo não é informação de combate.
templ cardsParty(v View) {
	if len(v.Group) > 0 {
		<section class="space-y-1.5">
			<h2 class={ ui.SectionLabelClasses("muted", "") }>Grupo</h2>
			<div class="grid gap-2 sm:grid-cols-2">
				for _, m := range v.Group {
					// O RETRATO ANCORA O CARTÃO: sem nada à esquerda, o nome e as barras
					// ficam soltos e gastam altura sem dizer quem é.
					//
					// É a monogram e não uma moldura de foto: não há campo de imagem no
					// modelo, e uma caixa que espera foto e recebe duas letras fica pior
					// que uma desenhada para duas letras. No dia em que a foto entrar,
					// ela entra aqui.
					<article class="flex items-center gap-2.5 border border-border/60 bg-card/60 p-2.5">
						<span
							aria-hidden="true"
							class="monogram size-11 rounded-sm text-sm"
							style={ "background: " + ui.NameGradient(m.Name) }
						>{ m.Initials }</span>
						<div class="flex min-w-0 flex-1 flex-col gap-1">
							<div class="flex items-baseline justify-between gap-2">
								<span class="flex min-w-0 items-baseline gap-1.5">
									// A presença é um PONTO e não um anel, porque aqui o cartão tem
									// largura de sobra.
									//
									// E ele nunca vai sozinho: cor não existe para quem usa leitor
									// de tela, então a frase viaja no `title` e num rótulo
									// só-para-leitor.
									if m.Presence != nil {
										<span
											title={ m.Name + " — " + m.Presence.Sentence }
											class={ "size-2 shrink-0 self-center rounded-full",
												templ.KV("bg-hp-full", m.Presence.AtTable),
												templ.KV("bg-grimorio-iron", !m.Presence.AtTable) }
										></span>
										<span class="sr-only">{ m.Presence.Sentence }</span>
									}
									<span class="truncate font-medium">{ m.Name }</span>
								</span>
								<span class="shrink-0 bg-muted px-1.5 text-xs font-bold uppercase tracking-widest text-muted-foreground">Nv { fmt.Sprint(m.Level) }</span>
							</div>
							if m.Classes != "" {
								<p class="truncate text-xs text-muted-foreground">{ m.Classes }</p>
							}
							// PV E PM LADO A LADO: empilhadas, gastam duas linhas para dizer
							// duas coisas que cabem numa.
							//
							// O RÓTULO FICA, mesmo apertado: sem ele, o que separa PV de PM é
							// só a cor, e cor sozinha não informa quem não a distingue. O
							// `aria-label` da barra já diz a frase inteira; isto é para quem
							// enxerga.
							<div class="flex items-center gap-3">
								@barraCompacta("PV", m.PV)
								@barraCompacta("PM", m.PM)
							</div>
						</div>
					</article>
				}
			</div>
		</section>
	}
}

// O TABULEIRO vem ANTES da fila e depois do Grupo: quando há mapa, é nele que a
// mesa olha — a fila responde "quem age quando", e o mapa responde "quem está
// onde", que é a pergunta do turno em curso.
//
// A RAIZ DA REGIÃO participa da altura nos dois papéis, e não é um bloco comum:
// a cena é `flex: 1` e recorta com `overflow: hidden`, e um `flex: 1` só sabe
// até onde crescer se o ancestral repassar a altura. Sem estas classes a janela
// nasce com a altura do nada, e quem rola passa a ser a PÁGINA em vez do mapa.
templ tableBoard(v View) {
	<div id="table-board" class="flex min-h-0 flex-1 flex-col">
		@boardTable(v.Board)
		// A RECUSA de uma parada mora aqui: quem move é o jogador, que não tem o
		// rodapé do mestre onde o `command_error` acende.
		//
		// Fica FORA do movimento proposto de propósito, porque a recusa mais
		// comum é a da PRIMEIRA parada ("não é a vez de Arwen"), e nessa hora
		// não há proposta nenhuma para pendurá-la.
		<p
			data-show="$move_error != ''"
			data-text="$move_error"
			aria-live="assertive"
			class="px-1 pt-1 text-xs text-destructive-ink"
		></p>
	</div>
}

// Iniciativa — LEITURA para o jogador; o mestre ganha aqui o que MONTA a fila.
// O diálogo de editar vem junto porque é dela que ele fala.
templ tableTracker(v View) {
	<div id="table-tracker">
			<section class="space-y-1.5">
				<div class="flex items-center justify-between gap-2">
					<h2 class={ ui.SectionLabelClasses("muted", "") }>Iniciativa</h2>
					// "Adicionar grupo" fica com a LISTA e não com o rodapé: ele
					// MONTA a fila, e os verbos do rodapé andam com ela pronta.
					if v.GM != nil {
						<span class="flex items-center gap-1.5">
							@addParty(v)
							// O "+ Combatente" fica ao lado do "Adicionar grupo": os dois
							// MONTAM a fila, um trazendo o elenco e o outro o capanga que
							// apareceu agora.
							//
							// O `aria-expanded` devolve a STRING e não o booleano: o
							// `data-attr` do Datastar trata valor booleano como ATRIBUTO
							// BOOLEANO — verdadeiro vira `aria-expanded=""` e falso REMOVE
							// o atributo. Para `disabled` isso é o certo; para ARIA é
							// inválido, e um `aria-expanded=""` não anuncia estado nenhum.
							// Vale para todo `data-attr:aria-*`.
							<button
								type="button"
								data-on:click="$combatant_form = !$combatant_form"
								data-attr:aria-expanded="$combatant_form ? 'true' : 'false'"
								class="inline-flex min-h-11 items-center gap-1.5 rounded-sm border border-grimorio-iron px-3 text-sm outline-none transition-colors hover:bg-accent"
							>+ Combatente</button>
							<button
								type="button"
								aria-label="Abrir o bestiário"
								title="Bestiário — trazer uma criatura do livro"
								data-on:click="document.getElementById('table-bestiary').showModal()"
								class="flex size-11 items-center justify-center rounded-sm border border-grimorio-iron text-lg outline-none transition-colors hover:bg-accent"
							>
			@ui.Icon("Skull", "size-5")
		</button>
						</span>
					}
				</div>
				if v.GM != nil {
					@formDeCombatente(v)
				}
				// Desenha O QUE CHEGOU, e nada mais. Quem esconde a fila fora de cena
				// é o servidor, no `redactForPlayers` — repetir a regra aqui num `if
				// v.SceneActive` seria a MESMA regra em dois lugares, e no dia em que
				// divergissem a tela mentiria com toda a confiança. Ao template sobra
				// escolher a FRASE do vazio.
				if len(v.Queue) == 0 {
					<p class="border border-dashed border-grimorio-iron p-4 text-center text-sm text-muted-foreground">
						if v.SceneActive {
							Em cena · ninguém na fila ainda.
						} else {
							Fora de cena. O mestre ainda não começou.
						}
					</p>
				} else {
					<ol class="space-y-1">
						for _, l := range v.Queue {
							@tableRowTracker(v, l)
						}
					</ol>
					// UM diálogo para a fila inteira, e não um por linha: quem
					// diz em quem ele mexe é o sinal que o número semeia. Um por
					// linha seriam N ids para colidir e N cópias para o morph
					// reconciliar a cada remendo.
					if v.GM != nil {
						@editarCombatente(v)
					}
				}
			</section>
			if v.GM != nil {
				@condicoesDoCombatente(v)
			}
	</div>
}

// AS CONDIÇÕES do combatente.
//
// UM diálogo para todas as linhas, e não um por combatente: são 35 condições, e
// uma cópia por linha multiplicaria isso em nós redesenhados a cada mudança na
// fila. Quem diz de QUEM é a caixa são os sinais, reescritos pela ABERTURA — o
// gesto que troca de item é o que limpa.
//
// A lista vem do CATÁLOGO e já chega ordenada em pt-BR. Uma segunda tabela do
// livro escrita aqui é uma tabela que desvia: a condição que faltar na cópia dá
// 400 ao ser aplicada.
templ condicoesDoCombatente(v View) {
	<dialog
		id="combatant-conditions"
		data-preserve-attr="open"
		aria-labelledby="combatant-conditions-title"
		class="scene-grimorio m-auto w-[min(34rem,calc(100vw-2rem))] rounded-sm border border-grimorio-iron bg-grimorio-panel p-4 text-foreground backdrop:bg-black/60"
	>
		<h2 id="combatant-conditions-title" class="font-heading text-lg tracking-wide text-grimorio-gold">
			Condições de <span data-text="$row_label"></span>
		</h2>
		<p class="mt-1 text-sm text-muted-foreground">
			As condições do livro (p394-395). Aqui elas são RASTREIO: o bloco de uma criatura é escrito à mão, então o app não recalcula Defesa nem ataque — quem aplica o efeito é você.
		</p>
		<ul class="mt-3 flex max-h-[50vh] flex-wrap gap-1.5 overflow-y-auto">
			for _, c := range book.Catalogs().Conditions {
				<li>
					<button
						type="button"
						title={ c.Description }
						data-attr:aria-pressed={ onCondition(c.ID) + " ? 'true' : 'false'" }
						data-class={ "{'brush-on': " + onCondition(c.ID) + "}" }
						data-on:click={ toggleConditionRow(v, c.ID) }
						class="inline-flex min-h-11 items-center rounded-sm border border-grimorio-iron px-3 text-sm outline-none transition-colors hover:bg-accent"
					>{ c.Name }</button>
				</li>
			}
		</ul>
		<div class="mt-4 flex justify-end">
			// FECHAR e não confirmar: cada clique já foi aplicado, e um botão de
			// confirmar prometeria que nada valeu até ali.
			<button
				type="button"
				data-on:click="document.getElementById('combatant-conditions').close()"
				class="inline-flex min-h-11 items-center rounded-sm border border-grimorio-iron px-3 text-sm outline-none transition-colors hover:bg-accent"
			>Fechar</button>
		</div>
	</dialog>
}

// Os comandos do mestre. A raiz existe para todo mundo e o CONTEÚDO é que é do
// mestre: a trava é a view não ter o que desenhar, e o jogador recebe uma casca
// vazia em vez de um id que some e leva o remendo junto.
templ tableCommands(v View) {
	<div id="table-commands" class="contents">
		if v.GM != nil {
			@gmControls(v, *v.GM)
		}
	</div>
}

// tableRegister é o único caminho de escrita da superfície.
templ tableRegister(v View) {
	<section class="space-y-2 border border-grimorio-iron bg-grimorio-panel p-3">
		<h2 class="font-heading text-sm font-semibold text-grimorio-gold">
			if v.Eu.InQueue {
				Rolar de novo
			} else {
				Registrar iniciativa
			}
			· { v.Eu.Name }
		</h2>
		<div class="flex flex-wrap items-end gap-2">
			<div class="space-y-1">
				<label for="d20" class={ ui.FieldLabelClasses("muted", "block") }>Dado (d20)</label>
				// Ligado a um SINAL e nunca renderizado pelo servidor: o remendo
				// chega a cada tique, e um `value` vindo do servidor apagaria o que
				// o jogador está digitando. Entrada em curso é do teclado de quem
				// digita, não estado da aplicação.
				<input
					id="d20"
					name="d20"
					type="number"
					min="1"
					max="20"
					inputmode="numeric"
					data-bind:d20
					class="w-24 border border-input bg-background px-2 py-1.5 font-mono tabular-nums outline-none"
				/>
			</div>
			<button
				type="button"
				data-on:click="$d20 = Math.floor(Math.random() * 20) + 1"
				class="border border-grimorio-iron-light bg-secondary px-3 py-1.5 text-sm text-secondary-foreground outline-none hover:bg-accent"
			>
				@ui.Icon("Dices", "size-4")
				Rolar
			</button>
			// A PRÉVIA some quando o dado não é um dado: o `data-bind` do Datastar
			// escreve ZERO no sinal quando o campo numérico esvazia. Sem isto,
			// apagar para redigitar mostra "Total previsto 8" quando o bônus é 8 e
			// não há dado nenhum — um total que não existe, lido no instante em que
			// a pessoa está decidindo.
			//
			// A faixa vem do LIVRO (1..20) e o servidor já a recusa; o que se
			// conserta aqui é a tela dizer a verdade antes do clique.
			<p class="text-sm text-muted-foreground">
				Bônus <span class="font-mono tabular-nums text-foreground">{ fmt.Sprint(v.Eu.Bonus) }</span>
				<span data-show="$d20 >= 1 && $d20 <= 20">
					· Total previsto <span class="font-mono tabular-nums text-foreground" data-text={ fmt.Sprintf("$d20 + %d", v.Eu.Bonus) }></span>
				</span>
				<span data-show="!($d20 >= 1 && $d20 <= 20)" class="italic">· informe o dado (1 a 20)</span>
			</p>
		</div>
		// Sai só o d20 no fio; o TOTAL é somado pelo servidor, que é quem tem a
		// `ComputeSheet`. O `data-indicator` desliga o botão enquanto o POST
		// voa — sem isso o duplo clique manda duas rolagens.
		//
		// E o botão fica desabilitado com o dado fora da faixa: oferecer uma ação
		// que o servidor vai recusar é fazer a pessoa descobrir o erro DEPOIS de
		// clicar. O campo vazio conta como fora da faixa, porque o `data-bind`
		// escreve ZERO no sinal quando ele esvazia.
		<button
			type="button"
			data-indicator:registering
			data-attr:disabled="$registering || !($d20 >= 1 && $d20 <= 20)"
			data-on:click={ fmt.Sprintf("@post('%s/iniciativa')", v.SessionBase()) }
			class="bg-primary px-3 py-1.5 text-sm font-semibold text-primary-foreground outline-none hover:opacity-90 disabled:opacity-50"
		>
			Registrar
		</button>
		<p class="text-xs text-destructive-ink" data-show="$error != ''" data-text="$error"></p>
	</section>
}

// A LINHA da fila.
//
// O `relative` da classe é CONTEXTO DE POSICIONAMENTO e não estilo: a piscada
// do vital pinta um véu `absolute inset-0` sobre a linha, e sem isto ele se
// ancoraria no primeiro ancestral posicionado — que é o diálogo da gaveta. O
// sintoma seria a tela inteira piscando de vermelho quando alguém perde 1 PV.
templ tableRowTracker(v View, l tableRow) {
	<li
		if l.OnTurn {
			aria-current="true"
		}
		class={ "relative flex items-center gap-2.5 border p-2",
			templ.KV("border-grimorio-gold/60 bg-grimorio-gold/10", l.OnTurn),
			templ.KV("border-border/60 bg-card/60", !l.OnTurn) }
	>
		if v.GM != nil {
			@numberEditable(v, l)
		} else {
			<span class={ "w-8 shrink-0 text-center font-mono text-lg font-bold tabular-nums",
				templ.KV("text-grimorio-gold", l.OnTurn), templ.KV("text-muted-foreground", !l.OnTurn) }>
				{ fmt.Sprint(l.Initiative) }
			</span>
		}
		<div class="min-w-0 flex-1 space-y-1">
			<div class="flex flex-wrap items-center gap-1.5">
				<span class="truncate font-medium">{ l.Label }</span>
				// O crachá é `--marker` e nunca a primária: crachá não se clica,
				// então não compete com a ação.
				//
				// A palavra é FICHA e não "PC" nem "Personagem". `PC` é termo
				// PROIBIDO pelo GLOSSARY, e a pergunta que o `type === "character"`
				// responde é "esta linha é ficha ou é NPC?". "Personagem" ainda
				// transbordaria: dez letras em `tracking-widest` numa linha de
				// 390px que já leva quatro alvos de 36px.
				if l.IsSheet {
					<span class="shrink-0 bg-marker px-1 text-[10px] font-bold uppercase tracking-widest text-marker-foreground">Ficha</span>
				}
				if l.Mine {
					<span class="shrink-0 bg-marker px-1 text-[10px] font-bold uppercase tracking-widest text-marker-foreground">Seu</span>
				}
				// "Na vez" por ESCRITO e não só pela cor dourada: um fundo colorido
				// não existe para leitor de tela.
				if l.OnTurn {
					<span class={ ui.SectionLabelClasses("gold", "shrink-0 text-[10px]") }>Na vez</span>
				}
			</div>
			@trackerBar(v, l, "hp", "PV", l.PV)
			@trackerBar(v, l, "mp", "PM", l.PM)
			if len(l.Conditions) > 0 {
				<ul class="flex flex-wrap gap-1">
					// Fundo a 15% da MESMA cor e a cor como TEXTO, e não a tinta de
					// penalidade sobre preenchimento sólido: sobre o sólido ela fica
					// abaixo dos 4,5:1 do WCAG AA. Tinta é para escrever sobre o
					// painel, não sobre o próprio preenchimento.
					//
					// O NOME e não o `id`: em `uppercase` a maioria dos ids sai igual
					// ao nome, e é só nos acentuados que o identificador cru aparece
					// (CAIDO, EM-CHAMAS, IMOVEL, VULNERAVEL). O `title` carrega o
					// EFEITO porque a condição aqui é RASTREIO e não regra — o motor
					// não recalcula os números de um bloco escrito à mão, então quem
					// aplica é o mestre e ele precisa ler o que ela faz.
					for _, c := range l.Conditions {
						<li
							data-condicao
							title={ conditionEffect(c) }
							class="rounded-md border border-[color:var(--hp-hurt)]/60 bg-[color:var(--hp-hurt)]/15 px-1.5 py-px text-[10px] font-semibold uppercase tracking-wide text-[color:var(--hp-hurt)]"
						>{ book.ConditionName(c) }</li>
					}
				</ul>
			}
		</div>
		if v.GM != nil {
			@rowVerbs(v, l)
		}
	</li>
}

// rowVerbs é o que o MESTRE faz com a LINHA INTEIRA: condições e tirar da fila.
//
// Ferir, curar e o olho NÃO moram aqui, e sim ao lado da barra que cada um mexe
// (`trackerBar`): os três falam de UM pool, e com dois pools por linha uma tira
// compartilhada não tem como dizer de qual — o `+` ao lado da lixeira não diz se
// devolve vida ou mana.
//
// Os dois verbos que sobraram existem para TODA linha, e é por isso que a
// fileira não precisa de vaga vazia: fileira que não varia não desalinha.
templ rowVerbs(v View, l tableRow) {
	<div class="flex shrink-0 items-center gap-1">
		<button
			type="button"
			aria-label={ "Condições de " + l.Label }
			title={ "Condições de " + l.Label + " (p394-395)" }
			data-on:click={ openConditions(l) }
			class="flex size-9 items-center justify-center rounded-sm border border-grimorio-iron text-muted-foreground outline-none transition-colors hover:bg-accent hover:text-foreground"
		>
			@ui.Icon("HeartPulse", "size-4")
		</button>
		<button
			type="button"
			aria-label={ "Remover " + l.Label + " da fila" }
			title={ "Remover " + l.Label + " da fila" }
			data-on:click={ rowCommand(v, l, "remover") }
			class="flex size-9 items-center justify-center rounded-sm border border-grimorio-iron text-muted-foreground outline-none transition-colors hover:border-destructive hover:text-destructive-ink"
		>
			@ui.Icon("Trash2", "size-4")
		</button>
	</div>
}

// trackerBar é UM pool da linha: a barra, e os verbos que mexem NELA.
//
// O verbo mora ao lado do que ele muda: com dois pools por linha, um `+` numa
// tira compartilhada não diz de qual número está falando, e o dedo apressado do
// mestre cura o PV querendo devolver mana.
//
// Três estados, e os três são desenho diferente: sem barra nenhuma a linha não
// rastreia aquele pool e não sai nada; com a barra ESCONDIDA sai a frase, porque
// "não tem PV" e "o mestre escondeu" são coisas diferentes; com número sai a
// barra. Os verbos só existem para o mestre — o jogador lê.
templ trackerBar(v View, l tableRow, pool, label string, b *tableBar) {
	if b != nil {
		<div class="flex items-center gap-1">
			if b.Hidden && v.GM == nil {
				<p class="text-xs italic text-muted-foreground">{ label } ocultos pelo mestre</p>
			} else {
				@barra(label, *b)
			}
			if v.GM != nil {
				@vitalStep(v, l, pool, "curar", "+", healVerb(pool))
				@vitalStep(v, l, pool, "ferir", "−", harmVerb(pool))
				@rowEye(v, l, pool, label, b.Hidden)
			}
		</div>
	}
}

// vitalStep: clique tira ou devolve 1, Shift+clique 5.
//
// Os dois passos são DUAS ROTAS, e o `evt.shiftKey` só escolhe QUAL delas — o
// número nunca viaja como dado. O `title` conta os dois passos porque atalho que
// ninguém descobre não existe, e o nome acessível traz o do combatente: numa
// fila cheia, "Ferir" sozinho não diz quem.
templ vitalStep(v View, l tableRow, pool, verb, sign, label string) {
	<button
		type="button"
		aria-label={ label + " " + l.Label }
		title={ label + " " + l.Label + " — clique 1, Shift+clique 5" }
		data-on:click={ rowVital(v, l, pool, verb) }
		class="flex size-9 items-center justify-center rounded-sm border border-grimorio-iron font-mono text-sm outline-none transition-colors hover:bg-accent"
	>{ sign }</button>
}

// rowEye esconde os PV deste combatente DOS JOGADORES.
//
// `aria-pressed` porque é um estado que fica, não uma ação que passa. E o
// `title` diz de quem se esconde: o ícone sozinho não conta que o segredo é dos
// jogadores e não do mestre.
templ rowEye(v View, l tableRow, pool, label string, hidden bool) {
	<button
		type="button"
		aria-pressed={ fmt.Sprint(hidden) }
		if hidden {
			aria-label={ "Revelar os " + label + " de " + l.Label }
			title={ "Revelar os " + label + " de " + l.Label + " para os jogadores" }
		} else {
			aria-label={ "Ocultar os " + label + " de " + l.Label }
			title={ "Ocultar os " + label + " de " + l.Label + " dos jogadores" }
		}
		data-on:click={ rowCommand(v, l, "vitais/"+pool+"/oculto") }
		class={ "flex size-9 items-center justify-center rounded-sm border border-grimorio-iron text-sm outline-none transition-colors hover:bg-accent",
			templ.KV("text-grimorio-gold", hidden), templ.KV("text-muted-foreground", !hidden) }
	>
		if hidden {
			@ui.Icon("EyeOff", "size-4")
		} else {
			@ui.Icon("Eye", "size-4")
		}
	</button>
}

// barraCompacta é a barra do cartão do Grupo, feita para duas caberem numa
// linha. A diferença para a `barra` é só o que ocupa largura: o rótulo encolhe e
// o número perde o máximo, que já viaja no `aria-label`.
templ barraCompacta(label string, b tableBar) {
	<div class="flex min-w-0 flex-1 items-center gap-1">
		<span class={ ui.SectionLabelClasses("muted", "shrink-0") }>{ label }</span>
		<div
			role="progressbar"
			aria-valuenow={ fmt.Sprint(b.Current) }
			aria-valuemin="0"
			aria-valuemax={ fmt.Sprint(b.Max) }
			aria-label={ barLabel(label, b) }
			class="h-1.5 min-w-0 flex-1 overflow-hidden rounded-full bg-muted"
		>
			<div class={ "h-full rounded-full", b.Tone } style={ fmt.Sprintf("width: %d%%", b.Pct) }></div>
		</div>
		<span class="shrink-0 font-mono text-[13px] tabular-nums text-foreground">{ fmt.Sprint(b.Current) }/{ fmt.Sprint(b.Max) }</span>
		@reservaDeTemporarios(b)
	</div>
}

// reservaDeTemporarios é o `+70` que segue a fração, no azul do PV temporário.
//
// PARCELA À PARTE e não somando, pela mesma razão do crachá da ficha: a barra
// responde "quanto apanhei", e somar faria um herói ferido desenhar cheio. O
// dano gasta esta parcela ANTES do PV (p106), que é o que o mestre precisa
// saber para decidir a pancada.
//
// Ela SÓ NASCE quando existe — um "+0" não quer dizer nada — e o `aria-hidden`
// é deliberado: o número já viaja no `aria-label` da barra ao lado, e duas
// vozes para o mesmo dado é o que o cabeçalho do `vitalBar` da ficha recusa.
//
// # O `sm:` não é gosto, é a fileira medida
//
// A fileira da gaveta do mestre está CHEIA a 390px: label, barra, fração e três
// botões cabem porque o flex espreme os passos de 36px para 32. Com o `+70`
// dentro, eles caíram para **16px** — metade de um alvo de toque. Tentei o
// conserto de cima (passos com `shrink-0`, fileira com `flex-wrap`), e ele
// custou mais: o olho desceu para uma segunda linha em TODOS os cartões, com ou
// sem reserva.
//
// Abaixo de `sm` sobra UM canal, e é o `aria-label` desta mesma barra. Medido, e
// registrado aqui porque a saída óbvia não existe: pintar a reserva DENTRO do
// trilho não custaria largura nenhuma — e não desenha, porque **o trilho tem
// largura ZERO nos dois chamadores desta barra**. Ele é `flex-1 min-w-0` numa
// fileira que já está cheia, então o `progressbar` existe para o leitor de tela
// e nunca teve caixa para pintar. É defeito anterior a esta fatia e não desta
// issue; consertá-lo muda a fileira de todo mundo.
//
// Quem joga no telefone continua vendo a reserva na PRÓPRIA ficha, onde o
// crachá a mostra em qualquer largura.
templ reservaDeTemporarios(b tableBar) {
	if b.Temp > 0 {
		<span
			aria-hidden="true"
			title="PV temporários — o dano gasta estes primeiro (p106)"
			class="hidden shrink-0 font-mono text-[13px] tabular-nums text-hp-temp sm:inline"
		>+{ fmt.Sprint(b.Temp) }</span>
	}
}

// barra é um `progressbar` de verdade, e não uma tira pintada: "um pouco de
// verde" não é resposta para quem não vê a tela — e o papel é o que o e2e lê.
//
// E HOJE ELA É SÓ ISSO. Medido na ALE-347, nos dois chamadores e nas duas
// larguras: o trilho sai com largura ZERO, porque é `flex-1 min-w-0` numa
// fileira que a fração e os três botões já enchem. O que a pessoa lê aqui é a
// FRAÇÃO; o `progressbar` serve a quem usa leitor de tela. Quem for consertar
// isto mexe na fileira de todo mundo — por isso ficou registrado e não
// remendado de passagem.
templ barra(label string, b tableBar) {
	<div class="flex items-center gap-1.5">
		<span class={ ui.SectionLabelClasses("muted", "w-7 shrink-0") }>{ label }</span>
		<div
			role="progressbar"
			aria-valuenow={ fmt.Sprint(b.Current) }
			aria-valuemin="0"
			aria-valuemax={ fmt.Sprint(b.Max) }
			aria-label={ barLabel(label, b) }
			class="h-1.5 min-w-0 flex-1 overflow-hidden rounded-full bg-muted"
		>
			<div class={ "h-full rounded-full", b.Tone } style={ fmt.Sprintf("width: %d%%", b.Pct) }></div>
		</div>
		<span class="shrink-0 font-mono text-[13px] tabular-nums text-foreground">{ fmt.Sprint(b.Current) }/{ fmt.Sprint(b.Max) }</span>
		@reservaDeTemporarios(b)
	</div>
}

// addParty traz os personagens do grupo para a fila.
//
// Continua clicável DEPOIS do primeiro uso porque `populateParty` é idempotente:
// o mestre que aceitou um jogador atrasado clica de novo e leva só o que
// faltava. Apagá-lo faria a segunda pergunta parecer respondida.
templ addParty(v View) {
	<button
		type="button"
		data-indicator:bringing
		data-attr:disabled="$bringing"
		data-on:click={ tableCommand(v, "POST", "iniciativa/por-no-mapa") }
		class="inline-flex min-h-11 items-center gap-1.5 rounded-sm border border-grimorio-iron px-3 text-sm outline-none transition-colors hover:bg-accent disabled:opacity-50"
	>+ Adicionar grupo</button>
}

// formDeCombatente é o capanga digitado no meio do combate.
//
// Ele está SEMPRE no HTML e quem o mostra é o sinal, não o servidor: um
// formulário que só existe depois de uma ida ao servidor perderia o que estava
// digitado a cada remendo da cena, e a cena é remendada a cada mudança de
// qualquer um na mesa. Pelo mesmo motivo os campos são ligados a SINAIS e nunca
// recebem `value` do servidor.
//
// O `Escape` fecha, porque é o gesto que todo mundo tenta primeiro num
// formulário aberto por engano e o gatilho que o abriu fica longe.
templ formDeCombatente(v View) {
	<div
		data-show="$combatant_form"
		style="display:none"
		data-on:keydown__window="evt.key === 'Escape' && ($combatant_form = false)"
		class="flex flex-wrap items-end gap-2 border border-dashed border-grimorio-iron p-3"
	>
		<div class="min-w-[10rem] flex-1 space-y-1">
			<label for="new-combatant" class={ ui.FieldLabelClasses("muted", "block") }>Nome</label>
			<input
				id="new-combatant"
				type="text"
				maxlength="60"
				placeholder="Goblin salteador…"
				data-bind:new_name
				class="w-full border border-input bg-background px-2 py-1.5 outline-none"
			/>
		</div>
		@campoDeNumero("nova-iniciativa", "Iniciativa", "new_initiative", "-5", "40")
		@campoDeNumero("novo-pv", "PV", "new_hp", "0", "999")
		// Ficha ou NPC: dois botões e não um seletor, porque são DOIS e o estado
		// tem de ser legível sem abrir nada. `aria-pressed` porque é escolha que
		// fica, não ação que passa.
		<div class="flex gap-1">
			@combatantKind("character", "Ficha")
			@combatantKind("npc", "NPC")
		</div>
		// O botão recusa o que o servidor recusaria, ANTES do clique: nome vazio
		// é a recusa que a pessoa mais encontra.
		<button
			type="button"
			data-attr:disabled="!$new_name.trim()"
			data-on:click={ fmt.Sprintf("@post('%s/iniciativa/adicionar')", v.SessionBase()) }
			class="min-h-11 rounded-sm bg-primary px-3 text-sm font-semibold text-primary-foreground outline-none hover:opacity-90 disabled:opacity-50"
		>Acrescentar</button>
	</div>
}

templ campoDeNumero(id, label, signal, min, max string) {
	<div class="w-20 space-y-1">
		<label for={ id } class={ ui.FieldLabelClasses("muted", "block") }>{ label }</label>
		<input
			id={ id }
			type="number"
			min={ min }
			max={ max }
			inputmode="numeric"
			data-bind={ signal }
			class="w-full border border-input bg-background px-2 py-1.5 font-mono tabular-nums outline-none"
		/>
	</div>
}

// O `aria-pressed` sai como STRING e não como booleano: o `data-attr` do
// Datastar daria `aria-pressed=""`, que é inválido e não anuncia estado nenhum.
templ combatantKind(kind, label string) {
	<button
		type="button"
		data-attr:aria-pressed={ fmt.Sprintf("$new_type === '%s' ? 'true' : 'false'", kind) }
		data-on:click={ fmt.Sprintf("$new_type = '%s'", kind) }
		data-class={ fmt.Sprintf("{'border-grimorio-gold text-grimorio-gold': $new_type === '%s', 'border-grimorio-iron text-muted-foreground': $new_type !== '%s'}", kind, kind) }
		class="min-h-11 rounded-sm border px-3 text-sm outline-none transition-colors hover:bg-accent"
	>{ label }</button>
}

// numberEditable: para o mestre, a INICIATIVA é botão — sem ela, consertar um
// número entrado errado custa remover e acrescentar de novo, perdendo PV e
// condições no caminho.
//
// O clique SEMEIA os sinais com os valores de AGORA ANTES de abrir: o diálogo
// não busca nada, e sem a semeadura ele abriria com o que sobrou da linha
// anterior.
templ numberEditable(v View, l tableRow) {
	<button
		type="button"
		aria-label={ "Editar " + l.Label }
		title={ "Editar " + l.Label + " — iniciativa e PV" }
		data-on:click={ openEdit(v, l) }
		class={ "w-8 shrink-0 rounded-sm text-center font-mono text-lg font-bold tabular-nums outline-none transition-colors hover:bg-accent",
			templ.KV("text-grimorio-gold", l.OnTurn), templ.KV("text-muted-foreground", !l.OnTurn) }
	>{ fmt.Sprint(l.Initiative) }</button>
}

// editarCombatente é DIÁLOGO e não campo na linha: a cena é remendada a cada
// mudança de qualquer um na mesa, e um input vivo dentro da lista perderia o
// foco a cada tique.
//
// Ele junta iniciativa e PV num diálogo só, e não um por campo: a fileira de
// verbos já leva quatro alvos de 36px numa linha de 390px, e um quinto não cabe.
// O ± continua sendo o caminho descoberto para o dano de 1 e 5; este é o caminho
// do valor exato.
templ editarCombatente(v View) {
	<dialog
		id="edit-combatant"
		data-preserve-attr="open"
		aria-labelledby="edit-combatant-title"
		class="scene-grimorio m-auto w-[min(20rem,calc(100vw-2rem))] rounded-sm border border-grimorio-iron bg-grimorio-panel p-4 text-foreground backdrop:bg-black/60"
	>
		<h2 id="edit-combatant-title" class="font-heading text-lg tracking-wide text-grimorio-gold">
			Editar <span data-text="$edit_name"></span>
		</h2>
		<p class="mt-1 text-sm text-muted-foreground">A ordem se reordena sozinha, e quem está na vez continua na vez.</p>
		<label for="edit-initiative" class={ ui.FieldLabelClasses("muted", "mt-3 block") }>Iniciativa</label>
		<input
			id="edit-initiative"
			type="number"
			min="-5"
			max="40"
			inputmode="numeric"
			data-bind="edit_initiative"
			class="mt-1 w-full border border-input bg-background px-2 py-1.5 font-mono tabular-nums outline-none"
		/>
		// O campo de PV só existe em linha COM vida, e quem sabe disso é o sinal
		// que o número semeou. O servidor confere de novo na escrita, porque a
		// tela pode estar defasada.
		<div data-show="$edit_hp_max > 0">
			<label for="edit-hp" class={ ui.FieldLabelClasses("muted", "mt-3 block") }>
				PV (de <span data-text="$edit_hp_max"></span>)
			</label>
			<input
				id="edit-hp"
				type="number"
				min="0"
				data-attr:max="$edit_hp_max"
				inputmode="numeric"
				data-bind="edit_hp"
				class="mt-1 w-full border border-input bg-background px-2 py-1.5 font-mono tabular-nums outline-none"
			/>
		</div>
		<div class="mt-4 flex justify-end gap-2">
			<button
				type="button"
				data-on:click="document.getElementById('edit-combatant').close()"
				class="inline-flex min-h-11 items-center rounded-sm border border-grimorio-iron px-3 text-sm outline-none transition-colors hover:bg-accent"
			>Cancelar</button>
			<button
				type="button"
				data-on:click={ saveEdit(v) }
				class="inline-flex min-h-11 items-center rounded-sm bg-primary px-3 text-sm font-semibold text-primary-foreground outline-none transition-opacity hover:opacity-90"
			>Salvar</button>
		</div>
	</dialog>
}

package table

import (
	"fmt"
	"t20engine/domain/creature"
	"t20engine/serve/web/ds"
	"t20engine/serve/web/ui"
)

// O EDITOR DE BLOCO desenhado, numa folha do kit (`gmNpcEditor`).
//
// Quem a abre é o SERVIDOR, ligando `$draft_open` ao devolver o rascunho
// semeado — assim o formulário nunca aparece antes de ter conteúdo.
//
// TRÊS ABAS (decisão do dono): Números, Ataques, Perícias e posses. O corte é
// por PERGUNTA e não por tamanho — "quais são os números dele", "como ele bate",
// "o que ele sabe e o que ele carrega".
//
// As CAIXAS ESCALARES são desenhadas UMA VEZ e nunca remendadas: elas se ligam a
// pedaços de `$draft`, e sinal sobrevive a qualquer remendo. O que o servidor
// redesenha são só as três LISTAS, porque Datastar não tem laço no cliente e uma
// lista de tamanho variável só existe como HTML que alguém escreveu.

templ blockEditor(v View) {
	<div style="display:none" data-show="$draft_open" class="ds-npc-editor">
		<div class="ds-dialog-head">
			<h2 data-text={ editorTitle } class="ds-dialog-title"></h2>
			@ds.IconButton(ds.ButtonGhost, "X", "Voltar ao elenco", templ.Attributes{"type": "button", "data-on:click": closeEditor})
		</div>
		<div class="ds-npc-body">
			// O NOME fica FORA das abas, e é o único campo que fica: ele não é um
			// número do bloco, é como o NPC se chama na mesa — e uma aba que o
			// escondesse deixaria "salvar sem nome" ser recusado por um campo que a
			// pessoa não estava vendo. "Nome do NPC" e não "Nome": a mesa já tem
			// uma caixa chamada "Nome", a do combatente novo.
			<div class="ds-field">
				<label for="npc-name">Nome do NPC</label>
				<input id="npc-name" class="ds-input" type="text" data-bind="draft.nome" placeholder="Ogro Capitão"/>
			</div>
			<div role="tablist" aria-label="Partes do bloco" class="ds-tabs">
				for _, aba := range editorTabs {
					@editorTabLink(aba)
				}
			</div>
			<div>
				@blockNumbers()
				@attacksTab(v)
				@ownedTab(v)
			</div>
		</div>
		// A RECUSA fica junto dos botões: quem lê está com o formulário aberto, e
		// uma frase atrás do painel é uma frase que ninguém lê. Sinal próprio para
		// não disputar com o `command_error`, que é da fila.
		<p role="alert" data-show="$draft_error !== ''" data-text="$draft_error" class="ds-help ds-reg-error ds-npc-error"></p>
		<div class="ds-dialog-foot">
			@ds.Button(ds.ButtonSecondary, templ.Attributes{"type": "button", "data-on:click": closeEditor}) {
				Cancelar
			}
			@ds.Button(ds.ButtonPrimary, templ.Attributes{"type": "button", "data-on:click": salvaOBloco(v)}) {
				Salvar
			}
		</div>
	</div>
}

// editorTabLink é um botão da fileira. `aria-selected` e `role="tab"` porque é o
// que um leitor de tela precisa para dizer "aba 2 de 3, selecionada" — e o valor
// sai como STRING, que é a armadilha do `data-attr` com booleano.
//
// O CONTADOR ao lado do nome não é enfeite: com o conteúdo escondido atrás de
// abas, "Ataques" sozinho não distingue um bloco com três ataques de um sem
// nenhum. Ele devolve o que as abas tiram.
templ editorTabLink(aba editorTab) {
	<button
		type="button"
		role="tab"
		data-attr:aria-selected={ fmt.Sprintf("%s ? 'true' : 'false'", onTabExpr(aba.ID)) }
		data-on:click={ pickTab(aba.ID) }
	>
		{ aba.Label }
		if tabSummary(aba.ID) != "" {
			<span data-text={ tabSummary(aba.ID) } class="ds-npc-count"></span>
		}
	</button>
}

// A ordem é do livro porque é dele que o mestre está copiando: quem tem a página
// aberta ao lado lê de cima para baixo, e uma ordem "melhor" o obrigaria a
// procurar cada campo.
templ blockNumbers() {
	<div role="tabpanel" data-show={ onTabExpr(abaDosNumeros) } class="ds-npc-panel">
		@blockSection("Identidade") {
			@numberBlock("nd", "ND", 0, 30)
			@blockChoice("tipo", "Tipo", kindOptions())
			@blockChoice("size", "Tamanho", sizeOptions())
			@blockText("deslocamento", "Deslocamento", "9m (6q)")
		}
		@blockSection("Combate") {
			@numberBlock("iniciativa", "Iniciativa", -20, 60)
			@numberBlock("percepcao", "Percepção", -20, 60)
			@numberBlock("defesa", "Defesa", 0, 60)
			@numberBlock("hp", "Pontos de Vida", 1, 9999)
			@blockMana()
		}
		@blockSection("Resistências") {
			@numberBlock("fortitude", "Fortitude", -20, 60)
			@numberBlock("reflexos", "Reflexos", -20, 60)
			@numberBlock("vontade", "Vontade", -20, 60)
		}
		@blockSection("Atributos") {
			@numberBlock("forca", "For", -5, 20)
			@numberBlock("destreza", "Des", -5, 20)
			@numberBlock("constituicao", "Con", -5, 20)
			@numberBlock("inteligencia", "Int", -5, 20)
			@numberBlock("sabedoria", "Sab", -5, 20)
			@numberBlock("carisma", "Car", -5, 20)
		}
	</div>
}

// blockMana é o único campo com interruptor, e a razão é do LIVRO: a linha de
// PM só existe em quem conjura (o Centauro Xamã tem 20 PM, p290; o Bandido não
// tem linha nenhuma). Um zero fixo diria "tem mana e está sem", que é outro
// estado — e é o estado errado na hora em que o mestre for gastar.
templ blockMana() {
	<div class="ds-field">
		<label for="npc-mp">Pontos de Mana</label>
		<div class="ds-npc-mana">
			<label class="ds-npc-check">
				<input type="checkbox" data-bind="draft.conjura"/>
				Conjura
			</label>
			<input id="npc-mp" class="ds-input" type="number" min="0" max="999" data-show="$draft.conjura" data-bind={ draftField("pm") }/>
		</div>
	</div>
}

// attacksTab é a lista que o servidor redesenha. O `+ Ataque` manda o
// rascunho INTEIRO e recebe de volta o rascunho com uma linha a mais — é assim
// que nada do que estava sendo digitado se perde.
templ attacksTab(v View) {
	<div role="tabpanel" data-show={ onTabExpr(abaDosAtaques) } class="ds-npc-panel">
		@listHeader(v, listaDeAtaques, "Ataques", "Ataque")
		@draftAttacks(v, nil)
		<p class="ds-help">O livro escreve a linha como "Corpo a Corpo: Clava +7 (1d6+3)" (p289). A nota entre parênteses vai em Efeito.</p>
	</div>
}

templ ownedTab(v View) {
	<div role="tabpanel" data-show={ onTabExpr(abaDasPosses) } class="ds-npc-panel">
		@listHeader(v, listaDePericias, "Perícias", "Perícia")
		@draftExpertises(v, nil)
		@listHeader(v, listaDeHabilidades, "Habilidades especiais", "Habilidade")
		@draftAbilities(v, nil)
		@blockSection("Posses") {
			@blockText("equipment", "Equipamento", "Clava, couro batido")
			@blockText("treasure", "Tesouro", "Metade")
		}
	</div>
}

templ listHeader(v View, list, title, what string) {
	<div class="ds-npc-list-head">
		<h3 class="ds-field-label">{ title }</h3>
		@ds.Button(ds.ButtonSecondary, templ.Attributes{"type": "button", "data-on:click": listCommand(v, list, -1)}) {
			@ui.Icon("Plus", "ds-icon")
			{ what }
		}
	</div>
}

// ── as três LISTAS, que são o que o servidor redesenha ───────────────────────
//
// Cada uma é um nó com id próprio, e o id é como o remendo a encontra. Elas NÃO
// entram na lista de regiões da Mesa: o stream não sabe do rascunho de ninguém, e
// um quadro dele apagaria as linhas em silêncio.

templ draftAttacks(v View, attacks []creature.Attack) {
	<div id="npc-attacks" class="ds-npc-rows">
		if len(attacks) == 0 {
			<p class="ds-help">Nenhum ataque.</p>
		}
		for i, attack := range attacks {
			<div class="ds-npc-row">
				@rowBox(rowField(listaDeAtaques, i, "name"), "Nome", "Clava")
				@numberRow(rowField(listaDeAtaques, i, "attackBonus"), "Ataque", -20, 60)
				@rowBox(rowField(listaDeAtaques, i, "damage"), "Dano", "1d6+3")
				@rowBox(rowField(listaDeAtaques, i, "special"), "Efeito", "mais agarrar")
				<label class="ds-npc-check">
					<input type="checkbox" data-bind={ rowField(listaDeAtaques, i, "ranged") }/>
					À distância
				</label>
				@removeRowButton(v, listaDeAtaques, i, attackName(attack, i))
			</div>
		}
	</div>
}

templ draftExpertises(v View, expertises []creature.Skill) {
	<div id="npc-expertises" class="ds-npc-rows">
		if len(expertises) == 0 {
			<p class="ds-help">Nenhuma perícia.</p>
		}
		for i, expertise := range expertises {
			<div class="ds-npc-row">
				@rowBox(rowField(listaDePericias, i, "name"), "Perícia", "Furtividade")
				@numberRow(rowField(listaDePericias, i, "bonus"), "Bônus", -20, 60)
				@rowBox(rowField(listaDePericias, i, "nota"), "Nota", "+14 em pântanos")
				@removeRowButton(v, listaDePericias, i, expertiseName(expertise, i))
			</div>
		}
	</div>
}

// draftAbilities: uma lista de FRASES, e por isso `<textarea>` e não
// `<input>` — o livro escreve habilidade especial em prosa ("Faro apurado.
// Recebe +2 em testes de Percepção baseados em olfato", p289), e uma caixa de uma
// linha faria o mestre resumir o que ele vai precisar ler em voz alta.
templ draftAbilities(v View, abilities []string) {
	<div id="npc-abilities" class="ds-npc-rows">
		if len(abilities) == 0 {
			<p class="ds-help">Nenhuma habilidade especial.</p>
		}
		for i := range abilities {
			<div class="ds-npc-row" data-prose>
				<textarea
					rows="2"
					class="ds-input"
					aria-label={ fmt.Sprintf("Habilidade especial %d", i+1) }
					data-bind={ rowField(listaDeHabilidades, i, "") }
					placeholder={ abilityPlaceholder }
				></textarea>
				@removeRowButton(v, listaDeHabilidades, i, fmt.Sprintf("a habilidade %d", i+1))
			</div>
		}
	</div>
}

// ── as peças pequenas ────────────────────────────────────────────────────────

templ blockSection(title string) {
	<section class="ds-npc-section">
		<h3 class="ds-field-label">{ title }</h3>
		<div class="ds-npc-grid">
			{ children... }
		</div>
	</section>
}

templ numberBlock(field, label string, min, max int) {
	<div class="ds-field">
		<label for={ "npc-" + field }>{ label }</label>
		<input id={ "npc-" + field } class="ds-input" type="number" min={ fmt.Sprint(min) } max={ fmt.Sprint(max) } data-bind={ draftField(field) }/>
	</div>
}

templ blockText(field, label, hint string) {
	<div class="ds-field" data-wide>
		<label for={ "npc-" + field }>{ label }</label>
		<input id={ "npc-" + field } class="ds-input" type="text" data-bind={ draftField(field) } placeholder={ hint }/>
	</div>
}

// blockChoice é um `<select>` de verdade, e não um trilho de botões: são
// sete tipos e seis tamanhos, a escolha é rara (uma vez por NPC) e o `<select>`
// nativo já traz teclado, busca por letra e o menu do sistema no telefone.
templ blockChoice(field, label string, options []blockOption) {
	<div class="ds-field">
		<label for={ "npc-" + field }>{ label }</label>
		<select id={ "npc-" + field } class="ds-input" data-bind={ draftField(field) }>
			for _, option := range options {
				<option value={ option.Value }>{ option.Label }</option>
			}
		</select>
	</div>
}

templ rowBox(path, label, hint string) {
	<label class="ds-field">
		<span>{ label }</span>
		<input class="ds-input" type="text" data-bind={ path } placeholder={ hint }/>
	</label>
}

templ numberRow(path, label string, min, max int) {
	<label class="ds-field">
		<span>{ label }</span>
		<input class="ds-input" type="number" min={ fmt.Sprint(min) } max={ fmt.Sprint(max) } data-bind={ path }/>
	</label>
}

// removeRowButton diz O QUE vai sair no nome acessível, e não "remover".
//
// Com cinco ataques na tela, cinco botões chamados "Remover" são cinco botões
// idênticos para quem navega por leitor de tela — e o que se apaga por engano é
// justamente o que se acabou de escrever.
templ removeRowButton(v View, list string, index int, what string) {
	@ds.IconButton(ds.ButtonGhost, "Trash2", "Tirar "+what, templ.Attributes{"type": "button", "title": "Tirar " + what, "data-on:click": listCommand(v, list, index)})
}

package table

import "t20engine/serve/web/ds"

// gmBanner é a faixa do Estandarte (p54) na mesa do mestre: um toque por aliado que vê o
// estandarte. O nó vazio fica pela razão do disparo: o fluxo remenda por id.
templ gmBanner(v View) {
	if len(v.Banners) > 0 {
		<section id="table-banner" class="ds-strike" role="status" aria-label="Estandarte">
			for _, band := range v.Banners {
				<div class="ds-strike-head">
					@ds.Badge("Estandarte · p54", true)
					<span class="ds-row-meta"><b>{ band.Head }</b></span>
				</div>
				<div class="ds-strike-foot">
					for _, offer := range band.Offers {
						@ds.Button(ds.ButtonSecondary, templ.Attributes{"type": "button", "aria-label": "Dar o Estandarte a " + offer.Name, "data-on:click": "@post('" + offer.Path + "')"}) {
							{ offer.Name }
						}
					}
					@ds.Button(ds.ButtonGhost, templ.Attributes{"type": "button", "aria-label": "Pronto: recolher o Estandarte até a próxima cena", "data-on:click": "@post('" + band.Done + "')"}) {
						Pronto
					}
				</div>
			}
		</section>
	} else {
		<section id="table-banner" hidden></section>
	}
}

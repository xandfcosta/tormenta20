package table

import (
	"fmt"
)

// A JANELA DAS NOTAS (ALE-218) — a mesma superfície, sem o mapa em volta.
//
// O corpo é o MESMO `notesBody` da coluna, e a faixa de modos é a mesma
// `modesRange`: a janela não é outra tela, é o mesmo painel noutro lugar. Duas
// cópias do editor divergiriam na primeira mudança de gramática do markdown,
// que é o defeito que o `.templ` vizinho existe para não ter.
//
// O que ela NÃO tem, e cada ausência é uma decisão:
//
//   - o alternador de FLUTUAR, porque não há mapa embaixo para cobrir;
//   - a DIVISA de largura, porque quem redimensiona a janela é o sistema;
//   - o ✕ de fechar, porque fechar é o botão da janela — e um segundo jeito de
//     fechar teria de decidir o que fazer com a janela em volta;
//   - o botão de DESTACAR, que aqui não teria para onde destacar.
templ notesWindow(v View) {
	<section
		id="notes-window"
		aria-label="Notas da sessão"
		data-init={ seedNotesWindow(v) }
		data-on:pagehide__window={ givesTheNotesBack(v) }
		class="ds-session ds-notes-window"
	>
		<header class="ds-notes-head">
			<h1 class="ds-sheet-name">{ fmt.Sprintf("Notas · Sessão %d", v.SessionNum) }</h1>
			@modesRange()
			@autosaveState()
		</header>
		@notesBody(v)
	</section>
}

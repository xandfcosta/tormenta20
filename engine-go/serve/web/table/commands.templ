package table

import (
	"fmt"

	"t20engine/domain/live"
	"t20engine/serve/web/ui"
)



// OS CONTROLES DO MESTRE.
//
// Eles entram na MESMA cena do jogador, e não numa segunda: a tela do mestre é
// a do jogador mais o que ele comanda. Duas cenas seriam duas listas de
// combatente para manter em dia, e o defeito delas é a mesma tela mostrando
// 52/95 e 57/95 do mesmo combatente.
//
// Quem decide se eles aparecem é o PAPEL, resolvido no servidor pelo mesmo
// `stateForRole` que o resto da casa usa. Esconder no cliente seria UX; a trava
// é a redação do estado, que o jogador nunca recebe.

templ gmControls(v View, r viewGm) {
	<section
		aria-label="Controles do mestre"
		class="flex shrink-0 flex-wrap items-center gap-2 border-t border-grimorio-iron bg-grimorio-panel px-2 py-1 sm:px-3"
	>
		// O CONTADOR vem primeiro e é texto, não enfeite: ele é quem explica por
		// que o avanço está apagado quando está. Botão apagado sem frase ao lado
		// é um beco.
		//
		// `aria-live` porque num app de remendo a rodada muda sem navegação, e
		// quem não vê a tela não tem outro sinal.
		<p aria-live="polite" class="text-xs text-muted-foreground">{ r.Contador }</p>
		// A RECUSA de um comando, e ela mora aqui e não na caixa de registrar: o
		// mestre que também joga tem as duas na tela, e a frase do "Adicionar
		// grupo" acesa dentro do "Registrar iniciativa" seria a frase certa no
		// lugar errado. Por isso o sinal é `command_error` e não `erro`.
		//
		// `w-full` e `order-last` para ela ocupar a própria fileira quando
		// aparece: enfiada entre os botões, empurraria o avanço para fora da
		// linha e a frase seria lida como rótulo do vizinho.
		<p
			data-show="$command_error != ''"
			data-text="$command_error"
			aria-live="assertive"
			class="order-last w-full text-xs text-destructive-ink"
		></p>
		<div class="ml-auto flex flex-wrap items-center gap-2">
			@turnStep(v, "iniciativa/vez-anterior", "Turno anterior", "‹", r.PodeAvancar)
			// O rótulo do avanço diz PARA ONDE vai: com um "▶" o mestre tem de
			// contar a lista para saber quem entra.
			<button
				type="button"
				if r.PodeAvancar {
					data-on:click={ tableCommand(v, "POST", "iniciativa/proxima-vez") }
					class="inline-flex min-h-11 items-center gap-1.5 rounded-sm border border-grimorio-gold bg-accent px-3 text-sm font-medium text-grimorio-gold outline-none transition-colors hover:bg-grimorio-gold/20"
				} else {
					disabled
					class="inline-flex min-h-11 cursor-not-allowed items-center gap-1.5 rounded-sm border border-grimorio-iron px-3 text-sm text-muted-foreground opacity-60"
				}
			>{ r.Avanco.Label }</button>
			// O "Iniciar cena" fica SEMPRE na fileira, em qualquer altura de
			// palco: abaixo de 1024 o ciclo sai do trilho, e sem esta exceção o
			// mestre no celular ficaria sem caminho nenhum para COMEÇAR. O que
			// anda é o par de baixo.
			//
			// E ele fica mesmo COM uma cena em curso, o que é novo: "uma cena
			// pode ser interrompida para dar lugar a outra… se os personagens
			// estão discutindo na corte e de repente são atacados, a cena da
			// discussão acaba e uma nova cena começa — um combate" (p252). Antes
			// o botão sumia ao começar, e o exemplo do livro era justamente o
			// que a tela não deixava fazer.
			@startScene(v)
			// Palco ALTO: encerrar e recuperar dividem a fileira com o avanço.
			// Palco BAIXO: os mesmos nós reaparecem na gaveta, e não outros —
			// são as MESMAS funções chamadas duas vezes, porque dois desenhos do
			// mesmo botão são dois lugares para consertar.
			<div class="stage-tall-only">
				if v.SceneActive {
					@endSceneButton(v)
				}
				@expireScene(v)
			</div>
			@tableDrawer(v)
		</div>
		@restDay(v)
	</section>
}

// tableDrawer é o rodapé do mestre quando o palco é baixo.
//
// `<details>` e não um popover com JavaScript: abrir e fechar é o que o elemento
// JÁ faz, e ele leva de graça o teclado, o foco e o "fechar com Escape" que uma
// gaveta de mão sempre esquece. Ela sobe (`bottom-full`) porque nasce no rodapé.
//
// Quem a mostra e a esconde é a consulta de contêiner na folha, e não uma classe
// aqui: a decisão é sobre a ALTURA MEDIDA do palco, e essa medida o servidor não
// tem.
templ tableDrawer(v View) {
	<details class="stage-drawer relative">
		<summary
			aria-label="Mais comandos da mesa"
			class="flex size-11 cursor-pointer list-none items-center justify-center rounded-sm border border-grimorio-iron text-sm outline-none transition-colors hover:bg-accent"
		>
			@ui.Icon("Settings2", "size-4")
		</summary>
		<div class="absolute bottom-full right-0 z-20 mb-2 flex w-56 flex-col gap-1 rounded-sm border border-grimorio-iron bg-grimorio-panel p-2 shadow-lg">
			if v.SceneActive {
				@endSceneButton(v)
			}
			@expireScene(v)
		</div>
	</details>
}

// Os DOIS gestos de fim de duração, e eles NÃO são o mesmo par.
//
// O de CENA não devolve ponto nenhum: ele expira a duração de cena, os usos
// "1/cena" e as posturas. Por isso ele NÃO se chama "Recuperar · cena" — a
// palavra "recuperar" é a do descanso, e o nome prometeria o que a função não
// faz. Os três gestos deste painel se separam pela PALAVRA e não pela cor:
// "Encerrar cena" tira a fila do ar, "Expirar efeitos" só encerra a duração,
// "Recuperar · dia" é o único que devolve pontos.
//
// Os dois FICAM (decisão do dono), porque "acabou a bênção" nem sempre é
// "acabou a cena" e o mestre precisa poder expirar a duração sem tirar a fila de
// ninguém.
//
// A de CENA acontece no clique porque não precisa de mais nada. A de DIA precisa
// da qualidade, que é o que a p106 usa para calcular quanto volta, e só por isso
// abre o diálogo — cobrar dois passos pelo que tem um seria cobrar por um dado
// que o motor não usa.
templ expireScene(v View) {
	<button
		type="button"
		data-indicator:resting
		data-attr:disabled="$resting"
		data-on:click={ tableCommand(v, "POST", "descanso/cena") }
		class="inline-flex min-h-11 items-center gap-1.5 rounded-sm border border-grimorio-iron px-3 text-sm outline-none transition-colors hover:bg-accent disabled:opacity-50"
	>
		@ui.Icon("Hourglass", "size-4")
		Expirar efeitos · cena
	</button>
	<button
		type="button"
		data-on:click="document.getElementById('day-rest').showModal()"
		class="inline-flex min-h-11 items-center gap-1.5 rounded-sm border border-grimorio-iron px-3 text-sm outline-none transition-colors hover:bg-accent"
	>
		@ui.Icon("Moon", "size-4")
		Recuperar · dia
	</button>
}

// restDay pergunta a QUALIDADE antes de descansar (T20 p106).
//
// `data-preserve-attr="open"` não é enfeite e sem ele o diálogo é inútil: a cena
// inteira é remendada a cada mudança, o `open` do `showModal()` só existe no DOM
// vivo, e o morph o apagaria — o diálogo FECHARIA sozinho no instante em que
// qualquer jogador registrasse iniciativa. O atributo diz ao morph para não
// tocar naquele, e ele é lido do nó que CHEGA, que é por isso que ele mora no
// HTML do servidor e não no que o navegador escreve.
//
// `<dialog>` nativo e não uma caixa flutuante: o modal de verdade traz o foco
// preso, o Escape, o fundo inerte e a camada de topo — que ainda por cima é o
// que o tira de dentro do `contain` do palco.
// `m-auto` na caixa porque o `preflight` do Tailwind zera a margem de TODO
// elemento, e a centralização do `<dialog>` modal é justamente a `margin: auto`
// que o navegador aplica sobre `inset: 0`. Sem ele o diálogo nasce grudado no
// canto superior esquerdo — medido, `top: 0, left: 0` numa janela de 1916×907.
templ restDay(v View) {
	<dialog
		id="day-rest"
		data-preserve-attr="open"
		aria-labelledby="day-rest-title"
		class="scene-grimorio m-auto w-[min(24rem,calc(100vw-2rem))] rounded-sm border border-grimorio-iron bg-grimorio-panel p-4 text-foreground backdrop:bg-black/60"
	>
		<h2 id="day-rest-title" class="font-heading text-lg tracking-wide text-grimorio-gold">Descanso de dia</h2>
		<p class="mt-1 text-sm text-muted-foreground">A qualidade do descanso decide quanto o grupo recupera de PV e PM (p106).</p>
		<label for="rest-quality" class={ ui.FieldLabelClasses("muted", "mt-3 block") }>Qualidade do descanso</label>
		// O NOME DO SINAL É `snake_case` porque ele aparece como CHAVE de
		// atributo, e chave de atributo é minusculada pelo analisador de HTML:
		// em camelCase ela chega MINÚSCULA e o Datastar liga um sinal NOVO com
		// esse outro nome, enquanto o servidor continua lendo o declarado. O `_`
		// atravessa o parser intacto. Sinal que só aparece em VALOR de atributo
		// (`data-show`, `data-text`) preserva a caixa e não corre esse risco.
		<select
			id="rest-quality"
			data-bind:rest_quality
			class="mt-1 w-full rounded-sm border border-input bg-background px-2 py-1.5 text-sm outline-none"
		>
			<option value="ruim">Ruim (½ nível)</option>
			<option value="normal">Normal (nível)</option>
			<option value="confortavel">Confortável (2×)</option>
			<option value="luxuosa">Luxuosa (3×)</option>
		</select>
		<div class="mt-4 flex justify-end gap-2">
			// `formmethod=dialog` num botão SEM formulário não fecha nada; o
			// fechar é explícito, e é o mesmo `close()` que o Descansar usa.
			<button
				type="button"
				data-on:click="document.getElementById('day-rest').close()"
				class="inline-flex min-h-11 items-center rounded-sm border border-grimorio-iron px-3 text-sm outline-none transition-colors hover:bg-accent"
			>Cancelar</button>
			// Fecha ANTES de postar: a recusa do servidor chega no
			// `$command_error`, que é do RODAPÉ — deixar o diálogo aberto por
			// cima dela esconderia a única frase que explica o que houve.
			<button
				type="button"
				data-on:click={ "document.getElementById('day-rest').close(); " + tableCommand(v, "POST", "descanso/dia") }
				class="inline-flex min-h-11 items-center rounded-sm bg-primary px-3 text-sm font-semibold text-primary-foreground outline-none transition-opacity hover:opacity-90"
			>Descansar</button>
		</div>
	</dialog>
}

// turnStep é o voltar. Ele existe porque errar o avanço é o engano mais
// comum da mesa, e sem ele o conserto é remontar a ordem inteira.
//
// O `route` chega INTEIRO, e NÃO como sufixo de um prefixo montado aqui: com a
// rota partida em duas metades, nenhuma delas é um caminho que se possa
// procurar, e uma varredura que renomeie rotas passa por cima desta. O botão
// fica postando num endereço que não existe, e o Datastar descarta o remendo de
// resposta não-2xx — o clique morre sem console, sem frase e sem nada.
templ turnStep(v View, route, label, glyph string, enabled bool) {
	<button
		type="button"
		aria-label={ label }
		if enabled {
			data-on:click={ tableCommand(v, "POST", route) }
			class="flex size-11 items-center justify-center rounded-sm border border-grimorio-iron text-sm outline-none transition-colors hover:bg-accent"
		} else {
			disabled
			class="flex size-11 cursor-not-allowed items-center justify-center rounded-sm border border-grimorio-iron text-sm text-muted-foreground opacity-60"
		}
	>{ glyph }</button>
}

// Abrir e encerrar a cena NÃO são um interruptor, e por isso são dois nós e não
// um com `if` dentro.
//
// Encerrar a cena tira a fila da mesa e é irreversível pelo mesmo clique — a
// vaga de registrar só existe DENTRO da cena. Um interruptor convidaria ao
// clique de volta que não existe; dois verbos dizem o que cada um faz.
//
// São dois nós também porque vivem em lugares diferentes: o INICIAR fica na
// fileira em qualquer altura de palco, e o ENCERRAR desce para a gaveta quando o
// palco é baixo. Continua sendo uma vaga só — nenhum deles aparece com o outro.
templ endSceneButton(v View) {
	<button
		type="button"
		data-on:click={ tableCommand(v, "POST", "cena/encerrar") }
		class="inline-flex min-h-11 items-center rounded-sm border border-grimorio-iron px-3 text-sm text-muted-foreground outline-none transition-colors hover:border-destructive hover:text-destructive-ink"
	>Encerrar cena</button>
}

// INICIAR CENA abre uma SEGUNDA CAMADA em vez de agir, pela mesma razão do
// duplicar peça: são TRÊS tipos (p252), e a diferença entre eles — se o tempo
// corre em rodadas — não cabe num rótulo só. Um botão que abrisse a cena de
// ação direto seria o app de antes com três nomes.
//
// `<details>` e não um popover de mão: abrir, fechar, o teclado, o foco e o
// Escape já vêm com o elemento. É a mesma escolha que a gaveta do rodapé
// registra logo acima.
templ startScene(v View) {
	<details class="relative">
		<summary
			aria-label="Iniciar uma cena"
			class="inline-flex min-h-11 cursor-pointer list-none items-center rounded-sm border border-grimorio-gold px-3 text-sm text-grimorio-gold outline-none transition-colors hover:bg-accent"
		>Iniciar cena</summary>
		// ANCORADO À DIREITA, como a gaveta do rodapé: a 390px o botão nasce a
		// 200px da borda, e uma camada de 16rem presa à ESQUERDA dele termina em
		// 438 — quarenta e oito pixels fora da tela, alcançáveis por ninguém. O
		// guarda do painel de verbos pegou isso na primeira corrida.
		<div class="absolute bottom-full right-0 z-20 mb-2 flex w-64 flex-col gap-1 rounded-sm border border-grimorio-iron bg-grimorio-panel p-2 shadow-lg">
			// O AVISO é UM, e é da camada e não de cada verbo: repetido nos três
			// ele ocupava um terço do painel dizendo a mesma frase. Ele existe
			// porque encerrar devolve a rodada e a vez ao começo, e um clique de
			// inércia no meio de um combate custaria a contagem.
			if v.Cena != nil {
				<p class="px-2 pb-1 text-2xs text-destructive-ink">
					{ "Interrompe a cena " + fmt.Sprint(v.Cena.Numero) + " (" + v.Cena.Nome + ")" }
				</p>
			}
			@startSceneVerb(v, live.SceneAction, "combate, perseguição · o tempo corre em rodadas")
			@startSceneVerb(v, live.SceneExploration, "atravessar o pântano, vasculhar a cripta")
			@startSceneVerb(v, live.SceneRoleplay, "a discussão noite adentro na corte")
		</div>
	</details>
}

// startSceneVerb é um dos três. A FRASE do livro vem junto do nome porque
// "exploração" e "interpretação" não dizem, sozinhas, o que muda — e o que muda
// é se a mesa vai contar rodadas.
templ startSceneVerb(v View, tipo live.SceneKind, frase string) {
	// O NOME ACESSÍVEL é o que o botão FAZ, e não o que ele mostra. Sem ele o
	// nome vira o conteúdo inteiro — "Ação combate, perseguição · o tempo corre
	// em rodadas" —, e aí "Exploração" e "Interpretação" também CONTÊM "ação":
	// procurar o verbo pelo nome acha os três.
	<button
		type="button"
		aria-label={ "Iniciar uma cena de " + tipo.Name() }
		data-on:click={ tableCommand(v, "POST", "cena/iniciar/"+string(tipo)) }
		class="flex min-h-11 flex-col items-start rounded-sm px-2 py-1 text-left text-sm outline-none transition-colors hover:bg-accent"
	>
		<span class="font-semibold">{ tipo.Name() }</span>
		<span class="text-2xs text-muted-foreground">{ frase }</span>
	</button>
}

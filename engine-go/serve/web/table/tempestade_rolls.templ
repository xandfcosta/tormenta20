package table

import (
	"strconv"

	"t20engine/serve/web/ds"
)

// informedRoll é a faixa de uma rolagem que a mesa só informa, nas duas sessões (ver `informed_roll_view.go`):
// a cabeça com quem rolou e o quê, um total por linha com a conta ao lado, as frases do que o mestre aplica e,
// só no teste de quem rolou, o "Rolar de novo" (p226). Sem os verbos do ataque: ela não muda nada. Sem
// rolagem, o NÓ VAZIO fica, pela razão do ataque: o stream remenda POR ID.
templ informedRoll(kind informedRollKind, band *rollBand) {
	if band != nil {
		<section id={ informedRollRegions[kind].id } class="ds-strike" data-test role="status" aria-label={ informedRollRegions[kind].label }>
			<div class="ds-strike-head">
				if band.Badge != "" {
					@ds.Badge(band.Badge, true)
				}
				if band.Tone != "" {
					<span class="ds-seal" data-tone={ band.Tone }>{ band.Seal }</span>
				}
				<span class="ds-row-meta">{ band.Who }<b>{ band.What }</b></span>
			</div>
			// `aria-live` na CONTA, pela razão do ataque: o selo já é lido no
			// nome acessível, e quem ouve precisa do resultado.
			for _, line := range band.Lines {
				<div class="ds-strike-roll" aria-live="polite">
					<b class="ds-strike-verdict">{ strconv.Itoa(line.Total) }</b>
					<span class="ds-strike-tally">{ line.Tally }</span>
				</div>
				if line.Note != "" {
					<p class="ds-help">{ line.Note }</p>
				}
			}
			for _, help := range band.Help {
				<p class="ds-help">{ help }</p>
			}
			@damageTakenBlock(band.Taken)
			if len(band.Offers) > 0 {
				<div class="ds-strike-foot" data-fill>
					if band.HandReroll {
						<label class="ds-strike-hand">
							<span class="ds-row-meta">Eu rolei</span>
							<input class="ds-input" type="number" min="1" max="20" inputmode="numeric" data-bind:reroll_d20 aria-label="O d20 que você rolou de novo na mesa"/>
						</label>
					}
					for _, offer := range band.Offers {
						@ds.Button(ds.ButtonSecondary, templ.Attributes{"type": "button", "data-on:click": offerCommand(offer)}) {
							{ offer.Label }
						}
					}
				</div>
			}
		</section>
	} else {
		<section id={ informedRollRegions[kind].id } hidden></section>
	}
}

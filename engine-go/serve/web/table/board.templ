package table

import (
	"fmt"

	"t20engine/domain/board"
	"t20engine/serve/web/ui"
)

// O TABULEIRO desenhado — a fatia que se OLHA.
//
// UM NÓ POR CAMADA, nunca um por quadrado: uma moldura de 20×14 são 280
// quadrados, e desenhá-los daria 280 nós para pintar linhas que um
// `repeating-linear-gradient` pinta em zero. O que vira nó é só o que EXISTE —
// as peças, os marcadores e o terreno difícil.
//
// DOM e não canvas: cada peça é um `<button>` com nome acessível que diz QUEM e
// ONDE. Num canvas isso viraria um DOM espelho invisível, escrito duas vezes.

templ boardTable(v BoardView) {
	if !v.Aberto {
		// As duas frases são DIFERENTES de propósito: o jogador não tem o que fazer
		// além de esperar, e o mestre tem — dizer ao mestre "o mestre abre quando a
		// cena tiver lugar" é a tela mandando ele fazer o que ela não deixa.
		<div class="flex flex-col items-center gap-3 border border-dashed border-grimorio-iron p-6 text-center">
			<span aria-hidden="true" class="text-2xl text-muted-foreground">▦</span>
			if v.Mestre {
				<p class="text-sm text-muted-foreground">Nenhum tabuleiro aberto. Vale para combate e para cena de interpretação.</p>
				<button
					type="button"
					data-on:click="document.getElementById('open-board').showModal()"
					class="inline-flex min-h-11 items-center rounded-sm bg-primary px-3 text-sm font-semibold text-primary-foreground outline-none transition-opacity hover:opacity-90"
				>Abrir tabuleiro</button>
				// Só aparece com lugares guardados: um botão que abre uma lista
				// vazia ensina que o acervo não serve para nada.
				if len(v.Acervo) > 0 {
					@botaoDoAcervo(v)
				}
			} else {
				<p class="text-sm text-muted-foreground">O mestre ainda não abriu um tabuleiro.</p>
			}
		</div>
		if v.Mestre {
			@openBoardButton(v)
		}
	} else if v.Cortina {
		// A CORTINA ocupa o lugar da cena e NÃO desenha grade, de propósito: a cena
		// vazia mostra grade, e as duas telas têm de se parecer o menos possível. O
		// nome do lugar não aparece porque o servidor já o apagou.
		<section aria-label="Cortina" class="flex flex-col items-center justify-center gap-2 border border-dashed border-grimorio-gold/40 p-6 text-center">
			@ui.Icon("Theater", "size-7 text-grimorio-gold/70")
			<p class="text-sm text-muted-foreground">O mestre está montando a cena.</p>
		</section>
	} else {
		<section
			aria-label={ "Tabuleiro · " + v.Lugar }
			class="flex min-h-0 flex-1 flex-col space-y-1.5"
		>
			if v.Mestre {
				// ENCERRAR e ABRIR OUTRO são gestos da SESSÃO e ficam fora do rascunho:
				// não há mesa para encerrar nem aba para acrescentar quando o que está
				// na tela é uma cena do acervo. O diálogo de editar peça FICA — ele é
				// sobre a peça, e o rascunho é feito de peças.
				if !v.Rascunho {
					@endBoardButton(v)
				}
				// UM diálogo de editar para TODAS as peças, semeado pelo gesto que o
				// abre. Ele mora aqui, fora do plano, porque um `<dialog>` dentro do
				// mapa herdaria o `--quadrado` e o empilhamento das camadas.
				@tokenEdit(v)
				if !v.Rascunho {
					@openBoardButton(v)
				}
			}
			// A CENA é a JANELA sobre um plano infinito, e tudo o que não é o mapa
			// flutua POR CIMA dela: o trilho, os avisos e os ajudantes de ferramenta.
			//
			// Sobrepor e não empilhar: um aviso que EMPURRA o mapa muda o tamanho da
			// cena, e a casa debaixo do dedo troca de lugar no meio do gesto.
			//
			// E ela NÃO ROLA — rolagem nativa precisaria de uma caixa com fim. Quem
			// anda é a janela, num par de sinais, e o plano inteiro é deslocado por um
			// `transform` só, em vez de recalcular a posição de cada peça.
			//
			// A GRADE e o AMBIENTE são fundo da CENA e não do plano: dentro do plano
			// deslocado eles cobririam só o pedaço de onde saíram, e arrastar revelaria
			// o vazio.
			//
			// FERRAMENTA LIGADA torna a peça e o losango INERTES ao dedo. Sem isso a
			// peça continua por CIMA das camadas de clique e o pointerdown sobre ela
			// vira arrasto: com a régua ligada, medir a distância até o ogro MOVERIA o
			// ogro.
			<div
				id={ sceneId }
				data-attr:style={ sceneStyle }
				data-class="{'board-with-tool': $tool !== ''}"
				data-on:wheel={ wheelMovesViewport }
				data-on:keydown__window={ zoomPeloTeclado }
				data-on:focusin={ viewportFollowsFocus }
				class={ "board-scene grimorio-frame ground-" + v.Chao }
			>
				<div aria-hidden="true" class="board-ambient"></div>
				<div aria-hidden="true" class="board-grid"></div>
				// O PLANO É DOIS, e a divisa é onde as camadas de clique entram. Um
				// `transform` cria CONTEXTO DE EMPILHAMENTO: com o plano deslocado, o
				// `z-index: 2` do marcador deixou de valer contra as camadas — ele passa
				// a disputar como FILHO de um plano que compete inteiro com elas, e as
				// camadas vêm depois no DOM.
				//
				// EMBAIXO das camadas fica o que é CHÃO: terreno, rastro, alcance,
				// gabarito — coisas que se olha e não se clica. Em CIMA fica o que
				// RESPONDE ao dedo: peças, marcadores, régua, destino.
				<div class="board-plane board-plane-ground">
					// O TERRENO vem ANTES das peças para ficar por baixo delas: uma peça
					// em cima de terreno difícil continua sendo a peça que se clica.
					//
					// Um laço só para as quatro espécies, com a classe saindo do nome
					// dela: quatro laços dariam quatro lugares para esquecer o quinto.
					for _, q := range v.Terreno {
						// O ÍCONE mora DENTRO da casa e o CSS o põe no canto da espécie.
						// Ver `terrain_drawing.go`.
						<div aria-hidden="true" class={ squareClass(q.Especie) } style={ posicaoNoPlano(q.X, q.Y, 1) }>
							@ui.Icon(drawing(board.TerrainKind(q.Especie)).Icone, "terrain-mark")
						</div>
					}
					// A TRILHA é rastro: vem antes das peças para que a peça que anda por
					// cima dela continue sendo a peça que se clica.
					if v.Movimento != nil {
						for _, q := range v.Movimento.Trilha {
							<div aria-hidden="true" class="board-trail" style={ posicaoNoPlano(q.X, q.Y, 1) }></div>
						}
						// Sem as PARADAS marcadas, o caminho é uma faixa contínua e não há
						// como ver quantas pernas o "Desfazer parada" vai encontrar.
						for _, q := range v.Movimento.Paradas {
							<div aria-hidden="true" class="board-stop" style={ posicaoNoPlano(q.X, q.Y, 1) }></div>
						}
					}
					// O ALCANCE é PINTURA e não alvo de clique: quem tem orçamento é o
					// jogador NA VEZ dele — o mestre move sem teto (-1), e fora de combate
					// todo mundo também. Se a casa alcançável fosse o único alvo, o mestre
					// não teria onde clicar.
					//
					// O SEGUNDO MOVIMENTO vem ANTES do primeiro no HTML: as duas faixas
					// chegam disjuntas do motor, e ter o ouro por cima garante que uma casa
					// de fronteira nunca apareça azul por acidente de empate.
					for _, q := range v.AlcanceSegundo {
						<div aria-hidden="true" class="board-range board-range-second" style={ posicaoNoPlano(q.X, q.Y, 1) }></div>
					}
					for _, q := range v.Alcance {
						<div aria-hidden="true" class="board-range" style={ posicaoNoPlano(q.X, q.Y, 1) }></div>
					}
					// O LAÇO do retângulo mora no plano do CHÃO: o que ele delimita é área,
					// e área fica por baixo de quem está em pé nela.
					//
					// UM nó posicionado por expressão, e não um por casa: desenhar mil divs
					// para mostrar a INTENÇÃO de pintar mil casas seria pagar o preço do
					// resultado antes de a pessoa ter pedido.
					// DOIS NÓS e não um, e isto CONGELA O NAVEGADOR se voltar a ser um
					// só: com `data-show` e `data-attr:style` no MESMO elemento, o
					// `data-show` escreve `el.style.display` e o `data-attr:style`
					// reescreve o atributo `style` inteiro, apagando o `display` que o
					// outro acabou de pôr — o que faz o outro pôr de novo. O renderizador
					// trava em laço, e o sintoma não é um erro: é a aba que para de
					// responder a tudo, inclusive a navegar para fora.
					//
					// Então quem ESCONDE é o de fora e quem POSICIONA é o de dentro.
					<div aria-hidden="true" data-show={ openIsLasso() }>
						<div data-attr:style={ lassoStyle } class="board-lasso"></div>
					</div>
				</div>
				// O GABARITO vem ACIMA do terreno e ABAIXO das peças: quem está dentro
				// precisa aparecer POR CIMA da área, senão a bola de fogo esconde
				// justamente quem ela pega. Quem o põe entre os dois é o `z-index`,
				// porque ele é IRMÃO dos planos e não filho — ver o `viewportDrawing`.
				@drawnTemplate(v)
				@clickLayers(v)
				// O PLANO DE CIMA: o que RESPONDE ao dedo. Ele repete o
				// `transform` da janela — os dois planos andam juntos, e o preço
				// de dois `translate` é o mesmo de um, porque quem compõe é a GPU.
				<div class="board-plane board-plane-tokens">
					for _, m := range v.Marcadores {
						@planMarker(v, m)
					}
					// O FANTASMA vem ANTES das peças: uma peça grande parada ao lado da
					// origem invade a casa dele, e quem tem de ficar por cima é a peça —
					// ela se clica, ele não.
					if v.Fantasma != nil {
						@originGhost(*v.Fantasma)
					}
					for _, p := range v.Pecas {
						@planToken(v, p)
						// O MENU vem logo depois da peça e é irmão dela no plano,
						// como o do marcador: ele é posicionado pela mesma casa, e
						// pendurá-lo DENTRO do botão faria um botão dentro de outro.
						if v.Mestre {
							@tokenMenu(v, p)
						}
					}
				</div>
				// A RÉGUA vem por CIMA de tudo: ela é uma linha fina entre dois
				// pontos, e uma peça em cima dela apagaria metade da medida.
				@drawnRuler(v)
				// A SETA DO MOVIMENTO sobe pela mesma razão: ela liga o fantasma à peça,
				// e as duas pontas dela são discos que a apagariam por baixo.
				@moveArrow(v)
				// A SETA VIVA do arrasto sobe junto e pela mesma razão.
				@movePreview(v)
				// O TRILHO flutua sobre o mapa, colado à esquerda e centrado na
				// altura: ele é o que se troca com mais frequência na cena, e a
				// mão volta sempre ao mesmo lugar.
				@toolsRail(v)
				// O NOME e os VERBOS são DOIS painéis flutuantes nos cantos, e não uma
				// faixa de ponta a ponta: o meio do topo é onde o mapa costuma ter
				// conteúdo, e a faixa o cobriria sem precisar.
				@sceneName(v)
				@sceneVerbs(v)
				// OS AVISOS ficam no ALTO e os AJUDANTES no PÉ, e a divisa é de
				// natureza: aviso é ESTADO da cena que se esquece (a cortina fechada,
				// a lente acesa); ajudante é o que a ferramenta ativa precisa dizer
				// AGORA (a medida, o gabarito, o custo do movimento).
				@boardNotices(v)
				@toolHelpers(v)
			</div>
		</section>
	}
}

// O NOME DA CENA, flutuando no canto superior esquerdo — e a BARRA DE ABAS
// quando há mais de um tabuleiro aberto.
//
// Ele é o `<h2>` da região e não um rótulo solto: a `<section>` já se anuncia
// como "Tabuleiro · Ponte", e quem navega por cabeçalho precisa achar a cena
// onde ela está.
//
// A BARRA nasce AQUI e não no trilho de ferramentas (decisão do dono): a aba É
// o nome da cena, e é aqui que esse nome já se lê; o trilho responde outra
// pergunta — "o que o dedo faz". Um trilho que misturasse as duas obrigaria a
// ler ícone por ícone para saber qual é ferramenta e qual é lugar.
//
// Com UM tabuleiro aberto a `v.Abas` chega vazia (ver `tableTabs`) e a tira não
// existe: barra de uma aba só é enfeite ocupando mapa.
templ sceneName(v BoardView) {
	if len(v.Abas) == 0 {
		<h2 class="board-scene-name">{ v.Lugar }</h2>
	} else {
		<div class="board-scene-name" role="group" aria-label="Tabuleiros abertos">
			for _, aba := range v.Abas {
				@boardTabLink(aba)
			}
		</div>
	}
}

// boardTabLink é uma ficha da barra.
//
// A ATIVA é o `<h2>` e as outras são botões: a `<section>` do tabuleiro nomeia
// a cena que está na tela, não as três que poderiam estar. Um `<h2>` por aba
// faria o leitor de tela anunciar três títulos para uma região só, e quem
// navega por cabeçalho pousaria numa cena que não está sendo desenhada.
//
// A aba SOB CORTINA leva o ícone do teatro, e para o jogador ele é a única
// informação que ela carrega: o nome não atravessa a cortina (ver
// `BoardForRole`), então a ficha dele diz "Cena 2" e mais nada.
templ boardTabLink(aba boardTab) {
	if aba.Ativa {
		<h2 class="board-tab board-tab-active" aria-current="true">
			if aba.Cortina {
				@ui.Icon("Theater", "size-3.5 shrink-0")
			}
			{ aba.Nome }
		</h2>
		if aba.MostraAMesa != "" {
			@showIsTable(aba)
		}
	} else {
		<button
			type="button"
			aria-label={ "Ver o tabuleiro " + aba.Nome }
			title={ "Ver o tabuleiro " + aba.Nome }
			data-on:click={ aba.Comando }
			class="board-tab"
		>
			if aba.Cortina {
				@ui.Icon("Theater", "size-3.5 shrink-0")
			}
			{ aba.Nome }
		</button>
	}
}

// MOSTRAR ESTA À MESA: o "parem tudo e olhem isto".
//
// Ele fica COLADO na aba ativa e não no painel dos verbos porque a frase que
// ele completa é a ficha ao lado: o mestre lê "Cripta" e clica em "mostrar esta
// à mesa". No painel dos verbos ele seria um ícone sem sujeito — "mostrar
// QUAL?".
//
// É um EMPURRÃO e não uma trava: a mesa salta para cá e volta a escolher em
// seguida. Por isso ele não tem estado ligado/desligado e não vira
// `aria-pressed` — um botão que se apaga sozinho seria um modo mentindo.
templ showIsTable(aba boardTab) {
	<button
		type="button"
		aria-label={ "Mostrar " + aba.Nome + " à mesa" }
		title="Mostrar esta cena à mesa: todo mundo salta para ela"
		data-on:click={ aba.MostraAMesa }
		class="board-tab-pull"
	>
		@ui.Icon("Users2", "size-3.5")
	</button>
}

// A FAIXA DA ÁREA de transferência: o que o CTRL+V vai colar.
//
// Ela existe porque a decisão do modo foi tomada no COPIAR e não no colar, e
// uma decisão guardada que não aparece na tela é estado escondido — a pessoa
// colaria "sangrando junto" pensando em "com PV próprio", e o sintoma (dano num
// zumbi aparecendo no outro) chegaria três turnos depois.
//
// O NÓ EXISTE SEMPRE e quem o esconde é o `data-show`: aqui mora o `keydown` do
// CTRL+V, e um nó que só nasce com a área cheia levaria o atalho junto.
//
// O `keydown__window` mora AQUI e não no trilho de ferramentas porque aquele nó
// já tem um: atributo repetido não existe no templ, e o segundo some sem erro.
templ clipboardStrip(v BoardView) {
	<div
		data-show="$area_token !== ''"
		data-on:keydown__window={ pasteInTheMiddleOfTheView(v) }
		class="board-area"
	>
		// `aria-live` porque copiar não navega e não move o foco: sem ele, quem
		// não vê a tela clica em "copiar para colar" e nada é anunciado.
		<span aria-live="polite" class="board-area-text">
			<span aria-hidden="true">@ui.Icon("Copy", "size-4")</span>
			<span data-text="$area_label + ' · ' + $area_phrase"></span>
		</span>
		<button
			type="button"
			aria-label="Esvaziar a área de transferência"
			title="Esvaziar a área"
			data-on:click={ emptiesTheClipboard }
			class="board-area-clear"
		>
			@ui.Icon("X", "size-4")
		</button>
	</div>
}

// OS VERBOS da cena, flutuando no canto superior direito.
//
// O ZOOM vem primeiro e é de TODO MUNDO: cada pessoa enquadra a própria
// janela, e o jogador que não enxerga a peça no telefone não depende do mestre
// para aproximar. Os verbos do mestre vêm depois, no mesmo painel — separá-los
// em dois cantos faria o jogador procurar num lugar que só existe para ele.
templ sceneVerbs(v BoardView) {
	<div class="board-scene-verbs">
		@planFraming(v)
		// O ENQUADRAMENTO é o único verbo que atravessa para o rascunho: ele é
		// sobre a JANELA, que é de quem olha. Os outros são da SESSÃO, e cada um
		// deles precisa de uma mesa do outro lado.
		if v.Mestre && !v.Rascunho {
			@clipboardStrip(v)
			// O acervo alcançável COM cena na mesa: trocar da taverna para a cripta
			// sem encerrar primeiro.
			@curtainButton(v)
			// A LENTE é vizinha da CORTINA: são as duas perguntas sobre o que a mesa
			// vê. Uma esconde a cena, a outra confere o que sobrou dela.
			@lensButton(v)
			@botaoDePorNoMapa(v)
			// ABRIR OUTRA CENA sem fechar esta. VIZINHO DO ACERVO e não do zoom: as
			// duas são "traga outra cena", uma do zero e a outra do que já foi jogado
			// — e ao lado do enquadramento o `Plus` encostava no + de aproximar, dois
			// sinais de mais lado a lado mexendo em coisas diferentes.
			// O ícone é a GRADE: o desenho do tabuleiro em toda esta cena.
			<button
				type="button"
				aria-label="Abrir outro tabuleiro"
				title="Abrir outro tabuleiro, sem fechar este"
				data-on:click="document.getElementById('open-board').showModal()"
				class="flex size-8 items-center justify-center rounded-sm border border-transparent text-sm text-muted-foreground outline-none transition-colors hover:border-grimorio-gold hover:text-grimorio-gold"
			>
				@ui.Icon("LayoutGrid", "size-4")
			</button>
			if len(v.Acervo) > 0 {
				@botaoDoAcervo(v)
			}
			// ÍCONE e não texto: o painel flutua sobre o mapa e cada palavra nele
			// é mapa que a pessoa deixa de ver. O nome acessível é o texto
			// inteiro — quem usa leitor de tela não perde a palavra que o desenho
			// economizou.
			<button
				type="button"
				aria-label="Encerrar o tabuleiro"
				title="Encerrar o tabuleiro"
				data-on:click="document.getElementById('close-board').showModal()"
				class="flex size-8 items-center justify-center rounded-sm border border-transparent text-sm text-muted-foreground outline-none transition-colors hover:border-destructive hover:text-destructive-ink"
			>
				@ui.Icon("X", "size-4")
			</button>
		}
	</div>
}

// OS AVISOS da cena, flutuando no alto do tabuleiro.
//
// Os dois existem pela mesma razão — um modo que se esquece é pior que nenhum
// —, e o esquecimento de cada um é caro de um jeito diferente: com a cortina
// fechada o mestre NARRA a taverna para uma mesa que está olhando um aviso; com
// a lente acesa ele olha a própria cena e não vê a peça que ele mesmo escondeu.
//
// `role="status"` porque são estado da cena, e não ações. Cada um carrega a
// própria saída: quem percebe o modo tem de poder desfazê-lo de onde percebeu.
templ boardNotices(v BoardView) {
	if v.AvisoDaCortina || v.Lente || v.Puxado != nil {
		<div class="board-notices">
			if v.Puxado != nil {
				// A TIRA DO PUXÃO é a única aqui que fala de uma mudança que quem lê
				// NÃO fez. Por isso ela nomeia a cena: "o mestre trouxe você" sobre um
				// mapa que trocou sozinho deixaria a pessoa procurando o que aconteceu.
				<p role="status" class="board-notice">
					@ui.Icon("Users2", "size-4 shrink-0")
					{ "O mestre trouxe a mesa para " + v.Puxado.Cena + "." }
					if v.Puxado.Volta != "" {
						<button
							type="button"
							data-on:click={ v.Puxado.ComandoDeVolta }
							class="board-notice-exit"
						>{ "Voltar para " + v.Puxado.Volta }</button>
					} else {
						// Quem JÁ estava nesta aba não tem para onde voltar: o gesto que
						// sobra é dizer "vi", que é escolher esta aba — o mesmo comando que
						// solta qualquer um do puxão. Sem ele a tira seria um modo sem gesto
						// que a desfaça, porque a aba ativa é um `<h2>` e não se clica.
						<button
							type="button"
							data-on:click={ v.Puxado.ComandoDeVolta }
							class="board-notice-exit"
						>Continuar aqui</button>
					}
				</p>
			}
			if v.AvisoDaCortina {
				<p role="status" class="board-notice">
					@ui.Icon("Theater", "size-4 shrink-0")
					A cortina está fechada: a mesa não vê esta cena.
					<button
						type="button"
						data-on:click={ curtainCommand(v, "abrir") }
						class="board-notice-exit"
					>Abrir a cortina</button>
				</p>
			}
			if v.Lente {
				<p role="status" class="board-notice">
					@ui.Icon("Eye", "size-4 shrink-0")
					{ lensPhrase(v.PecasEscondidas) }
					<button
						type="button"
						data-on:click={ lensCommand(v) }
						class="board-notice-exit"
					>Voltar à vista do mestre</button>
				</p>
			}
		</div>
	}
}

// OS AJUDANTES da ferramenta ativa, flutuando no pé do tabuleiro. Flutuam e não
// empurram: barra que aparece muda o tamanho da cena, e a casa debaixo do dedo
// troca de lugar no meio do gesto.
templ toolHelpers(v BoardView) {
	<div class="board-helpers">
		if v.Mestre {
			@partyBar(v)
		}
		@rulerReadingBox()
		@previewReading()
		@templateBar(v)
		if v.Movimento != nil && v.Movimento.Meu {
			@moveProposed(v)
		}
	</div>
}

// drawnTemplate é a área do livro (p225) sobre a cena, em UM nó.
//
// Um `<path>` e não um `<div>` por casa, e a razão não é o número de nós: um
// desenho feito de HTML teria de ser remendado DENTRO da região do mapa, e o
// quadro seguinte do stream — que não sabe do gabarito de ninguém — o apagaria
// sem erro nenhum. O `d` cabe num SINAL, e sinal sobrevive ao remendo. É o
// mesmo argumento da caixa de notas, que também não é região.
//
// O SVG fala em QUADRADOS, não em pixels: um `scale($square)` converte a
// unidade inteira, então mudar o zoom muda a escala do desenho sem uma linha de
// JavaScript. Sem moldura não há caixa para recortar, e o desenho ESCAPA do
// elemento (`overflow: visible`) como o resto do plano infinito.
templ drawnTemplate(v BoardView) {
	<svg
		aria-hidden="true"
		data-show={ "$template_path !== '' && $tool === '" + FerramentaDoGabarito + "'" }
		class="board-measure board-measure-back"
	>
		<g data-attr:transform={ viewportDrawing }>
			<path data-attr:d="$template_path" class="board-template"></path>
			// AS DUAS PONTAS. A ORIGEM é um pingo cheio e fica enquanto houver
			// gabarito: é ela que diz de ONDE a área sai, e numa esfera o desenho
			// sozinho não conta isso — o círculo é simétrico, e o centro dele é uma
			// casa que se clicou.
			//
			// A MIRA é um anel vazado e só existe enquanto a forma APONTA e a pessoa
			// está mirando: um anel parado depois de posto seria uma ponta que ninguém
			// pode mais mover.
			// O PINGO pousa onde a forma NASCE: no CANTO para a esfera, no centro da
			// casa para as outras (p225). Sempre no centro, ele mostraria a origem meio
			// quadrado longe de onde a bola caiu.
			<circle
				data-show={ "$template_phase > 0" }
				data-attr:cx="$template_x + ($template_at_intersection ? 0 : 0.5)"
				data-attr:cy="$template_y + ($template_at_intersection ? 0 : 0.5)"
				r="0.13"
				class="board-ruler-tip"
			></circle>
			<circle
				data-show="$template_phase === 1 && $template_aims"
				data-attr:cx="$template_aim_x + 0.5"
				data-attr:cy="$template_aim_y + 0.5"
				r="0.22"
				vector-effect="non-scaling-stroke"
				class="board-ruler-target"
			></circle>
		</g>
	</svg>
}

// drawnRuler é a linha entre as duas pontas.
//
// RETA e contínua, ao contrário do caminho proposto, que é tracejado e dobra
// pelos quadrados: são coisas diferentes — um é por onde a peça VAI, a outra é a
// distância até onde se quer acertar.
//
// A ponta de origem aparece com um clique só, e é ela que diz que a régua está
// esperando o segundo: sem ela, o primeiro clique não devolve nada e a mesa
// conclui que a ferramenta não funciona.
templ drawnRuler(v BoardView) {
	<svg
		aria-hidden="true"
		data-show={ "$ruler_phase > 0 && $tool === '" + FerramentaDaRegua + "'" }
		class="board-measure board-measure-front"
	>
		<g data-attr:transform={ viewportDrawing }>
			// A POLILINHA inteira num `<path>` só: o caminho sai dos sinais, e o
			// número de pernas não muda o número de nós.
			<path
				data-attr:d={ rulerPath }
				vector-effect="non-scaling-stroke"
				class="board-ruler-arrow"
			></path>
			// OS PINGOS de cada parada, e a RESERVA existe porque o Datastar não
			// tem laço: os nós são fixos e cada um se mostra conforme a lista.
			for _, i := range stopsReserve() {
				<circle
					data-show={ existsDot(i) }
					data-attr:cx={ rulerStop(i, 0) }
					data-attr:cy={ rulerStop(i, 1) }
					r="0.13"
					class="board-ruler-tip"
				></circle>
			}
			// O ALVO na ponta VIVA, que é onde o dedo está. Ele some quando a
			// régua congela: ali a ponta virou parada e já tem pingo.
			<circle
				data-show={ "$ruler_phase === " + number(reguaMedindo) }
				data-attr:cx="$ruler_aim_x + 0.5"
				data-attr:cy="$ruler_aim_y + 0.5"
				r="0.22"
				vector-effect="non-scaling-stroke"
				class="board-ruler-target"
			></circle>
		</g>
		// OS RÓTULOS DE CADA PERNA, FORA do `<g>` que escala: dentro dele o texto
		// seria multiplicado pelo `--quadrado` e viraria uma letra de 40px no zoom
		// máximo. Aqui ele fica do tamanho que se lê, e quem o posiciona é o mesmo
		// par de números passado pelo `scale` à mão.
		for _, i := range stopsReserve() {
			<g data-show={ existsLabel(i) }>
				<text
					data-attr:x={ legMid(i, 0) + " * $square - $viewport_x" }
					data-attr:y={ legMid(i, 1) + " * $square - $viewport_y" }
					data-text={ legLabel(i) }
					text-anchor="middle"
					dominant-baseline="middle"
					class="board-ruler-label"
				></text>
			</g>
		}
	</svg>
}

// rulerReadingBox é a faixa que diz a distância.
//
// Quadrados E metros — quadrado é a unidade da regra (p236), metro é a unidade da
// conversa — e, principalmente, a FAIXA de alcance do livro (p224). É a faixa que
// responde a pergunta real: "10,5m" obriga o jogador a lembrar que curto são 9m,
// enquanto "alcance médio" já é a resposta.
//
// A frase inteira vem pronta do servidor num sinal. Montá-la aqui exigiria a
// conversão de metro e os limiares das faixas numa expressão da tela — a segunda
// cópia da regra, e a que ninguém testa.
templ rulerReadingBox() {
	<p
		role="status"
		data-show={ "$ruler_text !== '' && $tool === '" + FerramentaDaRegua + "'" }
		class="board-helper gap-2"
	>
		@ui.Icon("Ruler", "size-4 text-grimorio-gold")
		<span data-text="$ruler_text" class="font-mono tabular-nums text-grimorio-gold"></span>
		<button
			type="button"
			aria-label="Guardar a régua"
			data-on:click={ saveRuler }
			class="ml-auto flex size-8 items-center justify-center rounded-sm border border-transparent text-sm text-muted-foreground outline-none transition-colors hover:border-grimorio-iron"
		>
			@ui.Icon("X", "size-4")
		</button>
	</p>
}

// templateBar responde, sem discussão, a pergunta que trava o turno do
// conjurador: "se eu soltar aqui, quem pega?".
//
// Por isso a LISTA de quem está dentro é o que ela tem de maior — o desenho no
// mapa mostra ONDE, mas é o NOME que resolve a dúvida, e é o nome que a mesa fala
// em voz alta.
//
// O tamanho é dito em quadrados E em metros: quadrado é a unidade do gabarito
// (p236) e metro é a unidade em que a magia está escrita na ficha.
templ templateBar(v BoardView) {
	<div
		role="status"
		data-show={ "$tool === '" + FerramentaDoGabarito + "'" }
		class="board-helper gap-1.5"
	>
		for _, forma := range bookShapes {
			<button
				type="button"
				title={ shapeLabel(forma) + ": o " + shapeMeasure(forma) + " em quadrados (p225)" }
				data-attr:aria-pressed={ fmt.Sprintf("$template === %q ? 'true' : 'false'", string(forma)) }
				data-class={ fmt.Sprintf("{'brush-on': $template === %q}", string(forma)) }
				data-on:click={ pickShape(forma) }
				class="inline-flex min-h-11 items-center rounded-sm border border-grimorio-iron px-2.5 text-xs outline-none transition-colors hover:bg-accent"
			>{ shapeLabel(forma) }</button>
		}
		// O RÓTULO muda com a forma porque "tamanho" não responde a pergunta de
		// nenhuma das quatro: o conjurador está lendo "raio 6m" na ficha, e é esse
		// número que ele quer digitar. O `for` desenha os quatro e o `data-show`
		// escolhe — o rótulo tem de casar com o `id` do campo, e um `id` só com
		// quatro textos alternados deixaria três rótulos apontando para o nada.
		for _, forma := range bookShapes {
			<label
				for="template-size"
				data-show={ fmt.Sprintf("$template === %q", string(forma)) }
				class="text-xs text-muted-foreground"
			>{ shapeMeasure(forma) }</label>
		}
		<input
			id="template-size"
			type="number"
			min="1"
			max={ templateBiggest() }
			data-bind="template_size"
			data-on:input__debounce.200ms={ repatchTemplate(v) }
			class="h-11 w-20 rounded-sm border border-grimorio-iron bg-transparent px-2 text-sm tabular-nums outline-none"
		/>
		<span
			data-text={ metersSize() }
			class="font-mono text-xs tabular-nums text-muted-foreground"
		></span>
		<span data-text="$template_text" class="min-w-0 flex-1 truncate text-xs text-grimorio-gold"></span>
		<button
			type="button"
			aria-label="Guardar o gabarito"
			data-on:click={ saveTemplate }
			class="flex size-8 shrink-0 items-center justify-center rounded-sm border border-transparent text-sm text-muted-foreground outline-none transition-colors hover:border-grimorio-iron"
		>
			@ui.Icon("X", "size-4")
		</button>
	</div>
}

// moveProposed é a faixa que diz o CUSTO e oferece o par de decidir.
//
// O número vem antes dos botões porque ele é o que decide o clique: "5 de 6"
// responde a pergunta que a pessoa tem na mão, e um par de botões sem o custo ao
// lado obrigaria a contar quadrados na tela.
//
// Confirmar e cancelar NÃO são um interruptor, pelo mesmo motivo do encerrar
// cena: são dois verbos com consequências diferentes, e um só convidaria ao
// clique de volta que não existe.
templ moveProposed(v BoardView) {
	<div class="board-helper gap-2">
		// RASCUNHO é a palavra do lado do jogador, e ela vem primeiro porque é ela
		// que explica a ausência do Confirmar: sem nomear a natureza do traço, a
		// tela dele parece a do mestre com um botão faltando.
		if !v.Mestre {
			<span class="board-draft-seal">Rascunho</span>
		}
		<p aria-live="polite" class="text-muted-foreground">
			{ v.Movimento.Rotulo } ·
			if v.Movimento.Orcamento < 0 {
				// Fora de combate não há vez nem ação de movimento a gastar: o custo
				// continua sendo dito, porque ele informa, mas não há ação para nomear.
				<span class="font-mono tabular-nums text-foreground">{ fmt.Sprint(v.Movimento.Custo) }</span>
				{ " quadrados" }
			} else {
				<span class="font-mono tabular-nums text-foreground">
					{ fmt.Sprintf("%d de %d", v.Movimento.Custo, v.Movimento.Orcamento) }
				</span>
				{ " quadrados" }
				if saldo := moveBalance(v.Movimento); saldo != "" {
					{ " · " + saldo }
				}
			}
		</p>
		// A LEGENDA DAS CORES: AS TRÊS SEMPRE, com a da vez acesa. Mostrar só a
		// que vale ensinaria a cor do momento e esconderia que existe uma escala —
		// quem nunca passou do deslocamento não descobriria o azul, que é
		// justamente a informação que muda a decisão.
		//
		// Só em combate: fora dele não há ação de movimento a gastar, a seta sai de
		// uma cor só, e uma legenda de três cores sobre um desenho de uma seria
		// explicar o que não está na tela.
		if v.Movimento.Orcamento >= 0 {
			<ul aria-label="O que as cores do movimento querem dizer" class="board-bands">
				for _, faixa := range moveLegend(v.Movimento) {
					<li class={ "board-band", faixa.Classe, templ.KV("board-band-active", faixa.Ativa) }>
						{ faixa.Texto }
					</li>
				}
			</ul>
		}
		// SEM O NOME, ao contrário da frase embaixo do mapa: o cabeçalho deste
		// painel já diz de quem é o movimento, e repetir empurra a linha para
		// duas a 390px. A legenda acima continua sendo o PREÇO do caminho; esta
		// linha é o saldo do turno, e as duas não se contradizem.
		if v.Movimento.NoActionLeft {
			<p class="text-xs font-semibold text-destructive-ink">não sobrou ação neste turno para mover</p>
		}
		<span class="ml-auto flex items-center gap-2">
			// DESFAZER UMA vem antes de CANCELAR, e a ordem é a do arrependimento:
			// primeiro se corrige a última perna, e só depois se joga a rota inteira
			// fora. Some quando não há perna a desfazer — um botão que não faz nada
			// é pior que nenhum, e com uma perna só desfazer JÁ É cancelar, que está
			// ali do lado dizendo isso com a palavra certa.
			if v.Movimento.PodeDesfazer {
				<button
					type="button"
					data-on:click={ moveCommand(v, "desfazer-parada") }
					class="inline-flex min-h-11 items-center gap-1.5 rounded-sm border border-grimorio-iron px-3 text-sm text-muted-foreground outline-none transition-colors hover:bg-accent hover:text-foreground"
				>
					@ui.Icon("CornerUpLeft", "size-4")
					Desfazer parada
				</button>
			}
			<button
				type="button"
				data-on:click={ moveCommand(v, "cancelar") }
				class="inline-flex min-h-11 items-center rounded-sm border border-grimorio-iron px-3 text-sm text-muted-foreground outline-none transition-colors hover:border-destructive hover:text-destructive-ink"
			>Cancelar</button>
			// CONFIRMAR é do MESTRE, e só dele: quem muda o estado do tabuleiro é quem
			// toca a cena. O botão não existe do lado do jogador nem escondido — mas a
			// fronteira de verdade é o `CommitMove`, e isto aqui é só não oferecer o
			// que seria recusado. Vale igual para o turno sem ação: o servidor já
			// recusa, e o botão ali convidaria para um beco (p233).
			if v.Mestre && !v.Movimento.NoActionLeft {
				<button
					type="button"
					data-on:click={ moveCommand(v, "confirmar") }
					class="inline-flex min-h-11 items-center rounded-sm bg-primary px-3 text-sm font-semibold text-primary-foreground outline-none transition-opacity hover:opacity-90"
				>Confirmar</button>
			}
		</span>
	</div>
}



// planToken é uma peça: monogram da ESPÉCIE, selo da INSTÂNCIA, e a barra de
// PV quando há número para mostrar.
//
// O nome acessível diz QUEM e ONDE, com a Coordinate COM SINAL que o servidor
// guarda — sem ele a peça é um disco anônimo para quem não vê a tela, e "o Zumbi
// 3" deixa de ter resposta.
//
// A cor vem por variável de estilo e não por classe, e é o único jeito: o matiz
// é um número calculado por nome, então não existe classe do Tailwind para ele —
// seriam 360 classes que o scanner nunca veria.
templ planToken(v BoardView, p boardToken) {
	<button
		type="button"
		aria-label={ tokenName(p) }
		title={ tokenName(p) }
		style={ posicaoNoPlano(p.X, p.Y, p.Pegada) + fmt.Sprintf("--matiz:%d;", p.Matiz) }
		data-class={ tokenStyling(p.ID, dragsItself(v, p.ID)) }
		if tokenReceivesGesture(v, p.ID) {
			data-on:pointerdown={ takeToken(v, p.ID) }
			data-on:pointermove__window={ followToken(v, p) }
			data-on:pointerup__window={ dropToken(v, p) }
		}
		if v.Mestre {
			data-on:contextmenu={ openMenuToken(p.ID) }
			data-attr:aria-expanded={ chosenToken(p.ID) + " ? 'true' : 'false'" }
		}
		class={ "board-token",
			templ.KV("board-token-on-turn", p.NaVez),
			templ.KV("board-token-object", p.IsObject),
			templ.KV("board-token-hidden", p.Oculta) }
	>
		<span class="board-monogram">{ p.Monograma }</span>
		if p.Instancia != "" {
			// O selo é TEXTO e não só cor: "eu ataco o Zumbi 3" precisa de
			// resposta num relance inclusive para quem não distingue matiz.
			<span class="board-seal">{ p.Instancia }</span>
		}
		if p.PV != nil {
			<span aria-hidden="true" class="board-vitals">
				<span class={ "board-vitals-full", ui.HpFillTone(*p.PV) } style={ fmt.Sprintf("width:%d%%", *p.PV) }></span>
			</span>
		}
	</button>
}

// originGhost é a peça TRANSPARENTE na casa de onde ela saiu.
//
// A peça de verdade está no fim do caminho — ela pousa onde foi solta —, e sem
// esta marca o começo do movimento não estaria em lugar nenhum: a trilha diz por
// onde se passou, mas não de onde se PARTIU, porque um rastro sem ponta não tem
// direção.
//
// É a peça INTEIRA e não um disco genérico porque o monogram e o selo são o que
// dizem QUEM saiu dali: com três zumbis em campo, uma sombra anônima não
// responde qual deles está a caminho.
//
// Sem a barra de PV: o fantasma marca um LUGAR, e a vida que a mesa consulta é
// a da peça, que está do outro lado da seta. Duas barras para o mesmo
// combatente seriam duas chances de ler a errada.
//
// `aria-hidden` porque quem conta esta história ao leitor de tela é o nome da
// PEÇA, que já diz a parada proposta e a casa de onde ela saiu (`tokenName`).
templ originGhost(p boardToken) {
	<div
		aria-hidden="true"
		style={ posicaoNoPlano(p.X, p.Y, p.Pegada) + fmt.Sprintf("--matiz:%d;", p.Matiz) }
		class="board-token board-token-ghost"
	>
		<span class="board-monogram">{ p.Monograma }</span>
		if p.Instancia != "" {
			<span class="board-seal">{ p.Instancia }</span>
		}
	</div>
}

// moveArrow liga o fantasma à peça, dobrando nas paradas.
//
// Mesma gramática da régua — o mesmo dourado, o mesmo fio de espessura
// constante —, e a ponta é o que a distingue: a régua MEDE entre dois lugares e
// não tem sentido, o movimento VAI de um para o outro.
//
// Ela convive com a trilha pintada porque as duas dizem coisas diferentes: a
// trilha são as casas que CUSTARAM (a diagonal do livro, p238, está no desenho
// dela), e a seta é o gesto — onde a pessoa clicou. Trocar uma pela outra
// perderia a conta ou perderia a direção.
//
// O `d` vem PRONTO do servidor, ao contrário do da régua: o caminho é dele, que
// o calcula e o guarda no provisório. Montá-lo aqui obrigaria a mandar as
// paradas para o navegador para ele redesenhá-las.
templ moveArrow(v BoardView) {
	if v.Movimento != nil && v.Movimento.Fio != "" {
		<svg aria-hidden="true" class="board-measure board-measure-front">
			<defs>
				<marker
					id="board-tip-move"
					markerUnits="userSpaceOnUse"
					markerWidth="0.5"
					markerHeight="0.44"
					refX="0.5"
					refY="0.22"
					orient="auto"
				>
					<path d="M 0 0 L 0.5 0.22 L 0 0.44 Z" class="board-move-tip"></path>
				</marker>
				// UMA PONTA POR FAIXA, e não a mesma repintada por CSS:
				// `marker-end` referencia um nó por `id`, e um `<marker>` só herdaria
				// a cor do primeiro fio que o usasse.
				<marker
					id="board-tip-second"
					markerUnits="userSpaceOnUse"
					markerWidth="0.5"
					markerHeight="0.44"
					refX="0.5"
					refY="0.22"
					orient="auto"
				>
					<path d="M 0 0 L 0.5 0.22 L 0 0.44 Z" class="board-move-tip-second"></path>
				</marker>
				<marker
					id="board-tip-beyond"
					markerUnits="userSpaceOnUse"
					markerWidth="0.5"
					markerHeight="0.44"
					refX="0.5"
					refY="0.22"
					orient="auto"
				>
					<path d="M 0 0 L 0.5 0.22 L 0 0.44 Z" class="board-move-tip-beyond"></path>
				</marker>
			</defs>
			<g data-attr:transform={ viewportDrawing }>
				<path
					d={ v.Movimento.Fio }
					marker-end={ endWireFits(v.Movimento) }
					vector-effect="non-scaling-stroke"
					class="board-move-arrow"
				></path>
				// O SEGUNDO MOVIMENTO, em azul: o trecho que passa da ação de movimento
				// e ainda cabe na ação padrão trocada por ela (p233).
				//
				// Cada faixa só existe no HTML quando existe de fato: um `<path>` de `d`
				// vazio esperando um sinal seria um nó a mais em toda cena para o caso raro.
				if v.Movimento.FioSegundo != "" {
					<path
						d={ v.Movimento.FioSegundo }
						marker-end={ endWireSecond(v.Movimento) }
						vector-effect="non-scaling-stroke"
						class="board-move-arrow board-move-second"
					></path>
				}
				// O QUE NÃO CABE NO TURNO, em vermelho: passou das duas ações, e não
				// há terceira ação de movimento para pagá-lo.
				if v.Movimento.FioAlem != "" {
					<path
						d={ v.Movimento.FioAlem }
						marker-end={ endWireBeyond(v.Movimento) }
						vector-effect="non-scaling-stroke"
						class="board-move-arrow board-move-beyond"
					></path>
				}
			</g>
			// OS RÓTULOS EM METROS de cada perna, FORA do `<g>` que escala, pela
			// mesma razão dos da régua: dentro dele o `scale($square)` multiplicaria a
			// fonte e 12px virariam 1000px no zoom máximo.
			//
			// Sem RESERVA de nós, ao contrário da régua: as pernas do movimento são
			// conhecidas no servidor — o caminho é dele —, então o laço é do `templ` e
			// não um `data-show` por índice.
			//
			// TODOS dourados, inclusive os das pernas além do deslocamento: o rótulo
			// responde "quanto anda esta perna", que é fato neutro, e a cor responde
			// "quanto disso cabe". Uma perna que ATRAVESSA a virada não tem cor única,
			// e pintar o número dela mentiria metade das vezes.
			for _, perna := range v.Movimento.Pernas {
				<text
					data-attr:x={ numeroDoFio(perna.MeioX) + " * $square - $viewport_x" }
					data-attr:y={ numeroDoFio(perna.MeioY) + " * $square - $viewport_y" }
					text-anchor="middle"
					dominant-baseline="middle"
					class="board-ruler-label"
				>{ perna.Rotulo }</text>
			}
		</svg>
	}
}

// O MARCADOR no plano. Para a mesa ele é um selo que não se clica; para o mestre
// é um botão que abre o que fazer com ele.
//
// O `pointer-events` decide isso no CSS e não aqui, e é o certo: o marcador fica
// POR CIMA do plano, então capturar o clique de quem não pode mexer nele
// roubaria o gesto de mover a peça que estiver embaixo.
templ planMarker(v BoardView, m boardMarker) {
	if v.Mestre {
		<button
			type="button"
			aria-label={ markerName(m) }
			title={ markerName(m) }
			data-attr:aria-pressed={ chosenMarker(m.ID) + " ? 'true' : 'false'" }
			data-on:click={ pickMarker(m.ID) }
			style={ posicaoNoPlano(m.X, m.Y, 1) + fmt.Sprintf("--marcador:%s;", markerColor(m.Cor)) }
			class={ "board-marker", templ.KV("board-marker-hidden", m.Escondido) }
		>{ m.Texto }</button>
		@markerActions(v, m)
	} else {
		<span
			aria-label={ "Marcador " + m.Texto + " em " + m.Onde }
			title={ m.Texto + " · " + m.Onde }
			style={ posicaoNoPlano(m.X, m.Y, 1) + fmt.Sprintf("--marcador:%s;", markerColor(m.Cor)) }
			class="board-marker"
		>{ m.Texto }</span>
	}
}

// O que o mestre faz com o LUGAR marcado.
//
// REVELAR vem primeiro porque é o verbo que a mesa vê: o marcador nasce
// escondido, e o gesto que importa é o de mostrá-lo na hora certa. As cores e o
// apagar vêm depois, na ordem em que se usam.
//
// As ações ficam no HTML SEMPRE e quem as mostra é o sinal: um grupo que só
// existisse depois de uma ida ao servidor chegaria tarde para um clique que já
// aconteceu.
templ markerActions(v BoardView, m boardMarker) {
	<div
		role="group"
		aria-label={ "O que fazer com o marcador " + m.Texto }
		data-show={ chosenMarker(m.ID) }
		style={ posicaoNoPlano(m.X, m.Y, 1) }
		class="board-marker-actions"
	>
		<button
			type="button"
			if m.Escondido {
				aria-label={ "Revelar o marcador " + m.Texto + " para a mesa" }
				title="Revelar para a mesa"
			} else {
				aria-label={ "Esconder o marcador " + m.Texto + " da mesa" }
				title="Esconder da mesa"
			}
			data-on:click={ markerCommand(v, m.ID, "revelar") }
			class="inline-flex size-6 items-center justify-center rounded-sm text-xs outline-none hover:bg-accent"
		>
			if m.Escondido {
				@ui.Icon("Eye", "size-4")
			} else {
				@ui.Icon("EyeOff", "size-4")
			}
		</button>
		for _, cor := range board.MarkerColors {
			<button
				type="button"
				aria-label={ "Pintar o marcador " + m.Texto + " de " + cor.Rotulo }
				title={ cor.Rotulo }
				aria-pressed={ fmt.Sprintf("%t", cor.ID == m.Cor) }
				data-on:click={ markerCommand(v, m.ID, "cor/"+cor.ID) }
				style={ fmt.Sprintf("--marcador:var(--marcador-%s);", cor.ID) }
				class="board-marker-color"
			></button>
		}
		<button
			type="button"
			aria-label={ "Apagar o marcador " + m.Texto }
			title="Apagar"
			data-on:click={ pickMarker("") + "; " + markerCommand(v, m.ID, "remover") }
			class="inline-flex size-6 items-center justify-center rounded-sm text-xs text-muted-foreground outline-none hover:border hover:border-destructive hover:text-destructive-ink"
		>
			@ui.Icon("X", "size-4")
		</button>
	</div>
}

// O diálogo de ABRIR.
//
// Pede o LUGAR antes da grade porque é uma cena que o mestre está montando, não
// uma planilha: "Taverna do Javali" é o que a mesa vai ler no topo. E diz a
// conversão do livro à vista (1 quadrado = 1,5m, p236) porque a ficha fala em
// METROS — sem ela o mestre faz a conta de cabeça toda vez.
//
// `<dialog>` nativo pelo mesmo motivo dos outros: foco preso, Escape, fundo
// inerte e camada de topo, que é o que o tira de dentro do `contain` do palco.
// O `m-auto` é obrigatório — o `preflight` do Tailwind zera a margem de todo
// elemento, e a centralização do modal é justamente a `margin: auto`.
templ openBoardButton(v BoardView) {
	<dialog
		id="open-board"
		data-preserve-attr="open"
		aria-labelledby="open-board-title"
		class="scene-grimorio m-auto w-[min(24rem,calc(100vw-2rem))] rounded-sm border border-grimorio-iron bg-grimorio-panel p-4 text-foreground backdrop:bg-black/60"
	>
		<h2 id="open-board-title" class="font-heading text-lg tracking-wide text-grimorio-gold">Abrir tabuleiro</h2>
		<p class="mt-1 text-sm text-muted-foreground">
			O tabuleiro não tem bordas: cada quadrado é 1,5m (p236) e a cena cresce para onde a mesa for. O deslocamento padrão de 9m anda 6 quadrados (p106).
		</p>
		<label for="new-place-field" class={ ui.FieldLabelClasses("muted", "mt-3 block") }>Lugar</label>
		// O NOME DO SINAL É `snake_case`, e é obrigatório: nome de ATRIBUTO é
		// minusculado pelo analisador de HTML, então caixa alta na chave liga um
		// sinal NOVO e deixa o declarado intocado — o fio leva os dois e o
		// servidor lê o errado.
		<input
			id="new-place-field"
			type="text"
			data-bind:new_place
			placeholder="Taverna do Javali"
			class="mt-1 w-full rounded-sm border border-input bg-background px-2 py-1.5 text-sm outline-none"
		/>
		// CHÃO e não "Cenário", que é o rótulo da SPA: em T20 cenário é ARTON, o
		// mundo da campanha, e a palavra não pode significar duas coisas na
		// mesma casa. Ver GLOSSARY.md.
		<label for="new-ground" class={ ui.FieldLabelClasses("muted", "mt-3 block") }>Chão</label>
		<select
			id="new-ground"
			data-bind:new_ground
			class="mt-1 w-full rounded-sm border border-input bg-background px-2 py-1.5 text-sm outline-none"
		>
			// A lista vem do `tabuleiro` e não é digitada aqui: uma terceira cópia à
			// mão é como nasce a opção que a tela oferece e o navegador desenha em
			// branco.
			for _, chao := range board.PlaceGrounds {
				<option value={ chao.ID }>{ chao.Rotulo }</option>
			}
		</select>
		<div class="mt-4 flex justify-end gap-2">
			<button
				type="button"
				data-on:click="document.getElementById('open-board').close()"
				class="inline-flex min-h-11 items-center rounded-sm border border-grimorio-iron px-3 text-sm outline-none transition-colors hover:bg-accent"
			>Cancelar</button>
			// Fecha ANTES de postar, como o descanso: a recusa chega no
			// `$command_error`, que é do RODAPÉ — o diálogo aberto por cima dela
			// esconderia a única frase que explica o que houve.
			<button
				type="button"
				data-on:click={ "document.getElementById('open-board').close(); " + sceneBoardCommand(v, "abrir") }
				class="inline-flex min-h-11 items-center rounded-sm bg-primary px-3 text-sm font-semibold text-primary-foreground outline-none transition-opacity hover:opacity-90"
			>Abrir</button>
		</div>
	</dialog>
}

// O diálogo de ENCERRAR, que é confirmação e não interruptor.
//
// A frase diz o que ACONTECE com a cena porque "encerrar" sozinho soa como
// perder: ela vai para os Lugares da campanha com as peças onde estão. Sem isso
// o mestre hesita no fim da noite e deixa a cena velha na mesa da semana
// seguinte.
templ endBoardButton(v BoardView) {
	<dialog
		id="close-board"
		data-preserve-attr="open"
		aria-labelledby="close-board-title"
		class="scene-grimorio m-auto w-[min(24rem,calc(100vw-2rem))] rounded-sm border border-grimorio-iron bg-grimorio-panel p-4 text-foreground backdrop:bg-black/60"
	>
		<h2 id="close-board-title" class="font-heading text-lg tracking-wide text-grimorio-gold">Encerrar o tabuleiro?</h2>
		<p class="mt-1 text-sm text-muted-foreground">
			A cena vai para os Lugares da campanha, com as peças onde estão, e você a reabre quando quiser. A iniciativa e os PV continuam como estão.
		</p>
		<div class="mt-4 flex justify-end gap-2">
			<button
				type="button"
				data-on:click="document.getElementById('close-board').close()"
				class="inline-flex min-h-11 items-center rounded-sm border border-grimorio-iron px-3 text-sm outline-none transition-colors hover:bg-accent"
			>Cancelar</button>
			<button
				type="button"
				data-on:click={ "document.getElementById('close-board').close(); " + sceneBoardCommand(v, "encerrar") }
				class="inline-flex min-h-11 items-center rounded-sm bg-destructive px-3 text-sm font-semibold text-destructive-foreground outline-none transition-opacity hover:opacity-90"
			>Encerrar</button>
		</div>
	</dialog>
}

// botaoDoAcervo é o gatilho, e ele aparece em DOIS lugares — na cena vazia e no
// cabeçalho da cena aberta. É um componente e não duas cópias porque a segunda
// cópia é a que fica para trás: o rótulo com a contagem tem de dizer o mesmo
// número nos dois, e a rota tem de ser a mesma.
templ botaoDoAcervo(v BoardView) {
	<button
		type="button"
		aria-label={ collectionLabel(v) }
		title={ collectionLabel(v) }
		data-on:click="document.getElementById('place-archive').showModal()"
		class="inline-flex min-h-11 shrink-0 items-center gap-1.5 rounded-sm border border-grimorio-iron px-2 text-sm outline-none transition-colors hover:bg-accent sm:px-3"
	>
		@ui.Icon("Library", "size-4")
		// AS PALAVRAS SAEM NO TELEFONE, a CONTAGEM fica: este é o único item do
		// painel com texto e contagem, e era ele que empurrava "Centralizar" e
		// "Afastar" para fora de uma janela de 390px. O que a frase carrega de
		// informação é o NÚMERO — o ícone de biblioteca já diz do que se trata.
		//
		// O nome ACESSÍVEL não encolhe junto: ele está no `aria-label`, com a frase
		// inteira. Esconder texto por CSS o tira da árvore de acessibilidade
		// (`display:none` não é `sr-only`), e um botão que vira "3" para quem usa
		// leitor de tela é pior que um botão largo.
		<span class="hidden sm:inline">Lugares da campanha ·</span>
		{ fmt.Sprint(len(v.Acervo)) }
	</button>
}

// collectionLabel é a frase inteira, e ela é o nome acessível do botão em toda
// largura — o que encolhe é só o que se VÊ.
func collectionLabel(v BoardView) string {
	return fmt.Sprintf("Lugares da campanha · %d", len(v.Acervo))
}

// O ACERVO de cenas guardadas.
//
// LISTA e não grade: o que decide entre a taverna e a cripta é o NOME, e nome é
// texto que se lê em coluna. Uma grade de miniaturas exigiria miniatura, que o
// servidor não tem — a cena guardada é estado, não imagem.
//
// A CONTAGEM de peças vai junto porque é o que separa a cena montada da cena
// aberta e abandonada: "Cripta · 9 peças" é uma noite de trabalho e "Cena · 0
// peças" é lixo que o mestre quer apagar.
templ placesCollection(v BoardView) {
	<dialog
		id="place-archive"
		data-preserve-attr="open"
		aria-labelledby="archive-title"
		class="scene-grimorio m-auto w-[min(30rem,calc(100vw-2rem))] rounded-sm border border-grimorio-iron bg-grimorio-panel p-4 text-foreground backdrop:bg-black/60"
	>
		<h2 id="archive-title" class="font-heading text-lg tracking-wide text-grimorio-gold">Lugares da campanha</h2>
		<p class="mt-1 text-sm text-muted-foreground">
			As cenas que você encerrou, com as peças onde estavam. Reabrir traz a cena numa aba nova, sem fechar as que já estão abertas.
		</p>
		<ul class="mt-3 max-h-[50vh] space-y-1 overflow-y-auto">
			for _, l := range v.Acervo {
				<li class="flex flex-wrap items-center gap-2 border border-grimorio-iron px-2 py-1.5">
					<span class="min-w-0 flex-1">
						<span class="block truncate text-sm text-foreground">{ l.Nome }</span>
						<span class="block text-xs text-muted-foreground">
							if l.AbertaEm != "" {
								// A LINHA DIZ O ESTADO, e não só a data: numa lista
								// longa, o que está na mesa agora se perde no meio
								// dos outros sem nada que o distinga.
								@ui.Icon("LayoutGrid", "mr-1 inline size-3")
								{ "nesta mesa agora · " + ui.TokenCount(l.Pecas) }
							} else {
								{ fmt.Sprintf("%s · %s", ui.TokenCount(l.Pecas), l.Quando) }
							}
						</span>
					</span>
					if l.AbertaEm != "" {
						// O QUE JÁ ESTÁ ABERTO NÃO SE REABRE: uma segunda aba da
						// mesma cena seriam duas verdades sobre onde as peças
						// estão, e a que fechasse por último apagaria a outra no
						// acervo. O gesto que sobra é ir até ela.
						<button
							type="button"
							data-on:click={ "document.getElementById('place-archive').close(); " + tabCommand(v, l.AbertaEm) }
							class="inline-flex min-h-11 items-center rounded-sm border border-grimorio-gold px-3 text-sm font-semibold text-grimorio-gold outline-none transition-colors hover:bg-accent"
						>Ver</button>
					} else {
						<button
							type="button"
							data-on:click={ "document.getElementById('place-archive').close(); " + placeCommand(v, l.ID, "reabrir") }
							class="inline-flex min-h-11 items-center rounded-sm bg-primary px-3 text-sm font-semibold text-primary-foreground outline-none transition-opacity hover:opacity-90"
						>Reabrir</button>
					}
					// APAGAR não fecha o diálogo, ao contrário do reabrir: quem está
					// limpando o acervo geralmente apaga mais de um, e reabrir o menu a
					// cada lixeira seria cobrar um clique por item. O reabrir fecha porque
					// ele leva para a aba nova — ficar com o menu por cima dela esconderia
					// o que ele fez.
					//
					// E ele NÃO aparece para o que está aberto: apagar do acervo uma cena
					// que está na mesa não apaga nada, porque encerrar a aba a grava de
					// volta com o mesmo nome. A trava de verdade é do servidor
					// (`removeOLugar`); isto é a cortesia de não oferecer o gesto que ele
					// vai recusar.
					if l.AbertaEm == "" {
						<button
							type="button"
							aria-label={ "Apagar " + l.Nome }
							title={ "Apagar " + l.Nome + " do acervo" }
							data-on:click={ placeCommand(v, l.ID, "remover") }
							class="flex size-11 items-center justify-center rounded-sm border border-grimorio-iron text-sm text-muted-foreground outline-none transition-colors hover:border-destructive hover:text-destructive-ink"
						>
							@ui.Icon("Trash2", "size-4")
						</button>
					}
				</li>
			}
		</ul>
		<div class="mt-4 flex justify-end">
			<button
				type="button"
				data-on:click="document.getElementById('place-archive').close()"
				class="inline-flex min-h-11 items-center rounded-sm border border-grimorio-iron px-3 text-sm outline-none transition-colors hover:bg-accent"
			>Fechar</button>
		</div>
	</dialog>
}

// O MENU DE CONTEXTO DA PEÇA.
//
// Clique direito na peça acende os verbos dela, ancorados na casa — o MESMO
// padrão que o marcador já usa nesta cena, e por isso o mestre não aprende um
// gesto novo. Ele é do mestre: quem esconde, duplica e tira uma peça é quem
// monta a mesa.
//
// O menu existe no HTML SEMPRE e quem o mostra é o sinal. Um grupo que só
// nascesse depois de uma ida ao servidor chegaria tarde para um clique que já
// aconteceu.
//
// O gesto nunca é o único caminho: a peça é um `<button>` de verdade, o teclado
// a alcança, e o `Enter` abre este mesmo menu.
//
// O ESC NÃO FECHA o menu: o `scene.js` mapeia Escape para "voltar" e o para no
// `document`, então um `keydown__window` nunca o vê. Quem fecha é o ✕, e abrir o
// menu de OUTRA peça — que é o mesmo sinal recebendo outro id.
templ tokenMenu(v BoardView, p boardToken) {
	<div
		role="group"
		aria-label={ "O que fazer com " + p.Rotulo }
		data-show={ chosenToken(p.ID) }
		style={ posicaoNoPlano(p.X, p.Y, p.Pegada) }
		class="board-token-menu"
	>
		// VISIBILIDADE primeiro: é o verbo que a mesa vê, e o único cujo esquecimento
		// entrega a emboscada. `aria-pressed` carrega o ESTADO; o nome carrega o
		// VERBO, que é o que o clique vai fazer.
		<button
			type="button"
			aria-label={ visibilityName(p) }
			title={ visibilityName(p) }
			aria-pressed={ fmt.Sprintf("%t", p.Oculta) }
			data-on:click={ tokenCommand(v, p.ID, "visibilidade") }
			class="board-token-verb"
		>
			if p.Oculta {
				@ui.Icon("EyeOff", "size-4")
			} else {
				@ui.Icon("Eye", "size-4")
			}
		</button>
		// DUPLICAR abre uma SEGUNDA CAMADA em vez de agir: são três modos, e a
		// diferença entre eles — o que a cópia faz com a linha da fila — não cabe
		// num ícone. Três ícones lado a lado seriam três desenhos parecidos numa
		// fileira de 28px sobre o mapa.
		<button
			type="button"
			aria-label={ "Duplicar " + p.Rotulo }
			title="Duplicar: escolher o que a cópia leva"
			popovertarget={ copyMenuId(p.ID) }
			class="board-token-verb"
		>
			@ui.Icon("Copy", "size-4")
		</button>
		<button
			type="button"
			aria-label={ "Editar " + p.Rotulo }
			title="Editar o nome e o tamanho"
			data-on:click={ openEditToken(p) }
			class="board-token-verb"
		>
			@ui.Icon("Pencil", "size-4")
		</button>
		// VOLTAR só existe quando há para onde, e a frase diz a casa: "voltar" sem
		// destino é um botão que promete desfazer algo que ninguém lembra.
		if p.DeOndeVeio != nil {
			<button
				type="button"
				aria-label={ "Voltar " + p.Rotulo + " para " + tokenSquare(p.DeOndeVeio) }
				title={ "Voltar para onde estava (" + tokenSquare(p.DeOndeVeio) + ")" }
				data-on:click={ tokenCommand(v, p.ID, "voltar") }
				class="board-token-verb"
			>
				@ui.Icon("CornerUpLeft", "size-4")
			</button>
		}
		<span aria-hidden="true" class="board-token-crease"></span>
		// TIRAR fica depois do vinco e é o único em vermelho: ele é o que não se
		// desfaz, e a distância é o que impede o clique de inércia depois de
		// duplicar três zumbis seguidos.
		<button
			type="button"
			aria-label={ "Tirar " + p.Rotulo + " do tabuleiro" }
			title="Tirar do tabuleiro (a linha da iniciativa fica)"
			data-on:click={ tokenCommand(v, p.ID, "remover") }
			class="board-token-verb board-token-verb-danger"
		>
			@ui.Icon("Trash2", "size-4")
		</button>
		<button
			type="button"
			aria-label={ "Fechar o menu de " + p.Rotulo }
			data-on:click={ closeMenuToken }
			class="board-token-verb"
		>
			@ui.Icon("X", "size-4")
		</button>
		@tokenCopyMenu(v, p)
	</div>
}

// A SEGUNDA CAMADA do menu: o que a cópia vai ser.
//
// POPOVER NATIVO, e isso foi medido e não escolhido. Como camada `absolute`
// dentro do menu ela estoura a janela do telefone e deixa a maioria dos modos
// inalcançável; virar para cima não resolve, e `position: fixed` não escapa: o
// plano tem `transform`, e transform em ancestral vira BLOCO DE CONTENÇÃO para
// `fixed`.
//
// A top layer resolve os três de uma vez: sai do `transform`, sai do `overflow`
// e é posicionada em relação à JANELA. Quem escreve as coordenadas é o
// `ancora()` do `scene.js`, no `beforetoggle` — o mesmo que posiciona o menu do
// jogador no Hub —, e ele já vira para cima quando o gatilho está na metade de
// baixo da tela.
//
// De brinde vêm o clique-fora e o Esc, que aqui FUNCIONA: o navegador fecha o
// popover antes de o `scene.js` engolir a tecla. É o único Esc desta cena que
// responde, e é por isso que ele não é anunciado em lugar nenhum — prometer
// "Esc fecha" numa tela em que ele só fecha ISTO seria pior que não prometer.
//
// A ORDEM é a do uso: "com PV próprio" é o "mais um zumbi" de montar encontro e
// vem primeiro; "sangrando junto" é o caso raro do mesmo inimigo desenhado em
// dois pontos; "só a peça" fica por último, porque quem o quer sabe o que quer.
//
// Cada linha tem a FRASE embaixo, e ela não é enfeite: "duplicar" é a mesma
// palavra três vezes, e o que distingue é uma consequência — se o dano de um
// aparece no outro. Sem a frase, o menu pede que se adivinhe.
templ tokenCopyMenu(v BoardView, p boardToken) {
	<div
		id={ copyMenuId(p.ID) }
		popover
		aria-label={ "O que a cópia de " + p.Rotulo + " leva" }
		class="board-token-copy"
	>
		@tokenCopyGroup("Duplicar aqui")
		@tokenCopyMode(v, p, "sozinha", "Outro, com PV próprio", "entra na fila com o PV cheio do original")
		// "COMBATENTE" e não "linha", e o GLOSSARY é quem manda: `linha` é
		// proibida em texto visível para o objeto — ela só vale falando do
		// elemento de UI. O comentário do código pode dizer linha; a tela, não.
		@tokenCopyMode(v, p, "junto", "Outro, sangrando junto", "o mesmo combatente da fila: uma barra de PV para os dois")
		// O BLOCO PRÓPRIO só aparece para quem TEM bloco: o herói e o NPC digitado
		// à mão não têm o que copiar, e oferecer o que o servidor vai recusar é
		// desenhar um erro.
		if p.TemBloco {
			@tokenCopyMode(v, p, "bloco", "Outro, com bloco próprio", "copia a ficha da criatura: dá para editar o chefe sem mexer nos outros")
		}
		@tokenCopyMode(v, p, "peca", "Só a peça", "sem fila e sem PV — cenário, ou entra na fila depois")
		// COPIAR guarda a decisão e não age. A pergunta dos três modos é feita UMA
		// vez, aqui, e cada `CTRL + V` depois põe outro igual sem perguntar de
		// novo: perguntar a cada colada mataria o valor do teclado, que é repetir.
		@tokenCopyGroup("Copiar para colar")
		@tokenClipboardMode(v, p, "sozinha", "com PV próprio")
		@tokenClipboardMode(v, p, "junto", "sangrando junto")
		@tokenClipboardMode(v, p, "peca", "só a peça")
	</div>
}

// tokenCopyGroup separa as duas metades da camada.
//
// `<p>` e não cabeçalho: a camada já tem `aria-label`, e um `<h4>` faria o leitor
// de tela anunciar um nível novo no meio de uma lista de seis botões. O que
// separa para quem NÃO vê é o rótulo de cada botão, que diz o verbo inteiro.
templ tokenCopyGroup(rotulo string) {
	<p aria-hidden="true" class="board-token-copy-group">{ rotulo }</p>
}

// tokenClipboardMode põe a peça na área com um modo grudado.
//
// O rótulo acessível diz o VERBO inteiro — "Copiar Zumbi para colar: com PV
// próprio" — porque o cabeçalho do grupo é `aria-hidden`, e sem ele o botão se
// anunciaria só como "com PV próprio", que é a metade que não diz o que acontece.
templ tokenClipboardMode(v BoardView, p boardToken, modo, nome string) {
	<button
		type="button"
		aria-label={ "Copiar " + p.Rotulo + " para colar: " + nome }
		data-on:click={ putsInTheClipboard(v, p, modo, nome) }
		class="board-token-copy-mode"
	>
		<span class="board-token-copy-name">{ nome }</span>
	</button>
}

// tokenCopyMode é uma escolha da segunda camada.
//
// O `title` NÃO repete a frase que já está desenhada: o rótulo acessível é o
// nome mais a frase, e um `title` igual faria o leitor de tela dizer a mesma
// coisa duas vezes — a armadilha que o `ui.Icon` já registra.
templ tokenCopyMode(v BoardView, p boardToken, modo, nome, frase string) {
	<button
		type="button"
		aria-label={ nome + ": " + frase }
		data-on:click={ copyCommand(v, p.ID, modo) }
		class="board-token-copy-mode"
	>
		<span class="board-token-copy-name">{ nome }</span>
		<span aria-hidden="true" class="board-token-copy-phrase">{ frase }</span>
	</button>
}

// O DIÁLOGO DE EDITAR é UM só para todas as peças, e quem o semeia é o gesto que
// o abre (`openEditToken`).
//
// Nó COMPARTILHADO exige limpeza no gesto que TROCA de item: abrir o Ogro depois
// do Zumbi mostraria o nome do Zumbi sobre o Ogro, e o mestre salvaria isso.
templ tokenEdit(v BoardView) {
	<dialog
		id="edit-token"
		data-preserve-attr="open"
		aria-labelledby="edit-token-title"
		class="scene-grimorio m-auto hidden w-[min(24rem,calc(100vw-2rem))] flex-col gap-3 rounded-sm border border-grimorio-iron bg-grimorio-panel p-4 text-foreground open:flex backdrop:bg-black/60"
	>
		<h2 id="edit-token-title" class="font-heading text-lg tracking-wide text-grimorio-gold">Editar a peça</h2>
		<div class="space-y-1">
			<label for="token-name" class={ ui.FieldLabelClasses("muted", "block") }>Nome da peça</label>
			<input
				id="token-name"
				type="text"
				maxlength="60"
				data-bind="token_name"
				class="w-full rounded-sm border border-input bg-background px-2 py-1.5 text-sm outline-none"
			/>
		</div>
		// O TAMANHO é uma lista fechada e não um número: o livro define 1, 2, 3 e 6
		// (p107, Tab. 1-21), e não existe 4 nem 5. Um campo livre deixaria o mestre
		// desenhar uma peça que nenhuma criatura tem.
		<div class="space-y-1">
			<label for="token-size" class={ ui.FieldLabelClasses("muted", "block") }>Tamanho</label>
			<select
				id="token-size"
				data-bind="token_size"
				class="h-11 w-full rounded-sm border border-input bg-background px-2 text-sm outline-none"
			>
				for _, t := range tokenSizes {
					<option value={ fmt.Sprint(t.Lado) }>{ t.Rotulo }</option>
				}
			</select>
		</div>
		<div class="flex items-center justify-end gap-2 border-t border-grimorio-iron pt-3">
			<button
				type="button"
				data-on:click="document.getElementById('edit-token').close()"
				class="inline-flex min-h-11 items-center rounded-sm border border-grimorio-iron px-3 text-sm text-muted-foreground outline-none transition-colors hover:bg-accent hover:text-foreground"
			>Cancelar</button>
			<button
				type="button"
				data-on:click={ saveEditToken(v) }
				class="inline-flex min-h-11 items-center rounded-sm bg-primary px-3 text-sm font-semibold text-primary-foreground outline-none transition-opacity hover:opacity-90"
			>Salvar</button>
		</div>
	</dialog>
}

// O TRILHO DE FERRAMENTAS, VERTICAL e SOBREPOSTO ao mapa.
//
// Ele existe para que o que o CLIQUE vai fazer seja legível ANTES do clique.
// Vertical porque nove ferramentas numa linha não cabem em telefone nenhum — a
// 390px o ✕ ficava inalcançável; sobreposto porque a cena não pode mudar de
// tamanho quando o trilho cresce.
//
// A divisa entre as duas metades é de PAPEL: em cima o que todo mundo faz —
// medir e mirar são gestos de quem ATACA —, embaixo o que muda a cena.
//
// CADA FERRAMENTA TEM UM NÚMERO, e ele é fixo por ferramenta e não pela posição
// no trilho: quem aprendeu `3 = gabarito` mestrando continua com `3 = gabarito`
// jogando. A lista, os botões e o teclado saem todos do `MapTools` — uma tabela
// à mão seria a segunda verdade sobre qual tecla liga o quê.
templ toolsRail(v BoardView) {
	<nav
		aria-label="Ferramentas do mapa"
		data-on:keydown__window={ railKeyboard(v.Mestre) }
		class="board-rail"
	>
		for i, f := range rail(v.Mestre) {
			// O VINCO separa o que é de todo mundo do que é do mestre. Ele sai do
			// PAPEL da ferramenta e não de um índice mágico: a primeira só-do-mestre
			// leva o vinco, e acrescentar uma quinta espécie não move nada.
			if i > 0 && f.SoMestre && !rail(v.Mestre)[i-1].SoMestre {
				<span aria-hidden="true" class="board-rail-crease"></span>
			}
			@railTool(f)
		}
		// A PEÇA AVULSA fica FORA da fileira numerada, atrás do próprio vinco. Ela
		// é ferramenta pela divisa desta seção — muda o que o clique faz — e mesmo
		// assim não é uma décima primeira entrada: o `railKeys` tem dez dígitos e o
		// `numberRail` estoura na décima primeira de propósito.
		//
		// O sinal é o MESMO (`$tool`), então ela exclui as outras por construção. O
		// que ela não tem é número, e o `NewPieceTool` registra por quê.
		if v.Mestre {
			<span aria-hidden="true" class="board-rail-crease"></span>
			<button
				type="button"
				title="Nova peça: a porta, o baú, o barril — o clique escolhe a casa"
				aria-label="Nova peça — o clique escolhe a casa"
				data-attr:aria-pressed={ onIsTool(NewPieceTool) + " ? 'true' : 'false'" }
				data-class={ toolStyling(NewPieceTool) }
				data-on:click={ pickTool(NewPieceTool) }
				class="board-tool"
			>
				@ui.Icon("PackagePlus", "size-4")
			</button>
		}
	</nav>
}

// railTool é um botão do trilho: o desenho, o número e o sinal único.
//
// O NÚMERO fica visível no canto do botão e não só no `title`: um atalho que só
// existe no balão do mouse é um atalho que ninguém descobre — e quem navega por
// teclado, que é quem mais o usaria, nunca vê balão nenhum.
templ railTool(f mapTool) {
	<button
		type="button"
		title={ f.Dica + " (tecla " + f.Atalho + ")" }
		aria-label={ shortcutName(f) }
		data-attr:aria-pressed={ onIsTool(f.ID) + " ? 'true' : 'false'" }
		data-class={ toolStyling(f.ID) }
		data-on:click={ pickTool(f.ID) }
		class="board-tool"
	>
		@ui.Icon(f.Icone, "size-4 "+f.Matiz)
		<span aria-hidden="true" class="board-tool-key">{ f.Atalho }</span>
	</button>
}

// O ENQUADRAMENTO do plano: centralizar e o zoom.
//
// AÇÕES e não ferramentas: ferramenta muda o que o CLIQUE faz, ação acontece
// uma vez e acaba. Por isso elas ficam no cabeçalho e não no trilho — no
// trilho, aproximar pareceria um modo que se liga.
//
// Os botões do zoom DESABILITAM no limite em vez de sumir: um botão que some
// move os vizinhos debaixo do dedo de quem está clicando repetido para
// aproximar.
templ planFraming(v BoardView) {
	<span role="group" aria-label="Enquadrar o mapa" class="ml-auto flex items-center gap-1">
		// CENTRALIZAR vem ANTES do zoom e é a única ação da faixa que precisa
		// saber da cena: num plano sem bordas, achar o grupo é a pergunta que se
		// faz primeiro, e aproximar é o ajuste que vem depois de achar.
		@centerer(v)
		// O VINCO separa "achar" de "aproximar", e ele é DECORATIVO — no telefone
		// quem separa é o espaço, e as margens dele eram o que faltava para o
		// painel caber a 390px.
		<span aria-hidden="true" class="mx-0.5 hidden h-5 w-px bg-grimorio-iron sm:inline-block"></span>
		<button
			type="button"
			aria-label="Afastar o mapa"
			title="Afastar (tecla −, ou Ctrl+roda)"
			data-attr:disabled={ ZoomAtLimit(-ZoomStep) }
			data-on:click={ zoomMidScene(step(-ZoomStep)) }
			class="flex size-8 items-center justify-center rounded-sm border border-grimorio-iron text-sm outline-none transition-colors hover:bg-accent disabled:opacity-50"
		>
			@ui.Icon("Minus", "size-4")
		</button>
		// O NÚMERO em quadrados por tela é mais útil que "120%": a pergunta do
		// mestre é "cabe o deslocamento inteiro?" (6 quadrados, p106), e uma
		// porcentagem obriga a converter de cabeça. `aria-live` porque ele é a
		// única resposta ao clique para quem não vê o mapa mudar.
		//
		// O MOSTRADOR SAI DA LARGURA NO TELEFONE, e NÃO da tela de quem escuta:
		// `sr-only` e NUNCA `hidden`, porque `display:none` o tiraria da árvore
		// de acessibilidade junto com a largura — o `sr-only` tira só os pixels.
		//
		// A UNIDADE virou irmão em vez de ficar no `data-text` porque o
		// `data-text` substitui o conteúdo inteiro do nó: um `<span>` dentro dele
		// seria apagado no primeiro zoom. É a mesma armadilha do
		// `data-attr:style`, que substitui o atributo inteiro.
		<output
			aria-live="polite"
			aria-label="Tamanho do quadrado"
			data-text="$square"
			class="sr-only text-right text-xs tabular-nums text-muted-foreground sm:not-sr-only sm:min-w-8"
		></output>
		<span aria-hidden="true" class="hidden text-xs text-muted-foreground sm:inline">px</span>
		<button
			type="button"
			aria-label="Aproximar o mapa"
			title="Aproximar (tecla +, ou Ctrl+roda)"
			data-attr:disabled={ ZoomAtLimit(ZoomStep) }
			data-on:click={ zoomMidScene(step(ZoomStep)) }
			class="flex size-8 items-center justify-center rounded-sm border border-grimorio-iron text-sm outline-none transition-colors hover:bg-accent disabled:opacity-50"
		>
			@ui.Icon("Plus", "size-4")
		</button>
	</span>
}

// centerer acha o grupo num plano que não tem começo.
//
// "Voltar ao começo" não significa nada aqui: a origem do plano é um lugar como
// outro qualquer, e o que o mestre quer é ver as peças. Por isso o alvo é a
// caixa que as contém, e por isso o RÓTULO muda quando não há nenhuma — "nas
// peças" numa cena vazia ensinaria que o botão está quebrado.
//
// ÍCONE e não texto, como os vizinhos: a linha do lugar é a mais estreita da
// região, e o nome por extenso empurra o nome da cena para fora. O nome
// acessível carrega a frase inteira.
templ centerer(v BoardView) {
	<button
		type="button"
		aria-label={ CenterTarget(v) }
		title={ CenterTarget(v) }
		data-on:click={ centerTokens(v) }
		class="flex size-8 items-center justify-center rounded-sm border border-grimorio-iron text-sm outline-none transition-colors hover:bg-accent"
	>
		@ui.Icon("Crosshair", "size-4")
	</button>
}

// O botão da LENTE.
//
// `aria-pressed` e não dois botões, como na cortina: é UM estado com dois lados.
// O valor sai como STRING porque `data-attr` com booleano vira atributo
// booleano, e `aria-pressed=""` não anuncia estado nenhum — mas aqui ele é
// CONSTANTE (o servidor sabe se a lente está ligada), então vai no atributo
// mesmo.
templ lensButton(v BoardView) {
	<button
		type="button"
		aria-pressed={ fmt.Sprintf("%t", v.Lente) }
		if v.Lente {
			aria-label="Voltar à vista do mestre"
			title="Voltar à vista do mestre"
		} else {
			aria-label="Ver a cena como a mesa vê"
			title="Ver como jogador: confira a emboscada sem parar de montá-la"
		}
		data-on:click={ lensCommand(v) }
		class={ "flex size-8 items-center justify-center rounded-sm border text-sm outline-none transition-colors",
			templ.KV("border-grimorio-gold bg-grimorio-gold/20 text-grimorio-gold", v.Lente),
			templ.KV("border-transparent text-muted-foreground hover:bg-accent", !v.Lente) }
	>
		if v.Lente {
			@ui.Icon("EyeOff", "size-5")
		} else {
			@ui.Icon("Eye", "size-5")
		}
	</button>
}

// O botão da CORTINA.
//
// O tabuleiro é do mestre; a mesa vê uma cortina no lugar dele enquanto ele
// monta a taverna com eles olhando a cripta.
//
// `aria-pressed` e não dois botões: é UM estado com dois lados, e o leitor de
// tela anuncia "pressionado" sem precisar de uma segunda palavra na tela. O
// valor sai como STRING porque `data-attr` com booleano vira atributo booleano,
// e `aria-pressed=""` não anuncia estado nenhum.
templ curtainButton(v BoardView) {
	<button
		type="button"
		aria-pressed={ fmt.Sprintf("%t", v.AvisoDaCortina) }
		if v.AvisoDaCortina {
			aria-label="Abrir a cortina para a mesa"
			title="Abrir a cortina: a mesa volta a ver a cena"
		} else {
			aria-label="Fechar a cortina"
			title="Fechar a cortina: montar a cena sem a mesa ver"
		}
		data-on:click={ curtainCommand(v, curtainTarget(v.AvisoDaCortina)) }
		class={ "flex size-8 items-center justify-center rounded-sm border text-sm outline-none transition-colors",
			templ.KV("border-grimorio-gold bg-grimorio-gold/20 text-grimorio-gold", v.AvisoDaCortina),
			templ.KV("border-transparent text-muted-foreground hover:bg-accent", !v.AvisoDaCortina) }
	>
			@ui.Icon("Theater", "size-5")
		</button>
}

// clickLayers são as superfícies que recebem o dedo, ENTRE os dois planos:
// abaixo delas fica o chão, acima ficam as peças.
templ clickLayers(v BoardView) {
	// A MÃO que arrasta a VISTA. Ela é a primeira das camadas porque é a
	// única que não fala em quadrado: o que ela mede é o deslocamento do
	// DEDO em pixels, e por isso o zoom não entra na conta dela.
	//
	// `aria-hidden` e não um botão: arrastar não é uma ação que o teclado
	// execute, e um botão que não faz nada com Enter é pior que nó nenhum.
	// Quem percorre o plano pelo teclado é o FOCO — o `scene.js` move o
	// foco entre as peças e a janela vai atrás, pelo `viewportFollowsFocus`.
	//
	// O `setPointerCapture` do `pegaAVista` é o que faz o arrasto sobreviver
	// a sair da janela: sem ele, soltar o botão fora do tabuleiro deixaria a
	// vista presa ao dedo para sempre.
	<div
		aria-hidden="true"
		data-show={ onIsTool(ViewTool) }
		data-class={ "{'board-viewport-grabbing': $" + sinalDoArrastoDaVista + "}" }
		data-on:pointerdown={ pegaAVista }
		data-on:pointermove={ followsView }
		data-on:pointerup={ dropView }
		data-on:pointercancel={ dropView }
		class="board-viewport"
	></div>
	// AS CAMADAS DE CLIQUE cobrem a JANELA INTEIRA e são IRMÃS do plano,
	// não filhas.
	//
	// Irmãs porque o plano é deslocado por um `transform`: dentro dele, o
	// `evt.offsetX` mediria a partir da origem do plano, e a conta do
	// quadrado teria de desfazer o deslocamento em vez de somá-lo. Fora
	// dele, a quina da camada É a quina da tela.
	//
	// A janela inteira porque um plano infinito precisa ser clicável em
	// todo lugar: com a moldura, fora dela não havia onde clicar.
	//
	// Cada uma é UM nó, e não um por quadrado: seiscentos botões seriam um
	// campo minado no leitor de tela.
	//
	// UMA CAMADA POR GESTO, e não uma que arbitra: quem escolhe é o sinal
	// do pincel — com uma espécie escolhida o clique PINTA, sem ela o
	// clique MOVE. Duas camadas empilhadas dariam o estado impossível de
	// pincel e régua ligados, com uma roubando o clique da outra.
	//
	// O `data-show` e não um `if` do servidor: a escolha do pincel é do
	// NAVEGADOR e não passa pelo servidor, então uma camada que só
	// existisse conforme o estado de lá chegaria tarde.
	//
	// O nome acessível da camada NÃO cita a espécie: ela sairia do sinal,
	// que guarda o ID, e o leitor de tela anunciaria "Pintar dificil" — sem
	// acento, porque id não é texto de gente. Quem diz a espécie é o
	// TRILHO, pelo botão que está `aria-pressed`.
	if v.Mestre {
		// PINTAR É UM TRAÇO e não um clique (ALE-203, item 8 do dono). O
		// `pointerdown` começa, o `pointermove` continua enquanto o dedo
		// atravessa casas novas, e o `pointerup` larga. O botão DIREITO apaga
		// no mesmo gesto, que é o que todo editor de mapa faz — e é por isso
		// que o menu do navegador precisa ser preso aqui.
		<button
			type="button"
			data-show={ onIsBrush() }
			aria-label="Pintar terreno — arraste para pintar, Shift+arraste enche um retângulo, botão direito apaga"
			data-on:pointerdown={ brushGesture(v, "") }
			data-on:pointermove={ followsBrush(v) + "; " + followsRect(retanguloDeTerreno) }
			data-on:pointerup={ wideBrush + "; " + dropTerrainRect(v) }
			data-on:pointercancel={ wideBrush + "; $" + sinalDoRetangulo + " = ''" }
			data-on:contextmenu={ prendeOMenuDoNavegador }
			class="board-squares"
		></button>
		// A BORRACHA tem camada PRÓPRIA e não é um modo do pincel: dividindo
		// a camada com a pintura, o nome acessível tinha de sair de um sinal
		// — e era o mesmo sinal que fazia a borracha apagar a espécie errada
		// em silêncio.
		//
		// Nela os DOIS botões apagam: a ferramenta já disse o que o gesto é, e
		// um botão que fizesse outra coisa seria a mesma ambiguidade que a fez
		// virar ferramenta.
		<button
			type="button"
			data-show={ onIsTool(EraserTool) }
			aria-label="Apagar o terreno — arraste para apagar, Shift+arraste limpa um retângulo"
			data-on:pointerdown={ brushGesture(v, pincelApaga) }
			data-on:pointermove={ followsBrush(v) + "; " + followsRect(retanguloDeTerreno) }
			data-on:pointerup={ wideBrush + "; " + dropTerrainRect(v) }
			data-on:pointercancel={ wideBrush + "; $" + sinalDoRetangulo + " = ''" }
			data-on:contextmenu={ prendeOMenuDoNavegador }
			class="board-squares"
		></button>
		<button
			type="button"
			data-show={ onIsTool(MarkTool) }
			aria-label="Marcar um lugar — escolha a casa"
			data-on:click={ clickedPointMarking(v) }
			class="board-squares"
		></button>
		// A camada da PEÇA AVULSA é irmã da de marcar, e pelo mesmo desenho: o
		// clique numa casa é o gesto inteiro, e a casa vai no caminho.
		<button
			type="button"
			data-show={ onIsTool(NewPieceTool) }
			aria-label="Nova peça — escolha a casa onde ela nasce"
			data-on:click={ clickedSquareNewPiece(v) }
			class="board-squares"
		></button>
	}
	// A camada de MEDIR é dos dois papéis, e por isso ela sai do bloco do
	// mestre. O `data-show` do movimento vale para todo mundo pelo mesmo
	// motivo: deixá-lo só onde havia pincel tornaria a régua do jogador um
	// desenho que rouba o clique do próprio movimento.
	//
	// A RÉGUA é uma POLILINHA, e por isso a camada dela tem quatro gestos
	// onde havia um: clique acrescenta parada, duplo clique congela, botão
	// direito apaga, e o movimento leva a perna viva atrás do dedo. Ver
	// `clickedPointRuler` para a gramática inteira e para o Escape que não
	// chega.
	<button
		type="button"
		data-show={ "$tool === '" + FerramentaDaRegua + "'" }
		aria-label="Medir a distância — clique para acrescentar paradas, duplo clique fecha, botão direito apaga"
		data-on:click={ clickedPointRuler(v) }
		data-on:dblclick={ freezeRuler }
		data-on:pointermove={ rulerFollowsPointer(v) }
		data-on:contextmenu={ prendeOMenuDoNavegador + "; " + saveRuler }
		class="board-squares"
	></button>
	// O GABARITO tem os mesmos gestos da régua, por simetria: o
	// ponteiro leva a MIRA atrás do dedo enquanto a forma aponta, e o botão
	// direito apaga sem trocar de ferramenta. Duas ferramentas de medir com
	// gramáticas diferentes seriam duas coisas para lembrar.
	<button
		type="button"
		data-show={ "$tool === '" + FerramentaDoGabarito + "'" }
		aria-label="Pôr o gabarito de área — clique na origem, clique de novo para apontar, botão direito apaga"
		data-on:click={ clickedPointTemplate(v) }
		data-on:pointermove={ templateFollowsPointer(v) }
		data-on:contextmenu={ prendeOMenuDoNavegador + "; " + saveTemplate }
		class="board-squares"
	></button>
	// A CAMADA DE REPOUSO é UMA SÓ, e ela faz duas coisas: o CLIQUE escolhe a
	// casa para onde a peça vai, e o ARRASTO marca um grupo.
	//
	// Duas camadas não funcionam: as duas se mostram com `$tool === ''`, e a
	// que vem DEPOIS no DOM cobre a outra — o dedo nunca chega ao laço, e o
	// sintoma é o gesto que simplesmente não acontece.
	//
	// O LAÇO só existe para o mestre, e a razão está no `board.MoveGroup`: um
	// jogador tem uma peça, e o que o grupo dispensa (a regra de deslocamento)
	// é justamente o que protege o turno dele.
	//
	// E a camada existe para o mestre MESMO SEM alvo de movimento: fora de
	// combate ninguém tem a vez, e é justamente quando ele está arrumando a
	// cena que marcar um grupo serve.
	if v.AlvoDoMovimento != "" || v.Mestre {
		<button
			type="button"
			data-show="$tool === ''"
			aria-label={ restLayerName(v) }
			data-on:click={ clickRest(v) }
			if v.Mestre {
				data-on:pointerdown={ takesRect(retanguloDePecas) }
				data-on:pointermove={ followsRect(retanguloDePecas) }
				data-on:pointerup={ dropTokensRect(v) }
				data-on:pointercancel={ "$" + sinalDoRetangulo + " = ''" }
			}
			class="board-squares"
		></button>
	}
}

// tableCollectionPlaces é a REGIÃO do acervo, e ela fica FORA da região do
// tabuleiro.
//
// O critério é o RITMO, o mesmo que o `TableRegions` já usa: o acervo muda
// quando uma cena é ARQUIVADA ou removida — duas vezes por sessão —, e o
// tabuleiro muda a cada peça que anda. Pendurar um no outro faz o mais lento ser
// remendado de graça a cada mudança do mais rápido, e numa campanha com uma
// centena e meia de lugares guardados a lista pesa várias vezes o que pesa a
// cena. É a mesma razão que criou a região `mesa-por-no-mapa`.
//
// O `<div>` existe SEMPRE: região que some do HTML é região que o remendo não
// acha. O que a porta do mestre esconde é o CONTEÚDO — e o `<dialog>` continua
// nascendo e morrendo com o gatilho, porque um diálogo sem botão que o abra é
// peso morto que a busca da página ainda encontra.
templ tableCollectionPlaces(v View) {
	<div id="table-archive">
		if v.Tabuleiro.Mestre && len(v.Tabuleiro.Acervo) > 0 {
			@placesCollection(v.Tabuleiro)
		}
	</div>
}

// partyBar é o que o laço de peças deixa na tela.
//
// Ela diz QUANTAS foram marcadas e o que fazer com elas, e as duas metades
// importam: sem o número, um laço que pegou peça escondida do jogador marcaria
// mais do que o mestre viu; sem a saída, desmarcar exigiria clicar no vazio e
// torcer.
//
// O verbo de MOVER não está aqui de propósito: mover é o ARRASTO de qualquer
// peça marcada, e um botão "mover" numa barra teria de perguntar para onde —
// que é justamente o que o dedo já responde.
templ partyBar(v BoardView) {
	<p role="status" data-show={ hasMarkedParty } class="board-helper gap-2">
		@ui.Icon("LayoutGrid", "size-4 text-grimorio-gold")
		<span data-text={ partyPhrase } class="text-grimorio-gold"></span>
		<button
			type="button"
			aria-label="Desmarcar o grupo"
			data-on:click={ unmarkParty }
			class="ml-auto flex size-8 items-center justify-center rounded-sm border border-transparent text-sm text-muted-foreground outline-none transition-colors hover:border-grimorio-iron"
		>
			@ui.Icon("X", "size-4")
		</button>
	</p>
}

// movePreview é a seta VIVA, desenhada enquanto o dedo arrasta a peça.
//
// Ela é irmã da `moveArrow` e não a mesma: aquela desenha o que o SERVIDOR
// guardou, com o `d` vindo pronto no HTML; esta desenha o que ainda não existe,
// e por isso vive em SINAIS — o caminho muda a cada casa que o dedo atravessa, e
// remendar HTML no meio do gesto trocaria os nós debaixo do dedo.
//
// O CAMINHO TODO e não só a perna viva: as paradas já postas continuam na conta,
// e as três cores são recalculadas sobre o TOTAL. É o que responde "se eu soltar
// aqui, quanto gastei?" — que é a pergunta do gesto.
templ movePreview(v BoardView) {
	<svg
		aria-hidden="true"
		data-show="$preview_arrow_fits !== ''"
		class="board-measure board-measure-front"
	>
		<g data-attr:transform={ viewportDrawing }>
			// AS TRÊS FAIXAS, cada uma no seu nó fixo: o `d` vazio não desenha nada,
			// então a faixa que não existe simplesmente não aparece — sem um
			// `data-show` por nó, que é a combinação que congela a aba quando
			// encontra um `data-attr` de estilo no mesmo elemento.
			<path
				data-attr:d="$preview_arrow_fits"
				vector-effect="non-scaling-stroke"
				class="board-preview-arrow board-preview-fits"
			></path>
			<path
				data-attr:d="$preview_arrow_second"
				vector-effect="non-scaling-stroke"
				class="board-preview-arrow board-preview-second"
			></path>
			<path
				data-attr:d="$preview_arrow_beyond"
				vector-effect="non-scaling-stroke"
				class="board-preview-arrow board-preview-beyond"
			></path>
		</g>
		// OS RÓTULOS EM METROS, fora do grupo que escala — mesma razão dos da régua
		// e dos da seta guardada: dentro dele a fonte seria multiplicada pelo zoom.
		//
		// QUEM ESCONDE É UM NÓ E QUEM POSICIONA É OUTRO: o `<g>` leva o `data-show`
		// e o `<text>` leva os `data-attr` de posição. Juntos no mesmo elemento eles
		// entram em laço e a aba PARA DE RESPONDER, sem console e sem exceção.
		for _, i := range legsReserve() {
			<g data-show={ existsPreviewLabel(i) }>
				<text
					data-attr:x={ previewMid(i, "x") + " * $square - $viewport_x" }
					data-attr:y={ previewMid(i, "y") + " * $square - $viewport_y" }
					data-text={ previewText(i) }
					text-anchor="middle"
					dominant-baseline="middle"
					class="board-ruler-label"
				></text>
			</g>
		}
	</svg>
}

// previewReading é a frase do custo enquanto o dedo arrasta.
//
// Ela mora nos AJUDANTES, junto da leitura da régua, e não no rodapé do
// movimento: o rodapé fala do que já foi proposto, e durante o arrasto ainda não
// há proposta nenhuma. Duas frases no mesmo lugar fariam a pessoa ler o custo
// velho achando que é o novo.
templ previewReading() {
	<p role="status" data-show="$preview_text !== ''" class="board-helper gap-2">
		@ui.Icon("MapPin", "size-4 text-grimorio-gold")
		<span data-text="$preview_text" class="font-mono tabular-nums text-grimorio-gold"></span>
	</p>
}

// newPieceBar é a tira da PEÇA AVULSA: o que ela vai ser, antes de o clique
// dizer onde ela nasce.
//
// Ela é irmã da `templateBar` e pelo mesmo desenho: a ferramenta ligada traz a
// tira com as escolhas dela, e o clique no mapa é o gesto que fecha. Um diálogo
// no lugar da tira exigiria fechá-lo para poder clicar no mapa — e aí a escolha
// e o clique ficariam em dois tempos, com o mestre lendo o nome que digitou
// dentro de uma caixa que sumiu.
//
// A FRASE de como sair está na tira porque o modo não tem número: quem não vê o
// atalho no botão precisa que a tira conte o resto do gesto.
templ newPieceBar(v BoardView) {
	<div
		role="status"
		data-show={ onIsTool(NewPieceTool) }
		class="board-helper gap-1.5"
	>
		<label class="flex items-center gap-1.5 text-xs">
			<span class={ ui.SectionLabelClasses("muted", "") }>Nova peça</span>
			<input
				type="text"
				data-bind="new_token_name"
				placeholder="Porta da cripta"
				aria-label="Nome da peça"
				class="min-h-11 w-40 rounded-sm border border-grimorio-iron bg-transparent px-2 text-sm outline-none"
			/>
		</label>
		// O TAMANHO é o do livro (p107, Tab. 1-21), e os quatro são os lados que
		// ela produz. Botões e não um campo numérico: 4 e 5 não são tamanho de
		// nada, e um campo livre convidaria a digitá-los para o servidor recusar.
		for _, t := range piecesFootprints {
			<button
				type="button"
				title={ t.Rotulo + ": " + t.Lado + " (p107)" }
				aria-label={ "Tamanho " + t.Rotulo }
				data-attr:aria-pressed={ fmt.Sprintf("$new_token_size === %d ? 'true' : 'false'", t.Lados) }
				data-class={ fmt.Sprintf("{'brush-on': $new_token_size === %d}", t.Lados) }
				data-on:click={ fmt.Sprintf("$new_token_size = %d", t.Lados) }
				class="inline-flex min-h-11 items-center rounded-sm border border-grimorio-iron px-2.5 text-xs outline-none transition-colors hover:bg-accent"
			>{ t.Lado }</button>
		}
		for _, a := range piecesLooks {
			<button
				type="button"
				title={ a.Dica }
				aria-label={ "Aparência: " + a.Rotulo }
				data-attr:aria-pressed={ fmt.Sprintf("$new_token_look === %q ? 'true' : 'false'", a.ID) }
				data-class={ fmt.Sprintf("{'brush-on': $new_token_look === %q}", a.ID) }
				data-on:click={ fmt.Sprintf("$new_token_look = %q", a.ID) }
				class="inline-flex min-h-11 items-center rounded-sm border border-grimorio-iron px-2.5 text-xs outline-none transition-colors hover:bg-accent"
			>{ a.Rotulo }</button>
		}
		<span class="text-xs text-muted-foreground">clique numa casa para pôr</span>
	</div>
}

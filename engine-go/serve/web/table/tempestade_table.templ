package table

import (
	"fmt"

	"t20engine/serve/web/ds"
	"t20engine/serve/web/sheetui"
	"t20engine/serve/web/ui"
)

// A SESSÃO DO JOGADOR (ALE-473), pelo mockup aprovado `sessao.html`. O
// cabeçalho com a faixa sem fim em cima; a barra da sessão embaixo no celular
// (decisão do dono: é onde o polegar alcança) e em cima no desktop. As quatro
// superfícies vestem o kit; o mapa do Tabuleiro é o de hoje, porque ele é
// conteúdo e não moldura (ver `tempestadeBoard`).
templ tempestadeTableScene(v View) {
	<main id="table" class="ds-session">
		@tempestadeHeader(v)
		// O ATAQUE PROPOSTO fica acima de toda superfície, pela razão do de
		// hoje: é o que a mesa tem de decidir agora, onde quer que se esteja.
		@tempestadeAttack(v)
		@tempestadeSkillTest(v)
		<nav class="ds-session-nav" aria-label="Superfícies da sessão">
			for _, layer := range surfaces(v) {
				<button
					type="button"
					data-attr:aria-current={ fmt.Sprintf("%s ? 'page' : 'false'", surface(layer.ID)) }
					data-on:click={ pickSurface(layer.ID) }
				>
					@ui.Icon(sessionSurfaceIcon(layer.ID), "ds-icon")
					{ layer.Label }
				</button>
			}
		</nav>
		if v.MySheet != nil {
			// O OUVIDO DA FICHA, pela razão do `tableScene`: o stream só avisa que
			// o personagem mudou, e quem repede a ficha é o cliente, na seção em
			// que a pessoa está.
			<div
				data-on-signal-patch-filter="{include: /^sheet_version$/}"
				data-on-signal-patch={ sheetui.SheetRefetch(*v.MySheet) }
				hidden
			></div>
			<div class="ds-session-surface" data-show={ surface(superficieDaFicha) }>
				@sheetui.SceneBody(*v.MySheet)
			</div>
			// AS AÇÕES: a barra de alvo fixa em cima e a lista rolando por baixo.
			<div class="ds-session-surface" data-show={ surface(superficieDasAcoes) }>
				@tempestadeTargetBar(v)
				<div class="ds-session-scroll">
					@sheetui.ActionsSurface(*v.MySheet)
				</div>
			</div>
		}
		// A MESA: o registro, a fila e o grupo, cada um região do stream. A ordem
		// troca sozinha fora de cena (o grupo vem primeiro), pelo CSS, porque as
		// regiões mudam por conta própria e a casca não.
		<div class="ds-session-surface" data-show={ surface(superficieDaMesa) }>
			<div class="ds-session-scroll">
				<div class="ds-mesa">
					@tempestadeRegister(v)
					@tempestadeTracker(v)
					@tempestadeParty(v)
				</div>
			</div>
		</div>
		// O TABULEIRO: o mapa ocupa a superfície inteira, e ela não rola — quem
		// anda é a janela do plano.
		<div class="ds-session-surface" data-show={ surface(superficieDoTabuleiro) }>
			@tempestadeBoardRegion(v)
		</div>
	</main>
}

// tempestadeHeader é o cabeçalho da sessão do jogador. O id é o mesmo do
// cabeçalho de hoje porque é por ele que o remendo pousa.
templ tempestadeHeader(v View) {
	<header
		id="table-header"
		class="ds-session-head"
		if v.Turn.Kind == "mine" {
			data-mine
		}
	>
		// `aria-live` pela razão do cabeçalho de hoje: a vez muda sem navegação,
		// e quem não vê a tela não tem outro sinal de que chegou a vez dele.
		<div class="ds-session-line" aria-live="polite">
			<span class="ds-live" role="img" aria-label="Ao vivo"></span>
			<span class="ds-row-meta">
				{ fmt.Sprintf("Sessão %d", v.SessionNum) }
				if v.Turn.Kind != "idle" {
					{ fmt.Sprintf(" · Rodada %d", v.Round) }
				}
			</span>
			// "SUA VEZ" mora junto da sessão, e LONGE do sair: o selo é o que se
			// procura com o olho na vez, e o sair é o gesto que não se quer
			// tocar por engano ao lado dele (decisão do dono).
			if v.Turn.Kind == "mine" {
				<span class="ds-your-turn">Sua vez</span>
			}
			<span class="ds-session-spacer"></span>
			// SAIR é link pela razão do de hoje: navegar é do navegador. Ícone,
			// com o nome inteiro para o leitor de tela e no `title`.
			<a
				href={ templ.SafeURL(campaignChronicle(v)) }
				class="ds-button"
				data-variant="ghost"
				data-icon
				aria-label="Sair da sessão"
				title="Sair da sessão e voltar para a crônica da campanha"
			>
				@ui.Icon("LogOut", "ds-icon")
			</a>
		</div>
		if len(v.Endless) > 0 {
			// UMA LISTA, e a ordem é dita por ela: um `<ol>` já anuncia a posição,
			// e o marcador da rodada é item próprio, lido no lugar em que ela
			// começa.
			<ol class="ds-turns" aria-label="Ordem de turnos, a partir de agora">
				for _, p := range v.Endless {
					if p.NewRound > 0 {
						<li class="ds-round-mark">{ fmt.Sprintf("Rodada %d", p.NewRound) }</li>
					}
					<li
						class="ds-turn"
						if p.Now {
							data-now
						}
						if p.Mine {
							data-mine
						}
					>{ turnStripName(p) }</li>
				}
			</ol>
		} else {
			<p class="ds-row-meta">Aguardando iniciativa</p>
		}
	</header>
}

// tempestadeTargetBar é a barra de ALVO DA VEZ das Ações, e é região
// do stream pela razão da de hoje: quem muda a lista de alvos é a fila. Ela
// também ESCREVE DE QUEM É A VEZ (`my_turn`) a cada tique, e diz por que as
// ações apagaram. Fora de combate a vez é de todos — conjurar não espera fila.
templ tempestadeTargetBar(v View) {
	<div id="table-turn-target" class="ds-target" data-signals={ fmt.Sprintf("{my_turn: %t}", v.Turn.Kind != "other") }>
		if v.Turn.Kind == "other" {
			<p class="ds-off-turn">É a vez de <b>{ v.Turn.Label }</b>. As ações abrem na sua vez.</p>
		}
		if len(v.Queue) > 0 {
			<label class="ds-target-bar">
				<span class="ds-target-key">
					@ui.Icon("Target", "ds-icon")
					Contra
				</span>
				<select class="ds-input" data-bind="turn_target">
					<option value="">Escolha o alvo</option>
					for _, target := range turnTargetsOf(v.Queue) {
						<option value={ target.EntryID }>{ target.Label }</option>
					}
				</select>
			</label>
		}
	</div>
}

// tempestadeAttack é o CARTÃO DO ATAQUE proposto, para todos na mesa: quem
// atacou quem, com o quê, a conta que o motor escreveu, e o que ainda pode ser
// feito antes de o mestre confirmar. "Rascunho" e "o mestre confirma" explicam
// a ausência do Confirmar, que é só do mestre.
templ tempestadeAttack(v View) {
	if v.Attack != nil {
		<section id="table-attack" class="ds-strike" aria-label="Ataque proposto">
			<div class="ds-strike-head">
				@ds.Badge("Rascunho", true)
				<span class="ds-row-meta">{ v.Attack.Attacker + " → " }<b>{ v.Attack.Target }</b></span>
				if v.Attack.Weapon != "" {
					<span class="ds-row-meta">{ "· " + v.Attack.Weapon }</span>
				}
			</div>
			// `aria-live` na conta, pela razão do de hoje: quem ouve precisa do
			// resultado, e não dos botões.
			<div class="ds-strike-roll" aria-live="polite">
				<b class="ds-strike-verdict">{ v.Attack.Verdict }</b>
				<span class="ds-strike-tally">{ v.Attack.Tally }</span>
			</div>
			for _, line := range attackNotes(v.Attack) {
				<p class="ds-help">{ line }</p>
			}
			<p class="ds-help">{ "O mestre confirma e aplica em " + v.Attack.Target + "." }</p>
			if len(v.Attack.Offers) > 0 || v.Attack.Mine {
				<div class="ds-strike-foot">
					for _, offer := range v.Attack.Offers {
						@ds.Button(ds.ButtonGhost, templ.Attributes{"type": "button", "data-on:click": offerCommand(offer)}) {
							{ offer.Label }
						}
					}
					if v.Attack.Mine {
						@ds.Button(ds.ButtonSecondary, templ.Attributes{"type": "button", "data-on:click": attackCommand(v, "cancelar")}) {
							Cancelar
						}
					}
				</div>
			}
		</section>
	} else {
		// O NÓ VAZIO fica, pela razão do de hoje: o stream remenda POR ID.
		<section id="table-attack" hidden></section>
	}
}

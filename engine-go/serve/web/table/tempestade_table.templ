package table

import (
	"fmt"

	"t20engine/serve/web/ds"
	"t20engine/serve/web/sheetui"
	"t20engine/serve/web/ui"
)

// A SESSÃO PARALELA (ALE-473), pelo mockup aprovado `sessao.html`: a visão do
// jogador com personagem, aberta com `?tempestade=1`. O cabeçalho com a faixa
// sem fim em cima; a barra da sessão embaixo no celular (decisão do dono: é
// onde o polegar alcança) e em cima no desktop; a Ficha embutida já na ficha
// paralela. Ações, Mesa e Tabuleiro ainda não migraram, e levam à sessão de
// hoje — nunca o desenho de hoje aqui dentro, que é a mistura que a transição
// por escopo proíbe.
templ tempestadeTableScene(v View) {
	<main id="table" class="ds-session">
		@tempestadeHeader(v)
		<nav class="ds-session-nav" aria-label="Superfícies da sessão">
			for _, layer := range surfaces(v) {
				<button
					type="button"
					data-attr:aria-current={ fmt.Sprintf("%s ? 'page' : 'false'", surface(layer.ID)) }
					data-on:click={ pickSurface(layer.ID) }
				>
					@ui.Icon(sessionSurfaceIcon(layer.ID), "ds-icon")
					{ layer.Label }
				</button>
			}
		</nav>
		if v.MySheet != nil {
			// O OUVIDO DA FICHA, pela razão do `tableScene`: o stream só avisa que
			// o personagem mudou, e quem repede a ficha é o cliente, na seção em
			// que a pessoa está.
			<div
				data-on-signal-patch-filter="{include: /^sheet_version$/}"
				data-on-signal-patch={ sheetui.SheetRefetch(*v.MySheet) }
				hidden
			></div>
			<div class="ds-session-surface" data-show={ surface(superficieDaFicha) }>
				@sheetui.SceneBody(*v.MySheet)
			</div>
		}
		for _, layer := range surfaces(v) {
			if layer.ID != superficieDaFicha {
				<div class="ds-session-surface ds-session-todo" data-show={ surface(layer.ID) }>
					@ds.Empty(layer.Label+" ainda está na sessão de hoje", "Esta superfície ainda não foi refeita no sistema novo.") {
						<div class="mt-3 flex justify-center">
							@ds.LinkButton(ds.ButtonSecondary, templ.SafeURL(v.SessionBase()), nil) {
								{ "Abrir " + layer.Label + " na sessão de hoje" }
							}
						</div>
					}
				</div>
			}
		}
	</main>
}

// tempestadeHeader é o cabeçalho da sessão paralela, e é a ÚNICA região que o
// stream remenda nela (`TableRegions`). O id é o mesmo do cabeçalho de hoje
// porque é por ele que o remendo pousa.
templ tempestadeHeader(v View) {
	<header
		id="table-header"
		class="ds-session-head"
		if v.Turn.Kind == "mine" {
			data-mine
		}
	>
		// `aria-live` pela razão do cabeçalho de hoje: a vez muda sem navegação,
		// e quem não vê a tela não tem outro sinal de que chegou a vez dele.
		<div class="ds-session-line" aria-live="polite">
			<span class="ds-live" role="img" aria-label="Ao vivo"></span>
			<span class="ds-row-meta">
				{ fmt.Sprintf("Sessão %d", v.SessionNum) }
				if v.Turn.Kind != "idle" {
					{ fmt.Sprintf(" · Rodada %d", v.Round) }
				}
			</span>
			<span class="ds-session-spacer"></span>
			if v.Turn.Kind == "mine" {
				<span class="ds-your-turn">Sua vez</span>
			}
			// SAIR é link pela razão do de hoje: navegar é do navegador.
			@ds.LinkButton(ds.ButtonGhost, templ.SafeURL(campaignChronicle(v)), templ.Attributes{"title": "Sair da sessão e voltar para a crônica da campanha"}) {
				Sair
			}
		</div>
		if len(v.Endless) > 0 {
			// UMA LISTA, e a ordem é dita por ela: um `<ol>` já anuncia a posição,
			// e o marcador da rodada é item próprio, lido no lugar em que ela
			// começa.
			<ol class="ds-turns" aria-label="Ordem de turnos, a partir de agora">
				for _, p := range v.Endless {
					if p.NewRound > 0 {
						<li class="ds-round-mark">{ fmt.Sprintf("Rodada %d", p.NewRound) }</li>
					}
					<li
						class="ds-turn"
						if p.Now {
							data-now
						}
						if p.Mine {
							data-mine
						}
					>{ turnStripName(p) }</li>
				}
			</ol>
		} else {
			<p class="ds-row-meta">Aguardando iniciativa</p>
		}
	</header>
}

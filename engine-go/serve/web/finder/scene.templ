package finder

import (
	"fmt"
	"t20engine/serve/web/ds"
	"t20engine/serve/web/ui"
)
import "strconv"

// A CAIXA do buscador do livro.
//
// `<dialog>` NATIVO, como o `abrir-tabuleiro`, e aqui ele paga cinco coisas de
// uma vez: foco preso, Esc, fundo inerte, camada de topo — e o driver de
// teclado da cena se RECOLHE sozinho, porque o `hasOpenOverlay()` do
// `scene-nav.ts` procura `dialog[open]`. Sem isso as setas continuariam andando
// na lista ATRÁS da caixa.
//
// O `scene-ds` vai NA CAIXA, porque ela abre por cima das telas que ainda não migraram,
// e os tokens do Tempestade só valem dentro desse escopo. Não é um `ds.Dialog` porque o
// campo mora na cabeça, no lugar do título.
//
// A caixa mora na CASCA e é desenhada UMA vez por página. Ela não é remendada —
// só o `#finder-found` de dentro é —, e essa divisão importa: o
// `data-bind:finder` do campo vive fora do que o servidor troca, então o que
// a pessoa está digitando nunca é redeclarado por baixo dela.
templ Dialog() {
	<dialog
		id="finder"
		class="scene-ds ds-dialog ds-finder"
		data-preserve-attr="open"
		aria-labelledby="finder-title"
		data-on:keydown={ ui.WalkTheSearch }
	>
		<h2 id="finder-title" class="sr-only">Buscar no livro</h2>
		<div class="ds-finder-field">
			// O NOME DO SINAL É MINÚSCULO porque o analisador de HTML minuscula
			// nome de atributo: um `data-bind:buscaDoLivro` ligaria um sinal
			// `buscadolivro` e deixaria o declarado intocado.
			//
			// E ele NÃO se chama `busca`: esse nome já é o da busca da cena, no
			// MESMO documento. Duas ligações no mesmo sinal fariam digitar aqui
			// reescrever o filtro da tela atrás — e o `@get` da cena mandaria o
			// texto do buscador.
			@ds.SearchField("finder-field", "Buscar no livro", templ.Attributes{
				"data-bind:finder": true, "autocomplete": "off",
				// No `type=search` o Esc limpa o campo e a caixa fica aberta. Aqui ele fecha, que
				// é o que ele faz em toda caixa do app.
				"data-on:keydown": "evt.key === 'Escape' && (evt.preventDefault(), el.closest('dialog').close())",
				"data-on:input__debounce.200ms": "@get('" + finderRoute + "')",
			})
			<form method="dialog">
				@ds.IconButton(ds.ButtonGhost, "X", "Fechar", nil)
			</form>
		</div>
		@finderResults(finderView{})
	</dialog>
}

// finderResults é o único pedaço REMENDADO, e por isso tem id próprio.
//
// `aria-live="polite"` porque a lista muda sem gesto nenhum de quem lê: o
// resultado chega 200ms depois da tecla, e sem o anúncio quem usa leitor de tela
// digita no escuro.
templ finderResults(v finderView) {
	<div id="finder-found" class="ds-finder-found" aria-live="polite">
		if !v.Buscando() {
			@ds.Empty("Buscar no livro", "Procura em criaturas, condições, magias, poderes e itens.")
		} else if v.Findings == 0 {
			@ds.Empty("Nada encontrado", "Nada no livro casa com “"+v.Search+"”.")
		} else {
			// O AVISO da segunda passada: sem ele, uma lista em que o termo não
			// aparece em nome nenhum parece a lista errada. Ver `searchTheBook`.
			if v.ByText {
				<p class="ds-row-meta">{ "Nenhum nome casa — estes mencionam “" + v.Search + "” no texto da regra." }</p>
			}
			for _, g := range v.Groups {
				<section class="ds-finder-group" aria-label={ g.Label }>
					<h3 class="ds-list-head">{ g.Label }</h3>
					for _, a := range g.Findings {
						// `<a>` de verdade: abrir é NAVEGAR, e um botão com
						// JavaScript perderia o clique do meio, o "abrir em
						// nova aba" e o Enter que o navegador já dá de graça.
						// O `data-resultado` é o que as setas percorrem.
						<a href={ templ.SafeURL(a.Destination) } class="ds-row ds-finder-row" data-resultado>
							<div>
								<div class="ds-row-title">{ a.Name }</div>
								if a.Detail != "" {
									<div class="ds-row-meta">{ a.Detail }</div>
								}
							</div>
							if a.Page > 0 {
								<span class="ds-row-meta">{ fmt.Sprintf("p%d", a.Page) }</span>
							}
						</a>
					}
					// O CORTE é dito e tem saída: um "+12" que não leva a lugar
					// nenhum informa e abandona. Este leva à cena da ferramenta
					// com a mesma busca, que é onde os doze estão.
					if g.Cortados() > 0 {
						<a href={ templ.SafeURL(g.More) } class="ds-row ds-finder-row ds-finder-more" data-resultado>
							{ "+" + strconv.Itoa(g.Cortados()) + " em " + g.Label }
						</a>
					}
				</section>
			}
		}
	</div>
}

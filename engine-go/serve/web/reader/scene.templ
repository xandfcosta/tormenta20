package reader

import (
	"fmt"
	"t20engine/serve/web/ds"
	"t20engine/serve/web/ui"
)

// A CENA DO LEITOR: o livro aberto na página do verbete.
//
// Ela é uma casca NUA e ocupa a tela inteira porque é para LER: cabeçalho de
// cena, trilho e migalhas roubariam altura da página do livro, que é o único
// conteúdo aqui. A barra fina de cima já diz onde se está e como andar.
//
// Todo o estado vive no `<div id="reader">` como atributos de DADO, e não em
// sinais do Datastar. A razão é que quem lê isto não é o Datastar: é o
// `reader.js`, um módulo próprio que roda uma vez na carga. Sinal seria estado
// de cliente viajando em toda requisição seguinte para nada.
templ readerScene(v readerView) {
	<div class="ds-reader">
		// A mesma barra nos dois lugares. Dentro da caixa do livro não há volta, que levaria
		// o iframe para a cena anterior, e o X é da caixa, desenhado por cima no canto: o
		// `data-in-dialog` reserva o espaço dele.
		<header
			class="ds-header ds-reader-bar"
			if v.InDialog {
				data-in-dialog
			}
		>
			if !v.InDialog {
				<a href={ templ.SafeURL(v.Back) } class="ds-header-back" aria-label="Voltar">
					@ui.Icon("ChevronLeft", "ds-icon")
				</a>
			}
			<h1 class="ds-header-title">{ v.title() }</h1>
			<div class="ds-reader-tools">
				<div class="ds-reader-group">
					@readerButton("previous", "ChevronLeft", "Página anterior")
					<span data-current-page class="ds-row-meta ds-reader-page">
						{ fmt.Sprintf("p%d", v.Page) }
					</span>
					@readerButton("next", "ChevronRight", "Próxima página")
				</div>
				<div class="ds-reader-group">
					@readerButton("less", "Minus", "Diminuir")
					@readerButton("more", "Plus", "Aumentar")
				</div>
				// A SAÍDA para o visualizador do navegador, e ela não é enfeite: este leitor
				// mostra uma página por vez e destaca um termo. Busca, miniaturas e impressão
				// são do visualizador de verdade, e mandar para lá é melhor que reimplementá-lo
				// pela metade. No celular só o ícone cabe, e o nome fica no `aria-label`.
				<a
					href={ templ.SafeURL(v.PDF) }
					target="_blank"
					rel="noopener"
					class="ds-button"
					data-variant="ghost"
					aria-label="Abrir fora"
					title="Abrir no visualizador do navegador"
				>
					@ui.Icon("ExternalLink", "ds-icon")
					<span class="ds-reader-out">Abrir fora</span>
				</a>
			</div>
		</header>
		// `overflow` no CONTÊINER e não no documento: a casca do app é `h-dvh` com o conteúdo
		// rolando por dentro, e deixar o documento rolar faria a barra sair da tela junto com
		// a página.
		<div
			id="reader"
			class="ds-reader-sheet"
			data-book={ v.PDF }
			data-worker={ v.Worker }
			data-page={ fmt.Sprintf("%d", v.Page) }
			data-opening={ fmt.Sprintf("%d", v.Opening) }
			data-term={ v.Term }
		>
			<div class="relative mx-auto w-fit">
				// Sem `max-w-full`: a largura é decidida no `reader.ts` (ver
				// `LARGURA_MAXIMA`), e deixar o CSS encolher o canvas por cima
				// desalinharia as marcas, que são posicionadas na largura que o
				// pdf.js desenhou.
				<canvas class="block shadow-lg"></canvas>
				// As marcas ficam numa camada IRMÃ do canvas e não desenhadas nele:
				// pintar o destaque no bitmap obrigaria a redesenhar a página
				// inteira para tirá-lo, e o texto por baixo continuaria coberto de
				// tinta em vez de realçado.
				<div data-marks aria-hidden="true" class="pointer-events-none absolute left-0 top-0"></div>
			</div>
		</div>
	</div>
}

// readerButton é um botão da barra. UMA marca (`data-action`) e não uma por família: o
// `reader.js` procura pelo que o botão FAZ, e dois atributos diferentes obrigariam o
// componente a saber qual dos dois escrever. Nasce desligado, e o `reader.js` o liga quando
// a página fica pronta.
templ readerButton(action, icon, label string) {
	@ds.IconButton(ds.ButtonSecondary, icon, label, templ.Attributes{"type": "button", "data-action": action, "disabled": true})
}

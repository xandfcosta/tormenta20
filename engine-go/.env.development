# Ambiente de DESENVOLVIMENTO — carregado por `pnpm dev`, que é o air na :3001.
#
# Este arquivo É versionado de propósito: nada aqui é segredo. O token assinado
# com o JWT_SECRET abaixo só vale no seu banco de dev, e o servidor RECUSA subir
# em produção com ele (ALE-119).
#
# Qualquer variável já exportada no shell vence o arquivo:
#   PORT=4000 pnpm dev

PORT=3001
DATABASE_URL=file:./data/t20-dev.db
JWT_SECRET=t20-dev-secret

# Quem administra a mesa (ALE-120): lista separada por vírgula. Este é o mestre
# do seed, então o `pnpm dev` já sobe com um admin de verdade. O papel NÃO tem
# coluna no banco — é este arquivo, e só ele.
ADMIN_EMAILS=mestre@t20.local
JWT_EXPIRES_IN=7d
COOKIE_NAME=t20_session

# HTTP em localhost: um cookie Secure seria descartado pelo browser e o login
# nunca concluiria.
COOKIE_SECURE=false

# CORS fica VAZIO, e é por isso que ele não aparece aqui como variável.
#
# Um processo só serve as cenas, a API e o fluxo ao vivo na mesma porta, então
# toda chamada do navegador é mesma-origem e nenhum middleware é montado — igual
# à produção, que é a propriedade que importa: ambiente de desenvolvimento mais
# permissivo que o de produção esconde defeito.
#
# > Aqui morava `CORS_ORIGIN=http://localhost:5173,http://[::1]:5173,...`, com as
# > três grafias que o navegador trata como origens diferentes. Elas existiam
# > porque a SPA era servida pelo Vite naquela porta e a API respondia noutra, e
# > a grafia que ficasse de fora perdia o socket para um 403 que chegava na tela
# > como "RECONECTANDO…" para sempre (ALE-185). A SPA saiu na ALE-272; a lista
# > sobreviveu a ela por meses, liberando credenciais para uma origem que
# > ninguém é dono (ALE-321).
#
# Precisa de uma origem externa? Escreva `CORS_ORIGIN=` aqui — a variável
# continua sendo lida, só não tem mais valor de fábrica.

# Onde a tela de admin e o `pnpm db:backup` escrevem (ALE-120).
BACKUP_DIR=../backups
# Backup automático (ALE-157). Zero em qualquer um dos dois desliga.
BACKUP_EVERY=24h
BACKUP_KEEP=7

CATALOG_PATH=parity/_catalogs.json

# HTTPS neste processo (ALE-118). Vazios = HTTP puro, que é o desenvolvimento
# de sempre. O par tem de estar INTEIRO: com só um dos dois o servidor RECUSA
# subir, em vez de cair para HTTP em silêncio — meio par vem sempre acompanhado
# de COOKIE_SECURE=true, e aí o cookie é descartado e o login não conclui.
#
# Para experimentar HTTPS aqui, gere um par de brincadeira FORA do repositório:
#   openssl req -x509 -newkey rsa:2048 -nodes -days 1 \
#     -keyout /tmp/t20-key.pem -out /tmp/t20-cert.pem -subj /CN=localhost
# O navegador vai reclamar (certificado que ninguém assinou) e é preciso passar
# pelo aviso à mão. Serve para ver o app em contexto seguro; não serve para a
# mesa — para a mesa, ver a seção "HTTPS na LAN" do README.
TLS_CERT_FILE=
TLS_KEY_FILE=

# O LIVRO (ALE-264): o caminho do Tormenta 20 em PDF que o servidor entrega em
# `/piloto/livro`. Vazio = nada é servido e o botão de abrir no livro não nasce.
# O arquivo é ignorado pelo git e vive fora do módulo Go, por isso é caminho e
# não embutido. Linearize antes (`qpdf --linearize`): medido, abrir uma página
# transfere o arquivo INTEIRO nos dois casos, e o qpdf encolhe 89,5 MB para
# 78,6 — o boot avisa quando não está.
LIVRO_PDF=
# Quantas páginas o arquivo tem antes da página impressa 1. Medido pelo rodapé
# do PDF da casa: a página 295 do arquivo imprime "289".
LIVRO_ABERTURA=6

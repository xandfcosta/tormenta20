# A configuração do `docker compose` (ALE-273).
#
#   cp .env.example .env
#
# Este arquivo é o MOLDE e é versionado; o `.env` que sai dele NÃO é, porque
# carrega a chave que assina os cookies da mesa.
#
# Nada aqui vira `.env.production` dentro da imagem: o `LoadConfig` do Go lê o
# ambiente do processo por cima de qualquer arquivo (ALE-119), e é o compose que
# passa estes valores.

# OBRIGATÓRIO. Quem alcança o servidor com esta chave emite o próprio cookie e é
# todo mundo de uma vez, então ela é sua e só sua:
#   openssl rand -hex 32
JWT_SECRET=

# OBRIGATÓRIO. Cadastro exige convite e só admin convida — um servidor sem admin
# é um servidor em que ninguém nunca entra (ALE-120). Separe por vírgula.
ADMIN_EMAILS=

# A porta que a mesa abre no navegador. Só o lado de FORA muda; dentro do
# contêiner o app escuta 3001 sempre.
T20_PORT=3001

# QUEM ESCREVE NO BANCO. O contêiner precisa do uid que é dono da pasta `data/`
# do hospedeiro, senão o primeiro `up` morre em "unable to open database file" —
# que parece banco corrompido e é permissão. Os seus:  id -u  e  id -g
T20_UID=1000
T20_GID=1000

JWT_EXPIRES_IN=7d

# `true` SOMENTE com HTTPS na frente. Em HTTP o navegador descarta o cookie e o
# login não conclui, sem erro em lugar nenhum (ALE-118).
COOKIE_SECURE=false

# O backup automático usa `VACUUM INTO` e poda os mais antigos. Zero em qualquer
# um dos dois desliga.
BACKUP_EVERY=24h
BACKUP_KEEP=7

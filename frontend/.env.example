# Frontend env vars (Vite). Copy to `.env.local` (gitignored) to override
# locally. Only `VITE_`-prefixed vars are exposed to the client bundle.

# TanStack Router/Query devtools toggle. Devtools render in dev by default;
# set to `off` to suppress them (their bottom-corner pills overlap UI and get
# in the way of browser / automated UI testing). Any other value = on.
VITE_DEVTOOLS=on

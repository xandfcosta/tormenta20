# O AMBIENTE da mesa de DEV (ALE-529), que o `docker-compose.dev.yml` dá ao app
# no lugar do `environment` de produção. Ele também preenche o compose de
# produção incluído quando não há `.env` na raiz — os `:?` dele não sobem sem a
# chave e o admin.
#
# É versionado de propósito: nada aqui é segredo.

APP_ENV=development
# A chave de dev, que o servidor aceita só fora de produção.
JWT_SECRET=t20-dev-secret
# O mestre da semente.
ADMIN_EMAILS=mestre@t20.local
JWT_EXPIRES_IN=7d
# Ligado, como em produção: o dev também chega pelo HTTPS do nginx.
COOKIE_SECURE=true
# O banco é efêmero: backup dele não guardaria nada.
BACKUP_EVERY=0
BACKUP_KEEP=0

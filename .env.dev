# As variáveis da mesa de DEV (ALE-529), para o `docker-compose.dev.yml`:
#
#   docker compose --env-file .env.dev -f docker-compose.dev.yml up -d --build
#
# É versionado de propósito: nada aqui é segredo. Ele entra no lugar do `.env`
# de produção na interpolação, e é assim que o compose de produção, herdado
# inteiro, sobe com o ambiente de dev sem pedir a chave da mesa de verdade.

# A chave de dev, que o servidor aceita só fora de produção.
JWT_SECRET=t20-dev-secret
# O mestre da semente.
ADMIN_EMAILS=mestre@t20.local
JWT_EXPIRES_IN=7d
# Ligado, como em produção: o dev também chega pelo HTTPS do nginx.
COOKIE_SECURE=true
# O banco é efêmero: backup dele não guardaria nada.
BACKUP_EVERY=0
BACKUP_KEEP=0
# Portas próprias, para subir ao lado da mesa de produção.
T20_HTTP_PORT=8080
T20_HTTPS_PORT=8443

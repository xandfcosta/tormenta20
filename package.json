{
  "name": "tormenta20",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n api,front -c green,cyan \"pnpm -F @tormenta20/engine-go dev\" \"pnpm -F frontend dev\"",
    "dev:frontend": "pnpm --filter frontend run dev",
    "build": "pnpm -r run build",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "test": "pnpm -r --filter '!e2e' run test",
    "test:e2e": "pnpm --filter e2e test",
    "typecheck": "pnpm -r run typecheck",
    "start": "pnpm --filter frontend build && pnpm -F @tormenta20/engine-go start"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "concurrently": "^9.1.0",
    "vitest": "^4.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "unrs-resolver",
      "@parcel/watcher",
      "esbuild",
      "@tailwindcss/oxide"
    ]
  }
}

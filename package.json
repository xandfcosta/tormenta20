{
  "name": "tormenta20",
  "private": true,
  "scripts": {
    "dev": "pnpm -F @tormenta20/engine-go dev",
    "build": "pnpm -r run build",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "test": "pnpm -r --filter '!e2e' run test",
    "test:e2e": "pnpm --filter e2e test",
    "typecheck": "pnpm -r run typecheck",
    "start": "pnpm build && pnpm -F @tormenta20/engine-go start",
    "db:backup": "bash scripts/backup-db.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0"
  }
}
